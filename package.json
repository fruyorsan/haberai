{
  "name": "haber-sitesi-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RSS toplayıp Gemini ile özetleyen ve yorum katan haber hattı",
  "scripts": {
    "collect": "node --env-file-if-exists=.env src/index.js",
    "collect:dry": "node --env-file-if-exists=.env src/index.js --dry",
    "share": "node --env-file-if-exists=.env src/share-cli.js",
    "share:dry": "node --env-file-if-exists=.env src/share-cli.js --dry",
    "indexnow": "node --env-file-if-exists=.env src/indexnow.mjs",
    "indexnow:dry": "node --env-file-if-exists=.env src/indexnow.mjs --dry",
    "backfill": "node --env-file-if-exists=.env src/backfill.js",
    "backfill:dry": "node --env-file-if-exists=.env src/backfill.js --dry",
    "ek-gorsel": "node --env-file-if-exists=.env src/ek-gorsel-doldur.js",
    "ek-gorsel:dry": "node --env-file-if-exists=.env src/ek-gorsel-doldur.js --dry",
    "gorsel-sorgu": "node --env-file-if-exists=.env src/gorsel-sorgu-doldur.js",
    "gorsel-sorgu:dry": "node --env-file-if-exists=.env src/gorsel-sorgu-doldur.js --dry",
    "gorsel-guvenli": "node scripts/gorsel-guvenli.mjs",
    "gorsel-guvenli:dry": "node scripts/gorsel-guvenli.mjs --dry",
    "bildirim": "node --env-file-if-exists=.env src/bildirim.js",
    "bildirim:dry": "node --env-file-if-exists=.env src/bildirim.js --dry",
    "indeks": "node src/indeks.js",
    "kapak": "node --env-file-if-exists=.env scripts/kapak-uret.mjs",
    "kaynak-gorsel": "node scripts/kaynak-gorsel.mjs",
    "domain": "node scripts/domain-durum.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5"
  }
}
