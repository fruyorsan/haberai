---
import { getArticles, timeAgo } from "../lib/articles.js";
import MarketTicker from "./MarketTicker.astro";

const nav = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Teknoloji", href: "/kategori/teknoloji/" },
  { label: "Yapay Zeka", href: "/kategori/yapay-zeka/" },
  { label: "Mobil", href: "/kategori/mobil/" },
  { label: "Oyun", href: "/kategori/oyun/" },
  { label: "Ekonomi", href: "/kategori/ekonomi/" },
  { label: "Tüm Haberler", href: "/haberler/" },
];

const path = Astro.url.pathname;
const latest = getArticles().slice(0, 8);
const today = new Date().toLocaleDateString("tr-TR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  weekday: "long",
});
const isActive = (href) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<MarketTicker />

<div class="topbar">
  <div class="container topbar__inner">
    <span class="topbar__date">{today}</span>
    {latest.length > 0 && (
      <div class="topbar__ticker">
        <span class="topbar__tag">
          <span class="topbar__live" aria-hidden="true"></span>
          SON DAKİKA
        </span>
        <div class="topbar__rot" id="son-dakika">
          {latest.map((a) => (
            <a class="topbar__slide" href={a.url}>
              <span class="topbar__headline">{a.title}</span>
              <span class="topbar__time">{timeAgo(a.publishedAt || a.generatedAt)}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label="HaberAI ana sayfa">
      <span class="logo__mark">H</span>
      <span class="logo__text">Haber<span class="logo__ai">AI</span></span>
    </a>
    <nav class="nav" aria-label="Bölümler">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav__link", { "nav__link--active": isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <form class="searchbox" action="/ara/" method="get" role="search">
      <svg class="searchbox__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.2-3.2" />
      </svg>
      <input
        class="searchbox__input"
        type="search"
        name="q"
        placeholder="Haber ara..."
        aria-label="Haber ara"
      />
    </form>
  </div>
</header>

<script>
  // Son dakika başlıklarını döndür
  const rot = document.getElementById("son-dakika");
  if (rot) {
    const slides = Array.from(rot.querySelectorAll(".topbar__slide"));
    if (slides.length > 0) {
      let i = 0;
      slides[0].classList.add("is-active");
      if (slides.length > 1) {
        setInterval(() => {
          slides[i].classList.remove("is-active");
          i = (i + 1) % slides.length;
          slides[i].classList.add("is-active");
        }, 6000);
      }
    }
  }

  // Kaydırınca header'a gölge ver
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-stuck", window.scrollY > 6);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .topbar {
    background: var(--red);
    color: #fff;
    font-size: 0.82rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 38px;
  }
  .topbar__date {
    opacity: 0.9;
    white-space: nowrap;
  }
  .topbar__ticker {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    margin-left: auto;
    overflow: hidden;
  }
  .topbar__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.26);
    padding: 3px 9px;
    border-radius: 6px;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .topbar__live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: topbar-blink 1.6s ease-in-out infinite;
  }
  @keyframes topbar-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  .topbar__rot {
    position: relative;
    flex: 1;
    height: 22px;
    min-width: 0;
  }
  .topbar__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateY(7px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    pointer-events: none;
    overflow: hidden;
  }
  .topbar__slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    overflow: visible;
  }
  .topbar__headline {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
  }
  .topbar__slide:hover .topbar__headline {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .topbar__time {
    opacity: 0.85;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.25s var(--ease);
  }
  .header.is-stuck {
    box-shadow: 0 10px 30px -18px rgba(16, 24, 40, 0.5);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 1.4rem;
    letter-spacing: -0.025em;
    flex-shrink: 0;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--red-grad);
    color: #fff;
    font-size: 1.2rem;
    box-shadow: 0 10px 22px -12px rgba(216, 31, 38, 0.95);
    transition: transform 0.3s var(--ease);
  }
  .logo:hover .logo__mark {
    transform: rotate(-6deg) scale(1.05);
  }
  .logo__ai {
    color: var(--red);
  }
  .nav {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    flex: 1;
  }
  .nav__link {
    position: relative;
    padding: 8px 11px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.93rem;
    color: #303238;
    transition: background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 11px;
    right: 11px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav__link:hover {
    background: var(--red-soft);
    color: var(--red-dark);
  }
  .nav__link:hover::after {
    transform: scaleX(1);
  }
  .nav__link--active {
    color: var(--red);
  }
  .nav__link--active::after {
    transform: scaleX(1);
  }

  .searchbox {
    position: relative;
    flex-shrink: 0;
  }
  .searchbox__icon {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .searchbox__input {
    width: 190px;
    height: 40px;
    padding: 0 14px 0 36px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--bg-soft);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, background 0.2s, width 0.25s var(--ease),
      box-shadow 0.2s;
  }
  .searchbox__input:focus {
    border-color: var(--red);
    background: #fff;
    width: 224px;
    box-shadow: 0 0 0 4px var(--red-soft);
  }

  @media (max-width: 1000px) {
    .searchbox {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .topbar__date,
    .topbar__time {
      display: none;
    }
    .header__inner {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 12px;
      padding-bottom: 12px;
      gap: 10px;
    }
    .nav {
      gap: 0;
      overflow-x: auto;
      width: 100%;
      flex-wrap: nowrap;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .nav__link {
      white-space: nowrap;
    }
  }
</style>
