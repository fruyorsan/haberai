---
import MarketTicker from "./MarketTicker.astro";

const nav = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Son Dakika", href: "/son-dakika/" },
  { label: "Piyasa", href: "/piyasa/" },
  { label: "Tüm Haberler", href: "/haberler/" },
];

const path = Astro.url.pathname;
const isActive = (href) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<MarketTicker />

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label="HaberAI ana sayfa">
      <span class="logo__mark">H</span>
      <span class="logo__text">Haber<span class="logo__ai">AI</span></span>
    </a>
    <nav class="nav" aria-label="Bölümler">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav__link", { "nav__link--active": isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header__actions">
      <form class="searchbox" action="/ara/" method="get" role="search">
        <button
          class="searchbox__toggle"
          type="button"
          aria-label="Haber ara"
          aria-expanded="false"
          aria-controls="search-input"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.2-3.2" />
          </svg>
        </button>
        <div class="searchbox__field">
          <svg class="searchbox__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.2-3.2" />
          </svg>
          <input
            id="search-input"
            class="searchbox__input"
            type="search"
            name="q"
            placeholder="Haber ara..."
            aria-label="Haber ara"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="searchbox__drop" id="search-drop" role="listbox" aria-label="Arama önerileri" hidden></div>
      </form>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Koyu temaya geç"
        aria-pressed="false"
        title="Görünüm temasını değiştir"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // --- Anlik arama: yazarken altinda acilir sonuç listesi, sayfadan ayrilma yok ---
  const searchForm = document.querySelector(".searchbox");
  if (searchForm) {
    const input = searchForm.querySelector(".searchbox__input");
    const drop = document.getElementById("search-drop");
    const toggle = searchForm.querySelector(".searchbox__toggle");
    const MAX_ITEMS = 6;
    const norm = (s) => String(s ?? "").toLocaleLowerCase("tr");
    const esc = (s) =>
      String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      }[c]));

    // Arama indeksi ilk tuş vuruşunda bir kez indirilir (sayfayı kilitlemez).
    let INDEX = null;
    let pending = null;
    const loadIndex = () => {
      if (INDEX) return Promise.resolve(INDEX);
      if (!pending) {
        pending = fetch("/search-index.json")
          .then((r) => r.json())
          .then((d) => (INDEX = d))
          .catch(() => (INDEX = []));
      }
      return pending;
    };

    let active = -1; // klavyeyle seçili öneri (listeye kapsamaz)
    let rawItems = [];
    let timer = 0;

    const close = () => {
      drop.hidden = true;
      drop.innerHTML = "";
      active = -1;
      input.setAttribute("aria-expanded", "false");
    };

    // Dar ekranda kutu SOLA doğru açılır/kapanır (geniş ekranda etkisiz).
    const setOpen = (open) => {
      searchForm.classList.toggle("is-open", open);
      if (toggle) toggle.setAttribute("aria-expanded", String(open));
    };
    // Öneri listesini ve (boşsa) açık kutuyu kapat.
    const collapse = () => {
      close();
      if (!input.value.trim()) setOpen(false);
    };

    if (toggle) {
      toggle.addEventListener("click", () => {
        setOpen(true);
        input.focus();
      });
    }

    const mark = (title, q) => {
      const safe = esc(title);
      if (!q) return safe;
      try {
        return safe.replace(new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi"), (m) => `<mark>${m}</mark>`);
      } catch {
        return safe;
      }
    };

    function render(items, q) {
      if (!items.length) {
        drop.innerHTML = `<div class="searchbox__empty">Sonuç bulunamadı.</div>
          <a class="searchbox__all" href="/ara/?q=${encodeURIComponent(q)}">Tüm sonuçları göster</a>`;
      } else {
        drop.innerHTML = items
          .map(
            (it, i) => `
          <a class="searchbox__opt" role="option" href="${esc(it.u)}" data-i="${i}">
            <span class="searchbox__opt-cat">${esc(it.c || "")}</span>
            <span class="searchbox__opt-title">${mark(it.t, q)}</span>
          </a>`
          )
          .join("") +
          `<a class="searchbox__all" href="/ara/?q=${encodeURIComponent(q)}">Tüm sonuçlar</a>`;
      }
      drop.hidden = false;
      input.setAttribute("aria-expanded", "true");
      active = -1;
    }

    const setActive = (i) => {
      const opts = drop.querySelectorAll(".searchbox__opt");
      opts.forEach((el, j) => {
        el.classList.toggle("is-active", j === i);
        el.setAttribute("aria-selected", String(j === i));
      });
      active = i;
    };

    function onType() {
      const q = norm(input.value).trim();
      if (q.length < 2) { close(); return; }
      loadIndex().then((list) => {
        // Yine gecikmeli yazım güncelse sonucu uygula; degilse sessizce atla.
        if (norm(input.value).trim() !== q) return;
        const words = q.split(/\s+/).filter(Boolean);
        const hits = [];
        for (const a of list) {
          const hay = norm(`${a.t} ${a.c} ${(a.tags || []).join(" ")} ${a.src}`);
          if (words.every((w) => hay.includes(w)))
            hits.push({ t: a.t, u: a.u, c: a.c });
          if (hits.length >= MAX_ITEMS) break;
        }
        rawItems = hits;
        render(hits, input.value.trim());
      });
    }

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(onType, 120);
    });
    input.addEventListener("focus", () => {
      setOpen(true);
      if (norm(input.value).trim().length >= 2) onType();
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (!drop.hidden) {
          close();
        } else {
          collapse();
          input.blur();
        }
        return;
      }
      if (drop.hidden) {
        if (e.key === "ArrowDown") { e.preventDefault(); if (norm(input.value).trim().length >= 2) onType(); }
        return;
      }
      const opts = drop.querySelectorAll(".searchbox__opt");
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(active < 0 ? 0 : (active + 1) % opts.length);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (active > 0) setActive(active - 1);
      } else if (e.key === "Enter" && active >= 0 && opts[active]) {
        e.preventDefault();
        opts[active].click();
      }
    });

    // Tık "blur"i tetiklemeden çalışsın ki öneriye ulaşabilsin.
    drop.addEventListener("mousedown", (e) => {
      if (e.target.closest("a")) e.preventDefault();
    });
    drop.addEventListener("click", (e) => {
      if (e.target.closest("a")) close();
    });
    document.addEventListener("click", (e) => {
      if (!searchForm.contains(e.target)) collapse();
    });
    input.addEventListener("blur", () => {
      if (!searchForm.contains(document.activeElement)) collapse();
    });
  }

  // Kaydırınca header'a gölge ver
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-stuck", window.scrollY > 6);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // --- Tema değiştirici ---
  const themeToggle = document.getElementById("theme-toggle");
  if (themeToggle) {
    const root = document.documentElement;
    const themeMeta = document.querySelector('meta[name="theme-color"]');

    const syncToggle = () => {
      const dark = root.dataset.theme === "dark";
      themeToggle.setAttribute("aria-pressed", String(dark));
      themeToggle.setAttribute(
        "aria-label",
        dark ? "Açık temaya geç" : "Koyu temaya geç"
      );
      if (themeMeta) {
        themeMeta.setAttribute("content", dark ? "#0b0d11" : "#d81f26");
      }
    };

    syncToggle();

    themeToggle.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";

      // Yumuşak geçiş (hareket azaltma tercihine saygılı)
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce) {
        root.classList.add("theme-transition");
        window.setTimeout(() => root.classList.remove("theme-transition"), 400);
      }

      root.dataset.theme = next;
      root.style.colorScheme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      syncToggle();
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg-elev);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.25s var(--ease);
  }
  .header.is-stuck {
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.5);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 1.4rem;
    letter-spacing: -0.025em;
    flex-shrink: 0;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--red-grad);
    color: #fff;
    font-size: 1.2rem;
    box-shadow: 0 10px 22px -12px rgba(216, 31, 38, 0.95);
    transition: transform 0.3s var(--ease);
  }
  .logo:hover .logo__mark {
    transform: rotate(-6deg) scale(1.05);
  }
  .logo__ai {
    color: var(--red);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
    /* Menü asla alt satıra kırılmaz: dar ekranda yatay kayar.
       (Eskiden "Tüm Haberler" tek başına altta kalıp ortada boşluk bırakıyordu.) */
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }
  .nav__link {
    position: relative;
    padding: 8px 11px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--text);
    transition: background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 11px;
    right: 11px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav__link:hover {
    background: var(--red-soft);
    color: var(--red-dark);
  }
  .nav__link:hover::after {
    transform: scaleX(1);
  }
  .nav__link--active {
    color: var(--red);
  }
  .nav__link--active::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .searchbox {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  /* Dar ekranda görünen yuvarlak büyüteç butonu (geniş ekranda gizli). */
  .searchbox__toggle {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-2);
    color: var(--text-2);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
      border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .searchbox__toggle:hover {
    color: var(--brand);
    border-color: var(--brand);
    background: var(--brand-soft);
  }
  .searchbox__toggle:active {
    transform: scale(0.96);
  }

  /* Kutunun kendisi: kapalıyken genişlik 0 → tıklayınca SOLA doğru açılır. */
  .searchbox__field {
    position: relative;
    display: flex;
    align-items: center;
    width: 190px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-2);
    overflow: hidden;
    transition: width 0.28s var(--ease), border-color 0.2s, background 0.2s,
      box-shadow 0.2s, opacity 0.2s;
  }
  .searchbox__icon {
    position: absolute;
    left: 13px;
    color: var(--muted);
    pointer-events: none;
  }
  .searchbox__input {
    width: 100%;
    height: 100%;
    padding: 0 14px 0 36px;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
  }
  .searchbox__input::placeholder {
    color: var(--muted);
  }
  .searchbox__field:focus-within {
    border-color: var(--brand);
    background: var(--surface);
    width: 224px;
    box-shadow: 0 0 0 4px var(--brand-soft);
  }

  /* --- Anlik arama onerileri (sayfa degismez, kutunun altinda acilir) --- */
  .searchbox__drop {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: min(460px, 92vw);
    max-height: min(62vh, 460px);
    overflow-y: auto;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    z-index: 60;
  }
  .searchbox__opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 9px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.89rem;
    line-height: 1.35;
  }
  .searchbox__opt:hover,
  .searchbox__opt.is-active {
    background: var(--red-soft);
  }
  .searchbox__opt-cat {
    flex-shrink: 0;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
    background: var(--red-soft);
    padding: 3px 8px;
    border-radius: 999px;
  }
  .searchbox__opt.is-active .searchbox__opt-cat,
  .searchbox__opt:hover .searchbox__opt-cat {
    background: color-mix(in srgb, var(--red) 18%, transparent);
  }
  .searchbox__opt-title {
    min-width: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-weight: 600;
  }
  .searchbox__opt-title mark {
    background: none;
    color: var(--red);
    font-weight: 800;
  }
  .searchbox__empty {
    padding: 14px 12px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .searchbox__all {
    display: block;
    margin-top: 4px;
    padding: 10px 12px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--red);
    text-decoration: none;
    border-radius: 0 0 9px 9px;
  }
  .searchbox__all:hover {
    background: var(--red-soft);
  }

  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-2);
    color: var(--text-2);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
      border-color 0.2s var(--ease), transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .theme-toggle:hover {
    color: var(--brand);
    border-color: var(--brand);
    background: var(--brand-soft);
    transform: translateY(-1px);
  }
  .theme-toggle:active {
    transform: translateY(0) scale(0.96);
  }
  .theme-toggle__icon {
    grid-area: 1 / 1;
    transition: opacity 0.3s var(--ease), transform 0.35s var(--ease);
  }
  .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.55);
  }
  :root[data-theme="dark"] .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }
  :root[data-theme="dark"] .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.55);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle__icon--sun {
      opacity: 1;
      transform: none;
    }
    :root:not([data-theme="light"]) .theme-toggle__icon--moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.55);
    }
  }

  @media (max-width: 1000px) {
    /* Dar ekran: yalnız büyüteç görünür; tıklayınca kutu sola doğru açılır. */
    .searchbox__toggle {
      display: grid;
    }
    .searchbox__field {
      width: 0;
      opacity: 0;
      border-color: transparent;
      background: transparent;
    }
    .searchbox.is-open .searchbox__toggle {
      display: none;
    }
    .searchbox.is-open .searchbox__field {
      width: min(62vw, 260px);
      opacity: 1;
      border-color: var(--border);
      background: var(--surface-2);
    }
    .searchbox.is-open .searchbox__field:focus-within {
      width: min(66vw, 280px);
      border-color: var(--brand);
      background: var(--surface);
      box-shadow: 0 0 0 4px var(--brand-soft);
    }
    /* Öneri kutusu kutunun değil ekranın kenarına hizalanır: arama alanının
       yanındaki tema düğmesi yüzünden sağa hizalanınca dar ekranda taşıyordu.
       (Header'da backdrop-filter olduğu için fixed konum header'a göre çözülür.) */
    .searchbox__drop {
      position: fixed;
      left: auto;
      right: 16px;
      top: 60px;
      width: min(calc(100vw - 32px), 520px);
      max-height: min(60vh, 420px);
    }
  }
  /* Telefon: logo satırı + altında yatay kayan menü.
     Sticky olduğu için yüksekliği mümkün olduğunca kısa tutulur. */
  @media (max-width: 720px) {
    .header__inner {
      position: relative;
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 8px;
      padding-bottom: 0;
      gap: 4px;
    }
    .header__actions {
      position: absolute;
      top: 8px;
      right: 16px;
    }
    .nav {
      gap: 0;
      overflow-x: auto;
      width: 100%;
      flex-wrap: nowrap;
      justify-content: flex-start;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    /* Parmakla rahat dokunma: en az 44px yükseklik. */
    .nav__link {
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 12px;
    }
    .nav__link::after {
      bottom: 6px;
    }
    /* Büyüteç ve tema düğmeleri 44x44 dokunma alanı. */
    .searchbox__toggle,
    .theme-toggle {
      width: 44px;
      height: 44px;
    }
    /* Çok dar ekranda açılan arama kutusu logoya taşmasın */
    .searchbox.is-open .searchbox__field,
    .searchbox.is-open .searchbox__field:focus-within {
      width: min(50vw, 190px);
    }
    /* Öneri kutusu: tam genişlik, arama alanının hemen altında. */
    .searchbox__drop {
      left: 16px;
      right: 16px;
      top: 58px;
      width: auto;
    }
    /* Öneri satırları parmakla seçilebilecek kadar büyük, etiket okunaklı. */
    .searchbox__opt {
      padding: 12px 12px;
      min-height: 46px;
    }
    .searchbox__opt-cat {
      font-size: 0.68rem;
    }
    /* iOS odaklanınca sayfayı yakınlaştırmasın: alan yazısı >= 16px. */
    .searchbox__input {
      font-size: 16px;
    }
  }
  /* Kapalıyken görünmez alan tıklamayı çalmasın (büyüteç butonu çalışsın). */
  @media (max-width: 1000px) {
    .searchbox:not(.is-open) .searchbox__field {
      pointer-events: none;
