---
import { getArticles, timeAgo } from "../lib/articles.js";
import MarketTicker from "./MarketTicker.astro";

const nav = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Teknoloji", href: "/kategori/teknoloji/" },
  { label: "Yapay Zeka", href: "/kategori/yapay-zeka/" },
  { label: "Mobil", href: "/kategori/mobil/" },
  { label: "Oyun", href: "/kategori/oyun/" },
  { label: "Ekonomi", href: "/kategori/ekonomi/" },
  { label: "Piyasa", href: "/piyasa/" },
  { label: "Tüm Haberler", href: "/haberler/" },
];

const path = Astro.url.pathname;
const latest = getArticles().slice(0, 8);
const today = new Date().toLocaleDateString("tr-TR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  weekday: "long",
});
const isActive = (href) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<MarketTicker />

<div class="topbar">
  <div class="container topbar__inner">
    <span class="topbar__date">{today}</span>
    {latest.length > 0 && (
      <div class="topbar__ticker">
        <span class="topbar__tag">
          <span class="topbar__live" aria-hidden="true"></span>
          SON DAKİKA
        </span>
        <div class="topbar__rot" id="son-dakika">
          {latest.map((a) => (
            <a class="topbar__slide" href={a.url}>
              <span class="topbar__headline">{a.title}</span>
              <span class="topbar__time">{timeAgo(a.publishedAt || a.generatedAt)}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label="HaberAI ana sayfa">
      <span class="logo__mark">H</span>
      <span class="logo__text">Haber<span class="logo__ai">AI</span></span>
    </a>
    <nav class="nav" aria-label="Bölümler">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav__link", { "nav__link--active": isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header__actions">
      <form class="searchbox" action="/ara/" method="get" role="search">
        <svg class="searchbox__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.2-3.2" />
        </svg>
        <input
          class="searchbox__input"
          type="search"
          name="q"
          placeholder="Haber ara..."
          aria-label="Haber ara"
        />
      </form>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Koyu temaya geç"
        aria-pressed="false"
        title="Görünüm temasını değiştir"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Son dakika başlıklarını döndür (kayan/roll geçiş — üst üste binme yok)
  const rot = document.getElementById("son-dakika");
  if (rot) {
    const slides = Array.from(rot.querySelectorAll(".topbar__slide"));
    if (slides.length > 0) {
      let i = 0;
      slides[0].classList.add("is-active");
      if (slides.length > 1) {
        setInterval(() => {
          const cur = slides[i];
          i = (i + 1) % slides.length;
          const next = slides[i];
          cur.classList.remove("is-active");
          cur.classList.add("is-prev"); // yukarı kayarak çıkar
          next.classList.remove("is-prev");
          next.classList.add("is-active"); // aşağıdan yukarı gelir
        }, 6000);
      }
    }
  }

  // Kaydırınca header'a gölge ver
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-stuck", window.scrollY > 6);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // --- Tema değiştirici ---
  const themeToggle = document.getElementById("theme-toggle");
  if (themeToggle) {
    const root = document.documentElement;
    const themeMeta = document.querySelector('meta[name="theme-color"]');

    const syncToggle = () => {
      const dark = root.dataset.theme === "dark";
      themeToggle.setAttribute("aria-pressed", String(dark));
      themeToggle.setAttribute(
        "aria-label",
        dark ? "Açık temaya geç" : "Koyu temaya geç"
      );
      if (themeMeta) {
        themeMeta.setAttribute("content", dark ? "#0b0d11" : "#d81f26");
      }
    };

    syncToggle();

    themeToggle.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";

      // Yumuşak geçiş (hareket azaltma tercihine saygılı)
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce) {
        root.classList.add("theme-transition");
        window.setTimeout(() => root.classList.remove("theme-transition"), 400);
      }

      root.dataset.theme = next;
      root.style.colorScheme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      syncToggle();
    });
  }
</script>

<style>
  .topbar {
    background: var(--brand-fill);
    color: #fff;
    font-size: 0.82rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 38px;
  }
  .topbar__date {
    opacity: 0.9;
    white-space: nowrap;
  }
  .topbar__ticker {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
    margin-left: auto;
    overflow: hidden;
  }
  .topbar__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.26);
    padding: 3px 9px;
    border-radius: 6px;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .topbar__live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: topbar-blink 1.6s ease-in-out infinite;
  }
  @keyframes topbar-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  .topbar__rot {
    position: relative;
    flex: 1;
    height: 22px;
    min-width: 0;
    overflow: hidden; /* kayan başlıklar bu kutunun dışına taşamaz */
  }
  .topbar__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.4s var(--ease), transform 0.42s var(--ease);
    pointer-events: none;
  }
  /* JS çalışmadan önce de ilk başlık görünür olsun (JS'siz/kapalı durumlar) */
  .topbar__slide:first-child {
    opacity: 1;
    transform: none;
  }
  /* Yukarı kayıp çıkan başlık: böylece iki başlık asla üst üste binmez */
  .topbar__slide.is-prev {
    opacity: 0;
    transform: translateY(-100%);
  }
  .topbar__slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .topbar__headline {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0; /* flex içinde küçülebilsin → taşma/üst üste binme olmaz */
    font-weight: 600;
  }
  .topbar__slide:hover .topbar__headline {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .topbar__time {
    opacity: 0.85;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg-elev);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.25s var(--ease);
  }
  .header.is-stuck {
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.5);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 1.4rem;
    letter-spacing: -0.025em;
    flex-shrink: 0;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--red-grad);
    color: #fff;
    font-size: 1.2rem;
    box-shadow: 0 10px 22px -12px rgba(216, 31, 38, 0.95);
    transition: transform 0.3s var(--ease);
  }
  .logo:hover .logo__mark {
    transform: rotate(-6deg) scale(1.05);
  }
  .logo__ai {
    color: var(--red);
  }
  .nav {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    flex: 1;
  }
  .nav__link {
    position: relative;
    padding: 8px 11px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--text);
    transition: background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 11px;
    right: 11px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav__link:hover {
    background: var(--red-soft);
    color: var(--red-dark);
  }
  .nav__link:hover::after {
    transform: scaleX(1);
  }
  .nav__link--active {
    color: var(--red);
  }
  .nav__link--active::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .searchbox {
    position: relative;
    flex-shrink: 0;
  }
  .searchbox__icon {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .searchbox__input {
    width: 190px;
    height: 40px;
    padding: 0 14px 0 36px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, background 0.2s, width 0.25s var(--ease),
      box-shadow 0.2s;
  }
  .searchbox__input::placeholder {
    color: var(--muted);
  }
  .searchbox__input:focus {
    border-color: var(--brand);
    background: var(--surface);
    width: 224px;
    box-shadow: 0 0 0 4px var(--brand-soft);
  }

  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-2);
    color: var(--text-2);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
      border-color 0.2s var(--ease), transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .theme-toggle:hover {
    color: var(--brand);
    border-color: var(--brand);
    background: var(--brand-soft);
    transform: translateY(-1px);
  }
  .theme-toggle:active {
    transform: translateY(0) scale(0.96);
  }
  .theme-toggle__icon {
    grid-area: 1 / 1;
    transition: opacity 0.3s var(--ease), transform 0.35s var(--ease);
  }
  .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.55);
  }
  :root[data-theme="dark"] .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }
  :root[data-theme="dark"] .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.55);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle__icon--sun {
      opacity: 1;
      transform: none;
    }
    :root:not([data-theme="light"]) .theme-toggle__icon--moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.55);
    }
  }

  @media (max-width: 1000px) {
    .searchbox {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .topbar__date,
    .topbar__time {
      display: none;
    }
    .header__inner {
      position: relative;
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 12px;
      padding-bottom: 12px;
      gap: 10px;
    }
    .header__actions {
      position: absolute;
      top: 12px;
      right: 20px;
    }
    .nav {
      gap: 0;
      overflow-x: auto;
      width: 100%;
      flex-wrap: nowrap;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .nav__link {
      white-space: nowrap;
    }
  }
</style>
