---
/**
 * Arayüz dili düğmesi (TR ⇄ EN).
 *
 * Sunucuda basılır: dil.js yüklenmeden önce de HTML'de görünür ve böylece
 * düğme hiçbir zaman "kaybolmuş" gibi algılanmaz. dil.js yalnızca tıklama
 * davranışını bağlar ve etiketleri (EN/TR · English/Türkçe) günceller.
 * Haber metinleri çevrilmez; yalnızca arayüz etiketleri değişir.
 */
---

<button
  class="dil-btn"
  type="button"
  data-dil-btn
  data-dil-atla
  title="Switch the interface to English"
>
  <svg
    class="dil-btn__ikon"
    viewBox="0 0 24 24"
    width="15"
    height="15"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="8.5"></circle>
    <path d="M3.5 12h17"></path>
    <path d="M12 3.5c2.5 2.4 3.8 5.3 3.8 8.5s-1.3 6.1-3.8 8.5c-2.5-2.4-3.8-5.3-3.8-8.5S9.5 5.9 12 3.5z"></path>
  </svg>
  <span class="dil-btn__kod" data-dil-kod>EN</span>
  <span class="dil-btn__ad" data-dil-ad>English</span>
</button>
