---
// Yorumlar — site içinde, hesap gerektirmeden.
//
// Okuyucu yalnızca takma ad + yorum yazar; GitHub/Google hesabı, e-posta,
// doğrulama yok. Veriler Supabase'deki `yorumlar` tablosunda tutulur ve
// tarayıcıdan REST ile okunur (bkz. supabase/yorumlar.sql).
//
// GÜVENLİK: Yorum metni asla innerHTML ile basılmaz (textContent kullanılır).
// Supabase "anon" anahtarı herkese açıktır; yazma/okuma RLS politikalarıyla
// sınırlanır, flood için veritabanı tarafında hız sınırı vardır.
//
// HIZ: Liste görünür alana yaklaşmadan (300px) yüklenmez. Akış (Shorts)
// panelinde ise yalnızca panel açılınca kurulur.
import { YORUM, CONTACT_EMAIL } from "../lib/site-meta.js";

interface Props {
  /** Yorumlar bu habere özel olsun diye kullanılan sabit anahtar. */
  slug: string;
  baslik: string;
  url: string;
  /** Akış (Shorts) panelinde gösterim: otomatik yükleme kapalı. */
  sade?: boolean;
}

const { slug, baslik, url, sade = false } = Astro.props;
const aktif = Boolean(YORUM.url && YORUM.anahtar);
const otomatik = !sade && Boolean(slug) && aktif;
---

<section
  class:list={["yorum", sade && "yorum--sade"]}
  id={sade ? undefined : "yorumlar"}
  data-yorum
  data-slug={slug}
  data-baslik={baslik}
  data-url={url}
  data-aktif={aktif ? "1" : "0"}
  data-api={YORUM.url}
  data-anahtar={YORUM.anahtar}
  data-tablo={YORUM.tablo}
>
  <header class="yorum__ust">
    <h2 class="yorum__baslik" id={sade ? undefined : "yorumlar-baslik"}>
      <span aria-hidden="true">💬</span> Yorumlar
      <span class="yorum__sayi" data-yorum-sayi hidden></span>
    </h2>
    <span class="yorum__not">Hesap gerekmez · reklamsız</span>
  </header>

  <p class="yorum__kim" data-yorum-kim hidden></p>

  {/* Akış panelinde: yorumlar haber sayfasıyla AYNI havuzu kullanır. */}
  {sade && (
    <p class="yorum__ortak">
      ✍️ Yorumun bu habere özel — haber sayfasındaki yorumlarla aynı yerde görünür.
    </p>
  )}

  <form class="yorum__form" data-yorum-form hidden novalidate action="#">
    <input
      class="yorum__ad"
      data-yorum-ad
      type="text"
      name="ad"
      maxlength="40"
      autocomplete="nickname"
      placeholder="Adın (boş bırakırsan “Okur”)"
      aria-label="Takma ad"
    />
    <textarea
      class="yorum__metin"
      data-yorum-metin
      name="metin"
      rows="3"
      maxlength="1200"
      required
      placeholder="Ne düşünüyorsun?"
      aria-label="Yorumun"
    ></textarea>
    <!-- Bal küpü: botlar doldurur, insanlar görmez. -->
    <input
      class="yorum__tuzak"
      data-yorum-tuzak
      type="text"
      name="web"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <div class="yorum__alt">
      <span class="yorum__kural">Küfür, hakaret ve reklam silinir.</span>
      <button type="submit" class="yorum__gonder" data-yorum-gonder>Yorum yaz</button>
    </div>
    <p class="yorum__durum" data-yorum-durum role="status" aria-live="polite"></p>
  </form>

  <p class="yorum__bekle" data-yorum-bekle hidden={!otomatik}>Yorumlar yükleniyor…</p>

  <ul class="yorum__liste" data-yorum-liste></ul>

  <p class="yorum__bos" data-yorum-bos hidden>İlk yorumu sen yaz.</p>

  <p class="yorum__kapali" data-yorum-kapali hidden={aktif}>
    💬 Yorumlar kısa süre içinde açılacak. Bu arada görüşünü{" "}
    <a href={`mailto:${CONTACT_EMAIL}`}>e-posta ile</a> iletebilirsin.
  </p>
</section>

<style>
  .yorum {
    margin: 34px 0 10px;
    padding: 20px 20px 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }
  .yorum--sade {
    margin: 0;
    padding: 2px 0 0;
    border: 0;
    background: transparent;
  }
  /* Panelde başlık panelin kendi başlığında; tekrar etmesin. */
  .yorum--sade .yorum__ust {
    display: none;
  }
  /* Akıştaki yorum kutusu: yorumlar haber sayfasıyla aynı havuzda. */
  .yorum__ortak {
    margin: 0 0 12px;
    padding: 8px 11px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--text-2);
  }
  /* Akış panelinde daha "sohbet" görünümlü form. */
  .yorum--sade .yorum__form {
    gap: 9px;
    margin-bottom: 14px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg);
  }
  .yorum--sade .yorum__metin {
    min-height: 84px;
    border-radius: 12px;
    background: var(--surface);
    font-size: 0.95rem;
  }
  .yorum--sade .yorum__ad {
    max-width: none;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
  }
  .yorum--sade .yorum__gonder {
    padding: 10px 20px;
    border-radius: 999px;
  }
  .yorum--sade .yorum__liste {
    gap: 10px;
  }
  .yorum--sade .yorum__oge {
    padding: 10px 12px;
    border-radius: 14px 14px 14px 5px;
    background: var(--surface-2);
  }
  .yorum--sade .yorum__oge-metin {
    font-size: 0.93rem;
  }
  .yorum__ust {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .yorum__baslik {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .yorum__sayi {
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--text-2);
    vertical-align: 2px;
  }
  .yorum__not {
    font-size: 0.78rem;
    color: var(--text-2);
  }
  /* Giriş yapan okuyucu: adı kilitli, kim yazdığı görünür. */
  .yorum__kim {
    margin: 0 0 8px;
    font-size: 0.76rem;
    color: var(--text-2);
  }
  .yorum__kim b {
    color: var(--heading);
  }
  .yorum__kim[hidden] {
    display: none;
  }
  /* Hesabıyla yorum yazan üyenin rozeti. */
  .yorum__uye {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  /* Özel rozet (yönetici/editoryal): "✓ üye"den ayrı, kırmızı-beyaz. */
  .yorum__rozet {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--brand-grad);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .yorum__form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }
  .yorum__form[hidden],
  .yorum__sayi[hidden],
  .yorum__bekle[hidden],
  .yorum__bos[hidden],
  .yorum__kapali[hidden] {
    display: none;
  }
  .yorum__ad,
  .yorum__metin {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
  }
  .yorum__ad {
    max-width: 260px;
  }
  .yorum__metin {
    resize: vertical;
    min-height: 76px;
    line-height: 1.5;
  }
  .yorum__ad:focus,
  .yorum__metin:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 16%, transparent);
  }
  .yorum__tuzak {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .yorum__alt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .yorum__kural {
    font-size: 0.74rem;
    color: var(--muted);
  }
  .yorum__gonder {
    padding: 9px 18px;
    border: 0;
    border-radius: 11px;
    background: var(--brand-grad);
    color: #fff;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 12px 22px -14px var(--brand-glow);
  }
  .yorum__gonder:hover {
    filter: brightness(1.05);
  }
  .yorum__gonder:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .yorum__durum {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-2);
    min-height: 1em;
  }
  .yorum__durum--hata {
    color: var(--brand-ink, #b3121a);
  }
  .yorum__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .yorum__oge {
    display: grid;
    grid-template-columns: 32px 1fr;
    column-gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--bg);
  }
  .yorum__oge-avatar {
    display: grid;
    place-items: center;
    grid-row: 1 / span 2;
    align-self: start;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    overflow: hidden;
    flex-shrink: 0;
  }
  .yorum__oge-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    display: block;
  }
  /* Yeni gönderilen yorum kısa bir "parlama" ile belirginleşir. */
  .yorum__oge--yeni {
    animation: yorum-yeni 1.6s var(--ease, ease);
  }
  @keyframes yorum-yeni {
    0% {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 18%, transparent);
    }
    100% {
      border-color: var(--border);
      box-shadow: none;
    }
  }
  .yorum__oge-ust {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .yorum__oge-ad {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--heading);
  }
  .yorum__oge-zaman {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .yorum__oge-metin {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-2);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  /* Yorum eylemleri: beğeni sayısı ve (sahibine) silme. */
  .yorum__eylem {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
  }
  .yorum__etkilesim {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font: inherit;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease),
      background 0.15s var(--ease);
  }
  .yorum__etkilesim:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .yorum__etkilesim:disabled {
    opacity: 0.55;
    cursor: default;
  }
  .yorum__begen.is-on {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand);
  }
  .yorum__begen.is-on svg {
    fill: currentColor;
  }
  .yorum__sil:hover {
    border-color: var(--brand-ink, #b3121a);
    color: var(--brand-ink, #b3121a);
  }
  .yorum__bekle,
  .yorum__bos {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-2);
  }
  .yorum__kapali {
    margin: 0;
    padding: 12px 14px;
    border: 1px dashed var(--border);
    border-radius: 13px;
    color: var(--text-2);
    font-size: 0.88rem;
  }

  /* =============================== TELEFON =============================== */
  @media (max-width: 640px) {
    .yorum__ust {
      flex-wrap: wrap;
      gap: 6px;
    }
    .yorum__kim {
      font-size: 0.74rem;
    }
    .yorum__metin {
      min-height: 88px;
      font-size: 0.95rem;
    }
    .yorum__alt {
      gap: 8px;
    }
    /* Telefonda "Gönder" tam genişlik: parmakla ıskalanmasın. */
    .yorum__gonder {
      flex: 1 1 100%;
      padding: 12px 18px;
      font-size: 0.92rem;
    }
    .yorum__oge {
      padding: 11px 12px;
      gap: 9px;
    }
    .yorum__oge-metin {
      font-size: 0.92rem;
    }
    .yorum__ortak {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  type Kok = HTMLElement;
  const baglananlar = new WeakSet<HTMLElement>();

  /**
   * Supabase başlıkları.
   *
   * Eski "anon" anahtarı bir JWT'dir (eyJ... ile başlar) ve hem `apikey` hem
   * `Authorization: Bearer` olarak gönderilir. Yeni paneldeki "publishable"
   * anahtarı (sb_publishable_...) JWT DEĞİLDİR; yalnızca `apikey` başlığıyla
   * gönderilir. (DİKKAT: bu yardımcı MUTLAKA <script> içinde olmalı — üst
   * frontmatter'a yazılırsa tarayıcıda tanımsız kalır ve yorum gönderilemez.)
   */
  function susBasliklari(anahtar: string): Record<string, string> {
    const h: Record<string, string> = { apikey: anahtar };
    if (anahtar.startsWith("eyJ")) h.Authorization = `Bearer ${anahtar}`;
    return h;
  }

  /**
   * Cihaz anahtarı. Hesabı olmayan okurun yorumunu daha sonra silebilmesi ve
   * anonim beğenilerin aynı cihazda hatırlanması için kullanılır. Tahmin
   * edilemeyen bir UUID'dir; sunucuya yalnızca RPC içinde gider.
   */
  function cihazKimlik(): string {
    const ANAHTAR = "hb-yorum-cihaz";
    try {
      const v = localStorage.getItem(ANAHTAR);
      if (v && v.length >= 8) return v;
    } catch {
      /* özel mod */
    }
    let v = "";
    try {
      v = crypto.randomUUID();
    } catch {
      /* eski tarayıcı */
    }
    if (!v) v = "c" + Math.random().toString(36).slice(2) + Date.now().toString(36);
    try {
      localStorage.setItem(ANAHTAR, v);
    } catch {
      /* özel mod: bu sayfa oturumunda çalışır */
    }
    return v;
  }

  /** Yorum RPC'si; SQL henüz kurulmadıysa null döner (REST yedeğine geçilir). */
  async function rpcYorum(
    api: string,
    anahtar: string,
    fn: string,
    govde: Record<string, unknown>,
  ): Promise<any> {
    try {
      const r = await fetch(`${api}/rest/v1/rpc/${fn}`, {
        method: "POST",
        headers: { ...susBasliklari(anahtar), "Content-Type": "application/json" },
        body: JSON.stringify(govde),
      });
      if (r.status === 404) return null;
      const metin = await r.text();
      if (!r.ok) {
        try {
          const j = JSON.parse(metin);
          return { hata: j.message || j.hata || `HTTP ${r.status}` };
        } catch {
          return { hata: `HTTP ${r.status}` };
        }
      }
      return metin ? JSON.parse(metin) : {};
    } catch {
      return null;
    }
  }

  /** Liste yüklendikten, yorum eklendikten ya da silindikten sonra sayaç. */
  function sayiGuncelle(kok: Kok) {
    const n = kok.querySelectorAll(".yorum__oge").length;
    const sayi = kok.querySelector<HTMLElement>("[data-yorum-sayi]");
    const bos = kok.querySelector<HTMLElement>("[data-yorum-bos]");
    if (sayi) {
      sayi.textContent = n ? String(n) : "";
      sayi.hidden = n === 0;
    }
    if (bos) bos.hidden = n > 0;
  }

  /** Sayfadaki hesap oturumu (yoksa null). */
  function hesap(): any {
    const H = (window as any).HaberinAi;
    return H && typeof H.oturumOku === "function" ? H.oturumOku() : null;
  }

  /**
   * Giriş durumuna göre takma ad alanını ayarlar.
   * Üye ise ad profilden gelir ve değiştirilemez (kimlik tutarlılığı).
   */
  function hesapUygula(kok: Kok) {
    const u = hesap();
    const adEl = kok.querySelector<HTMLInputElement>("[data-yorum-ad]");
    const kim = kok.querySelector<HTMLElement>("[data-yorum-kim]");
    if (u) {
      if (adEl) {
        adEl.value = u.ad || "";
        adEl.readOnly = true;
        adEl.hidden = true;
      }
      if (kim) {
        kim.hidden = false;
        kim.textContent = "";
        const b = document.createElement("b");
        b.textContent = u.ad;
        kim.append(b, document.createTextNode(" olarak yazıyorsun · profilden"));
      }
    } else {
      if (adEl) {
        adEl.readOnly = false;
        adEl.hidden = false;
        try {
          adEl.value = localStorage.getItem("yorum-ad") || adEl.value;
        } catch {
          /* özel mod */
        }
      }
      if (kim) kim.hidden = true;
    }
    return u;
  }

  const SURE = [
    [60, "sn"],
    [60, "dk"],
    [24, "sa"],
    [7, "gün"],
    [4.35, "hafta"],
    [12, "ay"],
  ];

  /** "az önce", "5 dk", "3 sa", "2 gün"… */
  function zaman(iso: string): string {
    const t = Date.parse(iso);
    if (!t) return "";
    let s = Math.max(0, (Date.now() - t) / 1000);
    if (s < 45) return "az önce";
    let birim = "sn";
    for (const [bol, ad] of SURE) {
      if (s < bol) {
        birim = ad;
        break;
      }
      s = s / bol;
    }
    return `${Math.floor(s)} ${birim}`;
  }

  function yaz(kok: Kok, metin: string, hata = false) {
    const el = kok.querySelector<HTMLElement>("[data-yorum-durum]");
    if (!el) return;
    el.textContent = metin;
    el.classList.toggle("yorum__durum--hata", hata);
  }

  /** Üye numarası → avatar (emoji ya da görsel). Yorum listesinde kullanılır. */
  const avatarHaritasi: Record<string, string> = {};

  const BEGEN_SVG =
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.4l8.8-8.7a5 5 0 0 0 0-7.1z"/></svg>';
  const SIL_SVG =
    '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 14h10l1-14"/><path d="M9 7V4h6v3"/></svg>';

  /** Yorumlarda görünen üyelerin avatarlarını tek istekte çeker. */
  async function avatarlariGetir(api: string, anahtar: string, idler: string[]) {
    const eksik = Array.from(new Set(idler.filter((i) => i && !(i in avatarHaritasi))));
    if (!eksik.length || !api || !anahtar) return;
    try {
      const adres =
        `${api}/rest/v1/avatarlar?select=uye_id,avatar` +
        `&uye_id=in.(${eksik.join(",")})`;
      const r = await fetch(adres, { headers: susBasliklari(anahtar) });
      for (const i of eksik) avatarHaritasi[i] = "";
      if (!r.ok) return;
      const veri = (await r.json()) as { uye_id?: string; avatar?: string }[];
      for (const s of veri) if (s.uye_id) avatarHaritasi[s.uye_id] = s.avatar || "";
    } catch {
      /* avatar çekilemezse baş harf görünür */
    }
  }

  function oge(y: {
    ad?: string;
    metin?: string;
    created_at?: string;
    uye_id?: string | null;
    etiket?: string | null;
    id?: number | string | null;
    benim?: boolean;
    begendim?: boolean;
    begeni?: number;
  }, etkilesim = false): HTMLLIElement {
    const li = document.createElement("li");
    li.className = "yorum__oge";
    if (y.id != null) li.dataset.yorumId = String(y.id);
    const avatar = document.createElement("span");
    avatar.className = "yorum__oge-avatar";
    avatar.setAttribute("aria-hidden", "true");
    const H = (window as any).HaberinAi;
    const avatarDeger = y.uye_id ? avatarHaritasi[y.uye_id] || "" : "";
    if (H && typeof H.avatarDoldur === "function") {
      H.avatarDoldur(avatar, avatarDeger, y.ad || "Okur");
    } else {
      avatar.textContent = (y.ad || "Okur").trim().charAt(0) || "O";
    }
    const ust = document.createElement("div");
    ust.className = "yorum__oge-ust";
    const ad = document.createElement("span");
    ad.className = "yorum__oge-ad";
    ad.textContent = y.ad || "Okur";
    if (y.uye_id) {
      const rozet = document.createElement("span");
      rozet.className = "yorum__uye";
      rozet.textContent = "✓ üye";
      rozet.title = "Hesabıyla yazdı";
      ad.after(rozet);
    }
    // Yönetici/özel rozet: yorum yazıldığı andaki etiket (ör. "Yönetici").
    if (y.etiket && String(y.etiket).trim()) {
      const ozel = document.createElement("span");
      ozel.className = "yorum__rozet";
      ozel.textContent = String(y.etiket).trim().slice(0, 24);
      ozel.title = "Özel rozet";
      ad.after(ozel);
    }
    const zm = document.createElement("time");
    zm.className = "yorum__oge-zaman";
    zm.textContent = zaman(y.created_at || "");
    const metin = document.createElement("p");
    metin.className = "yorum__oge-metin";
    metin.textContent = y.metin || "";
    ust.append(ad, zm);
    li.append(avatar, ust, metin);

    if (etkilesim && y.id != null) {
      const eylem = document.createElement("div");
      eylem.className = "yorum__eylem";

      const begen = document.createElement("button");
      begen.type = "button";
      begen.className = "yorum__etkilesim yorum__begen";
      begen.dataset.yorumBegen = String(y.id);
      begen.classList.toggle("is-on", Boolean(y.begendim));
      begen.setAttribute("aria-pressed", y.begendim ? "true" : "false");
      begen.setAttribute("aria-label", y.begendim ? "Beğeniyi geri al" : "Yorumu beğen");
      begen.title = y.begendim ? "Beğeniyi geri al" : "Beğen";
      begen.innerHTML = BEGEN_SVG;
      const say = document.createElement("span");
      say.dataset.begenSayi = "";
      say.textContent = String(Math.max(0, Number(y.begeni) || 0));
      begen.append(say);
      eylem.append(begen);

      if (y.benim) {
        const sil = document.createElement("button");
        sil.type = "button";
        sil.className = "yorum__etkilesim yorum__sil";
        sil.dataset.yorumSil = String(y.id);
        sil.setAttribute("aria-label", "Yorumumu sil");
        sil.title = "Yorumumu sil";
        sil.innerHTML = SIL_SVG;
        sil.append(document.createTextNode("Sil"));
        eylem.append(sil);
      }

      li.append(eylem);
    }

    return li;
  }

  async function yukle(kok: Kok) {
    const api = kok.dataset.api || "";
    const anahtar = kok.dataset.anahtar || "";
    const tablo = kok.dataset.tablo || "yorumlar";
    const slug = kok.dataset.slug || "";
    const liste = kok.querySelector<HTMLElement>("[data-yorum-liste]");
    const bekle = kok.querySelector<HTMLElement>("[data-yorum-bekle]");
    const bos = kok.querySelector<HTMLElement>("[data-yorum-bos]");
    const sayi = kok.querySelector<HTMLElement>("[data-yorum-sayi]");
    if (!api || !anahtar || !slug || !liste) return;

    if (bekle) bekle.hidden = false;
    if (bos) bos.hidden = true;
    liste.replaceChildren();
    try {
      // Önce tek RPC: beğeni sayısı, "ben beğendim" ve "benim yorumum"
      // bilgileri aynı cevapta gelir. SQL yaması henüz uygulanmadıysa
      // aşağıdaki REST yedeği çalışır; yorumlar yine görünür.
      const cihaz = cihazKimlik();
      const u = hesap();
      const rpcVeri: any = await rpcYorum(api, anahtar, "yorum_listele", {
        p_slug: slug,
        p_cihaz: cihaz,
        p_id: u?.id || null,
        p_token: u?.token || null,
      });
      if (Array.isArray(rpcVeri)) {
        const uyeIdler = rpcVeri
          .map((v: any) => v.uye_id)
          .filter((v: any): v is string => Boolean(v));
        if (uyeIdler.length) await avatarlariGetir(api, anahtar, uyeIdler);
        liste.replaceChildren(...rpcVeri.map((v: any) => oge(v, true)));
        sayiGuncelle(kok);
        kok.dataset.etkilesim = "1";
        kok.dataset.yuklendi = "1";
        return;
      }
      kok.dataset.etkilesim = "";

      const kuyruk =
        `&slug=eq.${encodeURIComponent(slug)}&order=created_at.desc&limit=100`;
      const temel = `${api}/rest/v1/${tablo}?select=`;
      // `etiket` kolonu hesap.sql henüz çalıştırılmadıysa sorgu 400 döner;
      // bu durumda eski kolonlarla devam et (yorumlar görünmeye devam etsin).
      let r = await fetch(temel + "id,ad,metin,created_at,uye_id,etiket" + kuyruk, {
        headers: susBasliklari(anahtar),
      });
      if (!r.ok) {
        r = await fetch(temel + "id,ad,metin,created_at,uye_id" + kuyruk, {
          headers: susBasliklari(anahtar),
        });
      }
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const veri = (await r.json()) as {
        id?: number | string;
        ad?: string;
        metin?: string;
        created_at?: string;
        uye_id?: string | null;
        etiket?: string | null;
      }[];
      const uyeIdler = veri.map((v) => v.uye_id).filter((v): v is string => Boolean(v));
      if (uyeIdler.length) await avatarlariGetir(api, anahtar, uyeIdler);
      liste.replaceChildren(...veri.map((v) => oge(v, false)));
      if (sayi) {
        sayi.textContent = veri.length ? String(veri.length) : "";
        sayi.hidden = veri.length === 0;
      }
      if (bos) bos.hidden = veri.length > 0;
      kok.dataset.yuklendi = "1";
    } catch {
      // Ağ hatası: kutu bozuk görünmesin, sessiz ve tekrar denenebilir kalsın.
      if (bekle) bekle.hidden = true;
      yaz(kok, "Yorumlar yüklenemedi. Biraz sonra tekrar dene.", true);
    } finally {
      if (bekle) bekle.hidden = true;
    }
  }

  /** Panelde aynı kutu her haber için kullanılıyor; son yazılan haber. */
  let sonSlug = "";

  function kur(kok: Kok, { yenile = false } = {}) {
    if (!kok) return;

    const aktif = kok.dataset.aktif === "1";
    if (!aktif) {
      const kapali = kok.querySelector<HTMLElement>("[data-yorum-kapali]");
      if (kapali) kapali.hidden = false;
      return;
    }
    const form = kok.querySelector<HTMLFormElement>("[data-yorum-form]");
    if (form) form.hidden = false;

    // Haber değiştiyse önceki haberin yazısı/durumu ekranda kalmasın.
    const slug = kok.dataset.slug || "";
    const degisti = slug !== sonSlug;
    if (degisti) {
      sonSlug = slug;
      const metinEl = kok.querySelector<HTMLTextAreaElement>("[data-yorum-metin]");
      if (metinEl) metinEl.value = "";
      yaz(kok, "");
      kok.dataset.yuklendi = "";
    }

    // Olaylar kutu başına BİR kez bağlanır; panel her açıldığında (yenile)
    // yalnızca liste tazelenir (aksi halde çift gönderim olurdu).
    if (!baglananlar.has(kok)) {
      baglananlar.add(kok);
      bagla(kok);
    }

    // Aynı haber için panel tekrar açılırsa ve liste zaten yüklüyse atla.
    if (yenile || degisti || kok.dataset.yuklendi !== "1") void yukle(kok);
  }

  function bagla(kok: Kok) {
    const adEl = kok.querySelector<HTMLInputElement>("[data-yorum-ad]");
    const metinEl = kok.querySelector<HTMLTextAreaElement>("[data-yorum-metin]");
    const tuzak = kok.querySelector<HTMLInputElement>("[data-yorum-tuzak]");
    const gonder = kok.querySelector<HTMLButtonElement>("[data-yorum-gonder]");
    const anahtar = kok.dataset.anahtar || "";
    const tablo = kok.dataset.tablo || "yorumlar";
    const api = kok.dataset.api || "";
    const form = kok.querySelector<HTMLFormElement>("[data-yorum-form]");

    hesapUygula(kok);
    window.addEventListener("hb-oturum-degisti", () => {
      hesapUygula(kok);
      if (kok.dataset.yuklendi === "1") void yukle(kok);
    });

    // Beğeni ve silme: liste her yenilendiğinde ayrı dinleyici eklememek için
    // tek bir olay delegasyonu kullanılır.
    const liste = kok.querySelector<HTMLElement>("[data-yorum-liste]");
    liste?.addEventListener("click", async (e) => {
      const hedef = e.target as Element;
      const begenBtn = hedef.closest("[data-yorum-begen]") as HTMLButtonElement | null;
      const silBtn = hedef.closest("[data-yorum-sil]") as HTMLButtonElement | null;
      const u = hesap();

      if (begenBtn) {
        const id = Number(begenBtn.dataset.yorumBegen || 0);
        if (!id) return;
        begenBtn.disabled = true;
        const r = await rpcYorum(api, anahtar, "yorum_begen", {
          p_yorum: id,
          p_cihaz: cihazKimlik(),
          p_id: u?.id || null,
          p_token: u?.token || null,
        });
        if (r && r.ok) {
          const on = Boolean(r.begendim);
          begenBtn.classList.toggle("is-on", on);
          begenBtn.setAttribute("aria-pressed", on ? "true" : "false");
          begenBtn.setAttribute("aria-label", on ? "Beğeniyi geri al" : "Yorumu beğen");
          const say = begenBtn.querySelector<HTMLElement>("[data-begen-sayi]");
          if (say) say.textContent = String(Math.max(0, Number(r.begeni) || 0));
        } else {
          yaz(kok, (r && r.hata) || "Beğeni kaydedilemedi. Biraz sonra tekrar dene.", true);
        }
        begenBtn.disabled = false;
        return;
      }

      if (silBtn) {
        const id = Number(silBtn.dataset.yorumSil || 0);
        if (!id) return;
        if (!window.confirm("Yorumun kalıcı olarak silinsin mi?")) return;
        silBtn.disabled = true;
        const r = await rpcYorum(api, anahtar, "yorum_sil", {
          p_yorum: id,
          p_cihaz: cihazKimlik(),
          p_id: u?.id || null,
          p_token: u?.token || null,
        });
        if (r && r.ok) {
          const li = silBtn.closest(".yorum__oge");
          if (li) li.remove();
          sayiGuncelle(kok);
          yaz(kok, "Yorumun silindi.");
        } else {
          yaz(kok, (r && r.hata) || "Yorum silinemedi. Biraz sonra tekrar dene.", true);
          silBtn.disabled = false;
        }
      }
    });

    let sonGonderim = 0;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!metinEl || !gonder) return;
      const metin = metinEl.value.trim();
      const slug = kok.dataset.slug || "";
      if (metin.length < 2) {
        yaz(kok, "Yorum çok kısa.", true);
        metinEl.focus();
        return;
      }
      // Bal küpü dolduysa bot: sessizce "başarılı" görün, sunucuya gitme.
      if (tuzak && tuzak.value.trim()) {
        metinEl.value = "";
        yaz(kok, "Yorumun alındı.");
        return;
      }
      const simdi = Date.now();
      if (simdi - sonGonderim < 15000) {
        yaz(kok, "Arka arkaya çok hızlı yazdın, birkaç saniye bekle.", true);
        return;
      }
      const ad = (adEl?.value || "").trim().slice(0, 40) || "Okur";
      gonder.disabled = true;
      yaz(kok, "Gönderiliyor…");
      try {
        const H = (window as any).HaberinAi;
        const u = hesap();
        let kayit: any;
        if (u && H && typeof H.yorumEkle === "function") {
          // Üye: yazma sunucudaki RPC'den geçer; ad profilden, oturum doğrulanır.
          const r = await H.yorumEkle(slug, metin);
          if (r && r.hata) throw new Error(r.hata);
          kayit = {
            id: r.id,
            ad: r.ad || u.ad,
            metin: r.metin || metin,
            created_at: new Date().toISOString(),
            uye_id: u.id,
            etiket: r.etiket || u.etiket || "",
            benim: true,
            begendim: false,
            begeni: 0,
          };
        } else {
          // Hesapsız yorum: cihaz anahtarı sunucuda sahiplik tablosuna yazılır.
          // SQL yaması yoksa eski doğrudan REST ekleme yoluna düşülür.
          const rpcKayit = await rpcYorum(api, anahtar, "yorum_ekle_anon", {
            p_slug: slug,
            p_ad: ad,
            p_metin: metin,
            p_cihaz: cihazKimlik(),
          });
          if (rpcKayit && !Array.isArray(rpcKayit) && !rpcKayit.hata && rpcKayit.id != null) {
            kayit = rpcKayit;
          } else {
            if (rpcKayit && rpcKayit.hata) throw new Error(rpcKayit.hata);
            const r = await fetch(`${api}/rest/v1/${tablo}`, {
              method: "POST",
              headers: {
                ...susBasliklari(anahtar),
                "Content-Type": "application/json",
                Prefer: "return=representation",
              },
              body: JSON.stringify({ slug, ad, metin }),
            });
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            [kayit] = (await r.json()) as { ad?: string; metin?: string; created_at?: string }[];
            kayit = { ...kayit, benim: false, begendim: false, begeni: 0 };
          }
        }
        const liste = kok.querySelector<HTMLElement>("[data-yorum-liste]");
        if (liste && kayit) {
          const yeni = oge(kayit, kok.dataset.etkilesim === "1");
          yeni.classList.add("yorum__oge--yeni");
          liste.prepend(yeni);
        }
        sayiGuncelle(kok);
        sonGonderim = Date.now();
        metinEl.value = "";
        try {
          localStorage.setItem("yorum-ad", ad);
        } catch {
          /* yok say */
        }
        yaz(
          kok,
          kok.classList.contains("yorum--sade")
            ? "Yorumun yayınlandı ✓ Haber sayfasında da görünüyor."
            : "Yorumun yayınlandı ✓",
        );
      } catch {
        yaz(kok, "Yorum gönderilemedi. Biraz sonra tekrar dene.", true);
      } finally {
        gonder.disabled = false;
      }
    });
  }

  (window as unknown as { HaberinaiYorum: unknown }).HaberinaiYorum = { kur };

  for (const kok of document.querySelectorAll<HTMLElement>("[data-yorum]")) {
    if (kok.dataset.aktif !== "1") {
      const kapali = kok.querySelector<HTMLElement>("[data-yorum-kapali]");
      if (kapali) kapali.hidden = false;
      continue;
    }
    if (kok.classList.contains("yorum--sade")) continue; // panel açılınca kurulur
    let kuruldu = false;
    const birKez = () => {
      if (kuruldu) return;
      kuruldu = true;
      kur(kok);
      window.removeEventListener("scroll", yakin);
    };
    const io = new IntersectionObserver(
      (girisler) => {
        if (girisler.some((g) => g.isIntersecting)) {
          io.disconnect();
          birKez();
        }
      },
      { rootMargin: "300px 0px" },
    );
    io.observe(kok);

    // Emniyet kemeri: IntersectionObserver bazı mobil tarayıcılarda kaydırma
    // sırasında gecikebiliyor. Kutu görünür alana 600px yaklaşınca da kur.
    function yakin() {
      const b = kok.getBoundingClientRect();
      if (b.top < window.innerHeight + 600 && b.bottom > -600) {
        io.disconnect();
        birKez();
      }
    }
    window.addEventListener("scroll", yakin, { passive: true });
    window.setTimeout(yakin, 1200);
  }
</script>
