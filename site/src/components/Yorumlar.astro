---
// Yorumlar — giscus (GitHub Discussions) tabanlı, reklamsız ve sunucusuz.
//
// NEDEN BU YOL: site tamamen statik (GitHub Pages) ve Netlify kapandı; yani
// yorumları saklayacak bir arka uç yok. giscus yorumları deponun Discussions
// bölümünde tutar, sayfaya yalnızca bir iframe gömer. Sunucu, veritabanı ve
// abonelik gerekmez; reklam ve takip kodu içermez.
//
// HIZ: iframe, kutu görünür alana yaklaşmadan (400px önce) yüklenmez.
//
// GÜVENLİK/BOZUK GÖRÜNÜM: giscus uygulaması depoya kurulu değilse giscus
// "kurulu değil" hatası yollar. O durumda (ya da 12 sn içinde yanıt gelmezse)
// kutu gizlenir, yerine tek satırlık sessiz bir not kalır. DIŞARI YÖNLENDİRME
// YOK (eskiden Telegram paneline atıyordu): yorum yeri her zaman site içinde.
// giscus geç de olsa yüklenirse kutu geri açılır — yavaş bağlantıda yanlış
// "kapalı" görünmesin.
import { GISCUS } from "../lib/site-meta.js";

interface Props {
  /** Yorum dizisi bu habere özel olsun diye kullanılan sabit anahtar. */
  slug: string;
  /** Tartışma başlığı (arama/discussions listesinde görünen ad). */
  baslik: string;
  /** Kanonik haber adresi. */
  url: string;
  /**
   * Akış (Shorts) içindeki alttan açılan panelde gösterim. Otomatik yükleme
   * kapatılır; panel açılınca window.HaberinaiYorum.kur() çağrılır.
   */
  sade?: boolean;
}

const { slug, baslik, url, sade = false } = Astro.props;

// Kimlikler tanımlıysa giscus denenir; değilse doğrudan sessiz not çizilir.
const giscusVar = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.kategoriId);
const otomatik = !sade && Boolean(slug) && giscusVar;
---

<section
  class:list={["yorum", sade && "yorum--sade"]}
  data-yorum
  data-slug={slug}
  data-baslik={baslik}
  data-url={url}
  data-giscus={giscusVar ? "1" : "0"}
  data-otomatik={otomatik ? "1" : "0"}
  data-repo={GISCUS.repo}
  data-repo-id={GISCUS.repoId}
  data-kategori={GISCUS.kategori}
  data-kategori-id={GISCUS.kategoriId}
>
  <header class="yorum__ust">
    <h2 class="yorum__baslik" id={sade ? undefined : "yorumlar-baslik"}>
      <span aria-hidden="true">💬</span> Yorumlar
    </h2>
    {giscusVar && (
      <span class="yorum__not">GitHub hesabıyla yazılır — reklamsız, takipsiz.</span>
    )}
  </header>

  {
    giscusVar && (
      <div class="yorum__kutu" data-yorum-kutu>
        <div class="giscus" data-yorum-giscus />
        <p class="yorum__bekle" data-yorum-bekle>
          Yorumlar yükleniyor…
        </p>
      </div>
    )
  }

  <p class="yorum__kapali" data-yorum-kapali hidden={giscusVar}>
    💬 Yorumlar şu an kapalı.
  </p>
</section>

<style>
  .yorum {
    margin: 34px 0 10px;
    padding: 20px 20px 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }
  .yorum--sade {
    margin: 0;
    padding: 4px 2px 0;
    border: 0;
    background: transparent;
  }
  .yorum__ust {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .yorum__baslik {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .yorum__not {
    font-size: 0.78rem;
    color: var(--text-2);
  }
  .yorum__kutu {
    min-height: 120px;
  }
  .yorum__bekle {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-2);
  }
  .yorum__kapali {
    margin: 0;
    padding: 12px 14px;
    border: 1px dashed var(--border);
    border-radius: 13px;
    color: var(--text-2);
    font-size: 0.88rem;
  }
  .yorum__kapali[hidden] {
    display: none;
  }
</style>

<script>
  // giscus gömme yardımcısı. Bir kez tanımlanır; hem haber sayfası hem de
  // akıştaki yorum paneli aynı işlevi kullanır.
  type Kok = HTMLElement & { dataset: DOMStringMap };

  const mesajlar = new WeakMap<HTMLElement, { gordum: boolean }>();

  function kutuKapat(kok: Kok, kutu: HTMLElement | null, kapali: HTMLElement | null) {
    if (kutu) kutu.hidden = true;
    if (kapali) kapali.hidden = false;
    kok.dataset.giscus = "0";
  }

  /** giscus geç de olsa geldi → kutu geri açılır (yanlış "kapalı" görünmesin). */
  function kutuAc(kok: Kok, kutu: HTMLElement | null, kapali: HTMLElement | null) {
    if (kutu) kutu.hidden = false;
    if (kapali) kapali.hidden = true;
    kok.dataset.giscus = "1";
  }

  function kur(kok: Kok, { yenile = false } = {}) {
    const kutu = kok.querySelector<HTMLElement>("[data-yorum-kutu]");
    if (!kutu) return;
    const kapali = kok.querySelector<HTMLElement>("[data-yorum-kapali]");
    const bekle = kok.querySelector<HTMLElement>("[data-yorum-bekle]");
    const hedef = kok.querySelector<HTMLElement>("[data-yorum-giscus]");
    if (!hedef || kok.dataset.giscus === "0") return;

    const slug = kok.dataset.slug || "";
    if (!slug) return;

    // Aynı haber için ikinci kez yükleme yapılmaz (panel kapanıp açılırsa atlanır).
    if (!yenile && hedef.dataset.kuruldu === "1") return;

    // Yenilemede eski iframe/script temizlenir; giscus yeniden çizilir.
    hedef.innerHTML = "";
    hedef.dataset.kuruldu = "1";
    kok.querySelectorAll("script[data-yorum-script]").forEach((s) => s.remove());

    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.dataset.yorumScript = "1";
    s.crossOrigin = "anonymous";
    s.setAttribute("data-repo", kok.getAttribute("data-repo") || "");
    s.setAttribute("data-repo-id", kok.getAttribute("data-repo-id") || "");
    s.setAttribute("data-category", kok.getAttribute("data-kategori") || "");
    s.setAttribute("data-category-id", kok.getAttribute("data-kategori-id") || "");
    s.setAttribute("data-mapping", "specific");
    s.setAttribute("data-term", slug);
    s.setAttribute("data-reactions-enabled", "1");
    s.setAttribute("data-emit-metadata", "0");
    s.setAttribute("data-input-position", "bottom");
    s.setAttribute("data-theme", "preferred_color_scheme");
    s.setAttribute("data-lang", "tr");
    s.setAttribute("data-loading", "lazy");
    hedef.appendChild(s);

    // 12 sn içinde giscus'tan olumlu mesaj gelmezse kutu kapanır (yerinde yalnız
    // sessiz not kalır). Süre geniş tutuldu: telefonda yavaş ağda giscus geç de
    // olsa yüklenir ve aşağıdaki mesaj geldiğinde kutu geri açılır.
    const durum = { gordum: false };
    mesajlar.set(kok, durum);
    window.setTimeout(() => {
      if (!durum.gordum && kok.dataset.giscus === "1") kutuKapat(kok, kutu, kapali);
    }, 12000);

    window.addEventListener("message", (e) => {
      if (e.origin !== "https://giscus.app") return;
      let d: { giscus?: { error?: string } } | string = e.data;
      if (typeof d === "string") {
        try {
          d = JSON.parse(d);
        } catch {
          return;
        }
      }
      const g = typeof d === "object" && d ? d.giscus : null;
      if (!g) return;
      // giscus iframe'i bu kutuda mı? (sayfada tek kutu olur; yine de kontrol)
      const cerceve = hedef.querySelector("iframe");
      if (cerceve && (e.source as Window | null) !== cerceve.contentWindow) return;
      if (g.error) {
        kutuKapat(kok, kutu, kapali);
        return;
      }
      durum.gordum = true;
      if (bekle) bekle.hidden = true;
      // Zaman aşımından sonra geldiyse kutuyu geri aç.
      if (kok.dataset.giscus !== "1") kutuAc(kok, kutu, kapali);
      kok.dataset.giscusAktif = "1";
    });
  }

  (window as unknown as { HaberinaiYorum: unknown }).HaberinaiYorum = { kur };

  // Otomatik mod: kutu görünür alana yaklaşınca yüklenir (hız için).
  for (const kok of document.querySelectorAll<HTMLElement>("[data-yorum]")) {
    if (kok.dataset.otomatik !== "1") continue;
    const io = new IntersectionObserver(
      (girisler) => {
        if (girisler.some((g) => g.isIntersecting)) {
          io.disconnect();
          kur(kok as Kok);
        }
      },
      { rootMargin: "400px 0px" },
    );
    io.observe(kok);
  }
</script>
