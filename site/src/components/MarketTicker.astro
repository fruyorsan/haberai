---
import { getMarket } from "../lib/market.js";
import { chartPaths, nf, pf } from "../lib/chart.js";

const { items } = getMarket();

// Kusursuz döngü için liste 3 kez tekrarlanır ve %33.33 kaydırılır.
const COPIES = 3;

const rows = items.map((it) => ({
  ...it,
  chart: chartPaths(it.series, 48, 16, 1),
  up: it.changePct >= 0,
}));
---

{items.length > 0 && (
  <div class="mticker" role="region" aria-label="Piyasa verileri">
    <a class="mticker__lead" href="/piyasa/" title="Tüm piyasa grafiklerini gör">
      <span class="mticker__dot" aria-hidden="true"></span>
      <span class="mticker__lead-text">PİYASA</span>
    </a>

    <div class="mticker__viewport">
      <div class="mticker__track">
        {Array.from({ length: COPIES }).map((_, copy) =>
          rows.map((it) => (
            <a
              class="mticker__item"
              href="/piyasa/"
              aria-hidden={copy > 0 ? "true" : undefined}
              tabindex={copy > 0 ? -1 : undefined}
            >
              <span class="mticker__label">{it.label}</span>
              <span class="mticker__value">{nf(it.value, it.decimals ?? 2)}</span>
              <span class:list={["mticker__chg", it.up ? "is-up" : "is-down"]}>
                <span class="mticker__arrow">{it.up ? "▲" : "▼"}</span>
                {pf(it.changePct)}
              </span>
              {it.chart && (
                <svg
                  class="mticker__spark"
                  viewBox="0 0 48 16"
                  width="48"
                  height="16"
                  aria-hidden="true"
                >
                  <path
                    d={it.chart.line}
                    fill="none"
                    stroke={it.up ? "#4ade80" : "#fb7185"}
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              )}
            </a>
          ))
        )}
      </div>
    </div>
  </div>
)}

<style>
  .mticker {
    --h: 44px;
    position: relative;
    display: flex;
    align-items: stretch;
    height: var(--h);
    background: linear-gradient(90deg, #0b0d11 0%, #191d25 50%, #0b0d11 100%);
    color: #e9ecf1;
    overflow: hidden;
    user-select: none;
    box-shadow: inset 0 -2px 0 rgba(216, 31, 38, 0.55);
  }

  /* Sabit "PİYASA" etiketi */
  .mticker__lead {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.045);
    border-right: 1px solid rgba(255, 255, 255, 0.09);
    transition: background 0.2s var(--ease);
  }
  .mticker__lead:hover {
    background: rgba(216, 31, 38, 0.35);
  }
  .mticker__lead-text {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #fff;
  }
  .mticker__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ef4444;
    animation: mt-pulse 2.2s var(--ease) infinite;
  }
  @keyframes mt-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.65);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
  }

  /* Kayan alan — kenarlarda yumuşak geçiş */
  .mticker__viewport {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 26px,
      #000 calc(100% - 46px),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 26px,
      #000 calc(100% - 46px),
      transparent 100%
    );
  }

  .mticker__track {
    display: flex;
    width: max-content;
    height: 100%;
    animation: mt-scroll 110s linear infinite;
    will-change: transform;
  }
  .mticker:hover .mticker__track {
    animation-play-state: paused;
  }

  .mticker__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: var(--h);
    padding: 0 18px;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    white-space: nowrap;
    transition: background 0.2s var(--ease);
  }
  .mticker__item:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .mticker__label {
    font-size: 0.73rem;
    font-weight: 600;
    color: #8f97a5;
    letter-spacing: 0.01em;
  }
  .mticker__value {
    font-size: 0.85rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .mticker__chg {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.73rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    padding: 3px 8px;
    border-radius: 999px;
  }
  .mticker__chg.is-up {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.13);
  }
  .mticker__chg.is-down {
    color: #fb7185;
    background: rgba(239, 68, 68, 0.14);
  }
  .mticker__arrow {
    font-size: 0.6rem;
    line-height: 1;
  }
  .mticker__spark {
    opacity: 0.85;
  }

  @keyframes mt-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (max-width: 720px) {
    .mticker {
      --h: 40px;
    }
    .mticker__lead {
      padding: 0 12px;
    }
    .mticker__item {
      padding: 0 13px;
    }
    .mticker__spark {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mticker__track {
      animation: none;
    }
    .mticker__dot {
      animation: none;
    }
  }
</style>
