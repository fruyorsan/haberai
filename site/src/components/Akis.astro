---
// ==========================================================================
// AI AKIŞ beslemesi — /akis/ ve /akis/kategori/<slug>/ sayfalarının ortak gövdesi
// --------------------------------------------------------------------------
// Neden bileşen: akış hem genel hem kategori bazlı yayınlanır. Site statik
// olduğu için "?kategori=" çalışmaz (sorgu dizesi üretim anında yoktur);
// kategori akışları GERÇEK adres olarak üretilir. İki sayfa da bu bileşeni
// kullanır, tasarım tek yerde kalır.
//
// Sonsuz kaydırma: toplar /akis/sayfa/<ofset>.json dosyalarından gelir
// (statik sitede sorgu dizesi işe yaramaz). Kategori akışında ilk kartlar
// süzülmüş listeden gelir, toplar baştan okunur ve istemci kategori dışı ile
// tekrar eden kartları ayıklar.
// ==========================================================================
import AdSlot from "./AdSlot.astro";
import Yorumlar from "./Yorumlar.astro";
import { getArticles, getCategories, imageUrl } from "../lib/articles.js";
import { kapakKaynagi } from "../lib/kapak.js";
import { akisKartlar, AKIS_ILK } from "../lib/akis-kart.js";
import { ilgiSirala, kapakliOneSirala } from "../lib/ilgi.js";
import { ADSENSE_SLOTS } from "../lib/site-meta.js";

const { kategori = "", kategoriAdi = "", ilkSayi = AKIS_ILK } = Astro.props;
const gecerliKat = Boolean(kategori);
const tumu = getArticles();
const kategoriler = getCategories().slice(0, 14);
// GLOBAL akış ilgi puanına göre sıralanır (teknoloji, oyun, yapay zekâ ve
// merak uyandıran konular öne). Her iki akışta da GERÇEK fotoğraflı haberler
// önce gelir: kategori akışları kronolojik kalır ama fotoğrafsız haberler
// grubun sonuna düşer (kart tamamen fotoğrafsız kalmasın). Sonsuz kaydırma
// topları da aynı sırayı kullanır (lib/ilgi.js).
const liste = gecerliKat
  ? kapakliOneSirala(tumu.filter((a) => a.categorySlug === kategori))
  : ilgiSirala(tumu);
// Kategori akışlarında ilk tur daha geniş basılır: toplar GLOBAL listeden
// geldiği için küçük/orta kategorilerde "daha fazla" boş dönebilirdi. Kategori
// sayfaları zaten "noindex"tir; biraz daha uzun HTML sorun değil.
const ilk = liste.slice(0, ilkSayi);
---

<div
    class="akis"
    id="akis"
    data-kategori={gecerliKat ? kategori : ""}
    data-toplam={liste.length}
    data-ilk={ilk.length}
    data-baslangic={gecerliKat ? 0 : AKIS_ILK}
  >
    <section class="akis__ust">
      <div class="container akis__tanitim">
        <span class="akis__rozet"><i aria-hidden="true">✦</i> Yapay zekâ özetli</span>
        <h1>{gecerliKat ? `${kategoriAdi} Shorts` : "Shorts Haber"}</h1>
        <p>
          Kaydır, oku, beğen. Yapay zekâ özetleriyle
          <strong>{liste.length}</strong> haber seni bekliyor.
        </p>
      </div>

      {/* Tek satır: solda kategori şeridi (kayar), sağda süzgeçler.
          Eskiden iki ayrı çip satırı üst üste duruyordu ve hangisinin ne
          olduğu karışıyordu. */}
      <div class="container akis__suz">
        <nav class="akis__katlar" aria-label="Kategoriler">
          <a class:list={["akis__kat", !gecerliKat && "is-active"]} href="/akis/">Tümü</a>
          {kategoriler.map((k) => (
            <a
              class:list={["akis__kat", gecerliKat && kategori === k.slug && "is-active"]}
              href={`/akis/kategori/${k.slug}/`}
            >
              {k.name}
            </a>
          ))}
        </nav>

        <div class="akis__cipler" role="group" aria-label="Akışı süz">
          <button
            class="akis__cip"
            type="button"
            data-sirala="bana"
            aria-pressed="false"
            aria-label="Sana özel sırala"
            title="Beğendiğin kategoriler öne gelsin"
          >
            <span class="akis__cip-ikon" aria-hidden="true">✨</span>
            <span class="akis__cip-yazi">Sana özel</span>
          </button>
          <button
            class="akis__cip"
            type="button"
            data-suz="begeni"
            aria-pressed="false"
            aria-label="Beğendiklerim"
            title="Beğendiklerim"
          >
            <span class="akis__cip-ikon" aria-hidden="true">♥</span>
            <span class="akis__cip-yazi">Beğendiklerim</span>
            <b data-sayi="begeni">0</b>
          </button>
          <button
            class="akis__cip"
            type="button"
            data-suz="kayit"
            aria-pressed="false"
            aria-label="Kaydedilenler"
            title="Kaydedilenler"
          >
            <span class="akis__cip-ikon" aria-hidden="true">🔖</span>
            <span class="akis__cip-yazi">Kaydedilenler</span>
            <b data-sayi="kayit">0</b>
          </button>
        </div>
      </div>
    </section>

    {/* Bildirim istemi: TEKRAR GELEN TRAFİĞİN en güçlü aracı. Yalnızca izin
        verilmemişse ve okuyucu kapatmadıysa görünür. Buton, zildeki akışın
        aynısını kullanır (OneSignal izni + optIn). */}
    <div class="container">
      <button class="akis__bel" id="akis-bel" type="button" hidden>
        <span class="akis__bel-ikon" aria-hidden="true">🔔</span>
        <span class="akis__bel-metin">
          <strong>Yeni haberler cebine gelsin</strong>
          <span>Son dakika ve takip ettiğin konular — ücretsiz, istediğin an kapat.</span>
        </span>
        <span class="akis__bel-btn" id="akis-bel-btn">Bildirimleri aç</span>
      </button>
    </div>

    <div class="akis__liste" id="akis-liste">
      <Fragment set:html={akisKartlar(ilk.slice(0, 12), 0)} />
      <AdSlot slot={ADSENSE_SLOTS.liste} label="Sponsorlu" />
      <Fragment set:html={akisKartlar(ilk.slice(12), 12)} />
    </div>

    <div class="akis__bos" id="akis-bos" hidden>
      <p>Bu süzgeçte gösterilecek kayıt yok. Akışı kaydırdıkça dolar.</p>
    </div>

    <div class="akis__bekle" id="akis-bekle" aria-live="polite">
      <span class="akis__bekle-ic" id="akis-bekle-ic" hidden>
        <span class="akis__donu" aria-hidden="true"></span> Yükleniyor…
      </span>
      <button class="akis__daha" id="akis-daha" type="button">
        Daha fazla haber
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14" />
          <path d="m5.5 12 6.5 6.5 6.5-6.5" />
        </svg>
      </button>
    </div>

    <p class="akis__bitti" id="akis-bitti" hidden>
      🎉 Akışın sonuna geldin. Tüm arşiv: <a href="/haberler/">tüm haberler</a>
    </p>
  </div>

  <div class="akis__toast" id="akis-toast" role="status" aria-live="polite" hidden></div>

  {/* Yorumlar — alttan açılan panel. Akışta yorum da beğen/kaydet gibi tek
      dokunuş olsun istendi; bu yüzden ayrı sayfaya atmak yerine panel açılır.
      Yorumlar panel ilk açıldığında yüklenir (Yorumlar bileşeni, Supabase). */}
  <div class="ysheet" id="yorum-sheet" hidden>
    <button class="ysheet__arka" type="button" data-yorum-kapat aria-label="Yorumları kapat"></button>
    <div class="ysheet__kutu" role="dialog" aria-modal="true" aria-labelledby="ysheet-baslik">
      <div class="ysheet__tutamak" aria-hidden="true"></div>
      <header class="ysheet__ust">
        <strong class="ysheet__baslik" id="ysheet-baslik">💬 Yorumlar</strong>
        <button class="ysheet__kapat" type="button" data-yorum-kapat aria-label="Kapat">✕</button>
      </header>
      <p class="ysheet__ad" id="ysheet-ad"></p>
      <div class="ysheet__govde">
        <Yorumlar sade slug="" baslik="" url="" />
      </div>      <a class="ysheet__oku" id="ysheet-oku" href="/akis/">Haberi oku →</a>
    </div>
  </div>

  <script>
    (function () {
      const kok = document.getElementById("akis");
      const liste = document.getElementById("akis-liste");
      const bekle = document.getElementById("akis-bekle");
      const bekleIc = document.getElementById("akis-bekle-ic");
      const daha = document.getElementById("akis-daha");
      const bitti = document.getElementById("akis-bitti");
      const bos = document.getElementById("akis-bos");
      const toast = document.getElementById("akis-toast");
      if (!kok || !liste) return;

      const kategori = kok.dataset.kategori || "";
      const toplam = Number(kok.dataset.toplam || 0);
      // Statik site: toplar hazır dosyalardan gelir (/akis/sayfa/<ofset>.json).
      // Kategori akışında ilk kartlar süzülmüş listeden geldiği için toplar
      // baştan okunur, tekrar eden slug'lar ayıklanır.
      let globalOffset = Number(kok.dataset.baslangic || 0);
      const listedekiler = new Set(
        [...liste.querySelectorAll(".ak")].map((k) => k.dataset.slug)
      );
      let tukendi = false;
      let yukleniyor = false;
      let suzgec = "tumu";
      // Kategori akışlarında toplar global listeden gelir ve bir turda hiç
      // eşleşen kart çıkmayabilir. Üst üste iki boş turdan sonra "daha fazla"
      // düğmesi sonsuz boş istek üretmesin diye akış bitmiş sayılır.
      let bosTur = 0;

      // --- Yerel durum (beğeni/kayıt) — sunucu gerekmez, cihazda kalır --------
      const oku = (ad) => {
        try {
          const v = JSON.parse(localStorage.getItem(ad) || "[]");
          return new Set(Array.isArray(v) ? v.map(String) : []);
        } catch (e) {
          return new Set();
        }
      };
      const yaz = (ad, set) => {
        try {
          localStorage.setItem(ad, JSON.stringify([...set].slice(-400)));
        } catch (e) {}
      };

      const begeniler = oku("akis-begeni");
      const kayitlar = oku("akis-kayit");
      // GÖRÜLENLER: bir kez gördüğün (ya da beğendiğin) haber, bir sonraki
      // ziyarette akışın tepesinde durmaz. Şikâyet: "beğendiğim şey bir dahaki
      // girişimde yine en üstteydi". Sıra: görülmemişler önce, gördükler sonra
      // (grup içinde sunucu sırası korunur). Veri cihazda kalır.
      const gorulenler = oku("akis-gorulen");

      const sayilari = () => {
        const b = kok.querySelector('[data-sayi="begeni"]');
        const k = kok.querySelector('[data-sayi="kayit"]');
        if (b) b.textContent = String(begeniler.size);
        if (k) k.textContent = String(kayitlar.size);
        kok.querySelectorAll(".akis__cip").forEach((c) => {
          const n = c.querySelector("b");
          if (n && Number(n.textContent) === 0) n.hidden = true;
          else if (n) n.hidden = false;
        });
      };

      // --- Kart boyama: beğeni/kayıt durumu ve süzgeç görünürlüğü -------------
      function boya(kart) {
        const slug = kart.dataset.slug;
        const begen = begeniler.has(slug);
        const kayit = kayitlar.has(slug);
        kart.classList.toggle("is-begen", begen);
        kart.classList.toggle("is-kayit", kayit);
        const b = kart.querySelector(".ak__begen");
        const k = kart.querySelector(".ak__kaydet");
        if (b) b.setAttribute("aria-pressed", String(begen));
        if (k) k.setAttribute("aria-pressed", String(kayit));
        // "Gördün" hafızası SESSİZ çalışır: görülenler bir sonraki açılışta
        // listenin altına iner ama kart üstünde rozet/soluklaşma GÖRÜNMEZ
        // (kullanıcı isteği, 18.10.2026).
        if (suzgec === "begeni") kart.hidden = !begen;
        else if (suzgec === "kayit") kart.hidden = !kayit;
        else kart.hidden = false;
      }

      /** Görüleni kalıcı olarak işaretler (sıra DEĞİŞMEZ; zıplama olmasın). */
      function gorulenIsaretle(kart) {
        const slug = kart.dataset.slug;
        if (!slug || gorulenler.has(slug)) return;
        gorulenler.add(slug);
        yaz("akis-gorulen", gorulenler);
        boya(kart);
      }

      // Kart ekranın yarısından fazlası görününce "gördün" sayılır.
      const gorulenGozcu =
        "IntersectionObserver" in window
          ? new IntersectionObserver(
              (girisler) => {
                for (const g of girisler) {
                  if (!g.isIntersecting) continue;
                  gorulenIsaretle(g.target);
                  gorulenGozcu.unobserve(g.target);
                }
              },
              { threshold: 0.6 }
            )
          : null;
      const gozle = (kap) => {
        if (!gorulenGozcu) return;
        kap.querySelectorAll(".ak").forEach((k) => gorulenGozcu.observe(k));
      };

      const boyaHepsi = () => {
        liste.querySelectorAll(".ak").forEach(boya);
        sayilari();
        if (bos) {
          const gorunen = [...liste.querySelectorAll(".ak")].some((k) => !k.hidden);
          bos.hidden = !(suzgec !== "tumu" && !gorunen);
        }
      };

      // --- Bildirim/toast ----------------------------------------------------
      let toastZaman = 0;
      function bildir(metin) {
        if (!toast) return;
        toast.textContent = metin;
        toast.hidden = false;
        toast.classList.add("is-gorunur");
        clearTimeout(toastZaman);
        toastZaman = setTimeout(() => {
          toast.classList.remove("is-gorunur");
          setTimeout(() => (toast.hidden = true), 260);
        }, 2200);
      }

      // --- Kart eylemleri ----------------------------------------------------
      function begen(kart) {
        const slug = kart.dataset.slug;
        const yeni = !begeniler.has(slug);
        if (yeni) begeniler.add(slug);
        else begeniler.delete(slug);
        yaz("akis-begeni", begeniler);
        boya(kart);
        sayilari();
        if (yeni) {
          kart.classList.remove("is-patladi");
          void kart.offsetWidth; // animasyonu yeniden başlat
          kart.classList.add("is-patladi");
          if (navigator.vibrate) navigator.vibrate(12);
          bildir("Beğendin ♥");
        }
      }

      function kaydet(kart) {
        const slug = kart.dataset.slug;
        const yeni = !kayitlar.has(slug);
        if (yeni) kayitlar.add(slug);
        else kayitlar.delete(slug);
        yaz("akis-kayit", kayitlar);
        boya(kart);
        sayilari();
        bildir(yeni ? "Kaydedildi 🔖" : "Kayıttan çıkarıldı");
      }

      // --- Yorumlar: alttan açılan panel (bottom sheet) --------------------
      // Akışta yorum, tıpkı beğen/kaydet gibi tek dokunuşta açılır. Yorum
      // kutusu YALNIZCA panel ilk kez açıldığında kurulur; her haber için
      // ayrı yorum yükü çekilmez (24 kart = 24 istek olurdu, sayfa yavaşlardı).
      const ySheet = document.getElementById("yorum-sheet");
      const yAd = document.getElementById("ysheet-ad");
      const yOku = document.getElementById("ysheet-oku");
      const yYorum = ySheet ? ySheet.querySelector("[data-yorum]") : null;
      let ySlug = "";

      function yorumAc(kart) {
        if (!ySheet || !yYorum) return;
        // Panel her zaman açılır. Yorum altyapısı henüz tanımlı değilse bile
        // kutu içinde sessiz bir not görünür (boş panel / dışarı yönlendirme yok).
        // Panel zaten bu haber için açıksa sadece gösterilir (liste yenilenmez).
        const ayni = ySlug && ySlug === kart.dataset.slug;
        ySlug = kart.dataset.slug || "";
        const ad = kart.dataset.ad || "Haber";
        if (yAd) yAd.textContent = ad;
        if (yOku) yOku.setAttribute("href", `/haber/${ySlug}/`);
        yYorum.setAttribute("data-slug", ySlug);
        yYorum.setAttribute("data-baslik", ad);
        yYorum.setAttribute("data-url", `${location.origin}/haber/${ySlug}/`);
        const sheet = ySheet;
        sheet.hidden = false;
        document.documentElement.classList.add("ysheet-kilit");
        // Yorumlar panel görünür olduktan sonra kurulur; aynı haber için
        // panel tekrar açılırsa mevcut liste korunur (yenileme yapılmaz).
        const api = (
          window as unknown as {
            HaberinaiYorum?: { kur: (k: Element, o?: { yenile?: boolean }) => void };
          }
        ).HaberinaiYorum;
        if (api && ySlug) api.kur(yYorum, { yenile: !ayni });
      }

      function yorumKapat() {
        if (!ySheet) return;
        ySheet.hidden = true;
        document.documentElement.classList.remove("ysheet-kilit");
      }

      if (ySheet) {
        ySheet.querySelectorAll("[data-yorum-kapat]").forEach((d) =>
          d.addEventListener("click", yorumKapat),
        );
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !ySheet.hidden) yorumKapat();
        });
      }

      async function paylas(kart) {
        const bag = kart.querySelector(".ak__baslik a");
        const url = bag ? new URL(bag.getAttribute("href"), location.origin).href : location.href;
        const baslik = bag ? bag.textContent.trim() : "HaberinAi";
        try {
          if (navigator.share) {
            await navigator.share({ title: baslik, text: baslik, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          bildir("Bağlantı kopyalandı");
        } catch (e) {
          if (e && e.name === "AbortError") return;
          bildir("Bağlantı adres çubuğunda");
        }
      }

      liste.addEventListener("click", (e) => {
        const dugme = e.target.closest("[data-islem]");
        if (!dugme) return;
        const kart = dugme.closest(".ak");
        if (!kart) return;
        const islem = dugme.dataset.islem;
        if (islem === "begen") {
          begen(kart);
          // Beğendiğin haber de "gördün" sayılır: bir sonraki ziyarette tepede
          // tekrar durmaz (şikâyetin tam karşılığı).
          gorulenIsaretle(kart);
        } else if (islem === "kaydet") {
          kaydet(kart);
          gorulenIsaretle(kart);
        } else if (islem === "paylas") paylas(kart);
        else if (islem === "yorum") yorumAc(kart);
      });

      // Fotoğrafa çift dokunma = beğen (Instagram alışkanlığı)
      let sonDokunma = 0;
      let sonKart = null;
      liste.addEventListener("pointerup", (e) => {
        const gorsel = e.target.closest(".ak__gorsel");
        if (!gorsel) return;
        const kart = gorsel.closest(".ak");
        const simdi = Date.now();
        if (kart && kart === sonKart && simdi - sonDokunma < 340) {
          if (!begeniler.has(kart.dataset.slug)) begen(kart);
          sonDokunma = 0;
          sonKart = null;
        } else {
          sonDokunma = simdi;
          sonKart = kart;
        }
      });

      // --- Süzgeçler ---------------------------------------------------------
      kok.querySelectorAll(".akis__cip[data-suz]").forEach((cip) => {
        cip.addEventListener("click", () => {
          const secilen = cip.dataset.suz || "tumu";
          // Seçili süzgece tekrar basmak süzgeci kaldırır. Telefonda "Tümü"
          // düğmesi gizlendiği için geri dönüş yolu bu.
          suzgec = cip.classList.contains("is-active") && secilen !== "tumu" ? "tumu" : secilen;
          kok.querySelectorAll(".akis__cip[data-suz]").forEach((c) => {
            const secili = (c.dataset.suz || "tumu") === suzgec;
            c.classList.toggle("is-active", secili);
            c.setAttribute("aria-pressed", String(secili));
          });
          boyaHepsi();
          // Süzgeçten sonra görünür kart sayısı değişti: ara reklamı yeniden
          // 8. GÖRÜNÜR kartın altına yerleştir (aksi halde gizli kartların
          // ardında kalıp akışın ortasında yüzer).
          reklamiYerlestir();
          window.scrollTo({ top: kok.querySelector(".akis__liste").offsetTop - 120, behavior: "smooth" });
          if (suzgec === "begeni") bildir("Beğendiğin haberler");
          else if (suzgec === "kayit") bildir("Kaydettiğin haberler");
          else bildir("Tüm haberler");
          // Boş liste mesajı: hangi süzgeçte olduğunu anlatan metin.
          if (bos) {
            const p = bos.querySelector("p");
            if (p) {
              p.textContent =
                suzgec === "begeni"
                  ? "Henüz beğendiğin haber yok. Kartlardaki ♥ simgesine dokun; beğendiklerin burada toplanır."
                  : suzgec === "kayit"
                    ? "Henüz kaydettiğin haber yok. Kartlardaki 🔖 simgesine dokun; kaydettiklerin burada toplanır."
                    : "";
            }
          }
        });
      });

      // --- Sana özel sıralama ------------------------------------------------
      // Varsayılan sıra sunucudan "ilgi puanı" ile gelir (teknoloji, oyun,
      // yapay zekâ ve merak uyandıran konular önde). "Sana özel" açılınca
      // yüklü kartlar, beğendiğin kategoriler öne çıkacak biçimde yeniden
      // dizilir: ilgi puanı + kategori beğeni bonusu. Veri cihazda kalır.
      // (Yeni yüklenen kartlar akışın altına eklenir; sıralama düğmeye
      //  basıldığında uygulanır, kaydırma sırasında zıplama olmaz.)
      const siralaDugme = kok.querySelector('[data-sirala="bana"]');
      let sanaOzel = false;

      function reklamiYerlestir() {
        const reklam = liste.querySelector(":scope > .ad");
        if (!reklam) return;
        const kartlar = [...liste.querySelectorAll(".ak")].filter((k) => !k.hidden);
        const hedef = kartlar[7];
        if (hedef) hedef.after(reklam);
        else liste.appendChild(reklam);
      }

      /**
       * Görülmemiş haberleri öne alır (görülenler akışın altına düşer).
       * YALNIZCA AÇILIŞTA çalışır: kaydırma sırasında sıra değişirse içerik
       * parmağın altından kayar. "Sana özel" açıksa dokunulmaz (okuyucunun
       * kendi seçimidir). Gruplar içinde sunucu sırası korunur.
       */
      function gorulenSirala() {
        if (sanaOzel || !gorulenler.size) return;
        const kartlar = [...liste.querySelectorAll(".ak")];
        if (!kartlar.length) return;
        kartlar
          .map((k, i) => ({ k, i, g: gorulenler.has(k.dataset.slug) ? 1 : 0 }))
          .sort((x, y) => x.g - y.g || x.i - y.i)
          .forEach((x) => liste.appendChild(x.k));
        reklamiYerlestir();
      }

      function sanaOzelUygula() {
        const kartlar = [...liste.querySelectorAll(".ak")];
        if (!kartlar.length) return;
        if (sanaOzel) {
          const katPuan = new Map();
          for (const k of kartlar) {
            if (!begeniler.has(k.dataset.slug)) continue;
            const kat = k.dataset.kat || "";
            katPuan.set(kat, (katPuan.get(kat) || 0) + 1);
          }
          const puan = (k) =>
            Number(k.dataset.ilgi || 0) + (katPuan.get(k.dataset.kat || "") || 0) * 9;
          kartlar
            .map((k, i) => ({ k, i, p: puan(k) }))
            .sort((x, y) => y.p - x.p || x.i - y.i)
            .forEach((x) => liste.appendChild(x.k));
        } else {
          kartlar
            .map((k, i) => ({ k, i, s: Number(k.dataset.siraKaydi ?? i) }))
            .sort((x, y) => x.s - y.s)
            .forEach((x) => liste.appendChild(x.k));
        }
        reklamiYerlestir();
      }

      if (siralaDugme) {
        siralaDugme.addEventListener("click", () => {
          sanaOzel = !sanaOzel;
          siralaDugme.classList.toggle("is-active", sanaOzel);
          siralaDugme.setAttribute("aria-pressed", String(sanaOzel));
          sanaOzelUygula();
          window.scrollTo({ top: liste.offsetTop - 120, behavior: "smooth" });
          bildir(
            sanaOzel
              ? "Sana özel: beğendiğin konular öne alındı ✨"
              : "İlgi sırasına dönüldü 🔥"
          );
        });
      }

      // --- Sonsuz kaydırma ---------------------------------------------------
      async function yukle() {
        if (yukleniyor || tukendi) return;
        yukleniyor = true;
        if (bekleIc) bekleIc.hidden = false;
        try {
          let eklenen = 0;
          // Kategori akışlarında toplar global listeden gelir; bir top az
          // sayıda eşleşme içerebilir. Kullanıcı "daha fazla"ya basıp yalnızca
          // 2-3 kart görmesin diye en az 12 karta ulaşana kadar (en fazla 6
          // top) devam edilir; liste biterse döngü kırılır.
          for (let tur = 0; tur < 6; tur++) {
            const y = await fetch(`/akis/sayfa/${globalOffset}.json`, {
              headers: { Accept: "application/json" },
            });
            const d = await y.json();
            if (!d.verilen) {
              tukendi = true;
              break;
            }
            globalOffset = Number.isFinite(d.sonraki) ? d.sonraki : globalOffset + 24;
            if (d.html) {
              const gecici = document.createElement("div");
              gecici.innerHTML = d.html;
              const parca = document.createDocumentFragment();
              const eklenecek = [];
              for (const k of [...gecici.children]) {
                const slug = k.dataset.slug;
                // Tekrar eden kart olmasın (kategori akışında ilk kartlar
                // süzülmüş listeden gelir) ve kategori dışı kart eklenmesin.
                if (listedekiler.has(slug)) continue;
                if (kategori && k.dataset.kat !== kategori) continue;
                listedekiler.add(slug);
                eklenecek.push(k);
                parca.appendChild(k);
              }
              liste.appendChild(parca);
              eklenecek.forEach(boya);
              gozle(parca);
              // Yeni kartlar akışın sonuna eklenir; "Sana özel" kapatıldığında
              // doğru sıraya dönebilmek için sunucu sırası numarası yazılır.
              let siraNo = liste.querySelectorAll(".ak").length - eklenecek.length;
              for (const k of eklenecek) k.dataset.siraKaydi = String(siraNo++);
              eklenen += eklenecek.length;
            }
            if (d.son) {
              tukendi = true;
              break;
            }
            if (eklenen >= 12) break;
          }
          sayilari();
          // Üst üste iki turda yeni kart gelmediyse liste tükenmiş sayılır.
          if (eklenen > 0) bosTur = 0;
          else if (++bosTur >= 2) tukendi = true;
          if (tukendi && bitti) bitti.hidden = false;
        } catch (e) {
          /* ağ hatası: sessizce dur, kullanıcı kaydırınca/düğmeye basınca tekrar dener */
        } finally {
          yukleniyor = false;
          if (bekleIc) bekleIc.hidden = true;
          dugmeDurumu();
          if (bos) {
            const gorunen = [...liste.querySelectorAll(".ak")].some((k) => !k.hidden);
            bos.hidden = !(suzgec !== "tumu" && !gorunen);
          }
          // Sentinelin görüş alanında olması hâlinde sıradaki topu da getir
          // (süzgeç/kategori yüzünden boş gelen toplar akışı tıkamasın).
          if (!tukendi) {
            const r = bekle ? bekle.getBoundingClientRect() : null;
            if (r && r.top < window.innerHeight + 300) setTimeout(yukle, 260);
          }
        }
      }

      /** "Daha fazla haber" düğmesinin durumu. */
      function dugmeDurumu() {
        if (!daha) return;
        daha.hidden = tukendi;
        daha.disabled = yukleniyor;
      }

      if (daha) daha.addEventListener("click", () => yukle());

      // Otomatik yükleme: IntersectionObserver + kaydırma yedeği.
      // (IO bazı tarayıcılarda/kare üretilmeyen sekmelerde tetiklenmez; kaydırma
      //  dinleyicisi her koşulda sentinel'i kontrol eder, elle düğme de durur.)
      if (bekle && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (girisler) => {
            if (girisler.some((g) => g.isIntersecting)) yukle();
          },
          { rootMargin: "600px 0px" }
        );
        io.observe(bekle);
      }
      // Kaydırma dinleyicisi her olayda yerleşim ölçmesin: kare başına bir kez.
      let kaydirmaBekliyor = false;
      window.addEventListener(
        "scroll",
        () => {
          if (kaydirmaBekliyor) return;
          kaydirmaBekliyor = true;
          requestAnimationFrame(() => {
            kaydirmaBekliyor = false;
            if (bekle && bekle.getBoundingClientRect().top < window.innerHeight + 800) yukle();
          });
        },
        { passive: true }
      );

      // --- Klavye: masaüstünde karta karta ilerle ----------------------------
      document.addEventListener("keydown", (e) => {
        if (e.target.matches("input, textarea, select")) return;
        const kartlar = [...liste.querySelectorAll(".ak")].filter((k) => !k.hidden);
        if (!kartlar.length) return;
        if (e.key === "ArrowDown" || e.key === "j") {
          const sonraki = kartlar.find((k) => k.getBoundingClientRect().top > window.innerHeight * 0.45);
          if (sonraki) {
            e.preventDefault();
            sonraki.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        } else if (e.key === "ArrowUp" || e.key === "k") {
          const oncekiler = kartlar.filter((k) => k.getBoundingClientRect().top < window.innerHeight * 0.35);
          if (oncekiler.length) {
            e.preventDefault();
            oncekiler[oncekiler.length - 1].scrollIntoView({ behavior: "smooth", block: "start" });
          }
        } else if (e.key === "l" || e.key === "s") {
          const orta = kartlar.find((k) => {
            const r = k.getBoundingClientRect();
            return r.top >= -r.height * 0.4 && r.top <= window.innerHeight * 0.5;
          });
          if (orta) {
            e.preventDefault();
            if (e.key === "l") begen(orta);
            else kaydet(orta);
          }
        }
      });

      // --- Açılış -------------------------------------------------------------
      // Sunucudan basılan kartların sırası: "Sana özel" kapatılınca bu sıraya
      // dönülür.
      liste.querySelectorAll(".ak").forEach((k, i) => (k.dataset.siraKaydi = String(i)));
      boyaHepsi();
      // Gördüğün haberler bu ziyarette aşağı düşer (görülmemişler önce).
      gorulenSirala();
      liste.querySelectorAll(".ak").forEach((k, i) => (k.dataset.siraKaydi = String(i)));
      gozle(liste);
      // Sayfada basılan kart sayısı listeyi bitiriyorsa (kısa kategori) bekleme.
      if (Number(kok.dataset.ilk || 0) >= toplam) {
        tukendi = true;
        if (bitti) bitti.hidden = false;
      }
      dugmeDurumu();

      // İlk ziyarette kaydırma ipucu (bir kez gösterilir).
      try {
        if (!localStorage.getItem("akis-ipucu") && window.scrollY < 40) {
          localStorage.setItem("akis-ipucu", "1");
          setTimeout(() => bildir("Kaydır, kısa kısa haberler ↓"), 1200);
        }
      } catch (e) {}

      // Akış sayfasından ayrılırken durumu tazele (geri dönüşte doğru görünsün).
      window.addEventListener("pageshow", boyaHepsi);

      // --- Bildirim istemi (tekrar gelen trafik) ---------------------------
      // Yalnızca tarayıcı izni henüz verilmemişse ve okuyucu istemi kapatmadıysa
      // gösterilir. Buton, zildekiyle aynı akışı çalıştırır: OneSignal izni +
      // push aboneliği (optIn). İzin verilirse istem kaybolur.
      (function () {
        const kutu = document.getElementById("akis-bel");
        const btn = document.getElementById("akis-bel-btn");
        if (!kutu || !btn) return;
        const K_KAPALI = "akis-bildirim-kapali";
        // iPhone/Safari: iOS'ta web push YALNIZCA "Ana Ekrana Ekle" ile açılan
        // uygulamada çalışır. Safari sekmesinde butona basmak sessizce hiçbir şey
        // yapmaz — okuyucuya "açtım ama gelmiyor" dedirtmemek için istem, bu
        // durumda buton yerine yolu gösterir (kullanıcı şikâyeti: telden açtım,
        // bildirim gelmedi).
        const iosCihaz =
          /iP(hone|ad|od)/.test(navigator.userAgent) ||
          (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
        const anaEkranda =
          navigator.standalone === true ||
          (window.matchMedia &&
            (window.matchMedia("(display-mode: standalone)").matches ||
              window.matchMedia("(display-mode: fullscreen)").matches));
        const iosSorun = iosCihaz && !anaEkranda;
        const izinVar = () => {
          try {
            return typeof Notification !== "undefined" && Notification.permission === "granted";
          } catch {
            return false;
          }
        };
        const goster = () => {
          try {
            if (localStorage.getItem(K_KAPALI) === "1") return;
          } catch {}
          if (izinVar()) return;
          if (iosSorun) {
            const metin = kutu.querySelector(".akis__bel-metin");
            const ikon = kutu.querySelector(".akis__bel-ikon");
            if (ikon) ikon.textContent = "📲";
            if (metin) {
              metin.innerHTML =
                "<strong>iPhone'da bildirim için: Paylaş → “Ana Ekrana Ekle”</strong>" +
                "<span>Sonra o ikondan aç ve buradaki düğmeye bas. Safari sekmesinde iOS bildirim göndermez.</span>";
            }
            btn.textContent = "Anladım";
          }
          kutu.hidden = false;
        };
        // İstem, sayfa içeriğini geciktirmesin: biraz sonra görünür.
        setTimeout(goster, 1500);

        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (iosSorun) {
            kutu.hidden = true;
            return;
          }
          btn.textContent = "Açılıyor…";
          let oldu = false;
          try {
            // Tek doğru kaynak: zilin (Bildirim.astro) kullandığı akış. Böylece
            // "izin var ama abonelik kurulmadı" durumu burada da doğru görünür.
            const api = window.HaberinaiPush;
            if (api) {
              oldu = await api.aboneBaslat();
            } else {
              const hazir = window.HaberinaiOS && window.HaberinaiOS.hazir;
              const os = hazir
                ? await Promise.race([
                    hazir,
                    new Promise((r) => setTimeout(() => r(null), 8000)),
                  ])
                : null;
              if (os) {
                try {
                  os.setConsentGiven(true);
                } catch {}
                // Tarayıcının KENDİ izin penceresi: dokunuş içinde ve
                // requestPermission() ile açılır. optIn() tek başına pencereyi
                // açmayabilir (o zaman "onaylamadım" deyip abone olunmuyordu).
                try {
                  const nb = os.Notifications;
                  if (
                    typeof Notification !== "undefined" &&
                    Notification.permission !== "granted" &&
                    nb &&
                    typeof nb.requestPermission === "function"
                  ) {
                    await Promise.race([
                      nb.requestPermission(),
                      new Promise((r) => setTimeout(() => r(false), 15000)),
                    ]);
                  }
                } catch {}
                await Promise.race([
                  os.User.PushSubscription.optIn(),
                  new Promise((r) => setTimeout(r, 8000)),
                ]);
                // Yalnızca tarayıcı izni yeterli DEĞİL: abonelik kimliği de
                // oluşmalı (yoksa bildirim hiç gelmez).
                const ps = os?.User?.PushSubscription;
                const idVar = ps && "id" in ps ? ps.id : undefined;
                oldu = Boolean(ps?.optedIn) && (idVar === undefined ? true : Boolean(idVar));
              }
            }
          } catch {}
          if (oldu) {
            btn.textContent = "Açıldı ✓";
            bildir("Bildirimler açıldı — son dakika haberleri cebine gelecek.");
            setTimeout(() => {
              kutu.hidden = true;
            }, 2200);
          } else {
            btn.textContent = "Bildirimleri aç";
            const api = window.HaberinaiPush;
            const izinVarMi = api?.izinVerildi?.() ?? izinVar();
            const engelli = api?.izinEngelli?.() === true;
            // İzin verilmiş ama abonelik kurulmadıysa istemi KAPATMA: okuyucu
            // (örneğin "Ana Ekrana Ekle"den sonra) yeniden deneyebilsin.
            if (!izinVarMi) {
              try {
                localStorage.setItem(K_KAPALI, "1");
              } catch {}
            }
            bildir(
              engelli
                ? "Bildirim izni kapalı: tarayıcı simgesi → İzinler → Bildirimler → İzin ver."
                : izinVarMi
                  ? "İzin var ama abonelik kurulamadı. Sayfayı yenileyip tekrar dene."
                  : "Bildirim izni verilmedi. Tarayıcı ayarlarından açabilirsin."
            );
            setTimeout(() => {
              kutu.hidden = true;
            }, 2200);
          }
        });
      })();
    })();
  </script>
