---
// Haber gövdesi içindeki fotoğraf figürü.
//
// Görsel telif güvenli stok hattından geliyorsa (`kaynak` dolu) lisansın
// istediği atıf verilir. Atıf artık fotoğrafın ALTINDA uzun bir satır değil,
// sağ alt köşedeki küçük "i" rozetinde: dokununca/hover'da fotoğrafçı + lisans
// görünür, tıklayınca Commons dosya sayfası açılır. Ekran okuyucular ve metin
// tarayıcılar için tam atıf DOM'da (sr-only) durmaya devam eder.
import { imageUrl, imageSrcset } from "../lib/articles.js";

const { url, baslik, kaynak, eskiKaynak } = Astro.props;

const lisansAdresi = (g) => {
  if (!g) return "";
  if (g.lisansUrl) return g.lisansUrl;
  const m = /^CC BY(-SA)? (\d\.\d)$/i.exec(String(g.lisans || ""));
  return m ? `https://creativecommons.org/licenses/${m[1] ? "by-sa" : "by"}/${m[2]}/` : "";
};
const lisansLink = kaynak ? lisansAdresi(kaynak) : "";

const atif = kaynak
  ? `Fotoğraf: ${kaynak.yazar || "Wikimedia Commons"}${kaynak.lisans ? ` · ${kaynak.lisans}` : ""} · Wikimedia Commons`
  : `Fotoğraf: ${eskiKaynak || "HaberinAi"}`;
const atifAdres = kaynak?.sayfa || url;
---

<figure class="content__fig">
  <div class="content__fig-kap">
    <a
      class="content__fig-link"
      href={url}
      target="_blank"
      rel="noopener nofollow"
      title="Fotoğrafı büyüt"
    >
      <img
        class="content__fig-img"
        src={imageUrl(url, 1000)}
        srcset={imageSrcset(url, [640, 1000]) || undefined}
        sizes="(max-width: 900px) 100vw, 800px"
        data-orig={url}
        alt={`${baslik} — haber fotoğrafı`}
        width="1000"
        height="563"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="if(this.dataset.orig&&!this.dataset.f){this.dataset.f='1';this.removeAttribute('srcset');this.removeAttribute('sizes');this.src=this.dataset.orig}else{this.closest('figure').remove()}"
      />
    </a>
    <a
      class="content__fig-credit"
      href={atifAdres}
      target="_blank"
      rel="noopener nofollow"
      title={atif}
      aria-label={`${atif}. Wikimedia Commons dosya sayfasını aç`}
    >
      <span aria-hidden="true">i</span>
    </a>
  </div>

  <figcaption class="sr-only">
    {atif}
    {kaynak?.lisans && lisansLink && <a href={lisansLink} target="_blank" rel="noopener nofollow">{kaynak.lisans}</a>}
    {kaynak?.sayfa && (
      <>
        {" · "}
        <a href={kaynak.sayfa} target="_blank" rel="noopener nofollow">Wikimedia Commons</a>
      </>
    )}
  </figcaption>
</figure>

<style>
  /* Stiller BURADA durmak zorunda: [slug].astro'daki kapsamlı (scoped) CSS bu
     bileşenin içindeki öğelere uygulanmaz. Daha önce orada tanımlıydı ve hiç
     eşleşmiyordu; görsel, HTML'deki height="563" özniteliği yüzünden telefonda
     263x563 gibi ezilmiş (oranı bozuk) görünüyordu. */
  .content__fig {
    margin: 30px 0;
    max-width: 75ch;
  }
  .content__fig-kap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: 0 10px 26px -12px rgba(15, 23, 42, 0.35);
  }
  .content__fig-link {
    display: block;
  }
  .content__fig-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 78vh;
    object-fit: cover;
    transition: transform 0.5s var(--ease, ease);
  }
  .content__fig-link:hover .content__fig-img {
    transform: scale(1.03);
  }
  /* Atıf rozeti: fotoğrafçı + lisans title'da, tıklayınca Commons sayfası. */
  .content__fig-credit {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: rgba(12, 15, 20, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.92);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.82rem;
    font-style: italic;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.18s var(--ease, ease), background 0.18s var(--ease, ease);
  }
  .content__fig-credit:hover,
  .content__fig-credit:focus-visible {
    opacity: 1;
    background: rgba(12, 15, 20, 0.78);
  }
</style>
