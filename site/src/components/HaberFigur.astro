---
// Haber gövdesi içindeki fotoğraf figürü.
//
// Stok fotoğrafta (`kaynak` dolu) lisansın istediği atıf görünür biçimde
// fotoğrafın altında verilir: fotoğrafçı · lisans · Wikimedia Commons.
// Görsele tıklamak stokta Commons dosya sayfasını, haberin kendi kaynak
// fotoğrafında ise büyük hâli açar.
import { imageUrl, imageSrcset } from "../lib/articles.js";

const { url, baslik, kaynak, eskiKaynak, altyazi, alt } = Astro.props;

const lisansAdresi = (g) => {
  if (!g) return "";
  if (g.lisansUrl) return g.lisansUrl;
  const m = /^CC BY(-SA)? (\d\.\d)$/i.exec(String(g.lisans || ""));
  return m ? `https://creativecommons.org/licenses/${m[1] ? "by-sa" : "by"}/${m[2]}/` : "";
};
const lisansLink = kaynak ? lisansAdresi(kaynak) : "";

// Stokta kaynak sayfa (Commons) daha bilgilendirici; kaynak fotoğrafta dosya.
const gorselAdres = (kaynak && kaynak.sayfa) || url;
const gorselBaslik = kaynak?.sayfa ? "Fotoğraf kaynağını aç" : "Fotoğrafı büyüt";
---

<figure class="content__fig">
  <div class="content__fig-kap">
    <a
      class="content__fig-link"
      href={gorselAdres}
      target="_blank"
      rel="noopener nofollow"
      title={gorselBaslik}
    >
      <img
        class="content__fig-img"
        src={imageUrl(url, 1000)}
        srcset={imageSrcset(url, [640, 1000]) || undefined}
        sizes="(max-width: 900px) 100vw, 800px"
        data-orig={url}
        alt={alt || `${baslik} — haber fotoğrafı`}
        width="1000"
        height="563"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="if(this.dataset.orig&&!this.dataset.f){this.dataset.f='1';this.removeAttribute('srcset');this.removeAttribute('sizes');this.src=this.dataset.orig}else{this.closest('figure').remove()}"
      />
    </a>
  </div>

  {(altyazi || kaynak) && (
    <figcaption class="content__fig-caption">
      {altyazi && <span class="content__fig-aciklama">{altyazi}</span>}
      {kaynak && (
        <span class="content__fig-credit">
          Fotoğraf: {kaynak.yazar || "Wikimedia Commons"}
          {kaynak.lisans && (
            <>
              {" · "}
              {lisansLink ? (
                <a href={lisansLink} target="_blank" rel="noopener nofollow">{kaynak.lisans}</a>
              ) : (
                kaynak.lisans
              )}
            </>
          )}
          {kaynak.sayfa && (
            <>
              {" · "}
              <a href={kaynak.sayfa} target="_blank" rel="noopener nofollow">Wikimedia Commons</a>
            </>
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>

<style>
  /* Stiller BURADA durmak zorunda: [slug].astro'daki kapsamlı (scoped) CSS bu
     bileşenin içindeki öğelere uygulanmaz. */
  .content__fig {
    margin: 32px 0;
    max-width: 75ch;
  }
  .content__fig-kap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: 0 10px 26px -12px rgba(15, 23, 42, 0.35);
  }
  .content__fig-link {
    display: block;
  }
  .content__fig-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 78vh;
    object-fit: cover;
    transition: transform 0.5s var(--ease, ease);
  }
  .content__fig-link:hover .content__fig-img {
    transform: scale(1.02);
  }
  .content__fig-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    padding: 0 4px;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
    text-align: left;
  }
  .content__fig-aciklama {
    font-style: italic;
  }
  .content__fig-credit {
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }
  .content__fig-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .content__fig-credit a:hover {
    color: var(--text);
  }
</style>
