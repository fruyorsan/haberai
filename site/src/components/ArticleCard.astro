---
import { timeAgo, publishedISO } from "../lib/articles.js";

const { article, size = "normal", index = 0, reveal = true } = Astro.props;
const when = timeAgo(publishedISO(article));

const words = `${article.summary || ""} ${article.comment || ""}`.split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

// ShiftDelete tarzı: daima gerçek haber fotoğrafı kullanılır.
const imgSrc = article.image || "/og-default.png";
const imgErr = "this.classList.add('is-broken');";

// Gecikmeli giriş animasyonu (en fazla 320ms)
const delay = Math.min(index * 45, 320);
---

<article
  class:list={["card", `card--${size}`]}
  data-reveal={reveal ? "" : undefined}
  style={reveal ? `transition-delay:${delay}ms` : undefined}
>
  <a class="card__link" href={article.url}>
    <div class="card__media">
      <div class="card__ph" aria-hidden="true">
        <span class="card__ph-mark">H</span>
        <span class="card__ph-cat">{article.category}</span>
      </div>
      <img
        class="card__img"
        src={imgSrc}
        alt={article.title}
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror={imgErr}
      />
      <div class="card__overlay" aria-hidden="true"></div>

      {article.breaking === true &&
      (article.publishedAt || article.generatedAt) &&
      (Date.now() - new Date(article.publishedAt || article.generatedAt).getTime()) <= 120 * 60 * 1000 ? (
        <span class="card__breaking">
          <span class="card__breaking-dot" aria-hidden="true"></span>
          SON DAKİKA
        </span>
      ) : (
        <span class="card__badge">{article.category}</span>
      )}

      {article.comment && (
        <span class="card__ai-badge" title="Yapay Zekâ Editör Analizli">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
          AI Analiz
        </span>
      )}
    </div>
    <div class="card__body">
      <h3 class="card__title">{article.title}</h3>
      <p class="card__summary">{article.summary}</p>
      <div class="card__meta">
        <span class="card__source">{article.source || "HaberinAi"}</span>
        <span class="card__dot">•</span>
        <span>{when}</span>
        <span class="card__dot">•</span>
        <span>{readMin} dk</span>
      </div>
    </div>
  </a>
</article>
