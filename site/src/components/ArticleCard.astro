---
import { timeAgo } from "../lib/articles.js";

const { article, size = "normal" } = Astro.props;
const when = timeAgo(article.publishedAt || article.generatedAt);
---

<article class:list={["card", `card--${size}`]}>
  <a class="card__link" href={article.url}>
    <div class="card__media">
      {article.image ? (
        <img src={article.image} alt={article.title} loading="lazy" />
      ) : (
        <div class="card__placeholder" aria-hidden="true"><span>H</span></div>
      )}
      <span class="card__badge">{article.category}</span>
    </div>
    <div class="card__body">
      <h3 class="card__title">{article.title}</h3>
      <p class="card__summary">{article.summary}</p>
      <div class="card__meta">
        <span class="card__source">{article.source}</span>
        <span class="card__dot">•</span>
        <span>{when}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
    height: 100%;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: #ddd;
  }
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .card:hover .card__media img {
    transform: scale(1.04);
  }
  .card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--red) 0%, var(--red-dark) 100%);
    color: #fff;
  }
  .card__placeholder span {
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.35);
  }
  .card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--red);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 4px 9px;
    border-radius: 6px;
  }
  .card__body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .card__title {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.35;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .card__summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__meta {
    margin-top: auto;
    padding-top: 10px;
    font-size: 0.8rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .card__source {
    color: var(--red);
    font-weight: 700;
  }

  .card--large .card__title {
    font-size: 1.5rem;
  }
  .card--large .card__summary {
    font-size: 0.98rem;
    -webkit-line-clamp: 4;
  }
  .card--wide {
    grid-column: span 2;
  }
  .card--wide .card__link {
    flex-direction: row;
  }
  .card--wide .card__media {
    width: 46%;
    aspect-ratio: auto;
  }
  @media (max-width: 640px) {
    .card--wide .card__link {
      flex-direction: column;
    }
    .card--wide .card__media {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
