---
import { timeAgo, publishedISO } from "../lib/articles.js";

const { article, size = "normal", index = 0, reveal = true } = Astro.props;
const when = timeAgo(publishedISO(article));

const words = `${article.summary || ""} ${article.comment || ""}`.split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

// Gecikmeli giriş animasyonu (en fazla 320ms)
const delay = Math.min(index * 45, 320);
---

<article
  class:list={["card", `card--${size}`]}
  data-reveal={reveal ? "" : undefined}
  style={reveal ? `transition-delay:${delay}ms` : undefined}
>
  <a class="card__link" href={article.url}>
    <div class="card__media">
      <div class="card__ph" aria-hidden="true">
        <span class="card__ph-mark">H</span>
        <span class="card__ph-cat">{article.category}</span>
      </div>
      <span class="card__badge">{article.category}</span>
    </div>
    <div class="card__body">
      <h3 class="card__title">{article.title}</h3>
      <p class="card__summary">{article.summary}</p>
      <div class="card__meta">
        <span class="card__source">{article.source}</span>
        <span class="card__dot">•</span>
        <span>{when}</span>
        <span class="card__dot">•</span>
        <span>{readMin} dk</span>
      </div>
    </div>
  </a>
</article>
