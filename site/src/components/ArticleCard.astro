---
import { timeAgo, publishedISO, imageUrl, imageSrcset } from "../lib/articles.js";
import { ilgiSkoru, ilgiRozetEsik, kategoriAgirlik } from "../lib/ilgi.js";
import { kapakKaynagi } from "../lib/kapak.js";

const { article, size = "normal", index = 0, reveal = true } = Astro.props;
const when = timeAgo(publishedISO(article));

const words = `${article.summary || ""} ${article.comment || ""}`.split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

// Kartta fotoğraf ~380 px genişlikte görünür; kaynak fotoğraf çoğu zaman
// 300 KB - 1,5 MB geliyor. Görsel CDN'inden geçirilip küçültülür + WebP olur;
// CDN erişilemezse `data-orig` ile kaynak adrese düşer.
// Kapak seçimi lib/kapak.js'ten geçer: kaynağın yanlış/genel görseli gösterilmez.
const kapak = kapakKaynagi(article);
// Kapak fotoğrafı doğrulanamıyorsa hiç fotoğraf konmaz: kartın kendi kırmızı
// zemini + "H" işareti görünür. Böylece onlarca kartta aynı yedek görseli
// tekrarlamak yerine kategoriye göre değişen temiz bir zemin kalır.
const imgSrc = kapak ? imageUrl(kapak, 640) : "";
const imgSet = kapak ? imageSrcset(kapak, [400, 640]) : "";
// "Son dakika" rozeti yalnızca taze kırılma haberlerinde görünür.
const yakinSonDakika =
  article.breaking === true &&
  Boolean(article.publishedAt || article.generatedAt) &&
  Date.now() - new Date(article.publishedAt || article.generatedAt).getTime() <= 120 * 60 * 1000;
// 🔥 İlgi rozeti (lib/ilgi.js): yalnızca "beklenmedik" haberlerde gösterilir.
// Kategori zaten ilgi çekiciyse (teknoloji/oyun/yapay zekâ) rozet anlam
// taşımaz — o sayfadaki her kartı işaretler. Rozet, rutin kategorilerden
// (gündem, spor, ekonomi, dünya) sıyrılan haberleri görünür kılar.
const ilgiRozetli =
  ilgiSkoru(article) >= ilgiRozetEsik() && kategoriAgirlik(article.categorySlug) < 20;
const imgErr =
  "if(this.dataset.orig&&!this.dataset.f){this.dataset.f='1';this.removeAttribute('srcset');this.removeAttribute('sizes');this.src=this.dataset.orig}else{this.classList.add('is-broken')}";

// Gecikmeli giriş animasyonu (en fazla 320ms)
const delay = Math.min(index * 45, 320);
---

<article
  class:list={["card", `card--${size}`, !kapak && "card--nofoto"]}
  data-kat={article.categorySlug}
  data-reveal={reveal ? "" : undefined}
  style={reveal ? `transition-delay:${delay}ms` : undefined}
>
  <a class="card__link" href={article.url}>
    <div class="card__media">
      <div class="card__ph" aria-hidden="true">
        <span class="card__ph-mark">H</span>
        <span class="card__ph-cat">{article.category}</span>
      </div>
      {kapak && (
        <img
          class="card__img"
          src={imgSrc}
          srcset={imgSet || undefined}
          sizes="(max-width: 600px) 96vw, (max-width: 1000px) 48vw, 380px"
          data-orig={kapak}
          alt={article.title}
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror={imgErr}
        />
      )}
      <div class="card__overlay" aria-hidden="true"></div>

      {yakinSonDakika ? (
        <span class="card__breaking">
          <span class="card__breaking-dot" aria-hidden="true"></span>
          SON DAKİKA
        </span>
      ) : (
        <span class="card__badge">{article.category}</span>
      )}

      {/* İlgi rozeti: yalnızca "son dakika" rozeti yokken (aynı köşeyi paylaşır). */}
      {ilgiRozetli && !yakinSonDakika && (
        <span class="card__fire" role="img" aria-label="İlgi çekici haber" title="İlgi çekici">
          🔥
        </span>
      )}

    </div>
    <div class="card__body">
      <h2 class="card__title">{article.title}</h2>
      <p class="card__summary">{article.summary}</p>
      <div class="card__meta">
        <span>{when}</span>
        <span class="card__dot">•</span>
        <span>{readMin} dk okuma</span>
      </div>
    </div>
  </a>
</article>
