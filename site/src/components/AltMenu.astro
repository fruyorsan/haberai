---
// ==========================================================================
// Alt menü — yalnızca telefonda görünen sabit alt gezinme çubuğu
// --------------------------------------------------------------------------
// Amaç: site telefondan "uygulama" gibi kullanılsın. Shorts Haber merkezde ve
// yükseltilmiş (marka gradyanı) durur; asıl çekim noktası orasıdır.
// Masaüstünde hiç basılmaz (CSS ile gizlenir), okuma alanını kapatmaz.
// ==========================================================================
const path = Astro.url.pathname;
const aktif = (href) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));

const menu = [
  { href: "/", label: "Anasayfa", ikon: "ev" },
  { href: "/akis/", label: "Shorts", ikon: "akis", vitrin: true },
  { href: "/son-dakika/", label: "Son Dakika", ikon: "canli" },
  { href: "/piyasa/", label: "Piyasa", ikon: "grafik" },
  { href: "/ara/", label: "Ara", ikon: "ara" },
];
---

<nav class="altmenu" aria-label="Hızlı menü">
  {
    menu.map((a) => (
      <a
        href={a.href}
        class:list={[
          "altmenu__a",
          { "is-active": aktif(a.href), "altmenu__a--vitrin": a.vitrin },
        ]}
        aria-current={aktif(a.href) ? "page" : undefined}
      >
        <span class="altmenu__simge" aria-hidden="true">
          {a.ikon === "ev" && (
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 10.6 12 3l9 7.6" />
              <path d="M5 9.8V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.8" />
            </svg>
          )}
          {a.ikon === "akis" && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M13.6 2 4.9 13.4c-.3.4 0 .9.5.9h4.9l-1 7.2c-.1.6.7.9 1 .4l8.8-11.5c.3-.4 0-.9-.5-.9h-4.9l1-7.1c.1-.6-.7-.9-1.1-.4z" />
            </svg>
          )}
          {a.ikon === "canli" && (
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="12" cy="12" r="8.6" />
              <circle cx="12" cy="12" r="3.4" fill="currentColor" stroke="none" />
            </svg>
          )}
          {a.ikon === "grafik" && (
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
              <path d="M3.5 20.5h17" />
              <path d="M7 17V9.5M12 17V5M17 17v-4.5" />
            </svg>
          )}
          {a.ikon === "ara" && (
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.3-3.3" />
            </svg>
          )}
        </span>
        <span class="altmenu__yazi">{a.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .altmenu {
    display: none;
  }

  /* Yalnızca telefon: sabit alt çubuk. */
  @media (max-width: 720px) {
    .altmenu {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      align-items: end;
      gap: 2px;
      padding: 6px 6px calc(6px + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, var(--surface) 92%, transparent);
      backdrop-filter: saturate(160%) blur(16px);
      -webkit-backdrop-filter: saturate(160%) blur(16px);
      border-top: 1px solid var(--border);
    }
    .altmenu__a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 3px;
      min-height: 48px;
      padding: 4px 2px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      transition: color 0.18s var(--ease), background 0.18s var(--ease);
    }
    .altmenu__a:active {
      background: var(--brand-soft);
    }
    .altmenu__a.is-active {
      color: var(--brand);
    }
    .altmenu__simge {
      display: grid;
      place-items: center;
      height: 26px;
    }
    .altmenu__yazi {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* Akış: çekim noktası — yükseltilmiş marka daireli düğme.
       Nabız atan halka + köşedeki canlı noktası: "şu an yayında" hissi. */
    .altmenu__a--vitrin .altmenu__simge {
      position: relative;
      width: 46px;
      height: 46px;
      margin-top: -18px;
      border-radius: 999px;
      background: var(--brand-grad);
      color: #fff;
      box-shadow: 0 12px 26px -10px var(--brand-glow);
      border: 3px solid var(--surface);
    }
    .altmenu__a--vitrin .altmenu__simge::after {
      content: "";
      position: absolute;
      inset: -3px;
      border-radius: 999px;
      border: 2px solid var(--brand);
      animation: altmenuNabiz 2.4s var(--ease) infinite;
      pointer-events: none;
    }
    .altmenu__a--vitrin .altmenu__simge::before {
      content: "";
      position: absolute;
      top: -2px;
      right: -2px;
      width: 11px;
      height: 11px;
      border-radius: 999px;
      background: #ff4040;
      border: 2px solid var(--surface);
      z-index: 1;
      pointer-events: none;
    }
    @keyframes altmenuNabiz {
      0% {
        transform: scale(1);
        opacity: 0.9;
      }
      70% {
        transform: scale(1.34);
        opacity: 0;
      }
      100% {
        transform: scale(1.34);
        opacity: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .altmenu__a--vitrin .altmenu__simge::after {
        animation: none;
        opacity: 0.5;
      }
    }
    .altmenu__a--vitrin {
      color: var(--brand);
      font-weight: 800;
    }
    .altmenu__a--vitrin.is-active {
      color: var(--brand);
    }
    .altmenu__a--vitrin:active .altmenu__simge {
      transform: scale(0.94);
    }
  }
</style>
