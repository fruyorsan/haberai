---
import Header from "../components/Header.astro";
import CategoryBar from "../components/CategoryBar.astro";
import Footer from "../components/Footer.astro";
import {
  ADSENSE_CLIENT,
  GA_MEASUREMENT_ID,
  GOOGLE_SITE_VERIFICATIONS,
  ONESIGNAL_APP_ID,
} from "../lib/site-meta.js";
import "../styles/global.css";

const {
  title = "HaberinAi — Yapay Zekâ Destekli Haberler",
  description = "Yapay zekâ destekli teknoloji haberleri: özetler, analizler ve editör yorumları.",
  canonical,
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  imageAlt,
  schema,
  preloadImage,
  noindex = false,
} = Astro.props;

// Mutlak URL tabanı (astro.config.mjs -> site)
const site = Astro.site ?? new URL("https://fruyorsan.github.io");

// Görsel/URL çözümleme: mutlak http(s) ise aynen, göreli ise site köküne göre mutlaklaştır.
function absoluteUrl(value) {
  if (!value) return "";
  const str = String(value).trim();
  if (!str) return "";
  if (/^https?:\/\//i.test(str)) return str;
  try {
    return new URL(str, site).href;
  } catch {
    return str;
  }
}

// canonical: verilen değer ya da mevcut sayfanın yolu
const canonicalUrl = absoluteUrl(canonical || Astro.url.pathname);

// og:image: haberin kendi görseli -> yoksa markalı yedek
const DEFAULT_OG_IMAGE = new URL("og-default.png", site).href;
const ogImage = image ? absoluteUrl(image) : DEFAULT_OG_IMAGE;
const ogImageAlt = imageAlt || title;

const tagList = Array.isArray(tags) ? tags.filter(Boolean) : [];
const isArticle = ogType === "article";
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {GOOGLE_SITE_VERIFICATIONS.map((code) => (
      <meta name="google-site-verification" content={code} />
    ))}
    {/* İnce/arama sayfaları noindex; geri kalanı Discover/News için tam izinli */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="HaberinAi" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {isArticle && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {isArticle && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {isArticle && section && <meta property="article:section" content={section} />}
    {isArticle && tagList.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#d81f26" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0d11" />
    <meta name="color-scheme" content="light dark" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="HaberinAi RSS" href="/rss.xml" />

    <!-- Tema (FOUC önleyici): Kullanıcının sistem temasına (Dark / Light) göre anında başlat -->
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          // Eski kalıcı localStorage kaydını temizle (sistem tercihini ezmesini önler)
          try { localStorage.removeItem("theme"); } catch (e) {}
          var sessionTheme = null;
          try {
            sessionTheme = sessionStorage.getItem("theme");
          } catch (e) {}
          var systemDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          // Kullanıcı mevcut sekmede elle butonla değiştirmediyse DOĞRUDAN sistemine göre başlat
          var theme =
            sessionTheme === "dark" || sessionTheme === "light"
              ? sessionTheme
              : systemDark
                ? "dark"
                : "light";
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>

    <!-- Yazı tipi ve harici kaynaklar: preconnect & dns-prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    {GA_MEASUREMENT_ID && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}

    <!-- LCP Önceliği: Ana görseli (hero) derhal ön yükle -->
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={absoluteUrl(preloadImage)}
        fetchpriority="high"
      />
    )}

    <!-- Yazı tipi: render-blocking olmayan asenkron yükleme (display=swap ile sistem fontu anında açılır) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
      />
    </noscript>

    <!-- JS açık işareti (animasyonlar için; JS kapalıysa içerik görünür kalır) -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <!-- Çerez izni: Google Consent Mode v2.
         Etiketler kaynakta her zaman bulunur (AdSense/Search Console doğrulaması görmeli),
         ancak kullanıcı "Kabul et" diyene kadar depolama "denied" kalır. -->
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }
window.gtag = window.gtag || gtag;
(function () {
  var onay = null;
  try { onay = localStorage.getItem("cerez-onay"); } catch (e) {}
  var verildi = onay === "kabul" ? "granted" : "denied";
  gtag("consent", "default", {
    ad_storage: verildi,
    ad_user_data: verildi,
    ad_personalization: verildi,
    analytics_storage: verildi,
    wait_for_update: 500
  });
})();
window.__olcumOnayla = function () {
  gtag("consent", "update", {
    ad_storage: "granted",
    ad_user_data: "granted",
    ad_personalization: "granted",
    analytics_storage: "granted"
  });
};`}
    />

    <!-- Google tag (gtag.js) -->
    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} is:inline></script>
        <script
          is:inline
          set:html={`gtag("js", new Date());
gtag("config", ${JSON.stringify(GA_MEASUREMENT_ID)}, { anonymize_ip: true });`}
        />
      </>
    )}

    <!-- AdSense: kimlik tanımlıysa (onay öncesi reklamlar kişiselleştirilmez) -->
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
        is:inline></script>
    )}

    <!-- Web push (OneSignal) — dokümandaki standart SDK kurulumu
         (https://documentation.onesignal.com/docs/en/web-sdk-setup):
           - SDK <head>'de yüklenir ve App ID ile init edilir.
           - Service worker: /OneSignalSDKWorker.js (site/public kökünde).
           - Tarayıcı izin penceresi kendiliğinden AÇILMAZ (slidedown kapalı);
             yalnızca zil ya da "kategoriyi takip et" düğmesine basılınca istenir.
           - Gizlilik: setConsentRequired(true) → okuyucu izin verene kadar veri
             toplanmaz; izin verildiğinde Bildirim.astro setConsentGiven(true) der. -->
    {ONESIGNAL_APP_ID && (
      <>
        <link rel="preconnect" href="https://cdn.onesignal.com" />
        <script
          src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"
          defer
          is:inline></script>
        <script
          is:inline
          set:html={`window.OneSignalDeferred = window.OneSignalDeferred || [];
window.HaberinaiOS = window.HaberinaiOS || {};
window.HaberinaiOS.hazir = new Promise(function (coz) { window.HaberinaiOS._coz = coz; });
OneSignalDeferred.push(async function (OneSignal) {
  try {
    await OneSignal.init({
      appId: ${JSON.stringify(ONESIGNAL_APP_ID)},
      serviceWorkerPath: "/OneSignalSDKWorker.js",
      serviceWorkerParam: { scope: "/" },
      allowLocalhostAsSecureOrigin: /^(localhost|127\\.0\\.0\\.1)$/.test(location.hostname),
      notifyButton: { enable: false },
      promptOptions: { slidedown: { enabled: false } }
    });
  } catch (e) {
    window.HaberinaiOS._coz(null);
    return;
  }
  try {
    OneSignal.setConsentRequired(true);
    var izinli =
      (typeof Notification !== "undefined" && Notification.permission === "granted") ||
      localStorage.getItem("bildirim-abone") === "true";
    if (izinli) OneSignal.setConsentGiven(true);
  } catch (e) {}
  window.HaberinaiOS._coz(OneSignal);
});
`}
        />
      </>
    )}

    <!-- Sayfaya ozel JSON-LD (WebSite/Organization vb.) -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />
    <CategoryBar />
    <main>
      <slot />
    </main>
    <Footer />

    <button class="to-top" id="to-top" type="button" aria-label="Sayfanın başına dön" title="Yukarı çık">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="M5 12l7-7 7 7" />
      </svg>
    </button>

    <script>
      // --- Kaydırdıkça ortaya çıkma ---
      const revealEls = Array.from(document.querySelectorAll("[data-reveal]"));
      if (revealEls.length) {
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-in");
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: "0px 0px 50px 0px", threshold: 0.01 }
          );
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add("is-in"));
        }
      }

      // --- Yukarı çık butonu (rAF ile akıcı kaydırma) ---
      const toTop = document.getElementById("to-top");
      if (toTop) {
        let ticking = false;
        const syncTopButton = () => {
          toTop.classList.toggle("is-visible", window.scrollY > 700);
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(syncTopButton);
            ticking = true;
          }
        };
        syncTopButton();
        window.addEventListener("scroll", onScroll, { passive: true });
        toTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // --- Tema: sistem tercihi değişirse (kullanıcı seçim yapmadıysa) uygula ---
      if (window.matchMedia) {
        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        const applyTheme = (theme) => {
          const root = document.documentElement;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        };
        const onSystemTheme = (e) => {
          let sessionTheme = null;
          try {
            sessionTheme = sessionStorage.getItem("theme");
          } catch (_) {}
          // Kullanıcı bu sekmede açıkça elle butonla değiştirmediyse sistem değişimine uy
          if (sessionTheme === "dark" || sessionTheme === "light") return;
          applyTheme(e.matches ? "dark" : "light");
        };
        if (mq.addEventListener) mq.addEventListener("change", onSystemTheme);
        else if (mq.addListener) mq.addListener(onSystemTheme);
      }
    </script>
    <!-- Çerez izni (KVKK/GDPR): onay verilene kadar GA/AdSense yüklenmez -->
    <div class="cerez" id="cerez" hidden>
      <div class="cerez__ic">
        <p>
          Sitede ölçüm ve (yayına girdiğinde) reklam için çerez kullanılıyor. Ayrıntılar:
          <a href="/gizlilik/">Gizlilik ve Çerez Politikası</a>
        </p>
        <div class="cerez__btn">
          <button type="button" data-cerez="red">Sadece zorunlu</button>
          <button type="button" class="cerez__kabul" data-cerez="kabul">Kabul et</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var kutu = document.getElementById("cerez");
        if (!kutu) return;
        var oku = function () {
          try { return localStorage.getItem("cerez-onay"); } catch (e) { return null; }
        };
        if (!oku()) {
          kutu.hidden = false;
          document.documentElement.classList.add("cerez-acik");
        }
        kutu.addEventListener("click", function (e) {
          var b = e.target && e.target.closest ? e.target.closest("[data-cerez]") : null;
          if (!b) return;
          var secim = b.getAttribute("data-cerez");
          try { localStorage.setItem("cerez-onay", secim); } catch (err) {}
          kutu.hidden = true;
          document.documentElement.classList.remove("cerez-acik");
          if (secim === "kabul" && window.__olcumOnayla) window.__olcumOnayla();
        });
      })();
    </script>

    <style>
      .cerez {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 60;
        background: var(--surface);
        border-top: 1px solid var(--border);
        box-shadow: var(--shadow-lg);
        padding: 12px 16px;
      }
      .cerez[hidden] {
        display: none;
      }
      .cerez__ic {
        max-width: var(--maxw);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px 18px;
        flex-wrap: wrap;
      }
      .cerez p {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text);
      }
      .cerez a {
        color: var(--brand);
        font-weight: 600;
      }
      .cerez__btn {
        display: flex;
        gap: 8px;
        margin-left: auto;
      }
      .cerez button {
        border: 1px solid var(--border-strong);
        background: var(--surface);
        color: var(--text);
        border-radius: 999px;
        padding: 8px 16px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      .cerez__kabul {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
      }
      .cerez__kabul:hover {
        background: var(--brand-strong);
        border-color: var(--brand-strong);
      }
    </style>
  </body>
</html>
