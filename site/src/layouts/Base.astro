---
import Header from "../components/Header.astro";
import CategoryBar from "../components/CategoryBar.astro";
import Footer from "../components/Footer.astro";
import AltMenu from "../components/AltMenu.astro";
import {
  ADSENSE_CLIENT,
  GA_MEASUREMENT_ID,
  GOOGLE_SITE_VERIFICATIONS,
  HESAP,
  KATEGORILER,
  AVATARLAR,
  ONESIGNAL_APP_ID,
} from "../lib/site-meta.js";
import "../styles/global.css";

const {
  title = "HaberinAi — Yapay Zekâ Destekli Haberler",
  description = "Yapay zekâ destekli teknoloji haberleri: özetler, analizler ve editör yorumları.",
  canonical,
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  imageAlt,
  schema,
  preloadImage,
  // LCP görseli responsive ise ön yüklemede de aynı küme verilir; aksi halde
  // tarayıcı iki ayrı fotoğraf indirir (biri kullanılmaz).
  preloadSrcset,
  preloadSizes,
  noindex = false,
  // Akış sayfaları kendi kategori şeridini taşır; üstteki global şerit
  // kapatılır ki iki benzer satır üst üste görünmesin.
  kategoriSeridi = true,
} = Astro.props;

// Mutlak URL tabanı (astro.config.mjs -> site)
const site = Astro.site ?? new URL("https://fruyorsan.github.io");

// Görsel/URL çözümleme: mutlak http(s) ise aynen, göreli ise site köküne göre mutlaklaştır.
function absoluteUrl(value) {
  if (!value) return "";
  const str = String(value).trim();
  if (!str) return "";
  if (/^https?:\/\//i.test(str)) return str;
  try {
    return new URL(str, site).href;
  } catch {
    return str;
  }
}

// canonical: verilen değer ya da mevcut sayfanın yolu
const canonicalUrl = absoluteUrl(canonical || Astro.url.pathname);

// og:image: haberin kendi görseli -> yoksa markalı yedek
const DEFAULT_OG_IMAGE = new URL("og-default.png", site).href;
const ogImage = image ? absoluteUrl(image) : DEFAULT_OG_IMAGE;
const ogImageAlt = imageAlt || title;

const tagList = Array.isArray(tags) ? tags.filter(Boolean) : [];
const isArticle = ogType === "article";

// Güvenlik: İçerik Güvenliği Politikası (CSP).
//
// GitHub Pages özel HTTP başlığı göndermediği için politika <meta> ile
// uygulanır. Yalnızca gerçekten kullandığımız kaynaklara izin veriyoruz:
//   * kendi dosyalarımız,
//   * Google (gtag/Analytics, AdSense ve reklam iframe'leri),
//   * OneSignal (web push SDK + API),
//   * Supabase (yorum/hesap),
//   * Google Fonts.
// Satır içi betik ve stiller site genelinde yoğun kullanıldığı için
// 'unsafe-inline' gerekli; buna karşın bilinmeyen üçüncü taraf alan adlarından
// betik/çerçeve yüklenmesi engellenir (enjekte edilen yabancı kod çalışmaz).
// Not: frame-ancestors <meta> ile desteklenmez; tıklama hırsızlığına karşı
// asıl koruma barındırma sağlayıcısındaki başlıklardır.
const CSP = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://www.googletagmanager.com https://*.google-analytics.com https://cdn.onesignal.com https://*.onesignal.com https://*.adtrafficquality.google",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' data: https://fonts.gstatic.com",
  "img-src 'self' data: blob: https:",
  "media-src 'self' https:",
  "connect-src 'self' https://*.supabase.co https://api.onesignal.com https://*.onesignal.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google",
  "frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google",
  "worker-src 'self' blob:",
  "manifest-src 'self'",
  "form-action 'self' mailto:",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Güvenlik: CSP ve referrer politikası. GitHub Pages özel HTTP başlığı
         göndermediği için <meta> ile uygulanır (ayrıntı: üstteki CSP sabiti). -->
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {GOOGLE_SITE_VERIFICATIONS.map((code) => (
      <meta name="google-site-verification" content={code} />
    ))}
    {/* İnce/arama sayfaları noindex; geri kalanı Discover/News için tam izinli */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    )}
    {/* Google, arama sonuçlarında site logosunu (favicon) yalnızca 48px'in
        katı olan PNG/ICO adreslerden alır. SVG'yi de destekler ama en güvenilir
        yol PNG bildirmektir: marka ikonu arama sonuçlarında görünsün. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/ikon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/ikon-512.png" />
    <link rel="shortcut icon" href="/ikon-192.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="HaberinAi" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {isArticle && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {isArticle && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {isArticle && section && <meta property="article:section" content={section} />}
    {isArticle && tagList.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <!-- Telefonda "uygulama gibi": ana ekrana eklenince Shorts Haber ile açılır. -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="HaberinAi" />
    <link rel="apple-touch-icon" href="/ikon-192.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="HaberinAi RSS" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="HaberinAi JSON Feed" href="/feed.json" />
    <!-- Yapay zekâ asistanları için makine okunabilir site özeti (llms.txt). -->
    <link rel="alternate" type="text/markdown" title="HaberinAi — LLM özeti" href="/llms.txt" />

    <!-- Palet (FOUC önleyici): seçilen paleti ilk boyamadan önce uygula.
         Sıra: Bordo → Siyan → Beyaz. Varsayılan: Beyaz. -->
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var PALETLER = { bordo: 1, siyan: 1, beyaz: 1 };
          var palet = null;
          try {
            palet = localStorage.getItem("hb-palet");
          } catch (e) {}
          // Eski tema kayıtlarını bir kez devral, sonra temizle.
          if (!PALETLER[palet]) {
            try {
              var eski =
                sessionStorage.getItem("theme") || localStorage.getItem("theme");
              if (eski === "dark") palet = "bordo";
              else if (eski === "light") palet = "beyaz";
            } catch (e) {}
          }
          try {
            sessionStorage.removeItem("theme");
            localStorage.removeItem("theme");
          } catch (e) {}
          if (!PALETLER[palet]) palet = "beyaz";
          root.dataset.theme = palet;
          root.style.colorScheme = palet === "beyaz" ? "light" : "dark";
          // Tarayıcı çubuğu rengi de palete uysun (mobilde adres çubuğu).
          var RENKLER = { beyaz: "#ffffff", bordo: "#23060d", siyan: "#0b0d10" };
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", RENKLER[palet] || "#ffffff");
        } catch (e) {}
      })();
    </script>

    <!-- Yazı tipi ve harici kaynaklar: preconnect & dns-prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    {GA_MEASUREMENT_ID && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}

    <!-- LCP Önceliği: Ana görseli (hero) derhal ön yükle -->
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={absoluteUrl(preloadImage)}
        imagesrcset={preloadSrcset || undefined}
        imagesizes={preloadSizes || undefined}
        fetchpriority="high"
      />
    )}

    <!-- Yazı tipi: render-blocking olmayan asenkron yükleme (display=swap ile sistem fontu anında açılır) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
      />
    </noscript>

    <!-- JS açık işareti (animasyonlar için; JS kapalıysa içerik görünür kalır) -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <!-- Okuyucu hesabı (Supabase). Anahtar gizli değildir; güvenlik sunucu
         tarafındaki fonksiyon + RLS ile sağlanır (supabase/hesap.sql). -->
    {HESAP.url && HESAP.anahtar && (
      <script
        type="application/json"
        id="hb-ayar"
        set:html={JSON.stringify({ hesapUrl: HESAP.url, hesapAnahtar: HESAP.anahtar, kategoriler: KATEGORILER.map((k) => k.slug), avatarlar: AVATARLAR })}
      />
    )}
    <!-- Hesap betiği senkron yüklenir: sayfa içindeki satır içi betikler
         (profil, hesap, ana sayfa kişiselleştirme) window.HaberinAi'yi
         doğrudan kullanabilsin. Dosya public/ altındadır; Astro paketleyicisi
         onu olduğu gibi /hesap.js olarak yayınlar. -->
    <script is:inline src="/hesap.js"></script>

    <!-- Çerez izni: Google Consent Mode v2.
         Etiketler kaynakta her zaman bulunur (AdSense/Search Console doğrulaması görmeli),
         ancak kullanıcı "Kabul et" diyene kadar depolama "denied" kalır. -->
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }
window.gtag = window.gtag || gtag;
(function () {
  var onay = null;
  try { onay = localStorage.getItem("cerez-onay"); } catch (e) {}
  var verildi = onay === "kabul" ? "granted" : "denied";
  gtag("consent", "default", {
    ad_storage: verildi,
    ad_user_data: verildi,
    ad_personalization: verildi,
    analytics_storage: verildi,
    wait_for_update: 500
  });
})();
window.__olcumOnayla = function () {
  gtag("consent", "update", {
    ad_storage: "granted",
    ad_user_data: "granted",
    ad_personalization: "granted",
    analytics_storage: "granted"
  });
};`}
    />

    <!-- Google tag (gtag.js) — ERTELENMİŞ YÜKLEME
         gtag.js tek başına ~500 KB'lık bir indirmedir ve mobilde ilk boyama
         için yarışır. Bu yüzden yalnızca sayfa tamamen yüklendikten sonra
         (ya da okuyucu sayfayla etkileşince) indirilir. Consent Mode ve olay
         komutları kuyrukta bekler (dataLayer); betik geldiğinde işlenir.
         Not: Okuyucu 1,2 saniyeden kısa sürede çıkarsa o oturum ölçülmez —
         mobil hız/SEO kazanımı için bilinçli tercih. -->
    {GA_MEASUREMENT_ID && (
      <script
        is:inline
        set:html={`gtag("js", new Date());
gtag("config", ${JSON.stringify(GA_MEASUREMENT_ID)}, { anonymize_ip: true });
(function () {
  var geldi = false;
  function yukle() {
    if (geldi) return;
    geldi = true;
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + ${JSON.stringify(GA_MEASUREMENT_ID)};
    document.head.appendChild(s);
    window.removeEventListener("pointerdown", yukle);
    window.removeEventListener("keydown", yukle);
    window.removeEventListener("touchstart", yukle);
    window.removeEventListener("scroll", yukle);
  }
  window.addEventListener("pointerdown", yukle, { passive: true });
  window.addEventListener("keydown", yukle);
  window.addEventListener("touchstart", yukle, { passive: true });
  window.addEventListener("scroll", yukle, { passive: true });
  if (document.readyState === "complete") setTimeout(yukle, 1200);
  else window.addEventListener("load", function () { setTimeout(yukle, 1200); });
})();`}
      />
    )}

    <!-- AdSense: kimlik tanımlıysa (onay öncesi reklamlar kişiselleştirilmez) -->
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
        is:inline></script>
    )}

    <!-- Reklam engelleyici dayanıklılığı.
         AdSense betiği engellenirse (window.adsbygoogle.loaded hiç true olmaz)
         ya da birim dolmazsa (data-ad-status="unfilled") reklam kutusu
         tamamen gizlenir: boş kutu, kaydırma boşluğu ve düzen kayması olmaz.
         "Reklam engelleyicinizi kapatın" uyarısı BİLİNÇLİ olarak gösterilmez:
         AdSense politikasına aykırıdır ve okuyucu deneyimini bozar.
         Okuyucu için içerik her durumda kesintisiz açılır. -->
    {ADSENSE_CLIENT && (
      <script is:inline>
        (function () {
          var BASLANGIC = Date.now();
          function bak() {
            var alanlar = document.querySelectorAll(".ad");
            var gecti = Date.now() - BASLANGIC;
            for (var i = 0; i < alanlar.length; i++) {
              var alan = alanlar[i];
              var ins = alan.querySelector("ins.adsbygoogle");
              var durum = ins ? ins.getAttribute("data-ad-status") : null;
              var yuklendi =
                !!(window.adsbygoogle && window.adsbygoogle.loaded === true);
              if (durum === "filled") {
                alan.classList.remove("ad--bos");
              } else if (durum === "unfilled" || (!yuklendi && gecti > 6000)) {
                alan.classList.add("ad--bos");
              }
            }
          }
          function basla() {
            bak();
            [1500, 4000, 7000, 11000, 16000].forEach(function (ms) {
              window.setTimeout(bak, ms);
            });
          }
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", basla);
          } else {
            basla();
          }
        })();
      </script>
    )}

    <!-- Web push (OneSignal) — dokümandaki standart SDK kurulumu
         (https://documentation.onesignal.com/docs/en/web-sdk-setup):
           - SDK <head>'de yüklenir ve App ID ile init edilir.
           - Service worker: /OneSignalSDKWorker.js (site/public kökünde).
           - Tarayıcı izin penceresi kendiliğinden AÇILMAZ (slidedown kapalı);
             yalnızca zil ya da "kategoriyi takip et" düğmesine basılınca istenir.
           - Gizlilik: setConsentRequired(true) → okuyucu izin verene kadar veri
             toplanmaz; izin verildiğinde Bildirim.astro setConsentGiven(true) der. -->
    {ONESIGNAL_APP_ID && (
      <>
        <link rel="preconnect" href="https://cdn.onesignal.com" />
        <script
          src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"
          defer
          is:inline></script>
        <script
          is:inline
          set:html={`window.OneSignalDeferred = window.OneSignalDeferred || [];
window.HaberinaiOS = window.HaberinaiOS || {};
window.HaberinaiOS.hazir = new Promise(function (coz) { window.HaberinaiOS._coz = coz; });
OneSignalDeferred.push(async function (OneSignal) {
  try {
    await OneSignal.init({
      appId: ${JSON.stringify(ONESIGNAL_APP_ID)},
      serviceWorkerPath: "/OneSignalSDKWorker.js",
      serviceWorkerParam: { scope: "/" },
      allowLocalhostAsSecureOrigin: /^(localhost|127\\.0\\.0\\.1)$/.test(location.hostname),
      /* Tarayıcı verisi temizlenirse/cihaz değişirse abonelik kendini onarsın
         (OneSignal önerisi). Yalnızca daha önce abone olmuş okuyucuyu etkiler. */
      autoResubscribe: true,
      notifyButton: { enable: false },
      promptOptions: { slidedown: { enabled: false } }
    });
  } catch (e) {
    window.HaberinaiOS._coz(null);
    return;
  }
  try {
    OneSignal.setConsentRequired(true);
    var izinli =
      (typeof Notification !== "undefined" && Notification.permission === "granted") ||
      localStorage.getItem("bildirim-abone") === "true";
    if (izinli) OneSignal.setConsentGiven(true);
  } catch (e) {}
  window.HaberinaiOS._coz(OneSignal);
});
`}
        />
      </>
    )}

    <!-- Sayfaya ozel JSON-LD (WebSite/Organization vb.) -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header />
    {kategoriSeridi && <CategoryBar />}
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Telefon: sabit alt gezinme (Shorts Haber merkezde). Masaüstünde gizli. -->
    <AltMenu />

    <button class="to-top" id="to-top" type="button" aria-label="Sayfanın başına dön" title="Yukarı çık">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="M5 12l7-7 7 7" />
      </svg>
    </button>

    <script>
      // --- Kaydırdıkça ortaya çıkma ---
      const revealEls = Array.from(document.querySelectorAll("[data-reveal]"));
      if (revealEls.length) {
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-in");
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: "0px 0px 50px 0px", threshold: 0.01 }
          );
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add("is-in"));
        }
      }

      // --- Yukarı çık butonu (rAF ile akıcı kaydırma) ---
      const toTop = document.getElementById("to-top");
      if (toTop) {
        let ticking = false;
        const syncTopButton = () => {
          toTop.classList.toggle("is-visible", window.scrollY > 700);
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(syncTopButton);
            ticking = true;
          }
        };
        syncTopButton();
        window.addEventListener("scroll", onScroll, { passive: true });
        toTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // Palet artık kullanıcının seçimine bağlıdır (Bordo · Siyan · Beyaz).
      // Sistem koyu modu tercihi bilerek yok sayılır: varsayılan Beyaz'dır.
    </script>
    <!-- Çerez izni (KVKK/GDPR): onay verilene kadar GA/AdSense yüklenmez -->
    <div class="cerez" id="cerez" hidden>
      <div class="cerez__ic">
        <p>
          Sitede ölçüm ve (yayına girdiğinde) reklam için çerez kullanılıyor. Ayrıntılar:
          <a href="/gizlilik/">Gizlilik ve Çerez Politikası</a>
        </p>
        <div class="cerez__btn">
          <button type="button" data-cerez="red">Sadece zorunlu</button>
          <button type="button" class="cerez__kabul" data-cerez="kabul">Kabul et</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var kutu = document.getElementById("cerez");
        if (!kutu) return;
        var oku = function () {
          try { return localStorage.getItem("cerez-onay"); } catch (e) { return null; }
        };
        if (!oku()) {
          kutu.hidden = false;
          document.documentElement.classList.add("cerez-acik");
        }
        kutu.addEventListener("click", function (e) {
          var b = e.target && e.target.closest ? e.target.closest("[data-cerez]") : null;
          if (!b) return;
          var secim = b.getAttribute("data-cerez");
          try { localStorage.setItem("cerez-onay", secim); } catch (err) {}
          kutu.hidden = true;
          document.documentElement.classList.remove("cerez-acik");
          if (secim === "kabul" && window.__olcumOnayla) window.__olcumOnayla();
        });
      })();
    </script>

    <style>
      .cerez {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 60;
        background: var(--surface);
        border-top: 1px solid var(--border);
        box-shadow: var(--shadow-lg);
        padding: 12px 16px;
      }
      .cerez[hidden] {
        display: none;
      }
      .cerez__ic {
        max-width: var(--maxw);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px 18px;
        flex-wrap: wrap;
      }
      .cerez p {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text);
      }
      .cerez a {
        color: var(--brand);
        font-weight: 600;
      }
      .cerez__btn {
        display: flex;
        gap: 8px;
        margin-left: auto;
      }
      .cerez button {
        border: 1px solid var(--border-strong);
        background: var(--surface);
        color: var(--text);
        border-radius: 999px;
        padding: 8px 16px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      .cerez__kabul {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
      }
      .cerez__kabul:hover {
        background: var(--brand-strong);
        border-color: var(--brand-strong);
      }
      /* Telefon: çerez çubuğu alttaki gezinme çubuğunun ÜSTÜNDE durur
         (ikisi üst üste binmesin), düğmeler parmakla rahat basılacak boyutta. */
      @media (max-width: 720px) {
        .cerez {
          bottom: calc(64px + env(safe-area-inset-bottom, 0px));
          padding: 10px 14px;
        }
        .cerez__ic {
          gap: 10px;
        }
        .cerez p {
          font-size: 0.84rem;
        }
        .cerez__btn {
          margin-left: 0;
          width: 100%;
        }
        .cerez button {
          flex: 1;
          min-height: 44px;
        }
      }
    </style>
  </body>
</html>
