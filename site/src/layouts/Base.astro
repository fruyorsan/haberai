---
import Header from "../components/Header.astro";
import BreakingBar from "../components/BreakingBar.astro";
import CategoryBar from "../components/CategoryBar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "HaberAI — Yapay Zekâ Destekli Haberler",
  description = "Yapay zekâ destekli teknoloji haberleri: özetler, analizler ve editör yorumları.",
  canonical,
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  imageAlt,
} = Astro.props;

// Mutlak URL tabanı (astro.config.mjs -> site)
const site = Astro.site ?? new URL("https://fruyorsan.github.io");

// Görsel/URL çözümleme: mutlak http(s) ise aynen, göreli ise site köküne göre mutlaklaştır.
function absoluteUrl(value) {
  if (!value) return "";
  const str = String(value).trim();
  if (!str) return "";
  if (/^https?:\/\//i.test(str)) return str;
  try {
    return new URL(str, site).href;
  } catch {
    return str;
  }
}

// canonical: verilen değer ya da mevcut sayfanın yolu
const canonicalUrl = absoluteUrl(canonical || Astro.url.pathname);

// og:image: haberin kendi görseli -> yoksa markalı yedek
const DEFAULT_OG_IMAGE = new URL("og-default.png", site).href;
const ogImage = image ? absoluteUrl(image) : DEFAULT_OG_IMAGE;
const ogImageAlt = imageAlt || title;

const tagList = Array.isArray(tags) ? tags.filter(Boolean) : [];
const isArticle = ogType === "article";
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="0txYR2AQdV9F9DdPhBtDSxs4PWnFvNyBUBXXix7m2Ck" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="HaberAI" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {isArticle && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {isArticle && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {isArticle && section && <meta property="article:section" content={section} />}
    {isArticle && tagList.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" id="theme-color" content="#d81f26" />
    <meta name="color-scheme" content="light dark" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="HaberAI RSS" href="/rss.xml" />

    <!-- Tema (FOUC önleyici): gövde çizilmeden önce doğru temayı uygula -->
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch (e) {}
          var systemDark =
            window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme =
            stored === "dark" || stored === "light" ? stored : systemDark ? "dark" : "light";
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#0b0d11" : "#d81f26");
        } catch (e) {}
      })();
    </script>

    <!-- Yazı tipi: önce bağlantı kur, sonra yükle -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap"
    />

    <!-- JS açık işareti (animasyonlar için; JS kapalıysa içerik görünür kalır) -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C9BGECSKCM" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-C9BGECSKCM");
    </script>
  </head>
  <body>
    <Header />
    <BreakingBar />
    <CategoryBar />
    <main>
      <slot />
    </main>
    <Footer />

    <button class="to-top" id="to-top" type="button" aria-label="Sayfanın başına dön" title="Yukarı çık">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5" />
        <path d="M5 12l7-7 7 7" />
      </svg>
    </button>

    <script>
      // --- Kaydırdıkça ortaya çıkma ---
      const revealEls = Array.from(document.querySelectorAll("[data-reveal]"));
      if (revealEls.length) {
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-in");
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: "0px 0px -6% 0px", threshold: 0.04 }
          );
          revealEls.forEach((el) => io.observe(el));
        } else {
          revealEls.forEach((el) => el.classList.add("is-in"));
        }
      }

      // --- Yukarı çık butonu ---
      const toTop = document.getElementById("to-top");
      if (toTop) {
        const syncTopButton = () => {
          toTop.classList.toggle("is-visible", window.scrollY > 700);
        };
        syncTopButton();
        window.addEventListener("scroll", syncTopButton, { passive: true });
        toTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // --- Tema: sistem tercihi değişirse (kullanıcı seçim yapmadıysa) uygula ---
      if (window.matchMedia) {
        const mq = window.matchMedia("(prefers-color-scheme: dark)");
        const applyTheme = (theme) => {
          const root = document.documentElement;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#0b0d11" : "#d81f26");
        };
        const onSystemTheme = (e) => {
          let stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch (_) {}
          if (stored === "dark" || stored === "light") return;
          applyTheme(e.matches ? "dark" : "light");
        };
        if (mq.addEventListener) mq.addEventListener("change", onSystemTheme);
        else if (mq.addListener) mq.addListener(onSystemTheme);
      }
    </script>
  </body>
</html>
