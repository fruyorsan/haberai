---
import Base from "../layouts/Base.astro";
import { HESAP, KATEGORILER, AVATARLAR } from "../lib/site-meta.js";

const hazir = Boolean(HESAP.url && HESAP.anahtar);
---

<Base
  title="Profilim — HaberinAi"
  description="Hesabın: ilgi alanlarını seç, bildirim konularını yönet, yorumlarını gör."
  noindex
>
  <div class="container profil">
    {!hazir && (
      <p class="profil__kapali">
        Hesap servisi henüz ayarlı değil. Yönetici <code>supabase/hesap.sql</code>
        dosyasını çalıştırmalı.
      </p>
    )}

    {/* Giriş yapılmamışsa */}
    <div class="profil__giris" id="profil-giris" hidden>
      <h1>Profil için giriş gerekli</h1>
      <p>İlgi alanlarını seçmek, bildirimlerini yönetmek ve yorumlarını görmek için hesabına gir.</p>
      <a class="profil__btn" href="/hesap/">Giriş yap / Hesap oluştur</a>
    </div>

    {/* Giriş yapılmışsa */}
    <div id="profil-icerik" hidden>
      <header class="profil__ust">
        <span class="profil__avatar" id="profil-avatar" aria-hidden="true"></span>
        <div class="profil__kim">
          <h1 id="profil-ad">Profilim</h1>
          <p class="profil__kadi">
            <span id="profil-kadi-metin"></span>
            <span class="profil__rozet" id="profil-rozet" hidden></span>
          </p>
        </div>
        <button type="button" class="profil__cikis" id="profil-cikis">Çıkış yap</button>
      </header>

      <section class="profil__blok">
        <h2 class="profil__h2">Görünen ad</h2>
        <p class="profil__aciklama">Yorumlarında bu ad görünür.</p>
        <div class="profil__satir">
          <input class="profil__girdi" id="profil-ad-girdi" type="text" maxlength="40" placeholder="Adın" />
          <button type="button" class="profil__btn profil__btn--kucuk" id="profil-ad-kaydet">Kaydet</button>
        </div>
      </section>

      <section class="profil__blok">
        <h2 class="profil__h2">Profil fotoğrafı</h2>
        <p class="profil__aciklama">
          Hazır bir desen seç ya da kendi fotoğrafını yükle. Yorumlarında ve
          üstteki hesap düğmesinde görünür.
        </p>
        <div class="profil__avatar-satir">
          <span class="profil__onizleme" id="profil-onizleme" aria-hidden="true"></span>
          <div class="profil__avatar-islem">
            <label class="profil__btn profil__btn--kucuk profil__dosya">
              Fotoğraf yükle
              <input type="file" id="profil-dosya" accept="image/*" hidden />
            </label>
            <button
              type="button"
              class="profil__btn profil__btn--kucuk profil__btn--ghost"
              id="profil-avatar-sil"
            >
              Kaldır
            </button>
          </div>
        </div>
        <div class="profil__avatarlar" id="profil-avatarlar">
          {AVATARLAR.map((a, i) => (
            <button
              type="button"
              class="profil__avatar-sec"
              data-avatar={a.kod}
              aria-label={`Avatar ${i + 1}`}
              aria-pressed="false"
              style={`--av-renk:${a.renk}`}
            >
              <img
                class="profil__avatar-resim"
                src={a.kod}
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
        <p class="profil__avatar-kaynak">
          Yapay zekâ ile üretilmiş özgün avatarlar
          (<a href="https://aihorde.net" target="_blank" rel="noopener">AI Horde</a>
          · ücretsiz, açık kaynak topluluk).
        </p>
        <span class="profil__mini" id="profil-avatar-durum" role="status" aria-live="polite"></span>
      </section>

      <section class="profil__blok">
        <h2 class="profil__h2">İlgi alanların</h2>
        <p class="profil__aciklama">
          Seçtiğin konular Shorts akışında “Sana özel” sıralamada öne çıkar ve
          ana sayfada önerilir. İstediğin kadar seçebilirsin.
        </p>
        <div class="profil__cipler" id="profil-ilgi">
          {KATEGORILER.map((k) => (
            <button type="button" class="profil__cip" data-ilgi={k.slug} aria-pressed="false">
              {k.ad}
            </button>
          ))}
        </div>
      </section>

      <section class="profil__blok">
        <h2 class="profil__h2">Bildirim konuların</h2>
        <p class="profil__aciklama">
          Yalnızca seçtiğin konulardan bildirim alırsın. Boş bırakırsan ilgi
          alanların bildirime de uygulanır; hiçbiri yoksa yalnızca son dakika
          haberleri gelir. Aşağıdaki sıklık ayarı, bu konuların sana ne sıklıkla
          ulaşacağını belirler.
        </p>
        <div class="profil__cipler" id="profil-bildirim">
          {KATEGORILER.map((k) => (
            <button type="button" class="profil__cip" data-bildirim={k.slug} aria-pressed="false">
              {k.ad}
            </button>
          ))}
        </div>

        <div class="profil__siklik">
          <label class="profil__siklik-etiket" for="profil-siklik">Bildirim sıklığı</label>
          <select class="profil__girdi" id="profil-siklik">
            <option value="aninda">Anında — seçtiğim her konuda</option>
            <option value="ozet">Günde 3 özet — 09:00 · 15:00 · 21:00</option>
            <option value="son">Sadece son dakika</option>
          </select>
          <span class="profil__mini" id="profil-siklik-durum" role="status" aria-live="polite"></span>
        </div>

        <div class="profil__bildirim-durum" id="profil-bildirim-durum">
          <span class="profil__nokta" id="profil-nokta" aria-hidden="true"></span>
          <span id="profil-bildirim-yazi">Bildirim durumu kontrol ediliyor…</span>
        </div>

        <div class="profil__islem">
          <button type="button" class="profil__btn profil__btn--kucuk" id="profil-bildirim-ac">
            Bildirimleri aç
          </button>
          <button type="button" class="profil__btn profil__btn--kucuk profil__btn--ghost" id="profil-bildirim-test">
            Deneme bildirimi
          </button>
          <span class="profil__mini" id="profil-mini" role="status" aria-live="polite"></span>
        </div>
      </section>

      <section class="profil__blok">
        <h2 class="profil__h2">Okuma listesi</h2>
        <p class="profil__aciklama">
          Kaydettiğin haberler hesabında saklanır; başka bir cihazdan girdiğinde
          de listende durur.
        </p>
        <ul class="profil__yorumlar" id="profil-kayitlar"></ul>
        <p class="profil__bos" id="profil-kayit-bos" hidden>
          Henüz kaydettiğin haber yok. Haber sayfasındaki yer imi düğmesiyle ekleyebilirsin.
        </p>
      </section>

      <section class="profil__blok">
        <h2 class="profil__h2">Yorumların</h2>
        <ul class="profil__yorumlar" id="profil-yorumlar"></ul>
        <p class="profil__bos" id="profil-yorum-bos" hidden>Henüz yorumun yok.</p>
      </section>

      <div class="profil__kaydet-satir">
        <span class="profil__mini" id="profil-durum" role="status" aria-live="polite"></span>
      </div>

      <section class="profil__blok" id="profil-yonetim" hidden>
        <h2 class="profil__h2">Yönetim · kayıtlı okurlar</h2>
        <p class="profil__aciklama">
          Sitede hesabı olan herkesi görürsün. Bir okura rozet yazabilirsin
          (ör. “Yönetici”, “Editör”, “İlk okur”). Rozet sadece görünür; yetki
          vermez. Bu bölüm yalnızca sana görünür.
        </p>
        <input
          class="profil__girdi profil__uye-ara"
          id="profil-uye-ara"
          type="search"
          placeholder="Ada ya da kullanıcı adı ara"
          autocomplete="off"
        />
        <div class="profil__uyeler" id="profil-uyeler"></div>
        <span class="profil__mini" id="profil-yonetim-durum" role="status" aria-live="polite"></span>
      </section>

      <section class="profil__blok profil__blok--tehlike">
        <h2 class="profil__h2">Hesabımı sil</h2>
        <p class="profil__aciklama">
          Hesabını kalıcı olarak kapatır. Profil fotoğrafın, okuma listen ve
          beğenilerin silinir; yorumların takma adla kalmaya devam eder.
          <a href="/gizlilik/" target="_blank" rel="noopener">Gizlilik Politikası</a>
        </p>
        <div class="profil__islem">
          <button type="button" class="profil__btn profil__btn--kucuk profil__btn--sil" id="profil-hesap-sil">
            Hesabımı sil
          </button>
          <span class="profil__mini" id="profil-sil-durum" role="status" aria-live="polite"></span>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .profil {
    max-width: 720px;
    margin: 36px auto 70px;
  }
  .profil__kapali {
    padding: 12px 14px;
    border: 1px dashed var(--border);
    border-radius: 12px;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .profil__giris {
    padding: 32px 24px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    text-align: center;
  }
  .profil__giris h1 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .profil__giris p {
    color: var(--text-2);
    font-size: 0.92rem;
    margin-bottom: 18px;
  }
  .profil__ust {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 18px;
  }
  .profil__avatar {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 900;
    font-size: 1.3rem;
  }
  .profil__kim {
    min-width: 0;
    flex: 1;
  }
  .profil__kim h1 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profil__kadi {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin: 2px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  /* Yönetici rozeti: kırmızı-beyaz, küçük ve dikkat çekmeden görünür. */
  .profil__rozet {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--brand-grad, #d9364b);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.5;
    white-space: nowrap;
  }
  .profil__rozet::before {
    content: "★";
    font-size: 0.62rem;
    opacity: 0.9;
  }
  .profil__siklik {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .profil__siklik-etiket {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-2);
  }
  .profil__siklik .profil__girdi {
    flex: 1 1 220px;
    padding: 8px 10px;
    font-size: 0.84rem;
  }
  .profil__uye-ara {
    width: 100%;
    margin: 10px 0 6px;
    padding: 9px 11px;
    font-size: 0.86rem;
  }
  .profil__uyeler {
    display: grid;
    gap: 8px;
  }
  .profil__uye {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) minmax(120px, 170px) auto;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--bg);
  }
  .profil__uye-av {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
  }
  .profil__uye-kim {
    min-width: 0;
    line-height: 1.25;
  }
  .profil__uye-kim b {
    display: block;
    font-size: 0.86rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profil__uye-kim span {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profil__uye-etiket {
    width: 100%;
    padding: 7px 9px;
    font-size: 0.8rem;
  }
  .profil__uye-kaydet {
    padding: 7px 11px;
    border: 0;
    border-radius: 9px;
    background: var(--brand-grad);
    color: #fff;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
  }
  .profil__uye-kaydet:disabled {
    opacity: 0.55;
    cursor: wait;
  }
  .profil__blok {
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    margin-bottom: 16px;
  }
  .profil__h2 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 900;
  }
  .profil__aciklama {
    margin: 0 0 12px;
    font-size: 0.83rem;
    color: var(--text-2);
    line-height: 1.5;
  }
  .profil__satir {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .profil__girdi {
    flex: 1;
    min-width: 180px;
    padding: 10px 13px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
  }
  .profil__girdi:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 16%, transparent);
  }
  .profil__cipler {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .profil__cip {
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-2);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.16s var(--ease), color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .profil__cip:hover {
    border-color: var(--brand);
  }
  .profil__cip.is-on {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .profil__bildirim-durum {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 10px;
    font-size: 0.86rem;
    color: var(--text-2);
  }
  .profil__nokta {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--muted);
    flex-shrink: 0;
  }
  .profil__nokta.is-on {
    background: #16a34a;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.18);
  }
  .profil__nokta.is-engel {
    background: #dc2626;
    box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.18);
  }
  .profil__islem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .profil__btn {
    display: inline-block;
    padding: 11px 18px;
    border: 0;
    border-radius: 12px;
    background: var(--brand-grad);
    color: #fff;
    font: inherit;
    font-weight: 800;
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 14px 26px -16px var(--brand-glow);
  }
  .profil__btn:hover {
    filter: brightness(1.05);
  }
  .profil__btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .profil__btn--kucuk {
    padding: 9px 15px;
    font-size: 0.85rem;
  }
  .profil__btn--ghost {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: none;
  }
  /* Hesap silme: uyarı niteliğinde, kenarlıklı düğme (kırmızı dolgu yok). */
  .profil__btn--sil {
    background: transparent;
    color: var(--brand-strong);
    border: 1px solid color-mix(in srgb, var(--brand) 45%, var(--border));
    box-shadow: none;
  }
  .profil__btn--sil:hover {
    background: color-mix(in srgb, var(--brand) 12%, transparent);
    filter: none;
  }
  .profil__blok--tehlike {
    border-style: dashed;
  }
  .profil__cikis {
    padding: 9px 15px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-2);
    color: var(--text-2);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    flex-shrink: 0;
  }
  .profil__cikis:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .profil__yorumlar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .profil__yorum {
    padding: 11px 13px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
  }
  .profil__yorum a {
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--brand);
    text-decoration: none;
  }
  .profil__yorum p {
    margin: 5px 0 0;
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .profil__yorum time {
    display: block;
    margin-top: 5px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .profil__bos {
    margin: 0;
    font-size: 0.86rem;
    color: var(--text-2);
  }
  .profil__kaydet-satir {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .profil__mini {
    font-size: 0.82rem;
    color: var(--text-2);
  }

  /* --- Profil fotoğrafı seçici --- */
  .profil__avatar-satir {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .profil__onizleme {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 900;
    font-size: 1.5rem;
    overflow: hidden;
  }
  .profil__onizleme img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profil__avatar-islem {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .profil__dosya {
    cursor: pointer;
  }
  .profil__avatarlar {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 9px;
  }
  .profil__avatar-sec {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-2);
    cursor: pointer;
    transition: transform 0.15s var(--ease), border-color 0.15s var(--ease),
      box-shadow 0.15s var(--ease);
  }
  .profil__avatar-sec:hover {
    border-color: var(--av-renk, var(--brand));
    transform: translateY(-2px);
  }
  .profil__avatar-sec.is-on {
    border-color: var(--av-renk, var(--brand));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--av-renk, var(--brand)) 22%, transparent);
    background: color-mix(in srgb, var(--av-renk, var(--brand)) 14%, var(--surface-2));
  }
  .profil__avatar-resim {
    display: block;
    width: 100%;
    max-width: 62px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--av-renk, var(--surface));
  }
  .profil__avatar-kaynak {
    margin: 10px 0 0;
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .profil__avatar-kaynak a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ============================== TELEFON ============================== */
  @media (max-width: 640px) {
    .profil {
      margin: 16px auto 24px;
    }
    .profil__ust {
      padding: 14px 15px;
      gap: 10px;
    }
    .profil__avatar {
      width: 44px;
      height: 44px;
      font-size: 1.05rem;
    }
    .profil__kim h1 {
      font-size: 1.05rem;
    }
    .profil__cikis {
      padding: 8px 12px;
      font-size: 0.78rem;
    }
    .profil__blok {
      padding: 15px 15px;
      border-radius: 14px;
      margin-bottom: 13px;
    }
    .profil__girdi {
      min-width: 0;
    }
    .profil__satir {
      gap: 8px;
    }
    /* Telefonda "Kaydet" tam genişlik: parmakla kolay basılır. */
    .profil__satir .profil__btn {
      flex: 1 1 100%;
    }
    .profil__avatarlar {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .profil__avatar-sec {
      padding: 8px;
    }
    .profil__yorum {
      padding: 10px 11px;
    }
    .profil__kaydet-satir .profil__btn {
      flex: 1 1 100%;
    }
    /* Telefonda yönetim satırı: avatar + ad üstte, rozet ve düğme altta. */
    .profil__uye {
      grid-template-columns: 34px minmax(0, 1fr);
    }
    .profil__uye-etiket,
    .profil__uye-kaydet {
      grid-column: 1 / -1;
    }
    .profil__uye-kaydet {
      width: 100%;
      padding: 9px 11px;
    }
    /* Hesap silme düğmesi telefonda tam genişlik (yanlışlıkla basılmasın diye
       yine de iki adımlı onay sorulur). */
    .profil__blok--tehlike .profil__islem .profil__btn {
      flex: 1 1 100%;
    }
  }
</style>

<script is:inline>
  (function () {
    var H = window.HaberinAi;
    var giris = document.getElementById("profil-giris");
    var icerik = document.getElementById("profil-icerik");
    if (!H || !icerik) return;

    var u = H.oturumOku ? H.oturumOku() : null;
    if (!u) {
      if (giris) giris.hidden = false;
      icerik.hidden = true;
      return;
    }
    icerik.hidden = false;

    var ilgiSecim = new Set(u.ilgi || []);
    var bildirimSecim = new Set(u.bildirim_ilgi || []);

    var avatar = document.getElementById("profil-avatar");
    var adEl = document.getElementById("profil-ad");
    var kadiEl = document.getElementById("profil-kadi-metin");
    var rozetEl = document.getElementById("profil-rozet");
    var adGirdi = document.getElementById("profil-ad-girdi");
    var durumEl = document.getElementById("profil-durum");
    var onizleme = document.getElementById("profil-onizleme");
    var avDurum = document.getElementById("profil-avatar-durum");
    var avSecimler = [].slice.call(document.querySelectorAll("[data-avatar]"));

    // Avatarı hem üstte hem önizlemede gösterir, seçili hazır avatari işaretler.
    function avatarCiz() {
      var g = H.oturumOku() || u;
      if (avatar) H.avatarDoldur && H.avatarDoldur(avatar, g.avatar, g.ad);
      if (onizleme) H.avatarDoldur && H.avatarDoldur(onizleme, g.avatar, g.ad);
      for (var i = 0; i < avSecimler.length; i++) {
        var on = g.avatar === avSecimler[i].getAttribute("data-avatar");
        avSecimler[i].classList.toggle("is-on", on);
        avSecimler[i].setAttribute("aria-pressed", String(on));
      }
    }

    /** Yönetici rozetini (varsa) ada bitişik gösterir. */
    function rozetCiz() {
      if (!rozetEl) return;
      var g = H.oturumOku() || u;
      var etiket = (g && g.etiket) || "";
      rozetEl.textContent = etiket;
      rozetEl.hidden = !etiket;
    }

    if (adEl) adEl.textContent = u.ad;
    if (kadiEl) kadiEl.textContent = "@" + u.kadi;
    if (adGirdi) adGirdi.value = u.ad;
    rozetCiz();
    avatarCiz();

    function cizCip(kap, kunye, secim) {
      var cipler = document.querySelectorAll("[" + kunye + "]");
      for (var i = 0; i < cipler.length; i++) {
        var acik = secim.has(cipler[i].getAttribute(kunye));
        cipler[i].classList.toggle("is-on", acik);
        cipler[i].setAttribute("aria-pressed", acik ? "true" : "false");
      }
    }
    function ciz() {
      cizCip(null, "data-ilgi", ilgiSecim);
      cizCip(null, "data-bildirim", bildirimSecim);
    }

    function cipTikla(kunye, secim) {
      return function () {
        var s = this.getAttribute(kunye);
        if (secim.has(s)) secim.delete(s);
        else secim.add(s);
        ciz();
        otomatikKaydet();
      };
    }
    [].forEach.call(document.querySelectorAll("[data-ilgi]"), function (c) {
      c.addEventListener("click", cipTikla("data-ilgi", ilgiSecim));
    });
    [].forEach.call(document.querySelectorAll("[data-bildirim]"), function (c) {
      c.addEventListener("click", cipTikla("data-bildirim", bildirimSecim));
    });
    ciz();

    function durum(mesaj) {
      if (durumEl) durumEl.textContent = mesaj || "";
    }

    // --- Otomatik kaydet (düğme yok): her seçim anında hesaba yazılır ---
    var kaydetZaman = null;
    async function tercihleriKaydet() {
      durum("Kaydediliyor…");
      try {
        var r = await H.profilGuncelle({
          ad: (adGirdi && adGirdi.value.trim()) || u.ad,
          ilgi: Array.from(ilgiSecim),
          bildirim_ilgi: Array.from(bildirimSecim),
        });
        if (r && r.hata) {
          durum(r.hata);
          return;
        }
        u = H.oturumOku();
        await H.pushEsle(u);
        durum("Kaydedildi ✓");
      } catch (e) {
        durum("Kaydedilemedi, tekrar dene.");
      }
    }
    function otomatikKaydet() {
      if (kaydetZaman) clearTimeout(kaydetZaman);
      kaydetZaman = setTimeout(function () {
        kaydetZaman = null;
        tercihleriKaydet();
      }, 350);
    }

    // --- Kaydet (eski düğme kaldırıldı; varsa da çalışsın) ---
    var kaydet = document.getElementById("profil-kaydet");
    kaydet &&
      kaydet.addEventListener("click", async function () {
        kaydet.disabled = true;
        try {
          await tercihleriKaydet();
        } finally {
          kaydet.disabled = false;
        }
      });

    // Görünen adı tek başına kaydet
    var adKaydet = document.getElementById("profil-ad-kaydet");
    adKaydet &&
      adKaydet.addEventListener("click", async function () {
        adKaydet.disabled = true;
        durum("Kaydediliyor…");
        try {
          var r = await H.profilGuncelle({ ad: (adGirdi && adGirdi.value.trim()) || u.ad });
          if (r && r.hata) { durum(r.hata); return; }
          u = H.oturumOku();
          if (adEl) adEl.textContent = u.ad;
          avatarCiz();
          durum("Adın güncellendi ✓");
        } catch (e) {
          durum("Güncellenemedi.");
        } finally {
          adKaydet.disabled = false;
        }
      });

    // --- Çıkış ---
    var cikis = document.getElementById("profil-cikis");
    cikis &&
      cikis.addEventListener("click", async function () {
        cikis.disabled = true;
        try { await H.cikisYap(); } catch (e) {}
        location.href = "/";
      });

    // --- Bildirim durumu ---
    var nokta = document.getElementById("profil-nokta");
    var belYazi = document.getElementById("profil-bildirim-yazi");
    var mini = document.getElementById("profil-mini");
    var belAc = document.getElementById("profil-bildirim-ac");
    var belTest = document.getElementById("profil-bildirim-test");
    var P = window.HaberinaiPush;

    function belCiz() {
      var izin = typeof Notification !== "undefined" ? Notification.permission : "yok";
      if (nokta) nokta.classList.remove("is-on", "is-engel");
      if (izin === "granted") {
        if (nokta) nokta.classList.add("is-on");
        if (belYazi) belYazi.textContent = "Bildirimler açık — bu cihaz yeni haberleri alıyor.";
        if (belAc) belAc.textContent = "Bildirimleri yenile";
        if (belTest) belTest.hidden = false;
      } else if (izin === "denied") {
        if (nokta) nokta.classList.add("is-engel");
        if (belYazi) {
          belYazi.textContent =
            "İzin engellenmiş. Adres çubuğunun yanındaki simge → İzinler → Bildirimler → İzin ver, sonra sayfayı yenile.";
        }
        if (belAc) belAc.textContent = "Nasıl açılır?";
        if (belTest) belTest.hidden = true;
      } else if (P && P.iosKuruluDegil && P.iosKuruluDegil()) {
        if (belYazi) belYazi.textContent = "iPhone: Paylaş → Ana Ekrana Ekle, sonra o ikondan aç.";
        if (belAc) belAc.textContent = "Nasıl?";
        if (belTest) belTest.hidden = true;
      } else {
        if (belYazi) belYazi.textContent = "Bildirimler kapalı — “Bildirimleri aç”a dokun.";
        if (belAc) belAc.textContent = "Bildirimleri aç";
        if (belTest) belTest.hidden = true;
      }
    }
    belCiz();

    belAc &&
      belAc.addEventListener("click", async function () {
        if (P && P.izinSor) P.izinSor(); // dokunuşun İÇİNDE
        if (typeof Notification !== "undefined" && Notification.permission === "denied") {
          if (mini) mini.textContent = "İzin tarayıcıda engelli; yukarıdaki adımları izle.";
          belCiz();
          return;
        }
        if (P && P.aboneBaslat) {
          if (mini) mini.textContent = "Açılıyor…";
          var oldu = await P.aboneBaslat();
          await H.pushEsle(H.oturumOku());
          if (mini) mini.textContent = oldu ? "Bildirimler açıldı ✓" : "Açılamadı; izni kontrol et.";
          if (oldu && P.hosgeldinBildirimi) await P.hosgeldinBildirimi();
        }
        belCiz();
      });

    belTest &&
      belTest.addEventListener("click", async function () {
        if (!P || !P.testBildirim) return;
        var gitti = await P.testBildirim();
        if (mini) mini.textContent = gitti ? "Deneme bildirimi gönderildi ✓" : "Gösterilemedi.";
      });

    // --- Profil fotoğrafı ---
    function avYaz(mesaj, hata) {
      if (avDurum) avDurum.textContent = mesaj || "";
      if (avDurum) avDurum.style.color = hata ? "var(--brand-ink, #b3121a)" : "";
    }
    avSecimler.forEach(function (btn) {
      btn.addEventListener("click", async function () {
        btn.disabled = true;
        avYaz("Kaydediliyor…");
        try {
          var r = await H.avatarAyarla(btn.getAttribute("data-avatar"));
          if (r && r.hata) {
            avYaz(r.hata, true);
            return;
          }
          avYaz("Profil fotoğrafı güncellendi ✓");
        } catch (e) {
          avYaz("Kaydedilemedi, tekrar dene.", true);
        } finally {
          btn.disabled = false;
          avatarCiz();
        }
      });
    });

    // Kendi fotoğrafı: tarayıcıda 128 px kareye küçültülür (küçük ve hızlı).
    function kucult(dosya, cb) {
      var okuyucu = new FileReader();
      okuyucu.onload = function () {
        var img = new Image();
        img.onload = function () {
          try {
            var kenar = 128;
            var cv = document.createElement("canvas");
            cv.width = kenar;
            cv.height = kenar;
            var ctx = cv.getContext("2d");
            var kisa = Math.min(img.width, img.height);
            ctx.drawImage(
              img,
              (img.width - kisa) / 2,
              (img.height - kisa) / 2,
              kisa,
              kisa,
              0,
              0,
              kenar,
              kenar,
            );
            cb(cv.toDataURL("image/jpeg", 0.82));
          } catch (e) {
            cb(null);
          }
        };
        img.onerror = function () {
          cb(null);
        };
        img.src = okuyucu.result;
      };
      okuyucu.onerror = function () {
        cb(null);
      };
      okuyucu.readAsDataURL(dosya);
    }

    var dosyaGirdi = document.getElementById("profil-dosya");
    dosyaGirdi &&
      dosyaGirdi.addEventListener("change", function () {
        var dosya = dosyaGirdi.files && dosyaGirdi.files[0];
        if (!dosya) return;
        if (dosya.size > 6 * 1024 * 1024) {
          avYaz("Dosya çok büyük (en fazla 6 MB).", true);
          dosyaGirdi.value = "";
          return;
        }
        avYaz("Fotoğraf hazırlanıyor…");
        kucult(dosya, async function (veri) {
          dosyaGirdi.value = "";
          if (!veri) {
            avYaz("Bu dosya okunamadı. PNG/JPG dene.", true);
            return;
          }
          var r = await H.avatarAyarla(veri);
          if (r && r.hata) {
            avYaz(r.hata, true);
            return;
          }
          avYaz("Fotoğrafın yüklendi ✓");
          avatarCiz();
        });
      });

    var avSil = document.getElementById("profil-avatar-sil");
    avSil &&
      avSil.addEventListener("click", async function () {
        avSil.disabled = true;
        avYaz("Kaldırılıyor…");
        try {
          var r = await H.avatarAyarla("");
          if (r && r.hata) {
            avYaz(r.hata, true);
            return;
          }
          avYaz("Profil fotoğrafı kaldırıldı (baş harfin görünür).");
        } finally {
          avSil.disabled = false;
          avatarCiz();
        }
      });

    // --- Hesabı sil ---
    var hsSil = document.getElementById("profil-hesap-sil");
    var hsDurum = document.getElementById("profil-sil-durum");
    function silYaz(mesaj) {
      if (hsDurum) hsDurum.textContent = mesaj || "";
    }
    hsSil &&
      hsSil.addEventListener("click", async function () {
        // Geri dönüşü olmayan işlem: iki adımlı onay.
        if (!window.confirm("Hesabın kalıcı olarak silinecek. Devam edilsin mi?")) return;
        var onay = (window.prompt("Silmeyi onaylamak için kullanıcı adını yaz:") || "").trim().toLowerCase();
        var suanki = H.oturumOku() || u || {};
        var beklenen = [String(suanki.kadi || ""), String(suanki.ad || "")].map(function (s) {
          return s.trim().toLowerCase();
        });
        if (!onay || beklenen.indexOf(onay) === -1) {
          silYaz("Kullanıcı adı eşleşmedi, silme iptal edildi.");
          return;
        }
        hsSil.disabled = true;
        silYaz("Hesap siliniyor…");
        try {
          var r = await H.hesapSil();
          if (r && r.hata) {
            silYaz(r.hata);
            return;
          }
          silYaz("Hesabın silindi. Yönlendiriliyorsun…");
          location.href = "/";
        } catch (e) {
          silYaz("Bir şeyler ters gitti. Tekrar dene.");
        } finally {
          hsSil.disabled = false;
        }
      });

    // --- Bildirim sıklığı (anında / günde 3 özet / sadece son dakika) ---
    var siklikEl = document.getElementById("profil-siklik");
    var siklikDurum = document.getElementById("profil-siklik-durum");
    function siklikCiz() {
      if (!siklikEl) return;
      var g = H.oturumOku() || u;
      var deger = (g && g.bildirim_siklik) || "aninda";
      // Hesapta değer yoksa (eski oturum) cihazdaki son seçim kullanılır.
      if (!g || !g.bildirim_siklik) {
        try {
          deger = localStorage.getItem("bildirim-siklik") || deger;
        } catch (e) {}
      }
      if (["aninda", "ozet", "son"].indexOf(deger) < 0) deger = "aninda";
      siklikEl.value = deger;
    }
    siklikCiz();
    siklikEl &&
      siklikEl.addEventListener("change", async function () {
        var deger = siklikEl.value;
        siklikEl.disabled = true;
        if (siklikDurum) siklikDurum.textContent = "Kaydediliyor…";
        try {
          var r = await H.bildirimSiklik(deger);
          if (r && r.hata) {
            if (siklikDurum) siklikDurum.textContent = r.hata;
            return;
          }
          u = H.oturumOku() || u;
          if (siklikDurum) {
            siklikDurum.textContent =
              deger === "ozet"
                ? "Günde 3 özet seçildi ✓"
                : deger === "son"
                  ? "Yalnızca son dakika seçildi ✓"
                  : "Anında bildirim seçildi ✓";
          }
        } catch (e) {
          if (siklikDurum) siklikDurum.textContent = "Kaydedilemedi, tekrar dene.";
        } finally {
          siklikEl.disabled = false;
        }
      });

    // --- Yönetim: kayıtlı okurlar + rozet (yalnızca yönetici) ---
    var yonetim = document.getElementById("profil-yonetim");
    var uyelerEl = document.getElementById("profil-uyeler");
    var uyeAra = document.getElementById("profil-uye-ara");
    var yonDurum = document.getElementById("profil-yonetim-durum");
    var uyeListe = [];
    var yonetimYuklendi = false;

    function tarihYaz(iso) {
      try {
        return new Date(iso).toLocaleDateString("tr-TR", {
          day: "2-digit",
          month: "short",
          year: "numeric",
        });
      } catch (e) {
        return "";
      }
    }

    function uyelerCiz() {
      if (!uyelerEl) return;
      var ara = ((uyeAra && uyeAra.value) || "").trim().toLocaleLowerCase("tr");
      uyelerEl.textContent = "";
      var goster = uyeListe.filter(function (x) {
        if (!ara) return true;
        var metin = String(x.ad || "") + " " + String(x.kadi || "");
        return metin.toLocaleLowerCase("tr").indexOf(ara) >= 0;
      });
      if (!goster.length) {
        var bos = document.createElement("p");
        bos.className = "profil__bos";
        bos.textContent = uyeListe.length
          ? "Aramaya uyan okur yok."
          : "Henüz kayıtlı okur yok.";
        uyelerEl.appendChild(bos);
        return;
      }
      goster.forEach(function (x) {
        var satir = document.createElement("div");
        satir.className = "profil__uye";

        var av = document.createElement("span");
        av.className = "profil__uye-av";
        av.setAttribute("aria-hidden", "true");
        if (H.avatarDoldur) H.avatarDoldur(av, x.avatar, x.ad);

        var kim = document.createElement("div");
        kim.className = "profil__uye-kim";
        var b = document.createElement("b");
        b.textContent = x.ad || x.kadi || "Okur";
        var alt = document.createElement("span");
        var parcalar = ["@" + (x.kadi || "?")];
        if (x.olusturma) parcalar.push(tarihYaz(x.olusturma));
        if (x.yorum) parcalar.push(x.yorum + " yorum");
        alt.textContent = parcalar.join(" · ");
        kim.append(b, alt);

        var girdi = document.createElement("input");
        girdi.className = "profil__girdi profil__uye-etiket";
        girdi.type = "text";
        girdi.maxLength = 24;
        girdi.value = x.etiket || "";
        girdi.placeholder = "Rozet (ör. Yönetici) — sadece görünür";
        girdi.setAttribute("aria-label", (x.ad || x.kadi) + " için rozet");

        var kaydetBtn = document.createElement("button");
        kaydetBtn.type = "button";
        kaydetBtn.className = "profil__uye-kaydet";
        kaydetBtn.textContent = "Kaydet";
        kaydetBtn.addEventListener("click", async function () {
          kaydetBtn.disabled = true;
          if (yonDurum) yonDurum.textContent = "Kaydediliyor…";
          try {
            var r = await H.adminEtiket(x.id, girdi.value.trim());
            if (r && r.hata) {
              if (yonDurum) yonDurum.textContent = r.hata;
              return;
            }
            x.etiket = r && r.etiket != null ? r.etiket : girdi.value.trim();
            var ben = H.oturumOku();
            if (ben && ben.id === x.id) {
              ben.etiket = x.etiket;
              try {
                localStorage.setItem("hb-oturum", JSON.stringify(ben));
              } catch (e) {}
              u = ben;
              rozetCiz();
            }
            if (yonDurum) yonDurum.textContent = "Rozet kaydedildi (yetki vermez) ✓";
          } catch (e) {
            if (yonDurum) yonDurum.textContent = "Kaydedilemedi, tekrar dene.";
          } finally {
            kaydetBtn.disabled = false;
          }
        });

        satir.append(av, kim, girdi, kaydetBtn);
        uyelerEl.appendChild(satir);
      });
    }

    async function yonetimKur() {
      var g = H.oturumOku() || u;
      // Yönetim paneli normal profilde GÖRÜNMEZ. Yalnızca yönetici hesabı,
      // adres çubuğuna ?yonetim=1 ekleyince açılır; başka hesaplar göremez.
      // Yetki yine sunucuda: admin_* fonksiyonları rol='yonetici' olmayanı reddeder.
      var yonetimAcik = false;
      try {
        yonetimAcik = new URLSearchParams(location.search).get("yonetim") === "1";
      } catch (e) {}
      if (!g || g.rol !== "yonetici" || !yonetimAcik) {
        if (yonetim) yonetim.hidden = true;
        return;
      }
      if (yonetim) yonetim.hidden = false;
      if (yonetimYuklendi) return;
      yonetimYuklendi = true;
      if (yonDurum) yonDurum.textContent = "Yükleniyor…";
      try {
        var r = await H.adminUyeler();
        if (r && r.hata) {
          if (yonDurum) yonDurum.textContent = r.hata;
          yonetimYuklendi = false;
          return;
        }
        uyeListe = Array.isArray(r) ? r : r && Array.isArray(r.uyeler) ? r.uyeler : [];
        uyelerCiz();
        if (yonDurum) {
          yonDurum.textContent = uyeListe.length + " kayıtlı okur";
        }
      } catch (e) {
        if (yonDurum) yonDurum.textContent = "Liste yüklenemedi, tekrar dene.";
        yonetimYuklendi = false;
      }
    }

    uyeAra && uyeAra.addEventListener("input", uyelerCiz);

    // Eski oturumlarda rol/etiket/bildirim_siklik alanları yok: sunucudan tazele.
    if (H.profilTazele) {
      H.profilTazele().then(function (yeni) {
        if (!yeni) return;
        u = yeni;
        if (adEl) adEl.textContent = u.ad;
        if (kadiEl) kadiEl.textContent = "@" + u.kadi;
        if (adGirdi) adGirdi.value = u.ad;
        rozetCiz();
        siklikCiz();
        yonetimKur();
        // Sunucudaki seçimler ekranda görünsün: eskiden tazeleme yalnızca
        // oturumu güncelliyor, çipler boş kalıyordu ("seçmiştim, gelmiyor").
        var yIlgi = new Set(u.ilgi || []);
        var yBildirim = new Set(u.bildirim_ilgi || []);
        if (!yBildirim.size && yIlgi.size) {
          yIlgi.forEach(function (s) {
            yBildirim.add(s);
          });
        }
        ilgiSecim.clear();
        yIlgi.forEach(function (s) {
          ilgiSecim.add(s);
        });
        bildirimSecim.clear();
        yBildirim.forEach(function (s) {
          bildirimSecim.add(s);
        });
        ciz();
      });
    }
    yonetimKur();

    // --- Okuma listesi ---
    var kListe = document.getElementById("profil-kayitlar");
    var kBos = document.getElementById("profil-kayit-bos");
    if (H.kayitlar) {
      H.kayitlar().then(function (gelen) {
        var veri = Array.isArray(gelen) ? gelen : [];
        if (!kListe) return;
        kListe.textContent = "";
        if (!veri.length) {
          if (kBos) kBos.hidden = false;
          return;
        }
        if (kBos) kBos.hidden = true;
        veri.forEach(function (k) {
          var li = document.createElement("li");
          li.className = "profil__yorum";
          var a = document.createElement("a");
          a.href = "/haber/" + k.slug + "/";
          a.textContent = k.baslik || "Habere git →";
          var t = document.createElement("time");
          try {
            t.textContent = new Date(k.created_at).toLocaleString("tr-TR");
          } catch (e) {
            t.textContent = "";
          }
          li.append(a, t);
          kListe.appendChild(li);
        });
      });
    }

    // --- Yorumlarım ---
    var liste = document.getElementById("profil-yorumlar");
    var bos = document.getElementById("profil-yorum-bos");
    H.yorumlarim().then(function (liste2) {
      if (!liste) return;
      var veri = Array.isArray(liste2) ? liste2 : [];
      liste.textContent = "";
      if (!veri.length) {
        if (bos) bos.hidden = false;
        return;
      }
      if (bos) bos.hidden = true;
      veri.forEach(function (y) {
        var li = document.createElement("li");
        li.className = "profil__yorum";
        var a = document.createElement("a");
        a.href = "/haber/" + y.slug + "/";
        a.textContent = "Habere git →";
        var p = document.createElement("p");
        p.textContent = y.metin;
        var t = document.createElement("time");
        try {
          t.textContent = new Date(y.created_at).toLocaleString("tr-TR");
        } catch (e) {
          t.textContent = "";
        }
        li.append(a, p, t);
        liste.appendChild(li);
      });
    });
  })();
</script>
