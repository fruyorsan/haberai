<script is:inline>
  (function () {
    var H = window.HaberinAi;
    var giris = document.getElementById("profil-giris");
    var icerik = document.getElementById("profil-icerik");
    if (!H || !icerik) return;

    var u = H.oturumOku ? H.oturumOku() : null;
    if (!u) {
      if (giris) giris.hidden = false;
      icerik.hidden = true;
      return;
    }
    icerik.hidden = false;

    var ilgiSecim = new Set(u.ilgi || []);
    var bildirimSecim = new Set(u.bildirim_ilgi || []);

    var avatar = document.getElementById("profil-avatar");
    var adEl = document.getElementById("profil-ad");
    var kadiEl = document.getElementById("profil-kadi-metin");
    var rozetEl = document.getElementById("profil-rozet");
    var adGirdi = document.getElementById("profil-ad-girdi");
    var durumEl = document.getElementById("profil-durum");
    var onizleme = document.getElementById("profil-onizleme");
    var avDurum = document.getElementById("profil-avatar-durum");
    var avSecimler = [].slice.call(document.querySelectorAll("[data-avatar]"));

    // Avatarı hem üstte hem önizlemede gösterir, seçili hazır avatari işaretler.
    function avatarCiz() {
      var g = H.oturumOku() || u;
      if (avatar) H.avatarDoldur && H.avatarDoldur(avatar, g.avatar, g.ad);
      if (onizleme) H.avatarDoldur && H.avatarDoldur(onizleme, g.avatar, g.ad);
      for (var i = 0; i < avSecimler.length; i++) {
        var on = g.avatar === avSecimler[i].getAttribute("data-avatar");
        avSecimler[i].classList.toggle("is-on", on);
        avSecimler[i].setAttribute("aria-pressed", String(on));
      }
    }

    /** Yönetici rozetini (varsa) ada bitişik gösterir. */
    function rozetCiz() {
      if (!rozetEl) return;
      var g = H.oturumOku() || u;
      var etiket = (g && g.etiket) || "";
      rozetEl.textContent = etiket;
      rozetEl.hidden = !etiket;
    }

    if (adEl) adEl.textContent = u.ad;
    if (kadiEl) kadiEl.textContent = "@" + u.kadi;
    if (adGirdi) adGirdi.value = u.ad;
    rozetCiz();
    avatarCiz();

    function cizCip(kap, kunye, secim) {
      var cipler = document.querySelectorAll("[" + kunye + "]");
      for (var i = 0; i < cipler.length; i++) {
        var acik = secim.has(cipler[i].getAttribute(kunye));
        cipler[i].classList.toggle("is-on", acik);
        cipler[i].setAttribute("aria-pressed", acik ? "true" : "false");
      }
    }
    function ciz() {
      cizCip(null, "data-ilgi", ilgiSecim);
      cizCip(null, "data-bildirim", bildirimSecim);
    }

    function cipTikla(kunye, secim) {
      return function () {
        var s = this.getAttribute(kunye);
        if (secim.has(s)) secim.delete(s);
        else secim.add(s);
        ciz();
        otomatikKaydet();
      };
    }
    [].forEach.call(document.querySelectorAll("[data-ilgi]"), function (c) {
      c.addEventListener("click", cipTikla("data-ilgi", ilgiSecim));
    });
    [].forEach.call(document.querySelectorAll("[data-bildirim]"), function (c) {
      c.addEventListener("click", cipTikla("data-bildirim", bildirimSecim));
    });
    ciz();

    function durum(mesaj) {
      if (durumEl) durumEl.textContent = mesaj || "";
    }

    // --- Otomatik kaydet (düğme yok): her seçim anında hesaba yazılır ---
    var kaydetZaman = null;
    async function tercihleriKaydet() {
      durum("Kaydediliyor…");
      try {
        var r = await H.profilGuncelle({
          ad: (adGirdi && adGirdi.value.trim()) || u.ad,
          ilgi: Array.from(ilgiSecim),
          bildirim_ilgi: Array.from(bildirimSecim),
        });
        if (r && r.hata) {
          durum(r.hata);
          return;
        }
        u = H.oturumOku();
        await H.pushEsle(u);
        durum("Kaydedildi ✓");
      } catch (e) {
        durum("Kaydedilemedi, tekrar dene.");
      }
    }
    function otomatikKaydet() {
      if (kaydetZaman) clearTimeout(kaydetZaman);
      kaydetZaman = setTimeout(function () {
        kaydetZaman = null;
        tercihleriKaydet();
      }, 350);
    }

    // --- Kaydet (eski düğme kaldırıldı; varsa da çalışsın) ---
    var kaydet = document.getElementById("profil-kaydet");
    kaydet &&
      kaydet.addEventListener("click", async function () {
        kaydet.disabled = true;
        try {
          await tercihleriKaydet();
        } finally {
          kaydet.disabled = false;
        }
      });

    // Görünen adı tek başına kaydet
    var adKaydet = document.getElementById("profil-ad-kaydet");
    adKaydet &&
      adKaydet.addEventListener("click", async function () {
        adKaydet.disabled = true;
        durum("Kaydediliyor…");
        try {
          var r = await H.profilGuncelle({ ad: (adGirdi && adGirdi.value.trim()) || u.ad });
          if (r && r.hata) { durum(r.hata); return; }
          u = H.oturumOku();
          if (adEl) adEl.textContent = u.ad;
          avatarCiz();
          durum("Adın güncellendi ✓");
        } catch (e) {
          durum("Güncellenemedi.");
        } finally {
          adKaydet.disabled = false;
        }
      });

    // --- Çıkış ---
    var cikis = document.getElementById("profil-cikis");
    cikis &&
      cikis.addEventListener("click", async function () {
        cikis.disabled = true;
        try { await H.cikisYap(); } catch (e) {}
        location.href = "/";
      });

    // --- Bildirim durumu ---
    var nokta = document.getElementById("profil-nokta");
    var belYazi = document.getElementById("profil-bildirim-yazi");
    var mini = document.getElementById("profil-mini");
    var belAc = document.getElementById("profil-bildirim-ac");
    var belTest = document.getElementById("profil-bildirim-test");
    var P = window.HaberinaiPush;

    function belCiz() {
      var izin = typeof Notification !== "undefined" ? Notification.permission : "yok";
      if (nokta) nokta.classList.remove("is-on", "is-engel");
      if (izin === "granted") {
        if (nokta) nokta.classList.add("is-on");
        if (belYazi) belYazi.textContent = "Bildirimler açık — bu cihaz yeni haberleri alıyor.";
        if (belAc) belAc.textContent = "Bildirimleri yenile";
        if (belTest) belTest.hidden = false;
      } else if (izin === "denied") {
        if (nokta) nokta.classList.add("is-engel");
        if (belYazi) {
          belYazi.textContent =
            "İzin engellenmiş. Adres çubuğunun yanındaki simge → İzinler → Bildirimler → İzin ver, sonra sayfayı yenile.";
        }
        if (belAc) belAc.textContent = "Nasıl açılır?";
        if (belTest) belTest.hidden = true;
      } else if (P && P.iosKuruluDegil && P.iosKuruluDegil()) {
        if (belYazi) belYazi.textContent = "iPhone: Paylaş → Ana Ekrana Ekle, sonra o ikondan aç.";
        if (belAc) belAc.textContent = "Nasıl?";
        if (belTest) belTest.hidden = true;
      } else {
        if (belYazi) belYazi.textContent = "Bildirimler kapalı — “Bildirimleri aç”a dokun.";
        if (belAc) belAc.textContent = "Bildirimleri aç";
        if (belTest) belTest.hidden = true;
      }
    }
    belCiz();

    belAc &&
      belAc.addEventListener("click", async function () {
        if (P && P.izinSor) P.izinSor(); // dokunuşun İÇİNDE
        if (typeof Notification !== "undefined" && Notification.permission === "denied") {
          if (mini) mini.textContent = "İzin tarayıcıda engelli; yukarıdaki adımları izle.";
          belCiz();
          return;
        }
        if (P && P.aboneBaslat) {
          if (mini) mini.textContent = "Açılıyor…";
          var oldu = await P.aboneBaslat();
          await H.pushEsle(H.oturumOku());
          if (mini) mini.textContent = oldu ? "Bildirimler açıldı ✓" : "Açılamadı; izni kontrol et.";
          if (oldu && P.hosgeldinBildirimi) await P.hosgeldinBildirimi();
        }
        belCiz();
      });

    belTest &&
      belTest.addEventListener("click", async function () {
        if (!P || !P.testBildirim) return;
        var gitti = await P.testBildirim();
        if (mini) mini.textContent = gitti ? "Deneme bildirimi gönderildi ✓" : "Gösterilemedi.";
      });

    // --- Profil fotoğrafı ---
    function avYaz(mesaj, hata) {
      if (avDurum) avDurum.textContent = mesaj || "";
      if (avDurum) avDurum.style.color = hata ? "var(--brand-ink, #b3121a)" : "";
    }
    avSecimler.forEach(function (btn) {
      btn.addEventListener("click", async function () {
        btn.disabled = true;
        avYaz("Kaydediliyor…");
        try {
          var r = await H.avatarAyarla(btn.getAttribute("data-avatar"));
          if (r && r.hata) {
            avYaz(r.hata, true);
            return;
          }
          avYaz("Profil fotoğrafı güncellendi ✓");
        } catch (e) {
          avYaz("Kaydedilemedi, tekrar dene.", true);
        } finally {
          btn.disabled = false;
          avatarCiz();
        }
      });
    });

    // Kendi fotoğrafı: tarayıcıda 128 px kareye küçültülür (küçük ve hızlı).
    function kucult(dosya, cb) {
      var okuyucu = new FileReader();
      okuyucu.onload = function () {
        var img = new Image();
        img.onload = function () {
          try {
            var kenar = 128;
            var cv = document.createElement("canvas");
            cv.width = kenar;
            cv.height = kenar;
            var ctx = cv.getContext("2d");
            var kisa = Math.min(img.width, img.height);
            ctx.drawImage(
              img,
              (img.width - kisa) / 2,
              (img.height - kisa) / 2,
              kisa,
              kisa,
              0,
              0,
              kenar,
              kenar,
            );
            cb(cv.toDataURL("image/jpeg", 0.82));
          } catch (e) {
            cb(null);
          }
        };
        img.onerror = function () {
          cb(null);
        };
        img.src = okuyucu.result;
      };
      okuyucu.onerror = function () {
        cb(null);
      };
      okuyucu.readAsDataURL(dosya);
    }

    var dosyaGirdi = document.getElementById("profil-dosya");
    dosyaGirdi &&
      dosyaGirdi.addEventListener("change", function () {
        var dosya = dosyaGirdi.files && dosyaGirdi.files[0];
        if (!dosya) return;
        if (dosya.size > 6 * 1024 * 1024) {
          avYaz("Dosya çok büyük (en fazla 6 MB).", true);
          dosyaGirdi.value = "";
          return;
        }
        avYaz("Fotoğraf hazırlanıyor…");
        kucult(dosya, async function (veri) {
          dosyaGirdi.value = "";
          if (!veri) {
            avYaz("Bu dosya okunamadı. PNG/JPG dene.", true);
            return;
          }
          var r = await H.avatarAyarla(veri);
          if (r && r.hata) {
            avYaz(r.hata, true);
            return;
          }
          avYaz("Fotoğrafın yüklendi ✓");
          avatarCiz();
        });
      });

    var avSil = document.getElementById("profil-avatar-sil");
    avSil &&
      avSil.addEventListener("click", async function () {
        avSil.disabled = true;
        avYaz("Kaldırılıyor…");
        try {
          var r = await H.avatarAyarla("");
          if (r && r.hata) {
            avYaz(r.hata, true);
            return;
          }
          avYaz("Profil fotoğrafı kaldırıldı (baş harfin görünür).");
        } finally {
          avSil.disabled = false;
          avatarCiz();
        }
      });

    // --- Hesabı sil ---
    var hsSil = document.getElementById("profil-hesap-sil");
    var hsDurum = document.getElementById("profil-sil-durum");
    function silYaz(mesaj) {
      if (hsDurum) hsDurum.textContent = mesaj || "";
    }
    hsSil &&
      hsSil.addEventListener("click", async function () {
        // Geri dönüşü olmayan işlem: iki adımlı onay.
        if (!window.confirm("Hesabın kalıcı olarak silinecek. Devam edilsin mi?")) return;
        var onay = (window.prompt("Silmeyi onaylamak için kullanıcı adını yaz:") || "").trim().toLowerCase();
        var suanki = H.oturumOku() || u || {};
        var beklenen = [String(suanki.kadi || ""), String(suanki.ad || "")].map(function (s) {
          return s.trim().toLowerCase();
        });
        if (!onay || beklenen.indexOf(onay) === -1) {
          silYaz("Kullanıcı adı eşleşmedi, silme iptal edildi.");
          return;
        }
        hsSil.disabled = true;
        silYaz("Hesap siliniyor…");
        try {
          var r = await H.hesapSil();
          if (r && r.hata) {
            silYaz(r.hata);
            return;
          }
          silYaz("Hesabın silindi. Yönlendiriliyorsun…");
          location.href = "/";
        } catch (e) {
          silYaz("Bir şeyler ters gitti. Tekrar dene.");
        } finally {
          hsSil.disabled = false;
        }
      });

    // --- Bildirim sıklığı + Genel Son Dakika + Hızlı Seçim ---
    var siklikEl = document.getElementById("profil-siklik");
    var siklikDurum = document.getElementById("profil-siklik-durum");
    var sondkEl = document.getElementById("profil-sondk-onay");
    var hepsiBtn = document.getElementById("profil-bildirim-hepsi");
    var temizleBtn = document.getElementById("profil-bildirim-temizle");

    hepsiBtn &&
      hepsiBtn.addEventListener("click", function () {
        [].forEach.call(document.querySelectorAll("[data-bildirim]"), function (c) {
          bildirimSecim.add(c.getAttribute("data-bildirim"));
        });
        ciz();
        otomatikKaydet();
      });

    temizleBtn &&
      temizleBtn.addEventListener("click", function () {
        bildirimSecim.clear();
        ciz();
        otomatikKaydet();
      });

    if (sondkEl) {
      try {
        sondkEl.checked = JSON.parse(localStorage.getItem("bildirim-son-dakika") || "false") === true;
      } catch (e) {
        sondkEl.checked = false;
      }
      sondkEl.addEventListener("change", async function () {
        var acik = Boolean(sondkEl.checked);
        try {
          localStorage.setItem("bildirim-son-dakika", JSON.stringify(acik));
          window.dispatchEvent(new CustomEvent("hb-bildirim-degisti"));
        } catch (e) {}
        await H.pushEsle(H.oturumOku() || u);
        if (siklikDurum) {
          siklikDurum.textContent = acik
            ? "Genel son dakika bildirimleri açıldı ✓"
            : "Yalnızca seçtiğin başlıklar gelecek ✓";
        }
      });
    }

    function siklikCiz() {
      if (!siklikEl) return;
      var g = H.oturumOku() || u;
      var mod = (g && g.bildirim_mod) || "";
      if (!mod) {
        try {
          mod = localStorage.getItem("bildirim-mod") || "";
        } catch (e) {}
      }
      if (!mod) {
        var eski = (g && g.bildirim_siklik) || "";
        if (!eski) {
          try {
            eski = localStorage.getItem("bildirim-siklik") || "aninda";
          } catch (e) {
            eski = "aninda";
          }
        }
        mod = eski === "ozet" ? "ozet" : eski === "son" ? "son" : "gun10";
      }
      if (["gun10", "hepsi", "ozet", "son", "kapali"].indexOf(mod) < 0) mod = "gun10";
      siklikEl.value = mod;
    }
    siklikCiz();
    siklikEl &&
      siklikEl.addEventListener("change", async function () {
        var deger = siklikEl.value;
        siklikEl.disabled = true;
        if (siklikDurum) siklikDurum.textContent = "Kaydediliyor…";
        try {
          var r = await H.bildirimSiklik(deger);
          if (r && r.hata) {
            if (siklikDurum) siklikDurum.textContent = r.hata;
            return;
          }
          u = H.oturumOku() || u;
          window.dispatchEvent(new CustomEvent("hb-bildirim-degisti"));
          if (siklikDurum) {
            siklikDurum.textContent =
              deger === "ozet"
                ? "Günde 3 özet seçildi ✓"
                : deger === "son"
                  ? "Yalnızca son dakika seçildi ✓"
                  : deger === "hepsi"
                    ? "Seçtiğin başlıklardaki tüm haberler açık ✓"
                    : deger === "kapali"
                      ? "Bildirimler duraklatıldı ✓"
                      : "Günde ~10 bildirim (Dengeli) seçildi ✓";
          }
        } catch (e) {
          if (siklikDurum) siklikDurum.textContent = "Kaydedilemedi, tekrar dene.";
        } finally {
          siklikEl.disabled = false;
        }
      });

    // --- Yönetim: kayıtlı okurlar + rozet (yalnızca yönetici) ---
    var yonetim = document.getElementById("profil-yonetim");
    var uyelerEl = document.getElementById("profil-uyeler");
    var uyeAra = document.getElementById("profil-uye-ara");
    var yonDurum = document.getElementById("profil-yonetim-durum");
    var uyeListe = [];
    var yonetimYuklendi = false;

    function tarihYaz(iso) {
      try {
        return new Date(iso).toLocaleDateString("tr-TR", {
          day: "2-digit",
          month: "short",
          year: "numeric",
        });
      } catch (e) {
        return "";
      }
    }

    function uyelerCiz() {
      if (!uyelerEl) return;
      var ara = ((uyeAra && uyeAra.value) || "").trim().toLocaleLowerCase("tr");
      uyelerEl.textContent = "";
      var goster = uyeListe.filter(function (x) {
        if (!ara) return true;
        var metin = String(x.ad || "") + " " + String(x.kadi || "");
        return metin.toLocaleLowerCase("tr").indexOf(ara) >= 0;
      });
      if (!goster.length) {
        var bos = document.createElement("p");
        bos.className = "profil__bos";
        bos.textContent = uyeListe.length
          ? "Aramaya uyan okur yok."
          : "Henüz kayıtlı okur yok.";
        uyelerEl.appendChild(bos);
        return;
      }
      goster.forEach(function (x) {
        var satir = document.createElement("div");
        satir.className = "profil__uye";

        var av = document.createElement("span");
        av.className = "profil__uye-av";
        av.setAttribute("aria-hidden", "true");
        if (H.avatarDoldur) H.avatarDoldur(av, x.avatar, x.ad);

        var kim = document.createElement("div");
        kim.className = "profil__uye-kim";
        var b = document.createElement("b");
        b.textContent = x.ad || x.kadi || "Okur";
        var alt = document.createElement("span");
        var parcalar = ["@" + (x.kadi || "?")];
        if (x.olusturma) parcalar.push(tarihYaz(x.olusturma));
        if (x.yorum) parcalar.push(x.yorum + " yorum");
        alt.textContent = parcalar.join(" · ");
        kim.append(b, alt);

        var girdi = document.createElement("input");
        girdi.className = "profil__girdi profil__uye-etiket";
        girdi.type = "text";
        girdi.maxLength = 24;
        girdi.value = x.etiket || "";
        girdi.placeholder = "Rozet (ör. Yönetici) — sadece görünür";
        girdi.setAttribute("aria-label", (x.ad || x.kadi) + " için rozet");

        var kaydetBtn = document.createElement("button");
        kaydetBtn.type = "button";
        kaydetBtn.className = "profil__uye-kaydet";
        kaydetBtn.textContent = "Kaydet";
        kaydetBtn.addEventListener("click", async function () {
          kaydetBtn.disabled = true;
          if (yonDurum) yonDurum.textContent = "Kaydediliyor…";
          try {
            var r = await H.adminEtiket(x.id, girdi.value.trim());
            if (r && r.hata) {
              if (yonDurum) yonDurum.textContent = r.hata;
              return;
            }
            x.etiket = r && r.etiket != null ? r.etiket : girdi.value.trim();
            var ben = H.oturumOku();
            if (ben && ben.id === x.id) {
              ben.etiket = x.etiket;
              try {
                localStorage.setItem("hb-oturum", JSON.stringify(ben));
              } catch (e) {}
              u = ben;
              rozetCiz();
            }
            if (yonDurum) yonDurum.textContent = "Rozet kaydedildi (yetki vermez) ✓";
          } catch (e) {
            if (yonDurum) yonDurum.textContent = "Kaydedilemedi, tekrar dene.";
          } finally {
            kaydetBtn.disabled = false;
          }
        });

        satir.append(av, kim, girdi, kaydetBtn);
        uyelerEl.appendChild(satir);
      });
    }

    // Canlı Yönetim Paneli Elemanları
    var yonCanliToplam = document.getElementById("yon-canli-toplam");
    var yonCanliDetay = document.getElementById("yon-canli-detay");
    var yonKayitliToplam = document.getElementById("yon-kayitli-toplam");
    var yonAktifUyeSayisi = document.getElementById("yon-aktif-uye-sayisi");
    var yonSayfalarBlok = document.getElementById("yon-sayfalar-blok");
    var yonSayfalar = document.getElementById("yon-sayfalar");
    var yonAktiflerBlok = document.getElementById("yon-aktifler-blok");
    var yonSonAktifler = document.getElementById("yon-son-aktifler");
    var yonYenileBtn = document.getElementById("profil-yonetim-yenile");

    function zamanGoreceli(iso) {
      if (!iso) return "Bilinmiyor";
      try {
        var fark = Date.now() - new Date(iso).getTime();
        var dk = Math.floor(fark / 60000);
        if (dk < 1) return "Az önce";
        if (dk < 60) return dk + " dk önce";
        var saat = Math.floor(dk / 60);
        if (saat < 24) return saat + " saat önce";
        var gun = Math.floor(saat / 24);
        return gun + " gün önce";
      } catch (e) {
        return "";
      }
    }

    function sayfalarCiz(sayfalar) {
      if (!yonSayfalar || !yonSayfalarBlok) return;
      if (!Array.isArray(sayfalar) || !sayfalar.length) {
        yonSayfalarBlok.hidden = true;
        return;
      }
      yonSayfalarBlok.hidden = false;
      yonSayfalar.textContent = "";
      sayfalar.forEach(function (s) {
        var a = document.createElement("a");
        a.className = "profil__sayfa-cip";
        a.href = s.sayfa || "/";
        a.target = "_blank";
        a.rel = "noopener";

        var ad = document.createElement("span");
        ad.className = "profil__sayfa-ad";
        ad.textContent = s.sayfa === "/" ? "Ana Sayfa (/)" : s.sayfa;

        var sayi = document.createElement("span");
        sayi.className = "profil__sayfa-sayi";
        sayi.textContent = s.ziyaretci + " kişi";

        a.append(ad, sayi);
        yonSayfalar.appendChild(a);
      });
    }

    function sonAktiflerCiz(aktifler) {
      if (!yonSonAktifler || !yonAktiflerBlok) return;
      if (!Array.isArray(aktifler) || !aktifler.length) {
        yonAktiflerBlok.hidden = true;
        return;
      }
      yonAktiflerBlok.hidden = false;
      yonSonAktifler.textContent = "";
      aktifler.forEach(function (m) {
        var kart = document.createElement("div");
        kart.className = "profil__aktif-kart";

        var av = document.createElement("div");
        av.className = "profil__aktif-av";
        H.avatarDoldur(av, m.avatar, m.ad || m.kadi);

        var nokta = document.createElement("span");
        nokta.className = "profil__aktif-nokta" + (m.canli_mi ? "" : " profil__aktif-nokta--cevrimdisi");
        av.appendChild(nokta);

        var bilgi = document.createElement("div");
        bilgi.className = "profil__aktif-bilgi";

        var b = document.createElement("b");
        b.textContent = (m.ad || m.kadi) + (m.etiket ? " · " + m.etiket : "");

        var span = document.createElement("span");
        span.textContent = m.canli_mi
          ? "🟢 Çevrimiçi (" + (m.sayfa || "/") + ")"
          : "Son aktif: " + zamanGoreceli(m.son_aktif);

        bilgi.append(b, span);
        kart.append(av, bilgi);
        yonSonAktifler.appendChild(kart);
      });
    }

    var yonetimInterval = null;
    async function yonetimGuncelle(sessiz) {
      var g = H.oturumOku() || u;
      if (!g || g.rol !== "yonetici") {
        if (yonetim) yonetim.hidden = true;
        if (yonetimInterval) clearInterval(yonetimInterval);
        return;
      }
      if (yonetim) yonetim.hidden = false;
      if (!sessiz && yonDurum) yonDurum.textContent = "Veriler güncelleniyor…";

      try {
        // Öncelik: Tam canlı istatistik RPC'si
        if (H.adminCanliIstatistik) {
          var r = await H.adminCanliIstatistik();
          if (r && !r.hata) {
            if (yonCanliToplam) yonCanliToplam.textContent = r.canli_toplam || 0;
            if (yonCanliDetay) {
              yonCanliDetay.textContent = (r.canli_uye || 0) + " üye · " + (r.canli_anonim || 0) + " misafir";
            }
            if (yonKayitliToplam) {
              yonKayitliToplam.textContent = (r.kayitli_uyeler || []).length;
            }
            if (yonAktifUyeSayisi) {
              yonAktifUyeSayisi.textContent = (r.son_aktif_uyeler || []).length;
            }

            sayfalarCiz(r.sayfalar);
            sonAktiflerCiz(r.son_aktif_uyeler);

            uyeListe = Array.isArray(r.kayitli_uyeler) ? r.kayitli_uyeler : [];
            uyelerCiz();
            if (yonDurum) {
              yonDurum.textContent = uyeListe.length + " kayıtlı okur · Canlı";
            }
            return;
          }
        }

        // Yedek: Eski admin_uyeler RPC'si
        var r2 = await H.adminUyeler();
        if (r2 && !r2.hata) {
          uyeListe = Array.isArray(r2) ? r2 : r2 && Array.isArray(r2.uyeler) ? r2.uyeler : [];
          if (yonKayitliToplam) yonKayitliToplam.textContent = uyeListe.length;
          uyelerCiz();
          if (yonDurum) {
            yonDurum.textContent = uyeListe.length + " kayıtlı okur";
          }
        } else if (r2 && r2.hata && yonDurum) {
          yonDurum.textContent = r2.hata;
        }
      } catch (e) {
        if (!sessiz && yonDurum) yonDurum.textContent = "Güncellenemedi, tekrar dene.";
      }
    }

    async function yonetimKur() {
      var g = H.oturumOku() || u;
      // Yönetici kontrolü: 'yonetici' rolü olmayan kesinlikle göremez.
      if (!g || g.rol !== "yonetici") {
        if (yonetim) yonetim.hidden = true;
        return;
      }
      if (yonetim) yonetim.hidden = false;
      if (yonetimYuklendi) return;
      yonetimYuklendi = true;

      await yonetimGuncelle(false);

      // Panel açıkken her 12 saniyede bir canlı verileri arka planda tazele
      if (!yonetimInterval) {
        yonetimInterval = setInterval(function () {
          if (document.visibilityState === "visible") {
            yonetimGuncelle(true);
          }
        }, 12000);
      }
    }

    if (yonYenileBtn) {
      yonYenileBtn.addEventListener("click", function () {
        yonetimGuncelle(false);
      });
    }

    uyeAra && uyeAra.addEventListener("input", uyelerCiz);

    // Eski oturumlarda rol/etiket/bildirim_siklik alanları yok: sunucudan tazele.
    if (H.profilTazele) {
      H.profilTazele().then(function (yeni) {
        if (!yeni) return;
        u = yeni;
        if (adEl) adEl.textContent = u.ad;
        if (kadiEl) kadiEl.textContent = "@" + u.kadi;
        if (adGirdi) adGirdi.value = u.ad;
        rozetCiz();
        siklikCiz();
        yonetimKur();
        // Sunucudaki seçimler ekranda görünsün: eskiden tazeleme yalnızca
        // oturumu güncelliyor, çipler boş kalıyordu ("seçmiştim, gelmiyor").
        var yIlgi = new Set(u.ilgi || []);
        var yBildirim = new Set(u.bildirim_ilgi || []);
        if (!yBildirim.size && yIlgi.size) {
          yIlgi.forEach(function (s) {
            yBildirim.add(s);
          });
        }
        ilgiSecim.clear();
        yIlgi.forEach(function (s) {
          ilgiSecim.add(s);
        });
        bildirimSecim.clear();
        yBildirim.forEach(function (s) {
          bildirimSecim.add(s);
        });
        ciz();
      });
    }
    yonetimKur();

    // --- Okuma listesi ---
    var kListe = document.getElementById("profil-kayitlar");
    var kBos = document.getElementById("profil-kayit-bos");
    if (H.kayitlar) {
      H.kayitlar().then(function (gelen) {
        var veri = Array.isArray(gelen) ? gelen : [];
        if (!kListe) return;
        kListe.textContent = "";
        if (!veri.length) {
          if (kBos) kBos.hidden = false;
          return;
        }
        if (kBos) kBos.hidden = true;
        veri.forEach(function (k) {
          var li = document.createElement("li");
          li.className = "profil__yorum";
          var a = document.createElement("a");
          a.href = "/haber/" + k.slug + "/";
          a.textContent = k.baslik || "Habere git →";
          var t = document.createElement("time");
          try {
            t.textContent = new Date(k.created_at).toLocaleString("tr-TR");
          } catch (e) {
            t.textContent = "";
          }
          li.append(a, t);
          kListe.appendChild(li);
        });
      });
    }

    // --- Yorumlarım ---
    var liste = document.getElementById("profil-yorumlar");
    var bos = document.getElementById("profil-yorum-bos");
    H.yorumlarim().then(function (liste2) {
      if (!liste) return;
      var veri = Array.isArray(liste2) ? liste2 : [];
      liste.textContent = "";
      if (!veri.length) {
        if (bos) bos.hidden = false;
        return;
      }
      if (bos) bos.hidden = true;
      veri.forEach(function (y) {
        var li = document.createElement("li");
        li.className = "profil__yorum";
        var a = document.createElement("a");
        a.href = "/haber/" + y.slug + "/";
        a.textContent = "Habere git →";
        var p = document.createElement("p");
        p.textContent = y.metin;
        var t = document.createElement("time");
        try {
          t.textContent = new Date(y.created_at).toLocaleString("tr-TR");
        } catch (e) {
          t.textContent = "";
        }
        li.append(a, p, t);
        liste.appendChild(li);
      });
    });
  })();
</script>


<style is:global>
  /* ========================================================================
     DİNAMİK YÖNETİM & OKUR LİSTESİ STİLLERİ (JavaScript ile üretilenler)
     ======================================================================== */
  .profil__uyeler {
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
    margin-top: 10px !important;
  }
  .profil__uye {
    display: grid !important;
    grid-template-columns: 38px minmax(0, 1fr) minmax(110px, 160px) auto !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 10px 14px !important;
    border: 1px solid var(--border) !important;
    border-radius: 12px !important;
    background: var(--bg) !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }
  .profil__uye-av {
    width: 38px !important;
    height: 38px !important;
    min-width: 38px !important;
    min-height: 38px !important;
    max-width: 38px !important;
    max-height: 38px !important;
    border-radius: 999px !important;
    overflow: hidden !important;
    display: grid !important;
    place-items: center !important;
    background: var(--brand-grad) !important;
    color: #fff !important;
    font-weight: 800 !important;
    font-size: 0.88rem !important;
    flex-shrink: 0 !important;
    box-sizing: border-box !important;
  }
  .profil__uye-av img,
  .profil__uye-av .hb-av-img {
    width: 100% !important;
    height: 100% !important;
    max-width: 38px !important;
    max-height: 38px !important;
    object-fit: cover !important;
    border-radius: 999px !important;
    display: block !important;
  }
  .profil__uye-kim {
    min-width: 0 !important;
    line-height: 1.3 !important;
  }
  .profil__uye-kim b {
    display: block !important;
    font-size: 0.88rem !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    color: var(--text) !important;
  }
  .profil__uye-kim span {
    display: block !important;
    font-size: 0.74rem !important;
    color: var(--muted) !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
  }
  .profil__uye-etiket {
    width: 100% !important;
    padding: 7px 10px !important;
    font-size: 0.82rem !important;
    border-radius: 8px !important;
    border: 1px solid var(--border) !important;
    background: var(--surface) !important;
    color: var(--text) !important;
    box-sizing: border-box !important;
  }
  .profil__uye-kaydet {
    padding: 7px 14px !important;
    border: 0 !important;
    border-radius: 8px !important;
