<script is:inline>
  (function () {
    var H = window.HaberinAi;
    var giris = document.getElementById("profil-giris");
    var icerik = document.getElementById("profil-icerik");
    if (!H || !icerik) return;

    var u = H.oturumOku ? H.oturumOku() : null;
    if (!u) {
      if (giris) giris.hidden = false;
      icerik.hidden = true;
      return;
    }
    icerik.hidden = false;

    var ilgiSecim = new Set(u.ilgi || []);
    var bildirimSecim = new Set(u.bildirim_ilgi || []);

    var avatar = document.getElementById("profil-avatar");
    var adEl = document.getElementById("profil-ad");
    var kadiEl = document.getElementById("profil-kadi-metin");
    var rozetEl = document.getElementById("profil-rozet");
    var adGirdi = document.getElementById("profil-ad-girdi");
    var durumEl = document.getElementById("profil-durum");
    var onizleme = document.getElementById("profil-onizleme");
    var avDurum = document.getElementById("profil-avatar-durum");
    var avSecimler = [].slice.call(document.querySelectorAll("[data-avatar]"));

    // Avatarı hem üstte hem önizlemede gösterir, seçili hazır avatari işaretler.
    function avatarCiz() {
      var g = H.oturumOku() || u;
      if (avatar) H.avatarDoldur && H.avatarDoldur(avatar, g.avatar, g.ad);
      if (onizleme) H.avatarDoldur && H.avatarDoldur(onizleme, g.avatar, g.ad);
      for (var i = 0; i < avSecimler.length; i++) {
        var on = g.avatar === avSecimler[i].getAttribute("data-avatar");
        avSecimler[i].classList.toggle("is-on", on);
        avSecimler[i].setAttribute("aria-pressed", String(on));
      }
    }

    /** Yönetici rozetini (varsa) ada bitişik gösterir. */
    function rozetCiz() {
      if (!rozetEl) return;
      var g = H.oturumOku() || u;
      var etiket = (g && g.etiket) || "";
      rozetEl.textContent = etiket;
      rozetEl.hidden = !etiket;
    }

    var acikLink = document.getElementById("profil-acik-link");
    var ilgiSayac = document.getElementById("profil-ilgi-sayac");
    if (adEl) adEl.textContent = u.ad;
