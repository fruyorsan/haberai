    // Kendi fotoğrafı: tarayıcıda 128 px kareye küçültülür (küçük ve hızlı).
    function kucult(dosya, cb) {
      var okuyucu = new FileReader();
      okuyucu.onload = function () {
        var img = new Image();
        img.onload = function () {
          try {
            var kenar = 128;
            var cv = document.createElement("canvas");
            cv.width = kenar;
            cv.height = kenar;
            var ctx = cv.getContext("2d");
            var kisa = Math.min(img.width, img.height);
            ctx.drawImage(
              img,
              (img.width - kisa) / 2,
              (img.height - kisa) / 2,
              kisa,
              kisa,
              0,
              0,
              kenar,
              kenar,
            );
            cb(cv.toDataURL("image/jpeg", 0.82));
          } catch (e) {
            cb(null);
          }
        };
        img.onerror = function () {
          cb(null);
        };
        img.src = okuyucu.result;
      };
      okuyucu.onerror = function () {
        cb(null);
      };
      okuyucu.readAsDataURL(dosya);
    }

