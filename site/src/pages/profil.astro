      var cipler = document.querySelectorAll("[" + kunye + "]");
      for (var i = 0; i < cipler.length; i++) {
        var acik = secim.has(cipler[i].getAttribute(kunye));
        cipler[i].classList.toggle("is-on", acik);
        cipler[i].setAttribute("aria-pressed", acik ? "true" : "false");
      }
    }
    function ciz() {
      cizCip(null, "data-ilgi", ilgiSecim);
      cizCip(null, "data-bildirim", bildirimSecim);
