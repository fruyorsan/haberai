---
import Base from "../layouts/Base.astro";
import { HESAP, KATEGORILER, AVATARLAR } from "../lib/site-meta.js";

const hazir = Boolean(HESAP.url && HESAP.anahtar);
---

<Base
  title="Profilim — HaberinAi"
  description="Hesabın: ilgi alanlarını seç, bildirim konularını yönet, yorumlarını gör."
  noindex
>
  <div class="container profil">
    {!hazir && (
      <p class="profil__kapali">
        Hesap hizmeti şu an kullanılamıyor. Lütfen daha sonra tekrar deneyin.
      </p>
    )}

    {/* Giriş yapılmamışsa */}
    <div class="profil__giris" id="profil-giris" hidden>
      <h1>Profil için giriş gerekli</h1>
      <p>İlgi alanlarını seçmek, bildirimlerini yönetmek ve yorumlarını görmek için hesabına gir.</p>
      <a class="profil__btn" href="/hesap/">Giriş yap / Hesap oluştur</a>
    </div>

    {/* Giriş yapılmışsa */}
    <div id="profil-icerik" hidden>
      <header class="profil__ust">
        <span class="profil__avatar" id="profil-avatar" aria-hidden="true"></span>
        <div class="profil__kim">
          <h1 id="profil-ad">Profilim</h1>
          <p class="profil__kadi">
            <span id="profil-kadi-metin"></span>
            <span class="profil__rozet" id="profil-rozet" hidden></span>
          </p>
        </div>
        <div class="profil__ust-aksiyon">
          <a class="profil__acik-link" id="profil-acik-link" href="/kullanici/" hidden>Açık profilim</a>
          <button type="button" class="profil__cikis" id="profil-cikis">Çıkış yap</button>
        </div>
      </header>

      <div class="profil__yerlesim">
        <nav class="profil__nav" id="profil-nav" aria-label="Profil bölümleri">
          <a href="#hesap" class="is-active">Hesap bilgileri</a>
          <a href="#ilgi">İlgi alanları</a>
          <a href="#bildirimler">Bildirimler</a>
          <a href="#kayitlar">Okuma listesi</a>
          <a href="#yorumlar">Yorumlar</a>
          <a href="#profil-yonetim" class="profil__nav-yonetim">Yönetim</a>
          <a href="#hesap-sil" class="profil__nav-tehlike">Hesabı sil</a>
        </nav>
        <div class="profil__akis">

      <section class="profil__blok" id="hesap">
        <h2 class="profil__h2">Hesap bilgileri</h2>
        <h3 class="profil__h3">Görünen ad</h3>
        <p class="profil__aciklama">Yorumlarında bu ad görünür.</p>
        <div class="profil__satir">
          <input class="profil__girdi" id="profil-ad-girdi" type="text" maxlength="40" placeholder="Adın" />
          <button type="button" class="profil__btn profil__btn--kucuk" id="profil-ad-kaydet">Kaydet</button>
        </div>
        <span class="profil__mini" id="profil-ad-durum" role="status" aria-live="polite"></span>

        <h3 class="profil__h3 profil__h3--ayrac">Profil fotoğrafı</h3>
        <p class="profil__aciklama">
          Hazır bir desen seç ya da kendi fotoğrafını yükle. Yorumlarında ve
          üstteki hesap düğmesinde görünür.
        </p>
        <div class="profil__avatar-satir">
          <span class="profil__onizleme" id="profil-onizleme" aria-hidden="true"></span>
          <div class="profil__avatar-islem">
            <label class="profil__btn profil__btn--kucuk profil__dosya">
              Fotoğraf yükle
              <input type="file" id="profil-dosya" accept="image/*" hidden />
            </label>
            <button
              type="button"
              class="profil__btn profil__btn--kucuk profil__btn--ghost"
              id="profil-avatar-sil"
            >
              Kaldır
            </button>
          </div>
        </div>
        <div class="profil__avatarlar" id="profil-avatarlar">
          {AVATARLAR.map((a) => (
            <button
              type="button"
              class="profil__avatar-sec"
              data-avatar={a.kod}
              title={a.ad}
              aria-label={a.ad}
              aria-pressed="false"
              style={`--av-renk:${a.renk}`}
            >
              <img
                class="profil__avatar-resim"
                src={a.kod}
                alt=""
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
        <span class="profil__mini" id="profil-avatar-durum" role="status" aria-live="polite"></span>
      </section>

      <section class="profil__blok" id="ilgi">
        <div class="profil__baslik-satir">
          <h2 class="profil__h2">İlgi alanları</h2>
          <div class="profil__baslik-sag">
            <span class="profil__mini" id="profil-durum" role="status" aria-live="polite"></span>
            <span class="profil__sayac" id="profil-ilgi-sayac"></span>
          </div>
        </div>
        <p class="profil__aciklama">
          Seçtiğin konular Shorts akışında “Sana özel” sıralamada öne çıkar ve
          ana sayfada önerilir. İstediğin kadar seçebilirsin.
        </p>
        <div class="profil__cipler" id="profil-ilgi">
          {KATEGORILER.map((k) => (
            <button type="button" class="profil__cip" data-ilgi={k.slug} aria-pressed="false">
              {k.ad}
            </button>
          ))}
        </div>
      </section>

      <section class="profil__blok" id="bildirimler">
        <div class="profil__baslik-satir">
          <h2 class="profil__h2">Bildirimler</h2>
          <div class="profil__hizli-sec">
            <button type="button" class="profil__mini-btn" id="profil-bildirim-hepsi">Tümünü seç</button>
            <button type="button" class="profil__mini-btn" id="profil-bildirim-temizle">Temizle</button>
          </div>
        </div>
        <p class="profil__aciklama">
          Sana <b>yalnızca aşağıdan seçtiğin başlıklardan</b> bildirim gelir; seçmediğin
          kategorilerden veya genel son dakikalardan rahatsız edilmezsin. Varsayılan olarak
          günde en fazla ~10 önemli gelişme dengeli aralıklarla gönderilir. İstersen aşağıdan
          tüm haberleri açabilir veya özet moduna geçebilirsin.
        </p>
        <div class="profil__cipler" id="profil-bildirim">
          {KATEGORILER.map((k) => (
            <button type="button" class="profil__cip" data-bildirim={k.slug} aria-pressed="false">
              {k.ad}
            </button>
          ))}
        </div>

        <div class="profil__siklik">
          <label class="profil__siklik-etiket" for="profil-siklik">Günlük bildirim sıklığı</label>
          <select class="profil__girdi" id="profil-siklik">
            <option value="gun10">Dengeli — Seçtiğim başlıklardan günde ~10 bildirim (Önerilen)</option>
            <option value="hepsi">Tüm haberler — Seçtiğim başlıklardaki her yeni haber gelsin</option>
            <option value="ozet">Günde 3 özet — 09:00 · 15:00 · 21:00</option>
            <option value="son">Sadece son dakika haberleri</option>
            <option value="kapali">Bildirimleri duraklat (Sessiz mod)</option>
          </select>
          <span class="profil__mini" id="profil-siklik-durum" role="status" aria-live="polite"></span>
        </div>

        <label class="profil__sondk-satir" for="profil-sondk-onay">
          <input type="checkbox" id="profil-sondk-onay" />
          <span>Seçtiğim başlıklar dışındaki genel <b>Son Dakika</b> haberleri de gelsin (varsayılan: kapalı)</span>
        </label>

        <div class="profil__bildirim-durum" id="profil-bildirim-durum">
          <span class="profil__nokta" id="profil-nokta" aria-hidden="true"></span>
          <span id="profil-bildirim-yazi">Bildirim durumu kontrol ediliyor…</span>
        </div>

        <div class="profil__islem">
          <button type="button" class="profil__btn profil__btn--kucuk" id="profil-bildirim-ac">
            Bildirimleri aç
          </button>
          <button type="button" class="profil__btn profil__btn--kucuk profil__btn--ghost" id="profil-bildirim-test">
            Deneme bildirimi
          </button>
          <span class="profil__mini" id="profil-mini" role="status" aria-live="polite"></span>
        </div>
      </section>

      <section class="profil__blok" id="kayitlar">
        <div class="profil__baslik-satir">
          <h2 class="profil__h2">Okuma listesi</h2>
          <span class="profil__sayac" id="profil-kayit-sayac" hidden></span>
        </div>
        <p class="profil__aciklama">
          Kaydettiğin haberler hesabında saklanır; başka bir cihazdan girdiğinde
          de listende durur.
        </p>
        <ul class="profil__yorumlar" id="profil-kayitlar"></ul>
        <button type="button" class="profil__daha-fazla" id="profil-kayit-daha" hidden></button>
        <p class="profil__bos" id="profil-kayit-bos" hidden>
          Henüz kaydettiğin haber yok. Haber sayfasındaki yer imi düğmesiyle ekleyebilirsin.
        </p>
      </section>

      <section class="profil__blok" id="yorumlar">
        <div class="profil__baslik-satir">
          <h2 class="profil__h2">Yorumların</h2>
          <span class="profil__sayac" id="profil-yorum-sayac" hidden></span>
        </div>
        <p class="profil__aciklama">
          Haberlerin altına bıraktığın yorumların geçmişi.
        </p>
        <ul class="profil__yorumlar" id="profil-yorumlar"></ul>
        <button type="button" class="profil__daha-fazla" id="profil-yorum-daha" hidden></button>
        <p class="profil__bos" id="profil-yorum-bos" hidden>Henüz yorumun yok.</p>
      </section>

      <section class="profil__blok profil__yonetim-alani" id="profil-yonetim" hidden>
        <div class="profil__yonetim-ust">
          <div>
            <h2 class="profil__h2">Yönetim paneli</h2>
            <p class="profil__aciklama">
              Sitenin anlık canlı ziyaretçileri, son aktif üyeleri ve kayıtlı kullanıcıları. Yalnızca <strong>Yönetici</strong> rolündeki hesabına görünür.
            </p>
          </div>
          <div class="profil__yonetim-aksiyon">
            <span class="profil__canli-etiket" id="yon-canli-durum-rozet">
              <span class="profil__canli-nokta"></span>
              Canlı Takip
            </span>
            <button type="button" class="profil__btn profil__btn--kucuk profil__btn--ghost" id="profil-yonetim-yenile">
              Yenile
            </button>
          </div>
        </div>

        {/* Canlı Sayaç & Metrik Kartları */}
        <div class="profil__metrik-izgara">
          <div class="profil__metrik-kart profil__metrik--canli">
            <div class="profil__metrik-baslik">
              <span class="profil__canli-nokta"></span>
              Şu an sitede
            </div>
            <div class="profil__metrik-sayi" id="yon-canli-toplam">0</div>
            <div class="profil__metrik-alt" id="yon-canli-detay">0 üye · 0 misafir</div>
          </div>

          <div class="profil__metrik-kart">
            <div class="profil__metrik-baslik">Kayıtlı okur</div>
            <div class="profil__metrik-sayi" id="yon-kayitli-toplam">0</div>
            <div class="profil__metrik-alt" id="yon-kayitli-detay">Sitede hesabı olanlar</div>
          </div>

          <div class="profil__metrik-kart">
            <div class="profil__metrik-baslik">Son 24 saatte aktif</div>
            <div class="profil__metrik-sayi" id="yon-aktif-uye-sayisi">0</div>
            <div class="profil__metrik-alt">Sitede hareket eden üye</div>
          </div>
        </div>

        {/* Canlı Gezilen Sayfalar */}
        <div class="profil__alt-blok" id="yon-sayfalar-blok" hidden>
          <h3 class="profil__alt-baslik">Şu an okunan sayfalar</h3>
          <div class="profil__sayfalar-liste" id="yon-sayfalar"></div>
        </div>

        {/* Son Aktif Üyeler */}
        <div class="profil__alt-blok" id="yon-aktifler-blok" hidden>
          <h3 class="profil__alt-baslik">Çevrimiçi ve son aktif üyeler</h3>
          <div class="profil__aktifler-liste" id="yon-son-aktifler"></div>
        </div>

        {/* Tüm Kayıtlı Üyeler ve Rozet Yönetimi */}
        <div class="profil__alt-blok">
          <div class="profil__baslik-satir">
            <h3 class="profil__alt-baslik">Üyeler ve rozetler</h3>
            <span class="profil__mini" id="profil-yonetim-durum" role="status" aria-live="polite"></span>
          </div>
          <p class="profil__aciklama">
            Okurlara özel unvan ve rozet yazabilirsin (ör. “Yönetici”, “Editör”, “İlk Okur”, “Teknoloji Meraklısı”).
          </p>
          <input
            class="profil__girdi profil__uye-ara"
            id="profil-uye-ara"
            type="search"
            placeholder="Ada ya da kullanıcı adına göre ara..."
            autocomplete="off"
          />
          <div class="profil__uyeler" id="profil-uyeler"></div>
        </div>
      </section>

      <section class="profil__blok profil__blok--tehlike" id="hesap-sil">
        <h2 class="profil__h2">Hesabımı sil</h2>
        <p class="profil__aciklama">
          Hesabını kalıcı olarak kapatır. Profil fotoğrafın, okuma listen ve
          beğenilerin silinir; yorumların takma adla kalmaya devam eder.
          <a href="/gizlilik/" target="_blank" rel="noopener">Gizlilik Politikası</a>
        </p>
        <div class="profil__islem">
          <button type="button" class="profil__btn profil__btn--kucuk profil__btn--sil" id="profil-hesap-sil">
            Hesabımı sil
          </button>
          <span class="profil__mini" id="profil-sil-durum" role="status" aria-live="polite"></span>
        </div>
      </section>
        </div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .profil {
    max-width: 1040px;
    margin: 36px auto 70px;
  }
  .profil__yerlesim {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .profil__nav {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .profil__nav a {
    padding: 9px 12px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
  }
  .profil__nav a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .profil__nav a.is-active {
    background: var(--brand-soft, rgba(217, 54, 75, 0.12));
    color: var(--brand-strong, #d9364b);
    font-weight: 700;
  }
  .profil__ust-aksiyon {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .profil__acik-link {
    padding: 9px 13px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: transparent;
    color: var(--text-2);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .profil__acik-link:hover {
    border-color: var(--brand);
    color: var(--text);
  }
  .profil__sayac {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-2);
    font-size: 0.74rem;
    font-weight: 700;
  }
  .profil__nav .profil__nav-tehlike {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    border-radius: 0 0 10px 10px;
    color: var(--muted);
  }
  /* Yönetim bağlantısı yalnızca yönetim paneli görünürken çıkar. */
  .profil__yerlesim:has(#profil-yonetim[hidden]) .profil__nav-yonetim {
    display: none;
  }
  .profil__akis > .profil__blok {
    scroll-margin-top: 90px;
  }
  .profil__h3 {
    margin: 10px 0 2px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
  }
  .profil__h3--ayrac {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .profil__yerlesim {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .profil__nav {
      position: static;
      flex-direction: row;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 6px;
    }
    .profil__nav a {
      white-space: nowrap;
      flex-shrink: 0;
    }
    .profil__nav .profil__nav-tehlike {
      margin: 0;
      padding-top: 9px;
      border-top: 0;
      border-radius: 10px;
    }
  }
  .profil__kapali {
    padding: 12px 14px;
    border: 1px dashed var(--border);
    border-radius: 12px;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .profil__giris {
    padding: 32px 24px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    text-align: center;
  }
  .profil__giris h1 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .profil__giris p {
    color: var(--text-2);
    font-size: 0.92rem;
    margin-bottom: 18px;
  }
  .profil__ust {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 18px;
  }
  .profil__avatar {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 900;
    font-size: 1.3rem;
  }
  .profil__kim {
    min-width: 0;
    flex: 1;
  }
  .profil__kim h1 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profil__kadi {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin: 2px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  /* Yönetici rozeti: kırmızı-beyaz, küçük ve dikkat çekmeden görünür. */
  .profil__rozet {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--brand-grad, #d9364b);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.5;
    white-space: nowrap;
  }
  .profil__rozet::before {
    content: "★";
    font-size: 0.62rem;
    opacity: 0.9;
  }
  .profil__siklik {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .profil__siklik-etiket {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-2);
  }
  .profil__siklik .profil__girdi {
    flex: 1 1 220px;
    padding: 8px 10px;
    font-size: 0.84rem;
  }
  .profil__uye-ara {
    width: 100%;
    margin: 10px 0 6px;
    padding: 9px 11px;
    font-size: 0.86rem;
  }
  .profil__uyeler {
    display: grid;
    gap: 8px;
  }
  .profil__uye {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) minmax(120px, 170px) auto;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--bg);
  }
  .profil__uye-av {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .profil__uye-av img,
  .profil__aktif-av img,
  .profil__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
    display: block;
  }
  .profil__uye-kim {
    min-width: 0;
    line-height: 1.25;
  }
  .profil__uye-kim b {
    display: block;
    font-size: 0.86rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profil__uye-kim span {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profil__uye-etiket {
    width: 100%;
    padding: 7px 9px;
    font-size: 0.8rem;
  }
  .profil__uye-kaydet {
    padding: 7px 11px;
    border: 0;
    border-radius: 9px;
    background: var(--brand-grad);
    color: #fff;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
  }
  .profil__uye-kaydet:disabled {
    opacity: 0.55;
    cursor: wait;
  }
  .profil__blok {
    padding: 18px 20px;
