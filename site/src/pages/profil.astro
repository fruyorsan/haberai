        bilgi.append(b, span);
        kart.append(av, bilgi);
        yonSonAktifler.appendChild(kart);
      });
    }

    var yonetimInterval = null;
    async function yonetimGuncelle(sessiz) {
      var g = H.oturumOku() || u;
      if (!g || g.rol !== "yonetici") {
        if (yonetim) yonetim.hidden = true;
        if (yonetimInterval) clearInterval(yonetimInterval);
        return;
      }
      if (yonetim) yonetim.hidden = false;
      if (!sessiz && yonDurum) yonDurum.textContent = "Veriler güncelleniyor…";

      try {
        // Öncelik: Tam canlı istatistik RPC'si
        if (H.adminCanliIstatistik) {
          var r = await H.adminCanliIstatistik();
          if (r && !r.hata) {
            if (yonCanliToplam) yonCanliToplam.textContent = r.canli_toplam || 0;
            if (yonCanliDetay) {
              yonCanliDetay.textContent = (r.canli_uye || 0) + " üye · " + (r.canli_anonim || 0) + " misafir";
            }
            if (yonKayitliToplam) {
              yonKayitliToplam.textContent = (r.kayitli_uyeler || []).length;
            }
            if (yonAktifUyeSayisi) {
              yonAktifUyeSayisi.textContent = (r.son_aktif_uyeler || []).length;
            }

            sayfalarCiz(r.sayfalar);
            sonAktiflerCiz(r.son_aktif_uyeler);

            uyeListe = Array.isArray(r.kayitli_uyeler) ? r.kayitli_uyeler : [];
            uyelerCiz();
            if (yonDurum) {
              yonDurum.textContent = uyeListe.length + " kayıtlı okur · Canlı";
            }
            return;
          }
        }

        // Yedek: Eski admin_uyeler RPC'si
        var r2 = await H.adminUyeler();
        if (r2 && !r2.hata) {
          uyeListe = Array.isArray(r2) ? r2 : r2 && Array.isArray(r2.uyeler) ? r2.uyeler : [];
          if (yonKayitliToplam) yonKayitliToplam.textContent = uyeListe.length;
          uyelerCiz();
          if (yonDurum) {
            yonDurum.textContent = uyeListe.length + " kayıtlı okur";
          }
        } else if (r2 && r2.hata && yonDurum) {
          yonDurum.textContent = r2.hata;
        }
      } catch (e) {
        if (!sessiz && yonDurum) yonDurum.textContent = "Güncellenemedi, tekrar dene.";
      }
    }

    async function yonetimKur() {
      var g = H.oturumOku() || u;
      // Yönetici kontrolü: 'yonetici' rolü olmayan kesinlikle göremez.
      if (!g || g.rol !== "yonetici") {
        if (yonetim) yonetim.hidden = true;
        return;
      }
      if (yonetim) yonetim.hidden = false;
      if (yonetimYuklendi) return;
      yonetimYuklendi = true;

      await yonetimGuncelle(false);

      // Panel açıkken her 12 saniyede bir canlı verileri arka planda tazele
      if (!yonetimInterval) {
        yonetimInterval = setInterval(function () {
          if (document.visibilityState === "visible") {
            yonetimGuncelle(true);
          }
        }, 12000);
      }
    }

    if (yonYenileBtn) {
      yonYenileBtn.addEventListener("click", function () {
        yonetimGuncelle(false);
      });
    }

    uyeAra && uyeAra.addEventListener("input", uyelerCiz);

    // Eski oturumlarda rol/etiket/bildirim_siklik alanları yok: sunucudan tazele.
    if (H.profilTazele) {
      H.profilTazele().then(function (yeni) {
        if (!yeni) return;
        u = yeni;
        if (adEl) adEl.textContent = u.ad;
        if (kadiEl) kadiEl.textContent = "@" + u.kadi;
        if (adGirdi) adGirdi.value = u.ad;
        rozetCiz();
        siklikCiz();
        yonetimKur();
        // Sunucudaki seçimler ekranda görünsün: eskiden tazeleme yalnızca
        // oturumu güncelliyor, çipler boş kalıyordu ("seçmiştim, gelmiyor").
        var yIlgi = new Set(u.ilgi || []);
        var yBildirim = new Set(u.bildirim_ilgi || []);
        if (!yBildirim.size && yIlgi.size) {
          yIlgi.forEach(function (s) {
            yBildirim.add(s);
          });
        }
        ilgiSecim.clear();
        yIlgi.forEach(function (s) {
          ilgiSecim.add(s);
        });
        bildirimSecim.clear();
        yBildirim.forEach(function (s) {
          bildirimSecim.add(s);
        });
        ciz();
      });
    }
    yonetimKur();

    // --- Sol menü aktif bölüm takibi ---
    var navEl = document.getElementById("profil-nav");
    if (navEl) {
      var navBaglantilar = [].slice.call(navEl.querySelectorAll("a[href^='#']"));
      function aktifSec(hash) {
        navBaglantilar.forEach(function (a) {
          a.classList.toggle("is-active", a.getAttribute("href") === hash);
        });
      }
      navBaglantilar.forEach(function (a) {
        a.addEventListener("click", function () {
          aktifSec(a.getAttribute("href"));
        });
      });
      if ("IntersectionObserver" in window) {
        var gozlemci = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting && en.target.id) {
                aktifSec("#" + en.target.id);
              }
            });
          },
          { rootMargin: "-20% 0px -65% 0px", threshold: 0 }
        );
        navBaglantilar.forEach(function (a) {
          var hedef = document.querySelector(a.getAttribute("href"));
          if (hedef) gozlemci.observe(hedef);
        });
      }
    }

    // --- Haber başlığı & kategori eşleştirme (search-index.json + slug yedeği) ---
    var haberHarita = Object.create(null);
    var indeksSoz = null;
    function indeksGetir() {
      if (indeksSoz) return indeksSoz;
      indeksSoz = fetch("/search-index.json")
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (liste) {
          if (Array.isArray(liste)) {
            liste.forEach(function (item) {
              if (!item || !item.u) return;
              var s = String(item.u).replace(/^\/haber\//, "").replace(/\/$/, "").trim();
              if (s) haberHarita[s] = item;
            });
          }
          return haberHarita;
        })
        .catch(function () { return haberHarita; });
      return indeksSoz;
    }

    function slugBaslik(slug) {
      if (!slug) return "Haber detayı";
      var temiz = String(slug)
        .replace(/^\/haber\//, "")
        .replace(/\/$/, "")
        .replace(/-[0-9a-f]{6,10}$/i, "")
        .replace(/-/g, " ")
        .trim();
      if (!temiz) return "Haber detayı";
      return temiz.charAt(0).toLocaleUpperCase("tr") + temiz.slice(1);
    }

    function kisaTarihSaat(iso) {
      if (!iso) return "";
      try {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return "";
        var gun = d.toLocaleDateString("tr-TR", {
          day: "2-digit",
          month: "short",
          year: "numeric",
        });
        var saat = d.toLocaleTimeString("tr-TR", {
          hour: "2-digit",
          minute: "2-digit",
        });
        return gun + " · " + saat;
      } catch (e) {
        return "";
      }
    }

    var SAYFA_BOYUTU = 5;

    // --- Okuma listesi ---
    var kListe = document.getElementById("profil-kayitlar");
    var kBos = document.getElementById("profil-kayit-bos");
    var kSayac = document.getElementById("profil-kayit-sayac");
    var kDaha = document.getElementById("profil-kayit-daha");
    var kayitVeri = [];
    var kayitTumunuGoster = false;

    function kayitlariCiz() {
      if (kSayac) {
        kSayac.textContent = String(kayitVeri.length);
        kSayac.hidden = !kayitVeri.length;
      }
      if (!kListe) return;
      kListe.textContent = "";
      if (!kayitVeri.length) {
        if (kBos) kBos.hidden = false;
        if (kDaha) kDaha.hidden = true;
        return;
      }
      if (kBos) kBos.hidden = true;

      var dilim = kayitTumunuGoster ? kayitVeri : kayitVeri.slice(0, SAYFA_BOYUTU);
      dilim.forEach(function (k) {
        var h = haberHarita[k.slug];
        var baslikMetin = k.baslik || (h && h.t) || slugBaslik(k.slug);
        var katMetin = (h && h.c) || "";
        var url = "/haber/" + encodeURIComponent(k.slug) + "/";

        var li = document.createElement("li");
        li.className = "profil__yorum";

        var ust = document.createElement("div");
        ust.className = "profil__yorum-ust";

        var konu = document.createElement("div");
        konu.className = "profil__yorum-konu";
        if (katMetin) {
          var kat = document.createElement("span");
          kat.className = "profil__yorum-kat";
          kat.textContent = katMetin;
          konu.appendChild(kat);
        }
        var a = document.createElement("a");
        a.className = "profil__yorum-baslik";
        a.href = url;
        a.textContent = baslikMetin;
        konu.appendChild(a);
        ust.appendChild(konu);

        var alt = document.createElement("div");
        alt.className = "profil__yorum-alt";

        var t = document.createElement("time");
        t.textContent = kisaTarihSaat(k.created_at);

        var aksiyon = document.createElement("div");
        aksiyon.className = "profil__yorum-aksiyon";

        var git = document.createElement("a");
        git.className = "profil__yorum-git";
        git.href = url;
        git.textContent = "Habere git →";
        aksiyon.appendChild(git);

        if (H.kaydetSil) {
          var silBtn = document.createElement("button");
          silBtn.type = "button";
          silBtn.className = "profil__kayit-sil";
          silBtn.textContent = "Kaldır";
          silBtn.addEventListener("click", async function () {
            silBtn.disabled = true;
            try {
              var r = await H.kaydetSil(k.slug);
              if (!r || !r.hata) {
                kayitVeri = kayitVeri.filter(function (x) { return x.slug !== k.slug; });
                kayitlariCiz();
              }
            } finally {
              silBtn.disabled = false;
            }
          });
          aksiyon.appendChild(silBtn);
        }

        alt.append(t, aksiyon);
        li.append(ust, alt);
        kListe.appendChild(li);
      });

      if (kDaha) {
        if (kayitVeri.length > SAYFA_BOYUTU) {
          kDaha.hidden = false;
          kDaha.textContent = kayitTumunuGoster
            ? "Daha az göster"
            : "Tüm kayıtları göster (" + kayitVeri.length + ")";
        } else {
          kDaha.hidden = true;
        }
      }
    }

    if (kDaha) {
      kDaha.addEventListener("click", function () {
        kayitTumunuGoster = !kayitTumunuGoster;
        kayitlariCiz();
      });
    }

    if (H.kayitlar) {
      Promise.all([H.kayitlar(), indeksGetir()]).then(function (sonuclar) {
        var gelen = sonuclar[0];
        kayitVeri = Array.isArray(gelen) ? gelen : [];
        kayitlariCiz();
      });
    }

    // --- Yorumlarım ---
    var liste = document.getElementById("profil-yorumlar");
    var bos = document.getElementById("profil-yorum-bos");
    var ySayac = document.getElementById("profil-yorum-sayac");
    var yDaha = document.getElementById("profil-yorum-daha");
    var yorumVeri = [];
    var yorumTumunuGoster = false;

    function yorumlariCiz() {
      if (!liste) return;
      if (ySayac) {
        ySayac.textContent = String(yorumVeri.length);
        ySayac.hidden = !yorumVeri.length;
      }
      liste.textContent = "";
      if (!yorumVeri.length) {
        if (bos) bos.hidden = false;
        if (yDaha) yDaha.hidden = true;
        return;
      }
      if (bos) bos.hidden = true;

      var dilim = yorumTumunuGoster ? yorumVeri : yorumVeri.slice(0, SAYFA_BOYUTU);
      dilim.forEach(function (y) {
        var h = haberHarita[y.slug];
        var baslikMetin = (h && h.t) || slugBaslik(y.slug);
        var katMetin = (h && h.c) || "";
        var url = "/haber/" + encodeURIComponent(y.slug) + "/#yorumlar";

        var li = document.createElement("li");
        li.className = "profil__yorum";

        var ust = document.createElement("div");
        ust.className = "profil__yorum-ust";

        var konu = document.createElement("div");
        konu.className = "profil__yorum-konu";
        if (katMetin) {
          var kat = document.createElement("span");
          kat.className = "profil__yorum-kat";
          kat.textContent = katMetin;
          konu.appendChild(kat);
        }
        var baslikLink = document.createElement("a");
        baslikLink.className = "profil__yorum-baslik";
        baslikLink.href = url;
        baslikLink.textContent = baslikMetin;
        konu.appendChild(baslikLink);
        ust.appendChild(konu);

        var p = document.createElement("p");
        p.className = "profil__yorum-metin";
        p.textContent = y.metin || "";

        var alt = document.createElement("div");
        alt.className = "profil__yorum-alt";

        var t = document.createElement("time");
        t.textContent = kisaTarihSaat(y.created_at);

        var git = document.createElement("a");
        git.className = "profil__yorum-git";
        git.href = url;
        git.textContent = "Habere git →";

        alt.append(t, git);
        li.append(ust, p, alt);
        liste.appendChild(li);
      });

      if (yDaha) {
        if (yorumVeri.length > SAYFA_BOYUTU) {
          yDaha.hidden = false;
          yDaha.textContent = yorumTumunuGoster
            ? "Daha az göster"
            : "Tüm yorumları göster (" + yorumVeri.length + ")";
        } else {
          yDaha.hidden = true;
        }
      }
    }

    if (yDaha) {
      yDaha.addEventListener("click", function () {
        yorumTumunuGoster = !yorumTumunuGoster;
        yorumlariCiz();
      });
    }

    Promise.all([H.yorumlarim(), indeksGetir()]).then(function (sonuclar) {
      var liste2 = sonuclar[0];
      yorumVeri = Array.isArray(liste2) ? liste2 : [];
      yorumlariCiz();
    });
  })();
</script>
