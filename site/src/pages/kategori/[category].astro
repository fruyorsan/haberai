---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import AdSlot from "../../components/AdSlot.astro";
import { ADSENSE_SLOTS } from "../../lib/site-meta.js";
import { getCategories, paginate, PER_PAGE, getYayinArticles } from "../../lib/articles.js";

export function getStaticPaths() {
  return getCategories().map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const all = getYayinArticles().filter((a) => a.categorySlug === category.slug);
const { items, current, totalPages: pages, total } = paginate(all, 1, PER_PAGE);
---

<Base
  title={`${category.name} Haberleri — HaberinAi`}
  description={`${category.name} kategorisindeki en güncel haberler, özetler ve yapay zekâ yorumları.`}
>
  <div class="container">
    <header class="cat-head">
      <span class="badge">{category.name}</span>
      <h1>{category.name} Haberleri</h1>
      <p class="muted">
        {total} haber{pages > 1 ? ` · Sayfa ${current}/${pages}` : ""}
      </p>
    </header>

    <div class="grid">
      {items.map((a, i) => <ArticleCard article={a} index={i} />)}
    </div>

    {ADSENSE_SLOTS.liste && <AdSlot slot={ADSENSE_SLOTS.liste} label="Sponsorlu" />}
    <Pagination current={current} totalPages={pages} base={`/kategori/${category.slug}/`} />
  </div>
</Base>

<style>
  .cat-head {
    padding: 30px 0 6px;
  }
  .cat-head h1 {
    font-size: 1.9rem;
    margin: 12px 0 4px;
    letter-spacing: -0.02em;
  }
  .cat-head .muted {
    font-size: 0.9rem;
  }
</style>
