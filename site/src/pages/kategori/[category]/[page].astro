---
import Base from "../../../layouts/Base.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getArticles, getCategories, paginate, PER_PAGE, totalPages } from "../../../lib/articles.js";

// Kategori sayfaları (2. sayfa ve sonrası). 1. sayfa /kategori/<slug>/ adresindedir.
// Sayfalama olmadan "gündem" gibi büyük kategoriler tek sayfada 500 KB'a çıkıp
// yüzlerce görsel yüklüyordu; bu yüzden liste PER_PAGE'lik sayfalara bölünür.
export function getStaticPaths() {
  const all = getArticles();
  const paths = [];
  for (const category of getCategories()) {
    const list = all.filter((a) => a.categorySlug === category.slug);
    const pages = totalPages(list, PER_PAGE);
    for (let p = 2; p <= pages; p++) {
      paths.push({ params: { category: category.slug, page: String(p) }, props: { category } });
    }
  }
  return paths;
}

const { category } = Astro.props;
const all = getArticles().filter((a) => a.categorySlug === category.slug);
const page = Number(Astro.params.page);
const { items, current, totalPages: pages, total } = paginate(all, page, PER_PAGE);
---

<Base
  title={`${category.name} Haberleri — Sayfa ${current} — HaberinAi`}
  description={`${category.name} kategorisindeki güncel haberler, özetler ve yapay zekâ yorumları (${current}. sayfa).`}
>
  <div class="container">
    <header class="cat-head">
      <span class="badge">{category.name}</span>
      <h1>{category.name} Haberleri</h1>
      <p class="muted">{total} haber · Sayfa {current}/{pages}</p>
    </header>

    <div class="grid">
      {items.map((a, i) => <ArticleCard article={a} index={i} />)}
    </div>

    <Pagination current={current} totalPages={pages} base={`/kategori/${category.slug}/`} />
  </div>
</Base>

<style>
  .cat-head {
    padding: 30px 0 6px;
  }
  .cat-head h1 {
    font-size: 1.9rem;
    margin: 12px 0 4px;
    letter-spacing: -0.02em;
  }
  .cat-head .muted {
    font-size: 0.9rem;
  }
</style>
