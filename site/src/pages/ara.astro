---
import Base from "../layouts/Base.astro";
---

<Base
  title="Haber Ara — HaberAI"
  description="HaberAI arşivinde anahtar kelimeyle hızlıca haber ara: teknoloji, ekonomi, oyun, mobil ve daha fazlası."
>
  <div class="container">
    <header class="page-head">
      <span class="badge">ARAMA</span>
      <h1>Haber Ara</h1>
      <div class="search-wrap">
        <svg class="search-wrap__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.2-3.2" />
        </svg>
        <input
          id="q"
          class="search-input"
          type="search"
          placeholder="Örn: iPhone, yapay zeka, PlayStation, dolar..."
          autocomplete="off"
          autofocus
        />
      </div>
      <p class="muted status" id="status">Aramak için yazmaya başla.</p>
    </header>

    <div class="grid" id="results"></div>
  </div>
</Base>

<style>
  .page-head {
    padding: 32px 0 22px;
    max-width: 720px;
  }
  .page-head h1 {
    font-size: 2rem;
    margin: 12px 0 16px;
    letter-spacing: -0.025em;
    font-weight: 900;
  }
  .search-wrap {
    position: relative;
  }
  .search-wrap__icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    height: 54px;
    padding: 0 18px 0 44px;
    font-size: 1.05rem;
    font-family: inherit;
    border: 2px solid var(--line);
    border-radius: 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .search-input:focus {
    border-color: var(--red);
    box-shadow: 0 0 0 4px var(--red-soft);
  }
  .status {
    margin: 12px 0 0;
    font-size: 0.9rem;
  }
</style>

<script>
  const input = document.getElementById("q");
  const results = document.getElementById("results");
  const status = document.getElementById("status");

  const esc = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    }[c]));
  const norm = (s) => String(s ?? "").toLocaleLowerCase("tr");

  // Optimizasyon: veri, kullanıcı arama yapana kadar indirilmez (tek seferlik).
  let DATA = null;
  let pending = null;

  function loadIndex() {
    if (DATA) return Promise.resolve(DATA);
    if (!pending) {
      pending = fetch("/search-index.json")
        .then((r) => r.json())
        .then((data) => {
          DATA = data;
          return data;
        });
    }
    return pending;
  }

  function card(a) {
    return `<article class="card">
      <a class="card__link" href="${esc(a.u)}">
        <div class="card__media">
          <div class="card__ph" aria-hidden="true">
            <span class="card__ph-mark">H</span>
            <span class="card__ph-cat">${esc(a.c || "")}</span>
          </div>
          ${a.img ? `<img src="${esc(a.img)}" alt="${esc(a.t)}" loading="lazy" decoding="async" onerror="this.classList.add('is-broken')" />` : ""}
          <span class="card__badge">${esc(a.c || "")}</span>
        </div>
        <div class="card__body">
          <h3 class="card__title">${esc(a.t)}</h3>
          <p class="card__summary">${esc(a.s)}</p>
          <div class="card__meta">
            <span class="card__source">${esc(a.src)}</span>
          </div>
        </div>
      </a>
    </article>`;
  }

  async function render(q) {
    const words = norm(q).trim().split(/\s+/).filter(Boolean);
    if (!words.length) {
      results.innerHTML = "";
      status.textContent = "Aramak için yazmaya başla.";
      return;
    }

    if (!DATA) {
      status.textContent = "Aranıyor...";
      try {
        await loadIndex();
      } catch {
        status.textContent = "Arama verisi yüklenemedi.";
        return;
      }
    }

    const hits = DATA.filter((a) => {
      const hay = norm(`${a.t} ${a.s} ${a.c} ${a.src} ${(a.tags || []).join(" ")}`);
      return words.every((w) => hay.includes(w));
    }).slice(0, 60);

    status.textContent = `${hits.length} sonuç bulundu (${DATA.length} haber içinde).`;
    results.innerHTML = hits.length
      ? hits.map(card).join("")
      : `<p class="muted">Sonuç bulunamadı. Farklı bir kelime dene.</p>`;
  }

  let timer;
  input.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => render(input.value), 130);
  });

  // Sayfa q parametresiyle açıldıysa doğrudan ara
  const initial = new URLSearchParams(location.search).get("q") || "";
  if (initial) {
    input.value = initial;
    render(initial);
  }
</script>
