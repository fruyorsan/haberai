---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import AdSlot from "../components/AdSlot.astro";
import FeaturedSlider from "../components/FeaturedSlider.astro";
import { getArticles, getFeatured, getTags } from "../lib/articles.js";
import { siteOrigin, ADSENSE_SLOTS } from "../lib/site-meta.js";

const articles = getArticles();
// Konu sayfalarına ana sayfadan da bağlantı verilir (hem gezinme hem arama
// motorlarının konu sayfalarını keşfi için).
const konular = getTags().slice(0, 14);
// İlk 6 haber "öne çıkanlar" slaytında gösterilir; ızgarada tekrar etmesinler.
const featured = getFeatured(6);
const featuredSlugs = new Set(featured.map((a) => a.slug));
const nonFeatured = articles.filter((a) => !featuredSlugs.has(a.slug));
// Teknoloji/yapay zekâ gelişmeleri ayrı ve belirgin bir bölümde öne çıkarılır.
const teknoKategoriler = new Set(["teknoloji", "yapay-zeka"]);
const tekno = articles
  .filter((a) => teknoKategoriler.has(a.categorySlug) && !featuredSlugs.has(a.slug))
  .slice(0, 4);
const teknoSlugs = new Set(tekno.map((a) => a.slug));
// ShiftDelete tarzı: Gerçek fotoğraflı haberler öncelikli gösterilir
const withPhoto = nonFeatured.filter((a) => a.image && !teknoSlugs.has(a.slug));
const withoutPhoto = nonFeatured.filter((a) => !a.image && !teknoSlugs.has(a.slug));
const grid = [...withPhoto, ...withoutPhoto].slice(0, 21);

// WebSite + Organization yapısal veri: Sitelinks arama kutusu (Google) + marka bilgisi.
// SearchAction, site içi arama sayfasına (/ara/) point eder.
const origin = siteOrigin(Astro.site);
const heroImage = featured[0]?.image || (featured[0] ? `/kapak/${featured[0].slug}.svg` : undefined);
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": origin + "/#website",
      url: origin + "/",
      name: "HaberinAi",
      description: "Yapay zekâ destekli Türkçe haber özeti ve editör yorumları.",
      inLanguage: "tr-TR",
      potentialAction: {
        "@type": "SearchAction",
        target: origin + "/ara/?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": origin + "/#organization",
      name: "HaberinAi",
      url: origin + "/",
      logo: origin + "/og-default.png",
    },
  ],
};
---

<Base
  title="HaberinAi — Yapay Zekâ Destekli Haberler"
  description="HaberinAi: yapay zekâ destekli teknoloji ve gündem haberlerinde özet, analiz ve editör yorumu."
  schema={siteSchema}
  preloadImage={heroImage}
>
  <div class="container">
    <h1 class="sr-only">HaberinAi — Yapay Zekâ Destekli Türkçe Haberler ve Gündem Özetleri</h1>
    {articles.length === 0 ? (
      <p class="empty">
        Henüz haber yok. Hattı çalıştır: <code>npm run collect</code>
      </p>
    ) : (
      <>
        <FeaturedSlider />

        {tekno.length >= 3 && (
          <section class="tekno">
            <div class="latest__head">
              <h2 class="section-title section-title--line tekno__h">
                <svg class="tekno__icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="3" />
                  <path d="M9 9h6v6H9z" />
                  <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
                </svg>
                Teknoloji
              </h2>
              <a class="latest__all" href="/kategori/teknoloji/">Tümü →</a>
            </div>
            <div class="grid">
              {tekno.map((a, i) => <ArticleCard article={a} index={i} />)}
            </div>
          </section>
        )}

        {grid.length > 0 && (
          <section class="latest">
            <div class="latest__head">
              <h2 class="section-title section-title--line">Son Haberler</h2>
              <a class="latest__all" href="/haberler/">Tümü →</a>
            </div>
            <div class="grid">
              {grid.map((a, i) => <ArticleCard article={a} index={i + 6} />)}
            </div>
            {articles.length > 27 && (
              <div class="more">
                <a class="more__btn" href="/haberler/">
                  Tüm Haberler ({articles.length})
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </a>
              </div>
            )}
          </section>
        )}

        <AdSlot slot={ADSENSE_SLOTS.liste} label="Sponsorlu" />

        {konular.length > 0 && (
          <section class="topics">
            <div class="latest__head">
              <h2 class="section-title section-title--line">Popüler Konular</h2>
              <a class="latest__all" href="/etiketler/">Tümü →</a>
            </div>
            <div class="topics__list">
              {konular.map((t) => (
                <a class="topics__item" href={`/etiket/${t.slug}/`}>
                  {t.name}
                  <span class="topics__n">{t.count}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .latest__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .latest__all {
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--red);
    white-space: nowrap;
    transition: transform 0.2s var(--ease);
  }
  .latest__all:hover {
    transform: translateX(3px);
  }

  /* Teknoloji vitrini: hemen göze çarpsın diye hafif marka tonlu zemin. */
  .tekno {
    margin: 8px 0 26px;
    padding: 4px 20px 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(120% 140% at 0% 0%, var(--brand-soft), transparent 58%),
      var(--surface);
  }
  .tekno__h {
    margin: 20px 0 16px;
  }
  .tekno__icon {
    color: var(--brand);
  }

  .topics {
    margin-top: 8px;
  }
  .topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 6px;
  }
  .topics__item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
    text-transform: capitalize;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .topics__item:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-2px);
  }
  .topics__n {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 80px 0;
    font-size: 1.05rem;
  }
  .empty code {
    background: var(--red-soft);
    color: var(--red-dark);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
  }

  .more {
    display: flex;
    justify-content: center;
    margin: 34px 0 8px;
  }
  .more__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 2px solid var(--brand);
    color: var(--brand);
    background: var(--surface);
    font-weight: 800;
    font-size: 0.95rem;
    padding: 13px 30px;
    border-radius: 13px;
    transition: background 0.22s var(--ease), color 0.22s var(--ease),
      transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
  }
  .more__btn:hover {
    background: var(--brand-fill-hover);
    border-color: var(--brand-fill-hover);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px -20px var(--brand-glow);
  }
  .more__btn svg {
    transition: transform 0.22s var(--ease);
  }
  .more__btn:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    /* "Tümü" bağlantısı ve "daha fazla" düğmesi parmakla rahat basılsın. */
    .latest__all {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 2px;
    }
    .more__btn {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
    }
  }
</style>
