---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticles } from "../lib/articles.js";

const articles = getArticles();
const lead = articles[0];
const secondary = articles.slice(1, 3);
const grid = articles.slice(3, 24);
---

<Base>
  <div class="container">
    {articles.length === 0 ? (
      <p class="empty">
        Henüz haber yok. Hattı çalıştır: <code>npm run collect</code>
      </p>
    ) : (
      <>
        <section class="hero">
          <div class="hero__lead">
            <ArticleCard article={lead} size="large" />
          </div>
          <div class="hero__side">
            {secondary.map((a) => <ArticleCard article={a} />)}
          </div>
        </section>

        {grid.length > 0 && (
          <section>
            <h2 class="section-title">Son Haberler</h2>
            <div class="grid">
              {grid.map((a) => <ArticleCard article={a} />)}
            </div>
            {articles.length > 24 && (
              <div class="more">
                <a class="more__btn" href="/haberler/">Tüm Haberler ({articles.length}) →</a>
              </div>
            )}
          </section>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 24px;
    margin: 28px 0 8px;
  }
  .hero__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 80px 0;
    font-size: 1.05rem;
  }
  .empty code {
    background: var(--red-soft);
    color: var(--red-dark);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
  }
  .more {
    display: flex;
    justify-content: center;
    margin: 30px 0 8px;
  }
  .more__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 2px solid var(--red);
    color: var(--red);
    background: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 13px 30px;
    border-radius: 12px;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .more__btn:hover {
    background: var(--red);
    color: #fff;
    transform: translateY(-1px);
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
