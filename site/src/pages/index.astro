---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import FeaturedSlider from "../components/FeaturedSlider.astro";
import { getArticles, getFeatured } from "../lib/articles.js";

const articles = getArticles();
// İlk 6 haber "öne çıkanlar" slaytında gösterilir; ızgarada tekrar etmesinler.
const featured = getFeatured(6);
const featuredSlugs = new Set(featured.map((a) => a.slug));
const grid = articles.filter((a) => !featuredSlugs.has(a.slug)).slice(0, 21);

// Izgaranın ilk satırı en çok göze çarpan yer: kaynak fotoğrafı olmayan haber
// burada kalırsa markalı kapak görseli görünür. İlk satırdaki fotoğrafsız
// haberler, sıradaki fotoğraflı haberlerle yer değiştirir (tarih sırası
// korunur, listenin bütünlüğü bozulmaz).
const HERO_ROW = 3;
for (let i = 0; i < Math.min(HERO_ROW, grid.length); i++) {
  if (grid[i].image) continue;
  const j = grid.findIndex((a, k) => k > i && a.image);
  if (j > i) [grid[i], grid[j]] = [grid[j], grid[i]];
}
---

<Base>
  <div class="container">
    {articles.length === 0 ? (
      <p class="empty">
        Henüz haber yok. Hattı çalıştır: <code>npm run collect</code>
      </p>
    ) : (
      <>
        <FeaturedSlider />

        {grid.length > 0 && (
          <section class="latest">
            <div class="latest__head">
              <h2 class="section-title section-title--line">Son Haberler</h2>
              <a class="latest__all" href="/haberler/">Tümü →</a>
            </div>
            <div class="grid">
              {grid.map((a, i) => <ArticleCard article={a} index={i + 6} />)}
            </div>
            {articles.length > 27 && (
              <div class="more">
                <a class="more__btn" href="/haberler/">
                  Tüm Haberler ({articles.length})
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </a>
              </div>
            )}
          </section>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .latest__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .latest__all {
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--red);
    white-space: nowrap;
    transition: transform 0.2s var(--ease);
  }
  .latest__all:hover {
    transform: translateX(3px);
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 80px 0;
    font-size: 1.05rem;
  }
  .empty code {
    background: var(--red-soft);
    color: var(--red-dark);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
  }

  .more {
    display: flex;
    justify-content: center;
    margin: 34px 0 8px;
  }
  .more__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 2px solid var(--brand);
    color: var(--brand);
    background: var(--surface);
    font-weight: 800;
    font-size: 0.95rem;
    padding: 13px 30px;
    border-radius: 13px;
    transition: background 0.22s var(--ease), color 0.22s var(--ease),
      transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
  }
  .more__btn:hover {
    background: var(--brand-fill-hover);
    border-color: var(--brand-fill-hover);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px -20px var(--brand-glow);
  }
  .more__btn svg {
    transition: transform 0.22s var(--ease);
  }
  .more__btn:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    /* "Tümü" bağlantısı ve "daha fazla" düğmesi parmakla rahat basılsın. */
    .latest__all {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 2px;
    }
    .more__btn {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
    }
  }
</style>
