---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticles, getCategories } from "../lib/articles.js";

const articles = getArticles();
const lead = articles[0];
const secondary = articles.slice(1, 3);
const grid = articles.slice(3, 24);
const cats = getCategories().slice(0, 9);
---

<Base>
  <div class="container">
    {articles.length === 0 ? (
      <p class="empty">
        Henüz haber yok. Hattı çalıştır: <code>npm run collect</code>
      </p>
    ) : (
      <>
        {cats.length > 1 && (
          <nav class="chips" aria-label="Kategoriler">
            {cats.map((c, i) => (
              <a class="chip" href={`/kategori/${c.slug}/`} style={`transition-delay:${i * 30}ms`}>
                {c.name}
                <span class="chip__n">{c.count}</span>
              </a>
            ))}
          </nav>
        )}

        <section class="hero">
          <div class="hero__lead">
            <ArticleCard article={lead} size="large" index={0} />
          </div>
          <div class="hero__side">
            {secondary.map((a, i) => <ArticleCard article={a} index={i + 1} />)}
          </div>
        </section>

        {grid.length > 0 && (
          <section class="latest">
            <div class="latest__head">
              <h2 class="section-title section-title--line">Son Haberler</h2>
              <a class="latest__all" href="/haberler/">Tümü →</a>
            </div>
            <div class="grid">
              {grid.map((a, i) => <ArticleCard article={a} index={i + 3} />)}
            </div>
            {articles.length > 24 && (
              <div class="more">
                <a class="more__btn" href="/haberler/">
                  Tüm Haberler ({articles.length})
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </a>
              </div>
            )}
          </section>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 22px 0 2px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    color: #303238;
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
      border-color 0.2s var(--ease), transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .chip:hover {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -14px rgba(216, 31, 38, 0.95);
  }
  .chip__n {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--bg-soft);
    border-radius: 999px;
    padding: 1px 7px;
    transition: background 0.2s, color 0.2s;
  }
  .chip:hover .chip__n {
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 24px;
    margin: 22px 0 8px;
  }
  .hero__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
  }

  .latest__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .latest__all {
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--red);
    white-space: nowrap;
    transition: transform 0.2s var(--ease);
  }
  .latest__all:hover {
    transform: translateX(3px);
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 80px 0;
    font-size: 1.05rem;
  }
  .empty code {
    background: var(--red-soft);
    color: var(--red-dark);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
  }

  .more {
    display: flex;
    justify-content: center;
    margin: 34px 0 8px;
  }
  .more__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 2px solid var(--red);
    color: var(--red);
    background: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 13px 30px;
    border-radius: 13px;
    transition: background 0.22s var(--ease), color 0.22s var(--ease),
      transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
  }
  .more__btn:hover {
    background: var(--red);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px -20px rgba(216, 31, 38, 1);
  }
  .more__btn svg {
    transition: transform 0.22s var(--ease);
  }
  .more__btn:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__side {
      grid-template-rows: auto;
    }
  }
</style>
