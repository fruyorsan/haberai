---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import AdSlot from "../components/AdSlot.astro";
import FeaturedSlider from "../components/FeaturedSlider.astro";
import { getArticles, getFeatured, getTags, imageUrl, imageSrcset, timeAgo, publishedISO } from "../lib/articles.js";
import { kapakKaynagi } from "../lib/kapak.js";
import { ilgiSirala } from "../lib/ilgi.js";
import { siteOrigin, ADSENSE_SLOTS } from "../lib/site-meta.js";

const articles = getArticles();
// Shorts vitrini: ilgi sırasının en tepesindeki 4 haber (hepsi gerçek fotoğraflı).
// Akışın ana sayfadaki yüzü burasıdır — ziyaretçiyi /akis/'a çeken görsel şerit.
// vitrin ve akış sırası
// featuredSlugs ve shortsSlugs tekrarı önler
const featured = getFeatured(6, 36, kapakKaynagi);
const featuredSlugs = new Set(featured.map((a) => a.slug));
const shorts = ilgiSirala(articles).filter((a) => !featuredSlugs.has(a.slug))
  .slice(0, 4)
  .map((a) => ({
    slug: a.slug,
    url: `/haber/${a.slug}/`,
    baslik: a.title,
    kategori: a.category,
    kapak: kapakKaynagi(a),
    zaman: timeAgo(publishedISO(a)),
  }));
// Konu sayfalarına ana sayfadan da bağlantı verilir (hem gezinme hem arama
// motorlarının konu sayfalarını keşfi için).
const konular = getTags().slice(0, 14);
const shortsSlugs = new Set(shorts.map((s) => s.slug));
// İlk 6 haber "öne çıkanlar" slaytında gösterilir; ızgarada tekrar etmesinler.
// vitrin ve akış sırası
// featuredSlugs ve shortsSlugs tekrarı önler
const nonFeatured = articles.filter((a) => !featuredSlugs.has(a.slug));
// Teknoloji/yapay zekâ gelişmeleri ayrı ve belirgin bir bölümde öne çıkarılır.
const teknoKategoriler = new Set(["teknoloji", "yapay-zeka", "mobil", "donanim", "yazilim", "oyun", "internet"]);
const tekno = articles
  .filter((a) => teknoKategoriler.has(a.categorySlug) && !featuredSlugs.has(a.slug) && !shortsSlugs.has(a.slug) && kapakKaynagi(a) && !/wikimedia|wikipedia/i.test(a.image || ""))
  .slice(0, 4);
const teknoSlugs = new Set(tekno.map((a) => a.slug));
// ShiftDelete tarzı: Gerçek fotoğraflı haberler öncelikli gösterilir.
// "Fotoğraflı" ölçütü güvenlik süzgecinden geçen kapaktır (lib/kapak.js):
// yanlış/genel görseli elenen haber, fotoğrafsız (kırmızı zeminli) kart olarak
// listenin sonuna alınır.
const withPhoto = nonFeatured.filter((a) => kapakKaynagi(a) && !teknoSlugs.has(a.slug) && !shortsSlugs.has(a.slug));
const withoutPhoto = nonFeatured.filter((a) => !kapakKaynagi(a) && !teknoSlugs.has(a.slug) && !shortsSlugs.has(a.slug));
const grid = [...withPhoto, ...withoutPhoto].slice(0, 21);

// WebSite + Organization yapısal veri: Sitelinks arama kutusu (Google) + marka bilgisi.
// SearchAction, site içi arama sayfasına (/ara/) point eder.
const origin = siteOrigin(Astro.site);
// Vitrin kapak görseli: preload edilecek adres de süzgeçten geçer. Vitrindeki
// ilk *geçerli* kapak seçilir; hiçbiri geçerli değilse markalı görsele düşülür.
const heroKapak = featured.map((a) => kapakKaynagi(a)).find(Boolean) || "";
// Vitrin görseli (FeaturedSlider) ile AYNI küme verilir: ön yükleme ve gerçek
// <img> aynı kaynağı seçer, iki ayrı fotoğraf indirilmez.
const heroImage = heroKapak ? imageUrl(heroKapak, 1280) : "";
const heroImageSet = heroKapak ? imageSrcset(heroKapak, [640, 960, 1280]) : undefined;
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": origin + "/#website",
      url: origin + "/",
      name: "HaberinAi",
      description: "Yapay zekâ destekli Türkçe haber özeti ve editör yorumları.",
      inLanguage: "tr-TR",
      potentialAction: {
        "@type": "SearchAction",
        target: origin + "/ara/?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": origin + "/#organization",
      name: "HaberinAi",
      url: origin + "/",
      // Kare logo (Google "yayıncı logosu" için kare ve >=112 px ister).
      logo: {
        "@type": "ImageObject",
        url: origin + "/ikon-512.png",
        width: 512,
        height: 512,
      },
    },
  ],
};
---

<Base
  title="HaberinAi — Son Dakika Haberleri, Teknoloji ve Yapay Zekâ"
  description="Son dakika haberleri dakikalar içinde güncellenir: teknoloji, yapay zekâ, oyun ve gündem. Özet, analiz ve AI yorumu; Shorts Haber ile kaydırarak oku."
  schema={siteSchema}
  preloadImage={heroImage || undefined}
  preloadSrcset={heroImageSet}
  preloadSizes="(max-width: 900px) 100vw, 1100px"
>
  <div class="container">
    <h1 class="sr-only">HaberinAi — Yapay Zekâ Destekli Türkçe Haberler ve Gündem Özetleri</h1>
    {articles.length === 0 ? (
      <p class="empty">
        Henüz haber yok. Hattı çalıştır: <code>npm run collect</code>
      </p>
    ) : (
      <>
        <FeaturedSlider />

        <section class="shorts" aria-labelledby="shorts-baslik">
          <div class="shorts__ust">
            <h2 class="shorts__baslik" id="shorts-baslik">
              <span class="shorts__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
                  <path d="M8 5.5v13l11-6.5z" />
                </svg>
              </span>
              Shorts Haber
              <span class="shorts__nokta" aria-hidden="true"></span>
            </h2>
            <a class="shorts__tum" href="/akis/">
              Akışa gir
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13" />
                <path d="m12.5 5.5 6.5 6.5-6.5 6.5" />
              </svg>
            </a>
          </div>
          <p class="shorts__alt">Kaydır, oku, beğen. Telefon için tasarlandı — dakikalar içinde tazelenir.</p>

          <div class="shorts__serit">
            {shorts.map((s) => (
              <a class="shorts__kart" href={s.url}>
                <span class="shorts__gorsel">
                  {s.kapak && (
                    <img
                      src={imageUrl(s.kapak, 640)}
                      srcset={imageSrcset(s.kapak, [480, 720])}
                      sizes="(max-width: 720px) 62vw, 260px"
                      alt={s.baslik}
                      width="640"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  )}
                  <span class="shorts__kat">{s.kategori}</span>
                </span>
                <span class="shorts__metin">{s.baslik}</span>
                <span class="shorts__meta">{s.zaman}</span>
              </a>
            ))}
          </div>

          <a class="shorts__btn" href="/akis/">
            Shorts'a gir — kaydırarak oku
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13" />
              <path d="m12.5 5.5 6.5 6.5-6.5 6.5" />
            </svg>
          </a>
        </section>

        {tekno.length >= 3 && (
          <section class="tekno">
            <div class="latest__head">
              <h2 class="section-title section-title--line tekno__h">
                <svg class="tekno__icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="3" />
                  <path d="M9 9h6v6H9z" />
                  <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
                </svg>
                Teknoloji
              </h2>
              <a class="latest__all" href="/kategori/teknoloji/">Tümü →</a>
            </div>
            <div class="grid">
              {tekno.map((a, i) => <ArticleCard article={a} index={i} />)}
            </div>
          </section>
        )}

        {grid.length > 0 && (
          <section class="latest" id="son-haberler">
            <div class="latest__head">
              <h2 class="section-title section-title--line" id="son-haberler-baslik">Son Haberler</h2>
              <a class="latest__all" href="/haberler/">Tümü →</a>
            </div>
            <div class="grid">
              {grid.map((a, i) => <ArticleCard article={a} index={i + 6} />)}
            </div>
            {articles.length > 27 && (
              <div class="more">
                <a class="more__btn" href="/haberler/">
                  Tüm Haberler ({articles.length})
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </a>
              </div>
            )}
          </section>
        )}

        <AdSlot slot={ADSENSE_SLOTS.liste} label="Sponsorlu" />

        {konular.length > 0 && (
          <section class="topics">
            <div class="latest__head">
              <h2 class="section-title section-title--line">Popüler Konular</h2>
              <a class="latest__all" href="/etiketler/">Tümü →</a>
            </div>
            <div class="topics__list">
              {konular.map((t) => (
                <a class="topics__item" href={`/etiket/${t.slug}/`}>
                  {t.name}
                  <span class="topics__n">{t.count}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>

  <script is:inline>
    // Ana sayfa kişiselleştirme: hesabında ilgi alanı seçtiyse "Son Haberler"
    // şeridi o konuları öne alır ve başlığı "Sana Özel" olur. Sıralama yalnızca
    // sunucudan basılan kartlar arasında yapılır (sayfa ağırlaşmaz).
    (function () {
      var H = window.HaberinAi;
      var u = H && typeof H.oturumOku === "function" ? H.oturumOku() : null;
      if (!u || !u.ilgi || !u.ilgi.length) return;
      var bolum = document.getElementById("son-haberler");
      if (!bolum) return;
      var grid = bolum.querySelector(".grid");
      if (!grid) return;
      var kartlar = [].slice.call(grid.querySelectorAll(".card"));
      if (kartlar.length < 2) return;
      var ilgi = new Set(u.ilgi);
      kartlar
        .map(function (k, i) {
          return { k: k, i: i, p: ilgi.has(k.dataset.kat) ? 1 : 0 };
        })
        .sort(function (a, b) {
          return b.p - a.p || a.i - b.i;
        })
        .forEach(function (x) {
          grid.appendChild(x.k);
        });
      var bas = document.getElementById("son-haberler-baslik");
      if (bas) bas.textContent = "Sana Özel";
      var all = bolum.querySelector(".latest__all");
      if (all) {
        all.textContent = "Tercihleri düzenle →";
        all.href = "/profil/";
      }
    })();
  </script>
</Base>

<style>
  /* --- Shorts vitrini: ana sayfanın en göze çarpan yeri.
         Akışın kendisi (/akis/) gibi koyu zemin + kırmızı vurgu kullanır;
         gerçek fotoğraflı 4 kart gösterilir, tıklama /akis/'a yönlendirilir. --- */
  .shorts {
    margin: 22px 0 8px;
    padding: 18px 18px 16px;
    border-radius: 20px;
    background: linear-gradient(160deg, #17181d 0%, #0b0d11 60%);
    border: 1px solid rgba(255, 78, 78, 0.46);
    box-shadow:
      0 0 0 1px rgba(255, 70, 70, 0.16),
      0 20px 46px -26px rgba(0, 0, 0, 0.78),
      0 0 40px -10px rgba(216, 31, 38, 0.6);
    position: relative;
    overflow: hidden;
  }
  /* Üstte ince kırmızı ışık çizgisi: panelin kenarı "yanıyor" gibi okunur. */
  .shorts::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 82, 82, 0.95) 22%,
      rgba(216, 31, 38, 0.95) 62%,
      transparent 100%
    );
    pointer-events: none;
  }
  .shorts::after {
    content: "";
    position: absolute;
    inset: -60% -20% auto auto;
    width: 360px;
    height: 280px;
    background: radial-gradient(closest-side, rgba(216, 31, 38, 0.52), transparent);
    pointer-events: none;
  }
  .shorts__ust {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    position: relative;
  }
  .shorts__baslik {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: clamp(1.15rem, 4vw, 1.5rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .shorts__play {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    padding-left: 2px;
    box-shadow: 0 8px 18px -8px var(--brand-glow);
  }
  .shorts__nokta {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ff4d4d;
    animation: shortsNabiz 2s var(--ease) infinite;
  }
  @keyframes shortsNabiz {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 77, 77, 0.75);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(255, 77, 77, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 77, 77, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shorts__nokta {
      animation: none;
    }
  }
  .shorts__tum {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.86);
    white-space: nowrap;
  }
  .shorts__tum:hover {
    color: #fff;
  }
  .shorts__alt {
    margin: 6px 0 14px;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.66);
    position: relative;
  }
  .shorts__serit {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(190px, 250px);
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 6px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .shorts__kart {
    display: flex;
    flex-direction: column;
    gap: 7px;
    scroll-snap-align: start;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s var(--ease);
  }
  .shorts__kart:hover {
    transform: translateY(-3px);
  }
  .shorts__gorsel {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: #23252c;
  }
  .shorts__gorsel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .shorts__kat {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .shorts__metin {
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.32;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .shorts__meta {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.74rem;
  }
  .shorts__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 14px;
    padding: 13px 22px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-weight: 800;
    box-shadow: 0 16px 32px -18px var(--brand-glow);
    position: relative;
    transition: transform 0.2s var(--ease), filter 0.2s var(--ease);
  }
  .shorts__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }
  @media (max-width: 640px) {
    .shorts {
      padding: 16px 14px 14px;
    }
    .shorts__serit {
      grid-auto-columns: minmax(170px, 62vw);
    }
    .shorts__btn {
      width: 100%;
      min-height: 48px;
    }
  }

  .latest__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .latest__all {
    margin-left: auto;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--red);
    white-space: nowrap;
    transition: transform 0.2s var(--ease);
  }
  .latest__all:hover {
    transform: translateX(3px);
  }

  /* Teknoloji vitrini: hemen göze çarpsın diye hafif marka tonlu zemin. */
  .tekno {
    margin: 8px 0 26px;
    padding: 4px 20px 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(120% 140% at 0% 0%, var(--brand-soft), transparent 58%),
      var(--surface);
  }
  .tekno__h {
    margin: 20px 0 16px;
  }
  .tekno__icon {
    color: var(--brand);
  }

  .topics {
    margin-top: 8px;
  }
  .topics__list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 6px;
  }
  .topics__item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
    text-transform: capitalize;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .topics__item:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-2px);
  }
  .topics__n {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 80px 0;
    font-size: 1.05rem;
  }
  .empty code {
    background: var(--red-soft);
    color: var(--red-dark);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 600;
  }

  .more {
    display: flex;
    justify-content: center;
    margin: 34px 0 8px;
  }
  .more__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 2px solid var(--brand);
    color: var(--brand);
    background: var(--surface);
    font-weight: 800;
    font-size: 0.95rem;
    padding: 13px 30px;
    border-radius: 13px;
    transition: background 0.22s var(--ease), color 0.22s var(--ease),
      transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
  }
  .more__btn:hover {
    background: var(--brand-fill-hover);
    border-color: var(--brand-fill-hover);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px -20px var(--brand-glow);
  }
  .more__btn svg {
    transition: transform 0.22s var(--ease);
  }
  .more__btn:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    /* "Tümü" bağlantısı ve "daha fazla" düğmesi parmakla rahat basılsın. */
    .latest__all {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 2px;
    }
    .more__btn {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
    }
  }
</style>
