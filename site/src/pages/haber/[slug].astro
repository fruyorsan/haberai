---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { getArticles, formatDate, publishedISO } from "../../lib/articles.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const all = getArticles();
const date = formatDate(publishedISO(article));

const sameCat = all.filter((a) => a.categorySlug === article.categorySlug && a.slug !== article.slug);
const related = (sameCat.length ? sameCat : all.filter((a) => a.slug !== article.slug)).slice(0, 3);

const keyPoints = Array.isArray(article.keyPoints) ? article.keyPoints.filter(Boolean) : [];
const body = Array.isArray(article.body) ? article.body.filter(Boolean) : [];

const words = `${article.summary || ""} ${keyPoints.join(" ")} ${body.join(" ")} ${article.comment || ""}`
  .split(/\s+/)
  .filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

const shareUrl = Astro.url.href;

// --- SEO yardımcıları ---
const site = Astro.site ?? new URL("https://fruyorsan.github.io");

const articleUrl = new URL(article.url, site).href;
const publishedIso = article.publishedAt || article.generatedAt;
const modifiedIso = article.refreshedAt || article.generatedAt;
// TELİF: kaynak sitelerin görselleri kullanılmaz. Paylaşım görseli her zaman
// HaberAI'nın kendi markalı görselidir.
const ogImage = new URL("og-default.png", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.summary,
  image: [ogImage],
  creditText: article.source,
  isBasedOn: article.sourceUrl,
  isAccessibleForFree: true,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  articleSection: article.category,
  keywords: (article.tags || []).join(", "),
  articleBody: body.length ? body.join("\n\n") : article.summary,
  author: { "@type": "Organization", name: "HaberAI" },
  publisher: {
    "@type": "Organization",
    name: "HaberAI",
    logo: { "@type": "ImageObject", url: new URL("favicon.svg", site).href },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
};
---

<Base
  title={`${article.title} — HaberAI`}
  description={article.summary}
  canonical={articleUrl}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  section={article.category}
  tags={article.tags}
  imageAlt={article.title}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="container">
    <article class="post">
      <nav class="crumbs">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href={`/kategori/${article.categorySlug}/`}>{article.category}</a>
      </nav>

      <span class="badge">{article.category}</span>
      <h1 class="post__title">{article.title}</h1>

      <div class="post__meta">
        <span class="post__source">{article.source}</span>
        <span class="post__dot">•</span>
        <time>{date}</time>
        <span class="post__dot">•</span>
        <span>{readMin} dk okuma</span>
        <div class="post__share">
          <ShareButtons url={shareUrl} title={article.title} />
        </div>
      </div>

      <div class="post__media">
        <div class="post__ph" aria-hidden="true">
          <span class="post__ph-mark">H</span>
          <span class="post__ph-cat">{article.category}</span>
          <span class="post__ph-note">HaberAI özgün görseli</span>
        </div>
      </div>

      <div class="post__body">
        {body.length > 0 && (
          <section class="content">
            <h2 class="content__title">Haberin Detayı</h2>
            {body.map((p) => <p class="content__p">{p}</p>)}
          </section>
        )}

        {(article.summary || keyPoints.length > 0) && (
          <section class="recap">
            {article.summary && (
              <>
                <h2 class="recap__title">Özet</h2>
                <p class="recap__text">{article.summary}</p>
              </>
            )}

            {keyPoints.length > 0 && (
              <>
                <h3 class="sr-only">Öne çıkanlar</h3>
                <ul class="recap__list">
                  {keyPoints.map((k) => (
                    <li class="recap__item">
                      <svg class="recap__check" viewBox="0 0 20 20" aria-hidden="true">
                        <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.13" />
                        <path
                          d="M6 10.4l2.6 2.6L14 7.7"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>{k}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        {article.comment && (
          <section class="analysis">
            <div class="analysis__head">
              <span class="analysis__badge">AI YORUMU</span>
              <span class="analysis__sub">HaberAI editör analizi</span>
            </div>
            <p class="analysis__text">{article.comment}</p>
          </section>
        )}
      </div>

      {article.tags?.length > 0 && (
        <div class="post__tags">
          {article.tags.map((t) => (
            <a class="post__tag" href={`/ara/?q=${encodeURIComponent(t)}`}>#{t}</a>
          ))}
        </div>
      )}

      <div class="post__ref">
        Kaynak:
        <a href={article.sourceUrl} target="_blank" rel="noopener nofollow">{article.source}</a>
        <span class="post__ai-note">
          Bu haber, kaynaktaki bilgilerden yararlanılarak HaberAI tarafından özgün biçimde
          yazılmıştır; kaynak metin ve kaynak görselleri kopyalanmaz. Hata olabilir, ayrıntılar
          için kaynağa bakın. <a href="/telif/">İçerik ve telif politikası</a>
        </span>
      </div>
    </article>

    <section
      class="aiask"
      id="aiask"
      data-title={article.title}
      data-summary={article.summary}
      data-comment={article.comment}
      data-keypoints={keyPoints.join(" | ")}
    >
      <div class="aiask__head">
        <span class="aiask__badge">AI'YA SOR</span>
        <span class="aiask__sub">Bu haber hakkında merak ettiklerini sorabilirsin</span>
      </div>
      <div class="aiask__chips">
        <button type="button" class="aiask__chip">Bu haber kısaca ne anlatıyor?</button>
        <button type="button" class="aiask__chip">Bu gelişme kimleri etkiler?</button>
        <button type="button" class="aiask__chip">Bunun olası sonuçları neler?</button>
      </div>
      <form class="aiask__form" id="aiask-form">
        <input
          id="aiask-input"
          type="text"
          placeholder="Sorunu buraya yaz..."
          maxlength="400"
          autocomplete="off"
        />
        <button type="submit">Sor</button>
      </form>
      <div class="aiask__answer" id="aiask-answer" hidden></div>
    </section>

    {related.length > 0 && (
      <section>
        <h2 class="section-title section-title--line">İlgili Haberler</h2>
        <div class="grid">
          {related.map((a, i) => <ArticleCard article={a} index={i} />)}
        </div>
      </section>
    )}
  </div>

  <script>
    // --- Okuma ilerleme çubuğu ---
    const bar = document.getElementById("progress");
    if (bar) {
      const update = () => {
        const el = document.documentElement;
        const max = el.scrollHeight - el.clientHeight;
        const p = max > 0 ? el.scrollTop / max : 0;
        bar.style.transform = `scaleX(${Math.min(Math.max(p, 0), 1)})`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }

    // --- AI'ya Sor ---
    const box = document.getElementById("aiask");
    if (box) {
      const form = document.getElementById("aiask-form");
      const input = document.getElementById("aiask-input");
      const out = document.getElementById("aiask-answer");
      const ctx = {
        title: box.dataset.title || "",
        summary: box.dataset.summary || "",
        comment: box.dataset.comment || "",
        keyPoints: box.dataset.keypoints || "",
      };

      async function ask(q) {
        if (!q || q.trim().length < 3) return;
        out.hidden = false;
        out.classList.add("is-loading");
        out.textContent = "AI düşünüyor...";
        try {
          // Site GitHub Pages'te, "AI'ya Sor" servisi Netlify fonksiyonu olarak
          // yayinda; bu yuzden tam adres kullaniliyor (CORS fonksiyonda acik).
          const res = await fetch("https://ai-sor--haberai.netlify.app/api/sor", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...ctx, question: q }),
          });
          const data = await res.json().catch(() => ({}));
          out.textContent = data.answer || data.error || "Yanıt alınamadı.";
        } catch {
          out.textContent = "Bağlantı hatası. Lütfen tekrar dene.";
        } finally {
          out.classList.remove("is-loading");
        }
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        ask(input.value);
      });

      document.querySelectorAll(".aiask__chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          const q = chip.textContent || "";
          input.value = q;
          ask(q);
        });
      });
    }
  </script>
</Base>

<style>
  /* --- Okuma ilerlemesi --- */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 30;
    background: var(--red-grad);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.1s linear;
  }

  .post {
    max-width: 780px;
    margin: 30px auto 0;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .post__title {
    font-size: 2.15rem;
    line-height: 1.19;
    letter-spacing: -0.025em;
    margin: 14px 0 14px;
    font-weight: 900;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.88rem;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 22px;
  }
  .post__source {
    color: var(--red);
    font-weight: 700;
  }
  .post__dot {
    opacity: 0.5;
  }
  .post__share {
    margin-left: auto;
  }

  .post__media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 24px;
    background: var(--bg-soft);
    aspect-ratio: 16 / 9;
    box-shadow: var(--shadow);
  }
  .post__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background:
      radial-gradient(120% 120% at 12% 0%, rgba(255, 255, 255, 0.16), transparent 55%),
      var(--red-grad);
    color: rgba(255, 255, 255, 0.94);
  }
  .post__ph-mark {
    font-size: clamp(3rem, 9vw, 5.4rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
  }
  .post__ph-cat {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .post__ph-note {
    position: absolute;
    right: 16px;
    bottom: 12px;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .post__body {
    font-size: 1.06rem;
    line-height: 1.75;
    color: var(--text-2);
  }

  /* --- Bölüm başlıkları --- */
  .content__title,
  .recap__title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 10px;
  }

  /* --- Özet bloğu (haber detayının altında, tam genişlik) --- */
  .recap {
    margin: 34px 0 8px;
    padding: 22px 24px 20px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
  }
  .recap__text {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.76;
    font-weight: 500;
    color: var(--text);
  }
  .recap__list {
    list-style: none;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px dashed var(--border-strong);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .recap__item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.99rem;
    line-height: 1.55;
    color: var(--text-2);
  }
  .recap__check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: var(--red);
  }

  /* --- Haberin detayı (gövde) --- */
  .content {
    margin: 30px 0 8px;
  }
  .content__p {
    margin: 0 0 18px;
    font-size: 1.08rem;
    line-height: 1.82;
    color: var(--text-2);
  }
  .content__p:first-of-type::first-letter {
    font-weight: 800;
  }
  .content__p:last-child {
    margin-bottom: 0;
  }

  /* --- AI analizi (özetten görsel olarak tamamen farklı) --- */
  .analysis {
    position: relative;
    margin: 32px 0;
    padding: 26px 28px;
    border-radius: 18px;
    background: linear-gradient(135deg, #14161a 0%, #1e222b 100%);
    color: #dfe3ea;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .analysis::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--red-grad);
  }
  .analysis::after {
    content: "";
    position: absolute;
    right: -70px;
    top: -70px;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(216, 31, 38, 0.32), transparent 70%);
    pointer-events: none;
  }
  .analysis__head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    position: relative;
  }
  .analysis__badge {
    background: var(--red-grad);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 5px 10px;
    border-radius: 7px;
  }
  .analysis__sub {
    font-size: 0.8rem;
    color: #9aa3b2;
    font-weight: 600;
  }
  .analysis__text {
    margin: 0;
    position: relative;
    font-size: 1.06rem;
    line-height: 1.78;
    color: #e6eaf1;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0;
  }
  .post__tag {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.82rem;
    color: var(--muted);
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
      border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .post__tag:hover {
    background: var(--red-soft);
    border-color: var(--red);
    color: var(--red-dark);
    transform: translateY(-2px);
  }
  .post__ref {
    font-size: 0.88rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .post__ref a {
    color: var(--red);
    font-weight: 600;
  }
  .post__ai-note {
    display: block;
    margin-top: 8px;
    font-size: 0.8rem;
    color: #9aa1ac;
  }

  @media (max-width: 640px) {
    .post__title {
      font-size: 1.62rem;
    }
    .post__share {
      margin-left: 0;
      width: 100%;
    }
    .analysis {
      padding: 22px 20px;
    }
    .recap {
      padding: 18px 18px 16px;
    }
    .recap__text {
      font-size: 1.04rem;
    }
  }

  /* --- AI'ya Sor --- */
  .aiask {
    max-width: 780px;
    margin: 34px auto 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .aiask__head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .aiask__badge {
    background: var(--control-bg);
    color: var(--control-fg);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 5px 11px;
    border-radius: 7px;
  }
  .aiask__sub {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .aiask__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .aiask__chip {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 7px 13px;
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease),
      color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .aiask__chip:hover {
    background: var(--red-soft);
    border-color: var(--red);
    color: var(--red-dark);
    transform: translateY(-2px);
  }
  .aiask__form {
    display: flex;
    gap: 8px;
  }
  .aiask__form input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.98rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .aiask__form input::placeholder {
    color: var(--muted);
  }
  .aiask__form input:focus {
    border-color: var(--red);
    box-shadow: 0 0 0 4px var(--red-soft);
  }
  .aiask__form button {
    height: 48px;
    padding: 0 24px;
    border: none;
    border-radius: 12px;
    background: var(--red-grad);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .aiask__form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -16px rgba(216, 31, 38, 1);
  }
  .aiask__answer {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--surface-2);
    border-left: 4px solid var(--brand);
    line-height: 1.7;
    color: var(--text-2);
    white-space: pre-wrap;
    animation: answer-in 0.35s var(--ease);
  }
  @keyframes answer-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .aiask__answer.is-loading {
    color: var(--muted);
    font-style: italic;
  }
</style>
