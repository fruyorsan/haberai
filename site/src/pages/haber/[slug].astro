---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getArticles, formatDate } from "../../lib/articles.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const all = getArticles();
const date = formatDate(article.publishedAt || article.generatedAt);

const sameCat = all.filter((a) => a.categorySlug === article.categorySlug && a.slug !== article.slug);
const related = (sameCat.length ? sameCat : all.filter((a) => a.slug !== article.slug)).slice(0, 3);

const words = `${article.summary} ${article.comment}`.split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.summary,
  image: article.image ? [article.image] : undefined,
  datePublished: article.publishedAt || article.generatedAt,
  dateModified: article.generatedAt,
  articleSection: article.category,
  keywords: (article.tags || []).join(", "),
  author: { "@type": "Organization", name: "HaberAI" },
  publisher: {
    "@type": "Organization",
    name: "HaberAI",
    logo: { "@type": "ImageObject", url: "/favicon.svg" },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.pathname },
};
---

<Base title={`${article.title} — HaberAI`} description={article.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container">
    <article class="post">
      <nav class="crumbs">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href={`/kategori/${article.categorySlug}/`}>{article.category}</a>
      </nav>

      <span class="badge">{article.category}</span>
      <h1 class="post__title">{article.title}</h1>

      <div class="post__meta">
        <span class="post__source">{article.source}</span>
        <span class="post__dot">•</span>
        <time>{date}</time>
        <span class="post__dot">•</span>
        <span>{readMin} dk okuma</span>
      </div>

      {article.image && (
        <img class="post__image" src={article.image} alt={article.title} />
      )}

      <p class="post__lead">{article.summary}</p>

      {article.comment && (
        <div class="post__comment">
          <div class="post__comment-head">
            <span class="post__comment-badge">AI YORUMU</span>
            <span class="post__comment-sub">HaberAI editör analizi</span>
          </div>
          <p>{article.comment}</p>
        </div>
      )}

      {article.tags?.length > 0 && (
        <div class="post__tags">
          {article.tags.map((t) => (
            <span class="post__tag">#{t}</span>
          ))}
        </div>
      )}

      <div class="post__ref">
        Kaynak:
        <a href={article.sourceUrl} target="_blank" rel="noopener nofollow">{article.source}</a>
      </div>
    </article>

    {related.length > 0 && (
      <section>
        <h2 class="section-title">İlgili Haberler</h2>
        <div class="grid">
          {related.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .post {
    max-width: 760px;
    margin: 30px auto 0;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .post__title {
    font-size: 2.1rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 14px 0 14px;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.88rem;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 22px;
  }
  .post__source {
    color: var(--red);
    font-weight: 700;
  }
  .post__image {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .post__lead {
    font-size: 1.18rem;
    line-height: 1.7;
    font-weight: 500;
    color: #2a2d34;
  }
  .post__comment {
    background: var(--red-soft);
    border-left: 4px solid var(--red);
    border-radius: 10px;
    padding: 18px 20px;
    margin: 26px 0;
  }
  .post__comment-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .post__comment-badge {
    background: var(--red);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 4px 9px;
    border-radius: 6px;
  }
  .post__comment-sub {
    font-size: 0.8rem;
    color: var(--red-dark);
    font-weight: 600;
  }
  .post__comment p {
    margin: 0;
    line-height: 1.7;
    color: #3a1f20;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0;
  }
  .post__tag {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .post__ref {
    font-size: 0.88rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .post__ref a {
    color: var(--red);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .post__title {
      font-size: 1.6rem;
    }
  }
</style>
