---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import AdSlot from "../../components/AdSlot.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import DevamHaber from "../../components/DevamHaber.astro";
import HaberFigur from "../../components/HaberFigur.astro";
import Yorumlar from "../../components/Yorumlar.astro";
import { getArticles, formatDate, publishedISO, imageUrl, imageSrcset, tagUrl, slugify } from "../../lib/articles.js";
import { kapakKaynagi, kapakUygunMu } from "../../lib/kapak.js";
import { ADSENSE_SLOTS, ONESIGNAL_APP_ID, siteOrigin } from "../../lib/site-meta.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const all = getArticles();
const date = formatDate(publishedISO(article));

// İlgili haberler: yalnızca kategoriye bakmak geniş kategorilerde (Gündem gibi)
// konuyla ilgisiz "en son" haberleri getiriyordu. Sıralama artık önce ortak
// konu (etiket) sayısına, sonra aynı kategoriye, en sonda tazeliğe göre yapılır.
const benimEtiketler = new Set(
  (Array.isArray(article.tags) ? article.tags : []).map((t) => slugify(t)).filter(Boolean)
);

const puanla = (a) => {
  if (a.slug === article.slug) return -1;
  const ortak = (Array.isArray(a.tags) ? a.tags : []).filter((t) => benimEtiketler.has(slugify(t))).length;
  return ortak * 4 + (a.categorySlug === article.categorySlug ? 1 : 0);
};

// getArticles() en yeniden eskiye sıralıdır; eşit puanda tazelik korunur.
const skorlu = all
  .map((a, i) => ({ a, i, p: puanla(a) }))
  .filter((x) => x.p > 0)
  .sort((x, y) => y.p - x.p || x.i - y.i)
  .map((x) => x.a);

// Kategorisinde tek kalan haberlerde liste eksik kalmasın: en yeni haberlerle tamamla.
const yedek = all.filter((a) => a.slug !== article.slug && !skorlu.includes(a));
const benzerler = [...skorlu, ...yedek];
// "Okumaya devam et" zinciri: haberin hemen ardından TAM içeriğiyle akan en
// ilgili 4 haber (ShiftDelete tarzı). Zincir burada durur.
const devam = benzerler.slice(0, 4);
// "İlgili Haberler": zincirde kullanılanların ardından gelen 3 haber (tekrar yok).
const related = benzerler.slice(4, 7);

const keyPoints = Array.isArray(article.keyPoints) ? article.keyPoints.filter(Boolean) : [];
const body = Array.isArray(article.body) ? article.body.filter(Boolean) : [];

// --- Kapak fotoğrafı (güvenlik süzgecinden geçmiş) ---
// Kaynağın verdiği görsel yanlış ya da tekrar eden genel bir "haber görseli" ise
// gösterilmez (bkz. lib/kapak.js); yerine doğrulanmış ek fotoğraf, o da yoksa
// markalı kapak kullanılır. `kapak` boşsa çağıranlar /og-default.png'e düşer.
const kapak = kapakKaynagi(article);

// --- Bildirim (web push) ---
// OneSignal App ID tanımlıysa haber sayfasında "bu kategoriyi takip et" düğmesi
// çıkar (bkz. components/Bildirim.astro). Kurulu değilse düğme hiç basılmaz.
const bildirimAktif = Boolean(String(ONESIGNAL_APP_ID || "").trim());

// --- Haber içi ek fotoğraflar ---
// Telif güvenli stok hattı görselleri `gorselEk` içinde (URL + fotoğrafçı +
// lisans) gelir; eski kayıtlarda yalnızca `images` (URL listesi) vardır.
// Kapak olarak kullanılan fotoğraf tekrar edilmez; boşsa bölüm hiç çizilmez.
const ekKaynaklar = Array.isArray(article.gorselEk) ? article.gorselEk.filter(Boolean) : [];
const ekGorseller = (ekKaynaklar.length
  ? ekKaynaklar.map((g) => g.url)
  : Array.isArray(article.images)
    ? article.images
    : []
)
  .filter((u) => typeof u === "string" && /^https?:\/\//i.test(u) && u !== kapak)
  .filter((u) => kapakUygunMu(article, u))
  .slice(0, 2);

/** Ek fotoğrafın telif/lisans bilgisi (varsa). */
const ekKaynak = (url) =>
  ekKaynaklar.find((g) => String(g.url) === String(url)) || null;

/** Stok fotoğrafın atıf metni: "Fotoğrafçı · Lisans · Wikimedia Commons" */
const atifMetni = (g) =>
  [g?.yazar, g?.lisans, "Wikimedia Commons"].filter(Boolean).join(" · ");

// Ek fotoğrafın gövdede nereye gireceği: uzun haberlerde ortaya doğru kaydırılır
// ki okuma akışı bölünmesin (ör. 6 paragraflı haberde 4. paragraftan sonra).
const fig2Indeks = Math.max(2, Math.round(body.length * 0.6) - 1);

const words = `${article.summary || ""} ${keyPoints.join(" ")} ${body.join(" ")} ${article.comment || ""}`
  .split(/\s+/)
  .filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

const shareUrl = Astro.url.href;

// --- SEO yardımcıları ---
const site = Astro.site ?? new URL("https://fruyorsan.github.io");

const articleUrl = new URL(article.url, site).href;
const publishedIso = article.publishedAt || article.generatedAt;
const modifiedIso = article.refreshedAt || article.generatedAt;
// Görsel: gerçek haber fotoğrafı varsa paylaşım görseli o olur; yoksa
// HaberinAi'nın kendi markalı görseli kullanılır.
const ogImage = kapak
  ? new URL(kapak, site).href
  : new URL("og-default.png", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.summary,
  image: [ogImage],
  creditText: article.source,
  isBasedOn: article.sourceUrl,
  isAccessibleForFree: true,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  articleSection: article.category,
  keywords: (article.tags || []).join(", "),
  articleBody: body.length ? body.join("\n\n") : article.summary,
  author: { "@type": "Organization", name: "HaberinAi", url: new URL("/", site).href },
  publisher: {
    "@type": "Organization",
    name: "HaberinAi",
    url: new URL("/", site).href,
    // Google yayıncı logosunu KARE ve en az 112 px ister; kare PNG ikon
    // (512x512) bu yüzden SVG yerine kullanılır — marka panelinde/News
    // sonuçlarında logo görünür.
    logo: {
      "@type": "ImageObject",
      url: new URL("ikon-512.png", site).href,
      width: 512,
      height: 512,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ana Sayfa", item: new URL("/", site).href },
    { "@type": "ListItem", position: 2, name: article.category, item: new URL(`/kategori/${article.categorySlug}/`, site).href },
    { "@type": "ListItem", position: 3, name: article.title, item: articleUrl },
  ],
};
---

<Base
  title={`${article.title} — HaberinAi`}
  description={article.summary}
  canonical={articleUrl}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  section={article.category}
  tags={article.tags}
  image={kapak || undefined}
  imageAlt={article.title}
  preloadImage={kapak ? imageUrl(kapak, 1200) : "/og-default.png"}
  preloadSrcset={kapak ? imageSrcset(kapak, [820, 1200]) : undefined}
  preloadSizes="(max-width: 900px) 100vw, 860px"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="container">
    <article class="post">
      <nav class="crumbs">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href={`/kategori/${article.categorySlug}/`}>{article.category}</a>
      </nav>

      <div class="post__top">
        <span class="badge">{article.category}</span>
        {bildirimAktif && (
          <div class="post__follow-wrap">
            <button
              type="button"
              class="post__follow"
              data-kategori={article.categorySlug}
              data-ad={article.category}
              aria-pressed="false"
              title={`${article.category} kategorisinde yeni haber çıkınca bildirim al`}
            >
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8.5a6 6 0 1 0-12 0c0 4.6-1.9 5.7-1.9 7.1h15.8c0-1.4-1.9-2.5-1.9-7.1z" />
                <path d="M10.2 20.2a2.1 2.1 0 0 0 3.6 0" />
              </svg>
              <span class="post__follow-text">Bu kategoriyi takip et</span>
            </button>
            <span class="post__follow-note" role="status" aria-live="polite" />
          </div>
        )}
      </div>
      <h1 class="post__title">{article.title}</h1>

      <div class="post__meta">
        <time>{date}</time>
        <span class="post__dot">•</span>
        <span>{readMin} dk okuma</span>
        <div class="post__share">
          <ShareButtons url={shareUrl} title={article.title} />
          <div class="post__ai" role="group" aria-label="Yapay zekâ araçları">
            <button type="button" class="post__ai-btn" data-jump="#ozet">
              <span class="post__ai-ico" aria-hidden="true">✨</span> AI Özet
            </button>
            <button type="button" class="post__ai-btn post__ai-btn--ask" data-jump="#aiask">
              <span class="post__ai-ico" aria-hidden="true">✨</span> AI'ya Sor
            </button>
          </div>
        </div>
      </div>

      <div class="post__media">
        <div class="post__ph" aria-hidden="true">
          <span class="post__ph-mark">H</span>
          <span class="post__ph-cat">{article.category}</span>
        </div>
        {kapak ? (
          <img
            class="post__img"
            src={imageUrl(kapak, 1200)}
            srcset={imageSrcset(kapak, [820, 1200]) || undefined}
            sizes="(max-width: 900px) 100vw, 860px"
            data-orig={kapak}
            alt={article.title}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            referrerpolicy="no-referrer"
            onerror="if(this.dataset.orig&&!this.dataset.f){this.dataset.f='1';this.removeAttribute('srcset');this.removeAttribute('sizes');this.src=this.dataset.orig}else{this.classList.add('is-broken')}"
          />
        ) : null}
        <span class="post__veil" aria-hidden="true"></span>
        {kapak && article.gorselKaynak?.sayfa ? (
          <a
            class="post__ph-credit"
            href={article.gorselKaynak.sayfa}
            target="_blank"
            rel="noopener nofollow"
            title={`Fotoğraf: ${atifMetni(article.gorselKaynak)}`}
            aria-label={`Fotoğraf: ${atifMetni(article.gorselKaynak)}. Wikimedia Commons dosya sayfasını aç`}
          >
            <span aria-hidden="true">i</span>
          </a>
        ) : kapak ? (
          <span
            class="post__ph-credit"
            title={`Fotoğraf: ${article.source}`}
            aria-label={`Fotoğraf: ${article.source}`}
          >
            <span aria-hidden="true">i</span>
          </span>
        ) : null}
        {kapak && <span class="sr-only">Fotoğraf: {article.gorselKaynak ? atifMetni(article.gorselKaynak) : article.source}</span>}
      </div>

      <div class="post__body">
        {/* ÖZET EN ÜSTTE: sitemizin asıl vaadi kısalık ve netlik. Okur, gövdeyi okumadan
            haberi anlayabilmeli; ayrıntı isteyen aşağıdaki "Haberin Detayı"na iner. */}
        {(article.summary || keyPoints.length > 0) && (
          <section class="recap" id="ozet">
            {article.summary && (
              <>
                <h2 class="recap__title">Özet</h2>
                <p class="recap__text">{article.summary}</p>
              </>
            )}

            {keyPoints.length > 0 && (
              <>
                <h3 class="sr-only">Öne çıkanlar</h3>
                <ul class="recap__list">
                  {keyPoints.map((k) => (
                    <li class="recap__item">
                      <svg class="recap__check" viewBox="0 0 20 20" aria-hidden="true">
                        <circle cx="10" cy="10" r="9" fill="currentColor" opacity="0.13" />
                        <path
                          d="M6 10.4l2.6 2.6L14 7.7"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>{k}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        {body.length > 0 && (
          <section class="content">
            <h2 class="content__title">Haberin Detayı</h2>
            {body.map((p, i) => (
              <Fragment>
                <p class="content__p">{p}</p>

                {/* Haber içi ek fotoğraflar: 1. paragraftan sonra ve gövdenin
                    ortasına doğru. Fotoğraf yüklenemezse figür tamamen kaldırılır,
                    sayfa bozulmaz. Tıklanınca kaynak fotoğraf yeni sekmede açılır. */}
                {ekGorseller[0] && i === 0 && body.length >= 3 && (
                  <HaberFigur
                    url={ekGorseller[0]}
                    baslik={article.title}
                    kaynak={ekKaynak(ekGorseller[0])}
                    eskiKaynak={article.source}
                  />
                )}

                {ekGorseller[1] && i === fig2Indeks && body.length >= 5 && (
                  <HaberFigur
                    url={ekGorseller[1]}
                    baslik={article.title}
                    kaynak={ekKaynak(ekGorseller[1])}
                    eskiKaynak={article.source}
                  />
                )}

                {/* Gövde ortası reklamı: 2. paragraftan sonra, yeterince uzun haberlerde (ShiftDelete tarzı in-article) */}
                {i === 1 && body.length >= 4 && (
                  <AdSlot slot={ADSENSE_SLOTS.makale2} format="fluid" layout="in-article" label="Sponsorlu" />
                )}
              </Fragment>
            ))}
          </section>
        )}

        {article.comment && (
          <section class="analysis">
            <div class="analysis__head">
              <span class="analysis__badge">AI YORUMU</span>
              <span class="analysis__sub">HaberinAi editör analizi</span>
            </div>
            <p class="analysis__text">{article.comment}</p>
          </section>
        )}

        <AdSlot slot={ADSENSE_SLOTS.makale} label="Sponsorlu" />
      </div>

      {article.tags?.length > 0 && (
        <div class="post__tags">
          {article.tags.map((t) => (
            <a class="post__tag" href={tagUrl(t) || `/ara/?q=${encodeURIComponent(t)}`}>
              #{t}
            </a>
          ))}
        </div>
      )}

      <div class="post__ref">
        Kaynak:
        <a href={article.sourceUrl} target="_blank" rel="noopener nofollow">{article.source}</a>
        <span class="post__ai-note">
          Bu haber, kaynaktaki bilgilerden yararlanılarak HaberinAi tarafından özgün biçimde
          yazılmıştır; kaynak metin birebir kopyalanmaz, fotoğraf kaynağa bağlantıyla gösterilir.
          Hata olabilir, ayrıntılar için kaynağa bakın. <a href="/telif/">İçerik ve telif politikası</a>
        </span>
      </div>
    </article>

    {/* AI'ya Sor kutusu yazının hemen ardında ve okuma zincirinden ÖNCE olmalı:
        aksi hâlde bu bölüme kaydıran düğme, okuru 4 başka haberin sonuna götürüyordu. */}
    <section
      class="aiask"
      id="aiask"
      data-title={article.title}
      data-summary={article.summary}
      data-comment={article.comment}
      data-keypoints={keyPoints.join(" | ")}
    >
      <div class="aiask__head">
        <span class="aiask__badge">AI'YA SOR</span>
        <span class="aiask__sub">Bu haber hakkında merak ettiklerini sorabilirsin</span>
      </div>
      <div class="aiask__chips">
        <button type="button" class="aiask__chip">Bu haber kısaca ne anlatıyor?</button>
        <button type="button" class="aiask__chip">Bu gelişme kimleri etkiler?</button>
        <button type="button" class="aiask__chip">Bunun olası sonuçları neler?</button>
      </div>
      <form class="aiask__form" id="aiask-form">
        <input
          id="aiask-input"
          type="text"
          placeholder="Sorunu buraya yaz..."
          maxlength="400"
          autocomplete="off"
        />
        <button type="submit">Sor</button>
      </form>
      <div class="aiask__answer" id="aiask-answer" hidden></div>
    </section>

    {/* ShiftDelete tarzı okumaya devam: haberin hemen ardından benzer haberlerin
        TAM içeriği akar (4 haber), sonra zincir durur. */}
    {devam.map((a, i) => <DevamHaber article={a} index={i} />)}

    {devam.length > 0 && (
      <div class="devam-end">
        <span class="devam-end__line" aria-hidden="true"></span>
        <span class="devam-end__text">Okuma zinciri burada sona erdi</span>
        <a class="devam-end__btn" href="/haberler/">Tüm haberlere göz at →</a>
      </div>
    )}

    {related.length > 0 && (
      <section>
        <h2 class="section-title section-title--line">İlgili Haberler</h2>
        <div class="grid">
          {related.map((a, i) => <ArticleCard article={a} index={i} />)}
        </div>
      </section>
    )}

    <AdSlot slot={ADSENSE_SLOTS.liste} label="Sponsorlu" />

    <Yorumlar
      slug={article.slug}
      baslik={article.title}
      url={`${siteOrigin(Astro.site)}/haber/${article.slug}/`}
    />
  </div>

  <script>
    // --- Okuma ilerleme çubuğu (rAF ile akıcı) ---
    const bar = document.getElementById("progress");
    if (bar) {
      let ticking = false;
      const update = () => {
        const el = document.documentElement;
        const max = el.scrollHeight - el.clientHeight;
        const p = max > 0 ? el.scrollTop / max : 0;
        bar.style.transform = `scaleX(${Math.min(Math.max(p, 0), 1)})`;
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    }

    // --- AI'ya Sor ---
    const box = document.getElementById("aiask");
    if (box) {
      const form = document.getElementById("aiask-form");
      const input = document.getElementById("aiask-input");
      const out = document.getElementById("aiask-answer");
      const ctx = {
        title: box.dataset.title || "",
        summary: box.dataset.summary || "",
        comment: box.dataset.comment || "",
        keyPoints: box.dataset.keypoints || "",
      };

      async function ask(q) {
        if (!q || q.trim().length < 3) return;
        out.hidden = false;
        out.classList.add("is-loading");
        out.textContent = "AI düşünüyor...";
        try {
          // Site GitHub Pages'te, "AI'ya Sor" servisi Netlify fonksiyonu olarak
          // yayinda; bu yuzden tam adres kullaniliyor (CORS fonksiyonda acik).
          const res = await fetch("https://ai-sor--haberai.netlify.app/api/sor", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...ctx, question: q }),
          });
          const data = await res.json().catch(() => ({}));
          out.textContent = data.answer || data.error || "Yanıt alınamadı.";
        } catch {
          out.textContent = "Bağlantı hatası. Lütfen tekrar dene.";
        } finally {
          out.classList.remove("is-loading");
        }
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        ask(input.value);
      });

      document.querySelectorAll(".aiask__chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          const q = chip.textContent || "";
          input.value = q;
          ask(q);
        });
      });
    }

    // --- "AI Özet" / "AI'ya Sor" düğmeleri: ilgili bölüme kaydır ve vurgula ---
    document.querySelectorAll(".post__ai-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const hedef = document.querySelector(btn.getAttribute("data-jump") || "");
        if (!hedef) return;
        hedef.scrollIntoView({ behavior: "smooth", block: "start" });
        hedef.classList.add("is-flash");
        setTimeout(() => hedef.classList.remove("is-flash"), 1400);
      });
    });
  </script>
</Base>

<style>
  /* --- Okuma ilerlemesi --- */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 30;
    background: var(--red-grad);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.1s linear;
  }

  .post {
    max-width: 780px;
    margin: 30px auto 0;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .crumbs a:hover {
    color: var(--red);
  }

  /* --- "Bu kategoriyi takip et" (bildirim) --- */
  .post__top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .post__follow-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .post__follow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    border-radius: 999px;
    background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--text) 7%, transparent),
        transparent 62%
      ),
      var(--surface);
    color: var(--text-2);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease),
      background 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .post__follow:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .post__follow:active {
    transform: scale(0.97);
  }
  .post__follow.is-on {
    border-color: transparent;
    background: var(--brand-grad);
    color: #fff;
    box-shadow: 0 10px 20px -14px var(--brand-glow);
  }
  .post__follow.is-on:hover {
