---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getArticles, formatDate } from "../../lib/articles.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const all = getArticles();
const date = formatDate(article.publishedAt || article.generatedAt);

const sameCat = all.filter((a) => a.categorySlug === article.categorySlug && a.slug !== article.slug);
const related = (sameCat.length ? sameCat : all.filter((a) => a.slug !== article.slug)).slice(0, 3);

const words = `${article.summary} ${article.comment}`.split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.summary,
  image: article.image ? [article.image] : undefined,
  datePublished: article.publishedAt || article.generatedAt,
  dateModified: article.generatedAt,
  articleSection: article.category,
  keywords: (article.tags || []).join(", "),
  author: { "@type": "Organization", name: "HaberAI" },
  publisher: {
    "@type": "Organization",
    name: "HaberAI",
    logo: { "@type": "ImageObject", url: "/favicon.svg" },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.pathname },
};
---

<Base title={`${article.title} — HaberAI`} description={article.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container">
    <article class="post">
      <nav class="crumbs">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href={`/kategori/${article.categorySlug}/`}>{article.category}</a>
      </nav>

      <span class="badge">{article.category}</span>
      <h1 class="post__title">{article.title}</h1>

      <div class="post__meta">
        <span class="post__source">{article.source}</span>
        <span class="post__dot">•</span>
        <time>{date}</time>
        <span class="post__dot">•</span>
        <span>{readMin} dk okuma</span>
      </div>

      {article.image && (
        <img class="post__image" src={article.image} alt={article.title} />
      )}

      <p class="post__lead">{article.summary}</p>

      {article.comment && (
        <div class="post__comment">
          <div class="post__comment-head">
            <span class="post__comment-badge">AI YORUMU</span>
            <span class="post__comment-sub">HaberAI editör analizi</span>
          </div>
          <p>{article.comment}</p>
        </div>
      )}

      {article.tags?.length > 0 && (
        <div class="post__tags">
          {article.tags.map((t) => (
            <span class="post__tag">#{t}</span>
          ))}
        </div>
      )}

      <div class="post__ref">
        Kaynak:
        <a href={article.sourceUrl} target="_blank" rel="noopener nofollow">{article.source}</a>
      </div>
    </article>

    <section
      class="aiask"
      id="aiask"
      data-title={article.title}
      data-summary={article.summary}
      data-comment={article.comment}
    >
      <div class="aiask__head">
        <span class="aiask__badge">AI'YA SOR</span>
        <span class="aiask__sub">Bu haber hakkında merak ettiklerini sorabilirsin</span>
      </div>
      <div class="aiask__chips">
        <button type="button" class="aiask__chip">Bu haber kısaca ne anlatıyor?</button>
        <button type="button" class="aiask__chip">Bu gelişme kimleri etkiler?</button>
        <button type="button" class="aiask__chip">Bunun olası sonuçları neler?</button>
      </div>
      <form class="aiask__form" id="aiask-form">
        <input
          id="aiask-input"
          type="text"
          placeholder="Sorunu buraya yaz..."
          maxlength="400"
          autocomplete="off"
        />
        <button type="submit">Sor</button>
      </form>
      <div class="aiask__answer" id="aiask-answer" hidden></div>
    </section>

    {related.length > 0 && (
      <section>
        <h2 class="section-title">İlgili Haberler</h2>
        <div class="grid">
          {related.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    )}
  </div>

  <script>
    const box = document.getElementById("aiask");
    if (box) {
      const form = document.getElementById("aiask-form");
      const input = document.getElementById("aiask-input");
      const out = document.getElementById("aiask-answer");
      const ctx = {
        title: box.dataset.title || "",
        summary: box.dataset.summary || "",
        comment: box.dataset.comment || "",
      };

      async function ask(q) {
        if (!q || q.trim().length < 3) return;
        out.hidden = false;
        out.classList.add("is-loading");
        out.textContent = "AI düşünüyor...";
        try {
          const res = await fetch("/api/sor", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...ctx, question: q }),
          });
          const data = await res.json().catch(() => ({}));
          out.textContent = data.answer || data.error || "Yanıt alınamadı.";
        } catch {
          out.textContent = "Bağlantı hatası. Lütfen tekrar dene.";
        } finally {
          out.classList.remove("is-loading");
        }
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        ask(input.value);
      });

      document.querySelectorAll(".aiask__chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          const q = chip.textContent || "";
          input.value = q;
          ask(q);
        });
      });
    }
  </script>
</Base>

<style>
  .post {
    max-width: 760px;
    margin: 30px auto 0;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .post__title {
    font-size: 2.1rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 14px 0 14px;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.88rem;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 22px;
  }
  .post__source {
    color: var(--red);
    font-weight: 700;
  }
  .post__image {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .post__lead {
    font-size: 1.18rem;
    line-height: 1.7;
    font-weight: 500;
    color: #2a2d34;
  }
  .post__comment {
    background: var(--red-soft);
    border-left: 4px solid var(--red);
    border-radius: 10px;
    padding: 18px 20px;
    margin: 26px 0;
  }
  .post__comment-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .post__comment-badge {
    background: var(--red);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 4px 9px;
    border-radius: 6px;
  }
  .post__comment-sub {
    font-size: 0.8rem;
    color: var(--red-dark);
    font-weight: 600;
  }
  .post__comment p {
    margin: 0;
    line-height: 1.7;
    color: #3a1f20;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0;
  }
  .post__tag {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .post__ref {
    font-size: 0.88rem;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .post__ref a {
    color: var(--red);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .post__title {
      font-size: 1.6rem;
    }
  }

  /* --- AI'ya Sor --- */
  .aiask {
    max-width: 760px;
    margin: 30px auto 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    background: #fff;
  }
  .aiask__head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .aiask__badge {
    background: #14161a;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 6px;
  }
  .aiask__sub {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .aiask__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .aiask__chip {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 7px 13px;
    font-size: 0.83rem;
    font-weight: 600;
    color: #303238;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .aiask__chip:hover {
    background: var(--red-soft);
    border-color: var(--red);
    color: var(--red-dark);
  }
  .aiask__form {
    display: flex;
    gap: 8px;
  }
  .aiask__form input {
    flex: 1;
    height: 48px;
    padding: 0 16px;
    border: 2px solid var(--line);
    border-radius: 12px;
    font-size: 0.98rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .aiask__form input:focus {
    border-color: var(--red);
    box-shadow: 0 0 0 4px var(--red-soft);
  }
  .aiask__form button {
    height: 48px;
    padding: 0 24px;
    border: none;
    border-radius: 12px;
    background: var(--red);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s;
  }
  .aiask__form button:hover {
    background: var(--red-dark);
  }
  .aiask__answer {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--bg-soft);
    border-left: 4px solid var(--red);
    line-height: 1.7;
    color: #2a2d34;
    white-space: pre-wrap;
  }
  .aiask__answer.is-loading {
    color: var(--muted);
    font-style: italic;
  }
</style>
