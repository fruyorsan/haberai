---
import Base from "../layouts/Base.astro";
import { getArticles, publishedISO, timeAgo } from "../lib/articles.js";

const latest = getArticles().slice(0, 8);
---

<Base
  title="Sayfa bulunamadı — HaberinAi"
  description="Aradığınız sayfa bulunamadı. Güncel haberlere HaberinAi'dan ulaşabilirsiniz."
  noindex
>
  <div class="container nf">
    <div class="nf__head">
      <span class="nf__code">404</span>
      <div>
        <h1>Aradığınız sayfa bulunamadı</h1>
        <p class="nf__text">
          Bağlantı taşınmış, adres yanlış yazılmış ya da haber kaldırılmış olabilir.
          Aşağıdaki güncel haberlere göz atabilirsiniz.
        </p>
      </div>
    </div>

    <a class="nf__btn" href="/">← Ana sayfaya dön</a>

    <h2 class="nf__sub">Son haberler</h2>
    <ul class="nf__list">
      {
        latest.map((a) => (
          <li>
            <a href={a.url}>{a.title}</a>
            <span class="nf__meta">
              {a.category} · {timeAgo(publishedISO(a))}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .nf {
    max-width: 820px;
    margin: 48px auto 80px;
  }
  .nf__head {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .nf__code {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    color: var(--brand, #d21a1a);
    letter-spacing: -0.04em;
  }
  .nf h1 {
    margin: 0 0 10px;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .nf__text {
    margin: 0;
    color: var(--text-2);
    line-height: 1.7;
  }
  .nf__btn {
    display: inline-block;
    margin: 26px 0 8px;
    padding: 11px 20px;
    border-radius: 10px;
    background: var(--brand-fill, #d21a1a);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .nf__btn:hover {
    background: var(--brand-fill-hover, #b31515);
    color: #fff;
  }
  .nf__sub {
    margin: 34px 0 12px;
    font-size: 1.1rem;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
  }
  .nf__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .nf__list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .nf__list a {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    line-height: 1.45;
  }
  .nf__list a:hover {
    color: var(--brand, #d21a1a);
  }
  .nf__meta {
    font-size: 0.8rem;
    color: var(--text-3, var(--muted, #6b7280));
  }
</style>
