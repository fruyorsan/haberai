---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL } from "../lib/site-meta.js";

const origin = Astro.site ? String(Astro.site).replace(/\/+$/, "") : "https://haberinai.site";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "İletişim — HaberinAi",
  description: "HaberinAi iletişim bilgileri: Haber ihbarı, editör masası, reklam, telif ve hukuki bildirim kanalları.",
  url: `${origin}/iletisim/`,
  mainEntity: {
    "@type": "NewsMediaOrganization",
    name: "HaberinAi",
    url: `${origin}/`,
    email: CONTACT_EMAIL,
    address: {
      "@type": "PostalAddress",
      addressLocality: "İstanbul",
      addressCountry: "TR",
    },
  },
};
---

<Base
  title="İletişim — HaberinAi"
  description="HaberinAi ile iletişim: Haber ihbarı, editör masası, telif talepleri, reklam iş birlikleri ve öneriler için resmi kanallarımız."
  canonical={`${origin}/iletisim/`}
  schema={schema}
>
  <div class="container iletisim">
    <header class="iletisim__hero">
      <span class="iletisim__rozet">Bize Ulaşın</span>
      <h1 class="iletisim__baslik">İletişim Kanalları</h1>
      <p class="iletisim__giris">
        Görüş, öneri, haber ihbarı, reklam teklifleri ve hukuki bildirimleriniz için ilgili
        departmanlarımızla iletişime geçebilirsiniz. E-posta bildirimleri en geç 24–48 saat içinde
        yanıtlanır.
      </p>
    </header>

    <div class="iletisim__grid">
      <div class="iletisim__kart">
        <div class="iletisim__ikon" aria-hidden="true">📬</div>
        <h2>Genel İletişim &amp; Okur Masası</h2>
        <p>Her türlü genel soru, geri bildirim ve önerileriniz için:</p>
        <a class="iletisim__posta" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <span class="iletisim__ek">Yedek / Domain: iletisim@haberinai.site</span>
      </div>

      <div class="iletisim__kart">
        <div class="iletisim__ikon" aria-hidden="true">📰</div>
        <h2>Haber İhbarı &amp; Basın Bültenleri</h2>
        <p>Doğrulanabilir basın bültenleri, özel haber ihbarları ve duyurularınız için:</p>
        <a class="iletisim__posta" href={`mailto:${CONTACT_EMAIL}?subject=Haber%20Ihbari`}>{CONTACT_EMAIL}</a>
        <span class="iletisim__ek">Editör Masası doğrudan inceler.</span>
      </div>

      <div class="iletisim__kart">
        <div class="iletisim__ikon" aria-hidden="true">⚖️</div>
        <h2>Hukuk, Tekzip ve Telif Hakları</h2>
        <p>İçerik kaldırma, düzeltme, tekzip veya telif hakları bildirimleriniz için:</p>
        <a class="iletisim__posta" href={`mailto:${CONTACT_EMAIL}?subject=Telif%20ve%20Hukuk`}>{CONTACT_EMAIL}</a>
        <span class="iletisim__ek">Talepler en geç 48 saat içinde sonuçlandırılır.</span>
      </div>

      <div class="iletisim__kart">
        <div class="iletisim__ikon" aria-hidden="true">💼</div>
        <h2>Reklam ve Sponsorluk</h2>
        <p>Görüntülü reklam, sponsorlu içerik ve iş birlikleri için:</p>
        <a class="iletisim__posta" href="/reklam/">Reklam Sayfasını İnceleyin</a>
        <span class="iletisim__ek">Veya doğrudan e-posta ile teklif isteyin.</span>
      </div>
    </div>

    <div class="iletisim__detay-izgara">
      <section class="iletisim__kutu">
        <h2>Yazışma ve Merkez Bilgileri</h2>
        <ul class="iletisim__bilgi-liste">
          <li><strong>Yayıncı:</strong> HaberinAi Bağımsız Dijital Medya</li>
          <li><strong>Konum / Şehir:</strong> İstanbul / Türkiye</li>
          <li><strong>Yayın Dili:</strong> Türkçe</li>
          <li><strong>Çalışma Saatleri:</strong> 7/24 Kesintisiz Dijital Yayın Hattı</li>
          <li><strong>Kurumsal Sayfalar:</strong> <a href="/kunye/">Künye</a> · <a href="/yayin-ilkeleri/">Yayın İlkeleri</a> · <a href="/gizlilik/">Gizlilik Politikası</a></li>
        </ul>
      </section>

      <section class="iletisim__kutu">
        <h2>Hızlı Mesaj Gönderin</h2>
        <p class="iletisim__not">
          Aşağıdaki formu doldurarak doğrudan e-posta istemciniz üzerinden editörlerimize yazabilirsiniz:
        </p>
        <form class="iletisim__form" action={`mailto:${CONTACT_EMAIL}`} method="get" enctype="text/plain">
          <div class="iletisim__alan">
            <label for="frm-ad">Adınız ve Soyadınız</label>
            <input type="text" id="frm-ad" name="name" placeholder="Örn: Ahmet Yılmaz" required />
          </div>
          <div class="iletisim__alan">
            <label for="frm-konu">Konu</label>
            <select id="frm-konu" name="subject">
              <option value="Genel Görüş / Öneri">Genel Görüş / Öneri</option>
              <option value="Haber İhbarı">Haber İhbarı</option>
              <option value="Hata Düzeltme Bildirimi">Hata Düzeltme Bildirimi</option>
              <option value="Telif / İçerik Kaldırma">Telif / İçerik Kaldırma</option>
              <option value="Reklam ve Sponsorluk">Reklam ve Sponsorluk</option>
            </select>
          </div>
          <div class="iletisim__alan">
            <label for="frm-mesaj">Mesajınız</label>
            <textarea id="frm-mesaj" name="body" rows="4" placeholder="Mesajınızı ve varsa ilgili haber linkini buraya yazınız..." required></textarea>
          </div>
          <button type="submit" class="iletisim__gonder-btn">Mesajı E-Posta İle Gönder</button>
        </form>
      </section>
    </div>
  </div>
</Base>

<style>
  .iletisim {
    max-width: 940px;
    margin: 40px auto 60px;
    padding: 0 16px;
  }
  .iletisim__hero {
    text-align: center;
    margin-bottom: 44px;
  }
  .iletisim__rozet {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .iletisim__baslik {
    font-size: clamp(2rem, 4vw, 2.7rem);
    letter-spacing: -0.03em;
    margin: 0 0 14px;
  }
  .iletisim__giris {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-2);
    max-width: 720px;
    margin: 0 auto;
  }
  .iletisim__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 36px;
  }
  .iletisim__kart {
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .iletisim__ikon {
    font-size: 1.9rem;
    margin-bottom: 12px;
  }
  .iletisim__kart h2 {
    font-size: 1.2rem;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }
  .iletisim__kart p {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 14px;
  }
  .iletisim__posta {
    display: inline-block;
    font-weight: 700;
    font-size: 1rem;
    color: var(--brand-strong);
    text-decoration: underline;
  }
  .iletisim__ek {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .iletisim__detay-izgara {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
  }
  .iletisim__kutu {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }
  .iletisim__kutu h2 {
    font-size: 1.25rem;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }
  .iletisim__bilgi-liste {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .iletisim__bilgi-liste li {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .iletisim__bilgi-liste li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .iletisim__bilgi-liste strong {
    color: var(--text);
  }
  .iletisim__bilgi-liste a {
    color: var(--brand-strong);
    font-weight: 600;
  }
  .iletisim__not {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.6;
    margin: 0 0 16px;
  }
  .iletisim__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .iletisim__alan {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .iletisim__alan label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
  }
  .iletisim__alan input,
  .iletisim__alan select,
  .iletisim__alan textarea {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font-family: inherit;
    font-size: 0.92rem;
  }
  .iletisim__alan input:focus,
  .iletisim__alan select:focus,
  .iletisim__alan textarea:focus {
    outline: none;
    border-color: var(--brand-strong);
  }
  .iletisim__gonder-btn {
    padding: 12px 20px;
    border: none;
    border-radius: 12px;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: 0 12px 24px -14px var(--brand-glow);
    transition: opacity 0.15s ease;
  }
  .iletisim__gonder-btn:hover {
    opacity: 0.92;
  }
  @media (max-width: 760px) {
    .iletisim__grid,
    .iletisim__detay-izgara {
      grid-template-columns: 1fr;
    }
  }
</style>
