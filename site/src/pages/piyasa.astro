---
import Base from "../layouts/Base.astro";
import { getMarket } from "../lib/market.js";
import { chartPaths, nf, pf } from "../lib/chart.js";

const { items, updatedAt } = getMarket();

const when = updatedAt
  ? new Date(updatedAt).toLocaleString("tr-TR", {
      day: "numeric",
      month: "long",
      hour: "2-digit",
      minute: "2-digit",
    })
  : null;

const upCount = items.filter((i) => i.changePct >= 0).length;
const downCount = items.length - upCount;

const CHART_W = 320;
const CHART_H = 84;

const cards = items.map((it, i) => ({
  ...it,
  chart: chartPaths(it.series, CHART_W, CHART_H, 4),
  gradId: `piyasa-grad-${i}`,
}));
---

<Base
  title="Piyasa — Borsa, Dolar, Altın ve Emtia — HaberinAi"
  description="BIST 30, S&P 500, Nasdaq, Dow Jones, Dolar/TL, Euro/TL, ons ve gram altın ile Brent petrolün anlık değerleri ve son bir aylık grafikleri."
>
  <div class="container">
    <header class="head">
      <span class="badge">PİYASA</span>
      <h1>Piyasa Göstergeleri</h1>
      <p class="head__sub muted">
        {items.length} gösterge · son bir aylık seyir
        {when && <> · son güncelleme: <strong>{when}</strong></>}
      </p>
      <div class="head__stats">
        <span class="stat stat--up">▲ {upCount} yükseliş</span>
        <span class="stat stat--down">▼ {downCount} düşüş</span>
        <span class="stat stat--note">Veriler Yahoo Finance'ten alınır, 5 dakikada bir güncellenir.</span>
      </div>
    </header>

    {items.length === 0 ? (
      <p class="muted empty">Piyasa verisi henüz hazır değil. Birkaç dakika sonra tekrar bak.</p>
    ) : (
      <div class="cards">
        {cards.map((it) => {
          const up = it.changePct >= 0;
          return (
            <article class:list={["pcard", up ? "is-up" : "is-down"]}>
              <div class="pcard__top">
                <h2 class="pcard__label">{it.label}</h2>
                <span class:list={["pcard__chg", up ? "is-up" : "is-down"]}>
                  <span class="pcard__arrow">{up ? "▲" : "▼"}</span>
                  {pf(it.changePct)}
                </span>
              </div>

              <div class="pcard__value">{nf(it.value, it.decimals ?? 2)}</div>

              {it.chart ? (
                <div class="pcard__chart">
                  <svg
                    viewBox={`0 0 ${CHART_W} ${CHART_H}`}
                    width="100%"
                    height={CHART_H}
                    preserveAspectRatio="none"
                    role="img"
                    aria-label={`${it.label} son bir aylık grafik`}
                  >
                    <defs>
                      <linearGradient id={it.gradId} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color={up ? "#22c55e" : "#ef4444"} stop-opacity="0.28" />
                        <stop offset="100%" stop-color={up ? "#22c55e" : "#ef4444"} stop-opacity="0" />
                      </linearGradient>
                    </defs>
                    <path d={it.chart.area} fill={`url(#${it.gradId})`} />
                    <path
                      d={it.chart.line}
                      fill="none"
                      stroke={up ? "#22c55e" : "#ef4444"}
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      vector-effect="non-scaling-stroke"
                    />
                    <circle
                      cx={it.chart.lastX}
                      cy={it.chart.lastY}
                      r="3.2"
                      fill={up ? "#22c55e" : "#ef4444"}
                    />
                  </svg>
                </div>
              ) : (
                <p class="pcard__nochart muted">Grafik verisi yok</p>
              )}

              {it.chart && (
                <div class="pcard__foot">
                  <span>1 ay en düşük: <strong>{nf(it.chart.min, it.decimals ?? 2)}</strong></span>
                  <span>en yüksek: <strong>{nf(it.chart.max, it.decimals ?? 2)}</strong></span>
                </div>
              )}
            </article>
          );
        })}
      </div>
    )}
  </div>
</Base>

<style>
  .head {
    padding: 32px 0 8px;
  }
  .head h1 {
    font-size: 2.1rem;
    font-weight: 900;
    letter-spacing: -0.028em;
    margin: 12px 0 8px;
  }
  .head__sub {
    margin: 0 0 14px;
    font-size: 0.95rem;
  }
  .head__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }
  .stat {
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .stat--up {
    color: var(--pos);
    background: var(--pos-soft);
  }
  .stat--down {
    color: var(--neg);
    background: var(--neg-soft);
  }
  .stat--note {
    color: var(--muted);
    background: var(--surface-2);
    font-weight: 500;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin: 24px 0 40px;
  }

  .pcard {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 18px 14px;
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .pcard::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
  }
  .pcard.is-up::before {
    background: linear-gradient(90deg, #22c55e, rgba(34, 197, 94, 0));
  }
  .pcard.is-down::before {
    background: linear-gradient(90deg, #ef4444, rgba(239, 68, 68, 0));
  }

  .pcard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .pcard__label {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .pcard__chg {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 4px 9px;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .pcard__chg.is-up {
    color: var(--pos);
    background: var(--pos-soft);
  }
  .pcard__chg.is-down {
    color: var(--neg);
    background: var(--neg-soft);
  }
  .pcard__arrow {
    font-size: 0.62rem;
  }

  .pcard__value {
    font-size: 1.7rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 8px 0 6px;
    font-variant-numeric: tabular-nums;
  }

  .pcard__chart {
    margin: 0 -4px;
  }

  .pcard__nochart {
    font-size: 0.85rem;
    padding: 20px 0;
  }

  .pcard__foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.76rem;
    color: var(--muted);
    border-top: 1px solid var(--line-2);
    padding-top: 10px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .pcard__foot strong {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    padding: 60px 0;
    text-align: center;
  }

  @media (max-width: 520px) {
    .head h1 {
      font-size: 1.7rem;
    }
    .pcard__value {
      font-size: 1.5rem;
    }
  }
</style>
