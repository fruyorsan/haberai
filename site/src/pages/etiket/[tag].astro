---
import Base from "../../layouts/Base.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import AdSlot from "../../components/AdSlot.astro";
import { ADSENSE_SLOTS } from "../../lib/site-meta.js";
import { etiketIndeksliMi } from "../../lib/indeks.js";
import { getTags, paginate, PER_PAGE } from "../../lib/articles.js";

export function getStaticPaths() {
  return getTags(2).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const { items, current, totalPages: pages, total } = paginate(tag.articles, 1, PER_PAGE);

// Yalnızca dizine giren etiket sayfalarına yapısal veri eklenir: noindex
// sayfalarda schema yayınlamak tarama bütçesini boşa harcar.
const indeksli = etiketIndeksliMi(total);
const kok = Astro.site ? String(Astro.site).replace(/\/+$/, "") : "https://haberinai.site";
const sayfaUrl = `${kok}/etiket/${tag.slug}/`;

const schema = indeksli
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "CollectionPage",
          "@id": `${sayfaUrl}#sayfa`,
          url: sayfaUrl,
          name: `${tag.name} haberleri`,
          description: `${tag.name} ile ilgili güncel haberler, özetler ve analizler.`,
          inLanguage: "tr-TR",
          isPartOf: { "@type": "WebSite", name: "HaberinAi", url: kok },
          mainEntity: {
            "@type": "ItemList",
            numberOfItems: items.length,
            itemListElement: items.slice(0, 20).map((a, i) => ({
              "@type": "ListItem",
              position: i + 1,
              url: `${kok}${a.url}`,
              name: a.title,
            })),
          },
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Ana Sayfa", item: `${kok}/` },
            { "@type": "ListItem", position: 2, name: "Konular", item: `${kok}/etiketler/` },
            { "@type": "ListItem", position: 3, name: tag.name, item: sayfaUrl },
          ],
        },
      ],
    }
  : undefined;
---

<Base
  title={`${tag.name} haberleri — HaberinAi`}
  description={`${tag.name} ile ilgili en güncel haberler, özetler ve yapay zekâ yorumları. ${total} haber.`}
  noindex={!indeksli}
  schema={schema}
>
  <div class="container">
    <header class="tag-head">
      <span class="badge">Konu</span>
      <h1>{tag.name}</h1>
      <p class="muted">
        {total} haber{pages > 1 ? ` · Sayfa ${current}/${pages}` : ""}
      </p>
    </header>

    <div class="grid">
      {items.map((a, i) => <ArticleCard article={a} index={i} />)}
    </div>

    {etiketIndeksliMi(total) && ADSENSE_SLOTS.liste && (
      <AdSlot slot={ADSENSE_SLOTS.liste} label="Sponsorlu" />
    )}
    <Pagination current={current} totalPages={pages} base={`/etiket/${tag.slug}/`} />

    <p class="tag-foot">
      <a href="/etiketler/">Tüm konular</a> · <a href="/haberler/">Son haberler</a>
    </p>
  </div>
</Base>

<style>
  .tag-head {
    padding: 30px 0 6px;
  }
  .tag-head h1 {
    font-size: 1.9rem;
    margin: 12px 0 4px;
    letter-spacing: -0.02em;
    text-transform: capitalize;
  }
  .tag-head .muted {
    font-size: 0.9rem;
  }
  .tag-foot {
    margin: 26px 0 0;
    font-size: 0.9rem;
  }
</style>
