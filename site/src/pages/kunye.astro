---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL } from "../lib/site-meta.js";

const origin = Astro.site ? String(Astro.site).replace(/\/+$/, "") : "https://haberinai.site";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Künye — HaberinAi",
  description: "HaberinAi künye bilgileri: Yayın kimliği, içerik sorumluluğu ve iletişim kanalları.",
  url: `${origin}/kunye/`,
};
---

<Base
  title="Künye — HaberinAi"
  description="HaberinAi künye bilgileri: Yayın kimliği, içerik sorumluluğu ve resmi iletişim kanalları."
  canonical={`${origin}/kunye/`}
  schema={schema}
>
  <div class="container kunye">
    <header class="kunye__ust">
      <span class="kunye__etiket">Kurumsal Kimlik</span>
      <h1 class="kunye__baslik">Künye</h1>
      <p class="kunye__giris">
        <strong>HaberinAi</strong> yayın kimliği, içerik yönetimi ve yasal bildirim kanallarına
        ilişkin bilgiler aşağıda yer almaktadır.
      </p>
    </header>

    <div class="kunye__grid">
      <div class="kunye__kart">
        <h2>Yayın Kimliği</h2>
        <dl class="kunye__dl">
          <dt>Yayın Adı</dt>
          <dd>HaberinAi</dd>

          <dt>Yayın Adresi</dt>
          <dd><a href={origin}>{origin.replace(/^https?:\/\//, "")}</a></dd>

          <dt>Yayın Niteliği</dt>
          <dd>Bağımsız Dijital Haber ve Analiz Platformu</dd>

          <dt>Yayın Dili</dt>
          <dd>Türkçe</dd>

          <dt>Merkez / Ülke</dt>
          <dd>Türkiye</dd>
        </dl>
      </div>

      <div class="kunye__kart">
        <h2>İçerik ve Yayın Yönetimi</h2>
        <dl class="kunye__dl">
          <dt>Yayın Sorumlusu</dt>
          <dd>HaberinAi Editör Masası</dd>

          <dt>Yayın Kapsamı</dt>
          <dd>Gündem, Dünya, Ekonomi, Teknoloji, Yapay Zekâ, Bilim, Spor ve Kültür</dd>

          <dt>İçerik Yöntemi</dt>
          <dd>Birincil kaynak takibi, yapay zekâ destekli özetleme ve editoryal bağlam analizi</dd>

          <dt>Yayın ve Telif İlkeleri</dt>
          <dd>
            <a href="/yayin-ilkeleri/">Yayın İlkeleri</a> · <a href="/telif/">İçerik ve Telif Politikası</a>
          </dd>
        </dl>
      </div>

      <div class="kunye__kart kunye__kart--tam">
        <h2>İletişim, Düzeltme ve Hukuki Bildirimler</h2>
        <dl class="kunye__dl kunye__dl--yatay">
          <div>
            <dt>E-posta (Genel &amp; Basın)</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd>
          </div>

          <div>
            <dt>Telif, Düzeltme ve Kaldırma Talepleri</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}?subject=Telif%20ve%20Duzeltme%20Talebi`}>{CONTACT_EMAIL}</a></dd>
          </div>

          <div>
            <dt>Yanıt ve İşlem Süresi</dt>
            <dd>Geçerli bildirimler en geç 48 saat içinde sonuçlandırılır.</dd>
          </div>

          <div>
            <dt>Yasal Metinler</dt>
            <dd>
              <a href="/gizlilik/">Gizlilik Politikası</a> · <a href="/kullanim-sartlari/">Kullanım Şartları</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <section class="kunye__not">
      <h2>Yasal Bilgilendirme</h2>
      <p>
        HaberinAi'de yayımlanan içerikler kamuoyunu bilgilendirme amacı taşır; yatırım, hukuk veya
        tıbbi tavsiye niteliğinde değildir. Haberlerde yararlanılan birincil kaynaklar açıkça
        belirtilir ve ilgili kaynağa doğrudan bağlantı verilir.
      </p>
      <p>
        5846 sayılı Fikir ve Sanat Eserleri Kanunu ile 5651 sayılı Kanun kapsamındaki her türlü
        düzeltme, tekzip veya içerik kaldırma başvurusu için <a href="/iletisim/">İletişim</a>
        sayfamız üzerinden bize ulaşabilirsiniz.
      </p>
    </section>
  </div>
</Base>

<style>
  .kunye {
    max-width: 880px;
    margin: 36px auto 60px;
    padding: 0 16px;
  }
  .kunye__ust {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 20px;
  }
  .kunye__etiket {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .kunye__baslik {
    margin: 12px 0 8px;
    font-size: clamp(1.65rem, 3.6vw, 2.3rem);
    letter-spacing: -0.025em;
  }
  .kunye__giris {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .kunye__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .kunye__kart {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .kunye__kart--tam {
    grid-column: 1 / -1;
  }
  .kunye__kart h2 {
    font-size: 1.15rem;
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.02em;
  }
  .kunye__dl {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .kunye__dl--yatay {
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
  }
  .kunye__dl dt {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .kunye__dl dd {
    margin: 3px 0 0;
    font-size: 0.93rem;
    color: var(--text);
    line-height: 1.5;
  }
  .kunye__dl a,
  .kunye__not a {
    color: var(--brand-strong);
    font-weight: 600;
  }
  .kunye__not {
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .kunye__not h2 {
    font-size: 1.12rem;
    margin: 0 0 10px;
  }
  .kunye__not p {
    color: var(--text-2);
    line-height: 1.72;
    margin: 0 0 10px;
    font-size: 0.9rem;
  }
  .kunye__not p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 700px) {
    .kunye__grid,
    .kunye__dl--yatay {
      grid-template-columns: 1fr;
    }
    .kunye__ust,
    .kunye__kart,
    .kunye__not {
      padding: 20px 16px;
    }
  }
</style>
