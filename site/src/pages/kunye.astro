---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL, HOSTING, PUBLISHER } from "../lib/site-meta.js";

const origin = Astro.site ? String(Astro.site).replace(/\/+$/, "") : "https://haberinai.site";

const yayinciAdres = PUBLISHER.adres
  ? [PUBLISHER.adres, PUBLISHER.sehir].filter(Boolean).join(", ")
  : "";

// Künyede yalnızca tanımlı alanlar basılır; uydurma kişi/kurum bilgisi yazılmaz.
const kimlik = [
  { etiket: "İmtiyaz Sahibi", deger: PUBLISHER.imtiyazSahibi || PUBLISHER.ad },
  { etiket: "Sorumlu Yazı İşleri Müdürü", deger: PUBLISHER.sorumluMudur || PUBLISHER.ad },
  { etiket: "Ticaret Unvanı", deger: PUBLISHER.ticaretUnvan },
  {
    etiket: "Vergi Bilgisi",
    deger: [PUBLISHER.vergiDairesi, PUBLISHER.vergiNo].filter(Boolean).join(" — "),
  },
  { etiket: "ETBİS Kayıt No", deger: PUBLISHER.etbis },
].filter((x) => x.deger);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Künye — HaberinAi",
      description: "HaberinAi künye bilgileri: Yayın kimliği, içerik sorumluluğu ve iletişim kanalları.",
      url: `${origin}/kunye/`,
      dateModified: "2026-10-30",
      publisher: { "@id": `${origin}/kunye/#yayinci` },
    },
    {
      "@type": "Organization",
      "@id": `${origin}/kunye/#yayinci`,
      name: PUBLISHER.ad,
      url: origin,
      email: PUBLISHER.eposta,
      areaServed: "TR",
      ...(yayinciAdres ? { address: { "@type": "PostalAddress", streetAddress: PUBLISHER.adres, addressLocality: PUBLISHER.sehir } } : {}),
      ...(PUBLISHER.telefon ? { telephone: PUBLISHER.telefon } : {}),
    },
  ],
};
---

<Base
  title="Künye — HaberinAi"
  description="HaberinAi künye bilgileri: Yayın kimliği, içerik sorumluluğu ve resmi iletişim kanalları."
  canonical={`${origin}/kunye/`}
  schema={schema}
>
  <div class="container kunye">
    <header class="kunye__ust">
      <span class="kunye__etiket">Kurumsal Kimlik</span>
      <h1 class="kunye__baslik">Künye</h1>
      <p class="kunye__giris">
        <strong>HaberinAi</strong> yayın kimliği, içerik yönetimi ve yasal bildirim kanallarına
        ilişkin bilgiler aşağıda yer almaktadır.
      </p>
      <p class="kunye__guncelleme">Son güncelleme: 30 Ekim 2026</p>
    </header>

    <section class="kunye__yayinci" id="yayinci-kimlik" aria-labelledby="yayinci-baslik">
      <div class="kunye__yayinci-ust">
        <h2 id="yayinci-baslik">Yayıncı Kimliği</h2>
        <p class="kunye__yayinci-not">
          Bu sayfa yayın kimliğini ve ulaşılabilir iletişim kanalını gösterir. Kişisel ev adresi
          veya telefon numarası yayınlanmaz; içeriklerle ilgili sorumluluk yayın kuruluna aittir.
        </p>
      </div>
      <dl class="kunye__dl kunye__dl--yatay">
        <div>
          <dt>Yayıncı</dt>
          <dd>{PUBLISHER.ad}</dd>
        </div>
        <div>
          {PUBLISHER.adres ? (
            <>
              <dt>Adres</dt>
              <dd>{yayinciAdres}</dd>
            </>
          ) : (
            <>
              <dt>Merkez</dt>
              <dd>{PUBLISHER.sehir}</dd>
            </>
          )}
        </div>
        <div>
          <dt>E-posta</dt>
          <dd><a href={`mailto:${PUBLISHER.eposta}`}>{PUBLISHER.eposta}</a></dd>
        </div>
        {PUBLISHER.telefon && (
          <div>
            <dt>Telefon</dt>
            <dd>{PUBLISHER.telefon}</dd>
          </div>
        )}
        {kimlik.map((x) => (
          <div>
            <dt>{x.etiket}</dt>
            <dd>{x.deger}</dd>
          </div>
        ))}
      </dl>
      <p class="kunye__yayinci-not">
        <strong>Yer sağlayıcı:</strong> {HOSTING.ad} — {HOSTING.adres}. Site, 5651 sayılı Kanun
        kapsamında yer sağlayıcı hizmeti alınarak yayımlanmaktadır. Yer sağlayıcının yalnızca
        barındırma hizmeti sunması, içerik sorumluluğunu ortadan kaldırmaz; editoryal sorumluluk
        yayıncıya aittir.
      </p>
    </section>

    <div class="kunye__grid">
      <div class="kunye__kart">
        <h2>Yayın Kimliği</h2>
        <dl class="kunye__dl">
          <dt>Yayın Adı</dt>
          <dd>HaberinAi</dd>

          <dt>Yayın Adresi</dt>
          <dd><a href={origin}>{origin.replace(/^https?:\/\//, "")}</a></dd>

          <dt>Yayın Niteliği</dt>
          <dd>Bağımsız Dijital Haber ve Analiz Platformu</dd>

          <dt>Yayın Dili</dt>
          <dd>Türkçe</dd>

          <dt>Merkez / Ülke</dt>
          <dd>Türkiye</dd>
        </dl>
      </div>

      <div class="kunye__kart">
        <h2>İçerik ve Yayın Yönetimi</h2>
        <dl class="kunye__dl">
          <dt>Yayın Kurulu</dt>
          <dd>{PUBLISHER.ad}</dd>

          <dt>Yayın Kapsamı</dt>
          <dd>Gündem, Dünya, Ekonomi, Teknoloji, Yapay Zekâ, Bilim, Spor ve Kültür</dd>

          <dt>İçerik Yöntemi</dt>
          <dd>Gündem taraması, yapay zekâ destekli özetleme ve editoryal bağlam analizi</dd>

          <dt>Yayın ve Telif İlkeleri</dt>
          <dd>
            <a href="/yayin-ilkeleri/">Yayın İlkeleri</a> · <a href="/telif/">İçerik ve Telif Politikası</a>
          </dd>
        </dl>
      </div>

      <div class="kunye__kart">
        <h2>Yapay Zekâ ve Editoryal Sorumluluk</h2>
        <dl class="kunye__dl">
          <dt>Kullanım Amacı</dt>
          <dd>Özetleme, kilit maddelerin çıkarılması ve bağlam analizi</dd>

          <dt>Üretim Yöntemi</dt>
          <dd>Editör masası kontrolünde yapay zekâ destekli özgün metin; kopyala-yapıştır içerik yok</dd>

          <dt>Kalite Denetimi</dt>
          <dd>Gövde/paragraf eşiği, özet ve yorum özgünlüğü, benzerlik süzgeci</dd>

          <dt>Şeffaflık</dt>
          <dd>Her haberin sonunda hazırlanma yöntemi, sorumlu yayıncı ve güncelleme tarihi gösterilir</dd>

          <dt>İnsan Sorumluluğu</dt>
          <dd>Yayın kararı ve düzeltme sorumluluğu {PUBLISHER.ad} / editör masasına aittir</dd>
        </dl>
      </div>

      <div class="kunye__kart">
        <h2>Reklam ve Finansman</h2>
        <dl class="kunye__dl">
          <dt>Gelir Modeli</dt>
          <dd>Görüntülü reklam ve açıkça etiketlenmiş sponsorluk</dd>

          <dt>Reklam Altyapısı</dt>
          <dd>Google AdSense; çerez izni Google Consent Mode ile yönetilir</dd>

          <dt>Yerleşim Politikası</dt>
          <dd>Yalnızca dizine açık sayfalarda, haber başına en fazla iki birim</dd>

          <dt>Editör Bağımsızlığı</dt>
          <dd>Reklam verenlerin haber seçimine ve yorumlara müdahalesi kabul edilmez</dd>

          <dt>Sponsorlu İçerik</dt>
          <dd>"Sponsorlu" etiketiyle yayımlanır ve haber akışından ayrılır</dd>
        </dl>
      </div>

      <div class="kunye__kart kunye__kart--tam">
        <h2>İletişim, Düzeltme ve Hukuki Bildirimler</h2>
        <dl class="kunye__dl kunye__dl--yatay">
          <div>
            <dt>E-posta (Genel &amp; Basın)</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd>
          </div>

          <div>
            <dt>Telif, Düzeltme ve Kaldırma Talepleri</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}?subject=Telif%20ve%20Duzeltme%20Talebi`}>{CONTACT_EMAIL}</a></dd>
          </div>

          <div>
            <dt>Yanıt ve İşlem Süresi</dt>
            <dd>
              Kişilik haklarına saldırı ve özel hayatın gizliliği kapsamındaki (5651 m.9) kaldırma
              bildirimleri en geç <strong>24 saat</strong>; diğer düzeltme ve telif talepleri en geç
              <strong>48 saat</strong> içinde sonuçlandırılır.
            </dd>
          </div>

          <div>
            <dt>Yasal Metinler</dt>
            <dd>
              <a href="/gizlilik/">Gizlilik Politikası</a> · <a href="/kullanim-sartlari/">Kullanım Şartları</a>
              {" · "}<a href="/mesafeli-satis/">Mesafeli Satış</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <section class="kunye__not">
      <h2>Yasal Bilgilendirme</h2>
      <p>
        HaberinAi'de yayımlanan içerikler kamuoyunu bilgilendirme amacı taşır; yatırım, hukuk veya
        tıbbi tavsiye niteliğinde değildir. Her haberin hazırlanma yöntemi ve sorumluluğu açıkça
        belirtilir. 5651 sayılı Kanun kapsamındaki kaldırma bildirimleri en geç 24 saat, diğer
        düzeltme ve telif talepleri en geç 48 saat içinde sonuçlandırılır.
      </p>
      <p>
        5846 sayılı Fikir ve Sanat Eserleri Kanunu ile 5651 sayılı Kanun kapsamındaki her türlü
        düzeltme, tekzip veya içerik kaldırma başvurusu için <a href="/iletisim/">İletişim</a>
        sayfamız üzerinden bize ulaşabilirsiniz.
      </p>
    </section>
  </div>
</Base>

<style>
  .kunye {
    max-width: 880px;
    margin: 36px auto 60px;
    padding: 0 16px;
  }
  .kunye__ust {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 20px;
  }
  .kunye__yayinci {
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 20px;
  }
  .kunye__yayinci-ust h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .kunye__yayinci-not {
    margin: 0 0 18px;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-2);
  }
  .kunye__etiket {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .kunye__baslik {
    margin: 12px 0 8px;
    font-size: clamp(1.65rem, 3.6vw, 2.3rem);
    letter-spacing: -0.025em;
  }
  .kunye__giris {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .kunye__guncelleme {
    margin: 12px 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .kunye__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .kunye__kart {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .kunye__kart--tam {
    grid-column: 1 / -1;
  }
  .kunye__kart h2 {
    font-size: 1.15rem;
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.02em;
  }
  .kunye__dl {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .kunye__dl--yatay {
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
  }
  .kunye__dl dt {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .kunye__dl dd {
    margin: 3px 0 0;
    font-size: 0.93rem;
    color: var(--text);
    line-height: 1.5;
  }
  .kunye__dl a,
  .kunye__not a {
    color: var(--brand-strong);
    font-weight: 600;
  }
  .kunye__not {
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .kunye__not h2 {
    font-size: 1.12rem;
    margin: 0 0 10px;
  }
  .kunye__not p {
    color: var(--text-2);
    line-height: 1.72;
    margin: 0 0 10px;
    font-size: 0.9rem;
  }
  .kunye__not p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 700px) {
    .kunye__grid,
    .kunye__dl--yatay {
      grid-template-columns: 1fr;
    }
    .kunye__ust,
    .kunye__kart,
    .kunye__yayinci,
    .kunye__not {
      padding: 20px 16px;
    }
  }
</style>
