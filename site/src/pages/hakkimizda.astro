---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL } from "../lib/site-meta.js";

const origin = Astro.site ? String(Astro.site).replace(/\/+$/, "") : "https://haberinai.site";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Hakkımızda — HaberinAi",
  description: "HaberinAi; Türkiye ve dünya gündemini, teknoloji, ekonomi ve bilim haberlerini analitik bakış açısıyla sunan bağımsız dijital haber platformudur.",
  url: `${origin}/hakkimizda/`,
  mainEntity: {
    "@type": "NewsMediaOrganization",
    name: "HaberinAi",
    url: `${origin}/`,
    logo: `${origin}/ikon-512.png`,
    foundingDate: "2024",
    email: CONTACT_EMAIL,
  },
};
---

<Base
  title="Hakkımızda — HaberinAi"
  description="HaberinAi; Türkiye ve dünya gündemini, teknoloji, ekonomi ve bilim haberlerini analitik bakış açısıyla sunan bağımsız dijital haber platformudur."
  canonical={`${origin}/hakkimizda/`}
  schema={schema}
>
  <div class="container hakkimizda">
    <header class="hakkimizda__hero">
      <span class="hakkimizda__rozet">Kurumsal Vizyon</span>
      <h1 class="hakkimizda__baslik">Yeni Nesil Dijital Habercilik</h1>
      <p class="hakkimizda__giris">
        <strong>HaberinAi</strong>; Türkiye ve dünyadaki son dakika gelişmelerini, teknoloji, ekonomi,
        bilim ve kültür haberlerini bilgi kirliliğinden arındırarak hızlı, anlaşılır ve analitik bir
        dille okuyucularına sunan bağımsız bir dijital medya platformudur.
      </p>
    </header>

    <div class="hakkimizda__grid">
      <section class="hakkimizda__kart">
        <h2>Misyonumuz</h2>
        <p>
          Günümüz dijital medyasında artan tık tuzağı (clickbait) başlıklar, gereksiz uzatılmış metinler
          ve teyit edilmemiş bilgi yığınları arasından okuyucuya en doğru, öz ve değerli bilgiyi ulaştırmaktır.
          Amacımız okuyucunun zamanına saygı duyarak, gelişmelerin arka planını ve neden önemli olduğunu
          anında aktarmaktır.
        </p>
      </section>

      <section class="hakkimizda__kart">
        <h2>Yayın Felsefemiz</h2>
        <p>
          Haberin sadece aktarılmasına değil, anlaşılmasına odaklanıyoruz. Her haberde olayın çekirdek
          özetini, 3 temel maddelik öne çıkan noktalarını ve gelişmelerin toplumsal/ekonomik etkilerini
          ele alan editoryal analizleri bir arada sunuyoruz.
        </p>
      </section>
    </div>

    <section class="hakkimizda__detay">
      <h2>Editoryal Süreç ve Teknoloji Yaklaşımımız</h2>
      <p>
        HaberinAi, geleneksel gazetecilik etik değerlerini modern veri işleme teknolojileri ve yapay zekâ
        araçlarıyla birleştirir.
      </p>
      <ul>
        <li>
          <strong>Çoklu Kaynak Teyidi:</strong> Gündemdeki olaylar saygın haber ajansları, resmi bültenler
          ve birinci el kaynaklar üzerinden karşılaştırmalı olarak doğrulanır.
        </li>
        <li>
          <strong>Analitik Derinlik:</strong> Gelişmeler yalnızca kuru birer bülten olarak değil, neden
          önemli olduğu ve gelecekte neye yol açabileceği perspektifinden incelenir.
        </li>
        <li>
          <strong>Telif Hakları ve Kaynak Şeffaflığı:</strong> Her haberde yararlanılan birincil kaynak
          kuruluş açıkça belirtilir, orijinal kaynağa saygı esastır.
        </li>
        <li>
          <strong>Okuyucu Odaklı Tasarım:</strong> Sayfalarımız reklam karmaşasından uzak, mobil öncelikli
          ve gözü yormayan modern tasarım diliyle inşa edilmiştir.
        </li>
      </ul>
    </section>

    <section class="hakkimizda__degerler">
      <h2>Temel İlkelerimiz</h2>
      <div class="hakkimizda__deger-izgara">
        <div class="hakkimizda__deger-kutu">
          <h3>Doğruluk ve Güvenilirlik</h3>
          <p>Teyit edilmemiş dedikodulara, spekülasyonlara ve manipülatif başlıklara asla yer vermeyiz.</p>
        </div>
        <div class="hakkimizda__deger-kutu">
          <h3>Bağımsızlık</h3>
          <p>Yayın politikamız hiçbir siyasi, ticari veya ideolojik grubun etkisinde değildir.</p>
        </div>
        <div class="hakkimizda__deger-kutu">
          <h3>Şeffaflık</h3>
          <p>Hatalarımızı gizlemez, okurlarımızın düzeltme taleplerini ivedilikle değerlendiririz.</p>
        </div>
        <div class="hakkimizda__deger-kutu">
          <h3>Kullanıcı Gizliliği</h3>
          <p>Okurlarımızın gizliliğini en üst düzeyde korur, kişisel verileri asla izinsiz paylaşmayız.</p>
        </div>
      </div>
    </section>

    <section class="hakkimizda__alt-cta">
      <h2>Bize Ulaşın</h2>
      <p>
        Görüş, öneri, basın bülteni veya editoryal sorularınız için bizimle her zaman iletişime geçebilirsiniz.
      </p>
      <div class="hakkimizda__butonlar">
        <a class="hakkimizda__btn" href="/iletisim/">İletişim Kanalları</a>
        <a class="hakkimizda__btn hakkimizda__btn--ikincil" href="/kunye/">Künye Bilgileri</a>
        <a class="hakkimizda__btn hakkimizda__btn--ikincil" href="/yayin-ilkeleri/">Yayın İlkeleri</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hakkimizda {
    max-width: 920px;
    margin: 40px auto 60px;
    padding: 0 16px;
  }
  .hakkimizda__hero {
    text-align: center;
    margin-bottom: 48px;
  }
  .hakkimizda__rozet {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hakkimizda__baslik {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hakkimizda__giris {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--text-2);
    max-width: 760px;
    margin: 0 auto;
  }
  .hakkimizda__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 36px;
  }
  .hakkimizda__kart {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }
  .hakkimizda__kart h2 {
    font-size: 1.35rem;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  .hakkimizda__kart p {
    color: var(--text-2);
    line-height: 1.7;
    margin: 0;
    font-size: 0.95rem;
  }
  .hakkimizda__detay {
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 36px;
  }
  .hakkimizda__detay h2 {
    font-size: 1.4rem;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .hakkimizda__detay p {
    color: var(--text-2);
    line-height: 1.75;
    margin-bottom: 20px;
  }
  .hakkimizda__detay ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hakkimizda__detay li {
    color: var(--text-2);
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .hakkimizda__detay li strong {
    color: var(--text);
  }
  .hakkimizda__degerler {
    margin-bottom: 40px;
  }
  .hakkimizda__degerler h2 {
    font-size: 1.4rem;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .hakkimizda__deger-izgara {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .hakkimizda__deger-kutu {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-2);
  }
  .hakkimizda__deger-kutu h3 {
    font-size: 1.05rem;
    margin: 0 0 8px;
  }
  .hakkimizda__deger-kutu p {
    color: var(--text-2);
    line-height: 1.6;
    margin: 0;
    font-size: 0.88rem;
  }
  .hakkimizda__alt-cta {
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-2) 100%);
    text-align: center;
  }
  .hakkimizda__alt-cta h2 {
    margin: 0 0 10px;
    font-size: 1.4rem;
  }
  .hakkimizda__alt-cta p {
    color: var(--text-2);
    margin: 0 0 24px;
    font-size: 0.98rem;
  }
  .hakkimizda__butonlar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hakkimizda__btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 12px;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 12px 24px -14px var(--brand-glow);
  }
  .hakkimizda__btn--ikincil {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: none;
  }
  @media (max-width: 700px) {
    .hakkimizda__grid,
    .hakkimizda__deger-izgara {
      grid-template-columns: 1fr;
    }
    .hakkimizda__detay,
    .hakkimizda__kart,
    .hakkimizda__alt-cta {
      padding: 22px 18px;
    }
  }
</style>
