---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL } from "../lib/site-meta.js";

const origin = Astro.site ? String(Astro.site).replace(/\/+$/, "") : "https://haberinai.site";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Hakkımızda — HaberinAi",
  description:
    "HaberinAi; Türkiye ve dünya gündemini yapay zekâ destekli özetler, öne çıkan maddeler ve bağlam analizleriyle sunan bağımsız dijital haber platformudur.",
  url: `${origin}/hakkimizda/`,
  dateModified: "2026-10-27",
  mainEntity: {
    "@type": "NewsMediaOrganization",
    name: "HaberinAi",
    url: `${origin}/`,
    logo: `${origin}/ikon-512.png`,
    email: CONTACT_EMAIL,
    publishingPrinciples: `${origin}/yayin-ilkeleri/`,
    correctionsPolicy: `${origin}/yayin-ilkeleri/`,
  },
};
---

<Base
  title="Hakkımızda — HaberinAi"
  description="HaberinAi; Türkiye ve dünya gündemini yapay zekâ destekli özetler, öne çıkan maddeler ve bağlam analizleriyle sunan bağımsız dijital haber platformudur."
  canonical={`${origin}/hakkimizda/`}
  schema={schema}
>
  <div class="container kurumsal">
    <header class="kurumsal__ust">
      <span class="kurumsal__etiket">Hakkımızda</span>
      <h1 class="kurumsal__baslik">Haberin Özü, Bağlamı ve Analizi</h1>
      <p class="kurumsal__giris">
        <strong>HaberinAi</strong>; Türkiye ve dünyadaki güncel gelişmeleri, teknoloji, ekonomi,
        bilim, spor ve kültür haberlerini bilgi kirliliğinden arındırarak anlaşılır özetler ve
        analitik değerlendirmelerle sunan bağımsız bir dijital haber platformudur.
      </p>
      <p class="kurumsal__guncelleme">Son güncelleme: 27 Ekim 2026</p>
    </header>

    <div class="kurumsal__ikili">
      <section class="kurumsal__kart">
        <h2>Amacımız</h2>
        <p>
          Dijital medyada yaygınlaşan tık tuzağı (clickbait) başlıklar ve cevabı son paragrafa
          saklanan uzun metinler yerine, okurun vaktine saygı duyan net bir okuma deneyimi sunmak.
          Her haberde olayın ne olduğunu, kilit noktalarını ve neden önem taşıdığını doğrudan
          aktarıyoruz.
        </p>
      </section>

      <section class="kurumsal__kart">
        <h2>Haberi Nasıl Sunuyoruz?</h2>
        <p>
          Platformumuzdaki her içerik dört katmandan oluşur: hızlı okuma sağlayan <strong>Özet</strong>,
          gelişmenin satır başlarını veren <strong>Öne Çıkanlar</strong>, olayın arka planını anlatan
          <strong>Haberin Detayı</strong> ve gelişmenin etkilerini değerlendiren <strong>AI Yorumu</strong>.
        </p>
        <p>
          Öne çıkaran özelliğimiz <strong>özet</strong>: Okuru uzun metinlere boğmadan, haberin özünü
          ve neden önemli olduğunu tek ekranda veriyoruz. <strong>Shorts</strong> formatıyla aynı
          gelişmeye dikey ve hızlı bir bakış, AI Yorumu ile de olayın etkisine dair farklı bir
          perspektif sunuyoruz.
        </p>
      </section>
    </div>

    <section class="kurumsal__blok">
      <h2>Çalışma Yöntemimiz ve Kalite Denetimi</h2>
      <p>
        HaberinAi, güncel habercilik standartlarını yapay zekâ destekli metin analizi ve otomatik
        kalite denetim süreçleriyle birleştirir:
      </p>
      <ul>
        <li>
          <strong>Gündem Taraması ve Tekilleştirme:</strong> Gündemdeki gelişmeler resmi
          açıklamalar, basın bültenleri ve kamuya açık ajans bilgileri üzerinden izlenir; aynı olayı
          anlatan mükerrer bültenler elenerek tek ve bütünlüklü bir haber dosyası oluşturulur.
        </li>
        <li>
          <strong>Özgün Özet ve Metin:</strong> Kopyala-yapıştır içerik yayınlanmaz. Her haber;
          kendi özeti, kendi başlığı ve kendi anlatım düzeniyle yazılır, yayına alınmadan önce
          otomatik cümle/ifade benzerlik denetiminden geçirilir.
        </li>
        <li>
          <strong>Analitik Katma Değer:</strong> Haber metnine eklenen analiz bölümünde, gelişmenin
          ilgili sektör, ekonomi veya günlük yaşam üzerindeki olası etkileri değerlendirilir;
          okuyucu haber sayfasındaki etkileşimli soru-cevap aracıyla konunun detaylarını sorgulayabilir.
        </li>
        <li>
          <strong>Okura Saygılı Şeffaflık:</strong> Her haberin sonunda hazırlanma yöntemi, yayın ve
          güncelleme tarihi, sorumlu yayıncı, düzeltme kanalı ve editoryal ilkelere bağlantı gösterilir.
          Haber metinleri ve görselleri izinsiz kullanılmaz; görsellerde haberin kaynağındaki
          fotoğraf (kaynak bağlantısıyla) ya da HaberinAi'nin kendi tasarımı tercih edilir.
        </li>
      </ul>
    </section>

    <section class="kurumsal__blok">
      <h2>Temel İlkelerimiz</h2>
      <div class="kurumsal__ilkeler">
        <div>
          <h3>Doğruluk ve Şeffaflık</h3>
          <p>
            Kaynağı belirsiz iddialara yer vermeyiz; olası maddi hatalarda düzeltme ve tekzip
            taleplerini en geç 48 saat, 5651 m.9 kapsamındaki kaldırma bildirimlerini en geç 24
            saat içinde sonuçlandırırız.
          </p>
        </div>
        <div>
          <h3>Bağımsızlık</h3>
          <p>
            Haber seçimi ve analizlerimiz hiçbir siyasi, ticari veya kurumsal çıkar grubunun
            yönlendirmesine tabi değildir.
          </p>
        </div>
        <div>
          <h3>Telif Haklarına Saygı</h3>
          <p>
            İçeriklerimiz kendi özet ve anlatımımızla üretilir; kopyala-yapıştır metin yayınlanmaz.
            Görsellerde haberin kaynağındaki fotoğraflar kaynak bağlantısıyla ya da HaberinAi'nin
            kendi tasarımları kullanılır; hak sahiplerinin bildirimleri en geç 48 saat, 5651 m.9
            kapsamındaki kaldırma bildirimleri en geç 24 saat içinde sonuçlandırılır.
          </p>
        </div>
        <div>
          <h3>Okur Deneyimi ve Gizlilik</h3>
          <p>
            Sayfalarımızı reklama boğmadan hızlı ve sade tutar, ziyaretçi gizliliğini Google Consent
            Mode ve yürürlükteki mevzuat çerçevesinde koruruz.
          </p>
        </div>
      </div>
    </section>

    <section class="kurumsal__blok">
      <h2>Yapay Zekâ Kullanımı ve İnsan Sorumluluğu</h2>
      <p>
        Haberlerin özetlenmesi, kilit maddelerin çıkarılması ve bağlam analizinin hazırlanmasında
        yapay zekâ dil modellerinden yararlanıyoruz. Yapay zekâ bir karar mercii değil, üretim
        aracıdır: gündem seçimi, yayın kararı ve içeriğin sorumluluğu editör masasındadır.
      </p>
      <ul>
        <li>
          <strong>Görünür açıklama:</strong> Her haberin sonundaki "Bu haber hakkında" kutusunda
          içeriğin yapay zekâ destekli özetleme ve editör kontrolüyle hazırlandığı, yayın/güncelleme
          tarihi ve sorumlu yayıncı açıkça belirtilir. Yorum bölümü "AI Yorumu" etiketiyle ayrılır.
        </li>
        <li>
          <strong>Özgünlük denetimi:</strong> Kopyala-yapıştır metin yayınlanmaz; uzun ortak cümle
          dizileri otomatik benzerlik süzgeciyle ayıklanır. Özetin gövdeyi, yorumun özeti tekrar
          ettiği üretimler kalite kapısından geçemez.
        </li>
        <li>
          <strong>İnsan denetimi ve düzeltme:</strong> Okuyucu bildirimi geldiğinde içerik
          incelenir; maddi hata düzeltilir veya yayından kaldırılır. Düzeltme talepleri en geç
          48 saat, 5651 m.9 kapsamındaki kaldırma bildirimleri en geç 24 saat içinde yanıtlanır.
        </li>
      </ul>
    </section>

    <section class="kurumsal__blok">
      <h2>Finansman, Reklam ve Editoryal Bağımsızlık</h2>
      <p>
        HaberinAi'nin geliri reklam ve açıkça etiketlenmiş sponsorluklardan oluşur. Reklam
        verenlerin haber seçimine, başlığa, özete veya yorumlara müdahalesi kabul edilmez.
        Ücret karşılığı yayımlanan içerikler "Sponsorlu" etiketiyle ayrılır.
      </p>
      <ul>
        <li>
          Reklamlar yalnızca dizine açık, kalite kapısını geçmiş sayfalarda gösterilir;
          noindex sayfalarda reklam yüklenmez.
        </li>
        <li>
          Haber başına en fazla iki reklam birimi kullanılır; okuma deneyimini bozacak
          yoğunluktan kaçınılır.
        </li>
        <li>
          Reklam ve ölçüm çerezleri Google Consent Mode ile yönetilir. Ayrıntılar
          <a href="/gizlilik/">Gizlilik ve Çerez Politikası</a>'nda yer alır.
        </li>
      </ul>
    </section>

    <section class="kurumsal__alt">
      <div>
        <h2>Kurumsal Bağlantılar</h2>
        <p>Yayın yapımız, ilkelerimiz ve iletişim kanallarımız hakkında ayrıntılı bilgi:</p>
      </div>
      <div class="kurumsal__butonlar">
        <a class="kurumsal__btn" href="/kunye/">Künye</a>
        <a class="kurumsal__btn kurumsal__btn--ikincil" href="/yayin-ilkeleri/">Yayın İlkeleri</a>
        <a class="kurumsal__btn kurumsal__btn--ikincil" href="/telif/">İçerik ve Telif</a>
        <a class="kurumsal__btn kurumsal__btn--ikincil" href="/iletisim/">İletişim</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .kurumsal {
    max-width: 880px;
    margin: 36px auto 60px;
    padding: 0 16px;
  }
  .kurumsal__ust {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    margin-bottom: 20px;
  }
  .kurumsal__etiket {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .kurumsal__baslik {
    margin: 12px 0 10px;
    font-size: clamp(1.65rem, 3.6vw, 2.3rem);
    line-height: 1.18;
    letter-spacing: -0.025em;
  }
  .kurumsal__giris {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--text-2);
  }
  .kurumsal__guncelleme {
    margin: 12px 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .kurumsal__ikili {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .kurumsal__kart {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .kurumsal__kart h2 {
    margin: 0 0 8px;
    font-size: 1.18rem;
    letter-spacing: -0.02em;
  }
  .kurumsal__kart p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .kurumsal__blok {
    padding: 26px 28px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    margin-bottom: 20px;
  }
  .kurumsal__blok h2 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .kurumsal__blok > p {
    margin: 0 0 16px;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .kurumsal__blok ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kurumsal__blok li {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  .kurumsal__blok li strong {
    color: var(--text);
  }
  .kurumsal__blok a {
    color: var(--brand-strong);
    font-weight: 600;
  }
  .kurumsal__ilkeler {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 22px;
    margin-top: 14px;
  }
  .kurumsal__ilkeler h3 {
    margin: 0 0 5px;
    font-size: 0.98rem;
  }
  .kurumsal__ilkeler p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-2);
  }
  .kurumsal__alt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }
  .kurumsal__alt h2 {
    margin: 0 0 4px;
    font-size: 1.15rem;
  }
  .kurumsal__alt p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-2);
  }
  .kurumsal__butonlar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .kurumsal__btn {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--brand-grad);
    color: #fff;
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
  }
  .kurumsal__btn--ikincil {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--border);
  }
  @media (max-width: 700px) {
    .kurumsal__ikili,
    .kurumsal__ilkeler {
      grid-template-columns: 1fr;
    }
    .kurumsal__ust,
    .kurumsal__kart,
    .kurumsal__blok,
    .kurumsal__alt {
      padding: 20px 16px;
    }
  }
</style>
