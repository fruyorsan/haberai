---
import Base from "../layouts/Base.astro";
import { getTags, getArticles, timeAgo, publishedISO } from "../lib/articles.js";

const tags = getTags();
const toplamHaber = getArticles().length;

// Konuya sabit renk tonu (kategoriler ve son dakika şeridiyle aynı mantık).
function hue(str) {
  let h = 0;
  const s = String(str || "haber");
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360;
  return h;
}

const items = tags.map((t) => ({
  ...t,
  color: `hsl(${hue(t.name)} 72% 46%)`,
  son: t.articles[0],
}));
---

<Base
  title="Konular — HaberinAi"
  description="HaberinAi konuları: deprem, ekonomi, hava durumu, spor, teknoloji ve daha fazlası. Her konudaki en güncel haberler, özetler ve yapay zekâ yorumları."
>
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">Konular</h1>
      <p class="muted">
        {toplamHaber} haber, {tags.length} konuda. Bir konuya tıklayarak o konudaki tüm
        haberleri görebilirsin.
      </p>
    </header>

    {items.length === 0 ? (
      <p class="muted">Henüz konu yok.</p>
    ) : (
      <div class="catgrid">
        {items.map((t) => (
          <a class="catcard" href={`/etiket/${t.slug}/`} style={`--h:${t.color}`}>
            <span class="catcard__top">
              <span class="catcard__name">{t.name}</span>
              <span class="catcard__n">{t.count} haber</span>
            </span>
            {t.son && (
              <span class="catcard__son">
                <span class="catcard__dot" aria-hidden="true" />
                <span class="catcard__title">{t.son.title}</span>
              </span>
            )}
            {t.son && <span class="catcard__time">{timeAgo(publishedISO(t.son))}</span>}
          </a>
        ))}
      </div>
    )}

    <p class="muted konu-not">
      Konular, haberlerin içeriğine göre yapay zekâ tarafından etiketlenir; yalnızca yeterli
      sayıda habere ulaşan konular burada listelenir.
    </p>
  </div>
</Base>

<style>
  .page-head {
    padding: 30px 0 20px;
  }
  .page-title {
    font-size: 1.9rem;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }
  .muted {
    margin: 0;
  }

  .catgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 14px;
    padding-bottom: 20px;
  }
  .catcard {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-left: 4px solid var(--h);
    border-radius: 14px;
    background: var(--surface);
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease),
      border-color 0.22s var(--ease);
  }
  .catcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 38px -26px rgba(0, 0, 0, 0.6);
  }
  .catcard__top {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .catcard__name {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-transform: capitalize;
  }
  .catcard__n {
    margin-left: auto;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 2px 9px;
    white-space: nowrap;
  }
  .catcard__son {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-2);
  }
  .catcard__dot {
    width: 6px;
    height: 6px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--h);
    flex-shrink: 0;
  }
  .catcard__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .catcard__time {
    font-size: 0.76rem;
    color: var(--muted);
  }
  .konu-not {
    font-size: 0.85rem;
    padding-bottom: 10px;
  }
</style>
