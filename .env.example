# ===================================================================
# AI SAĞLAYICILAR
# ===================================================================
# ÖNERİLEN: Groq — ücretsiz katmanı çok cömert ve hızlı.
# Anahtar: https://console.groq.com/keys  (ücretsiz kayıt)
GROQ_API_KEY=

# Gemini — ücretsiz katman: MODEL BAŞINA GÜNDE ~20 istek (yedek olarak iyi).
# Anahtar: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini ek anahtarlar (isteğe bağlı). Ücretsiz kota model başına günlük ~20
# olduğu için 2-3 anahtar görsel ajanının vision bütçesini katlar. Sırayla
# kullanılır; virgülle birden fazla anahtar da yazılabilir:
#   GEMINI_API_KEY_2=anahtar_a,anahtar_b
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- İsteğe bağlı ayarlar ---
# Bir çalıştırmada işlenecek maksimum haber
MAX_PER_RUN=8

# Bu saatten eski haberleri atla
MAX_AGE_HOURS=48

# Model listelerini değiştirmek istersen (virgülle):
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest

# ===================================================================
# GÖRSEL AJANI (kapak seçimi + AI görsel üretimi)
# ===================================================================
# Cloudflare Workers AI: vision (aday puanlama) ve gerektiğinde görsel üretimi.
# Hesap kimliği: Cloudflare dashboard > Workers & Pages > Account ID
# Token: "Workers AI" yetkili API token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# İsteğe bağlı: vision modelini değiştir (varsayılan llama-3.2-11b-vision).
# NOT: Llama vision modeli ilk kullanımda Cloudflare panelinden lisans onayı
# ister (403 "Model Agreement"). Bir kez kabul edince çalışır.
# CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# Tur başına en fazla hedef haber (varsayılan 3).
GORSEL_AJAN_LIMIT=3
# Geriye dönük gün penceresi (varsayılan 3; 0 = tüm arşiv).
GORSEL_AJAN_GUN=3
# Günlük en fazla AI çağrısı (brif + vision + üretim). Bütçe bitince tur durur.
GORSEL_GUNLUK_AI=120
# 0 = AI görsel üretimini kapat (yalnızca arama + vision).
GORSEL_URETIM=1
# Başarısız hedefi yeniden denemeden önce bekleme (saat).
GORSEL_TEKRAR_SAAT=12
# 1 = Pollinations ücretsiz yedeğini de dene (varsayılan kapalı; sık 503 verir).
# GORSEL_POLLINATIONS=0

# ===================================================================
# SOSYAL DAĞITIM (hepsi OPSİYONEL — boş bıraktığın kanal atlanır)
# ===================================================================
# Sitenin genel adresi (paylaşım linkleri için). Boşsa https://fruyorsan.github.io
SITE_URL=

# Bir çalıştırmada paylaşılacak maksimum haber (ilk kurulumda eski arşiv taşmasını
# önler). 0 = sınırsız.
SHARE_MAX_PER_RUN=5

# --- Telegram ---
# Bot: @BotFather ile oluştur. Chat ID: @userinfobot veya kanal/grup id'si (-100...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ---
# Kanal > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# --- Slack ---
# apps.slack.com > Incoming Webhooks > Add New Webhook
SLACK_WEBHOOK_URL=

# --- Generic webhook (Zapier / Make / IFTTT / n8n) ---
# JSON gövde: { title, summary, url, category, image }
SHARE_WEBHOOK_URL=

# --- Bluesky ---
# Şifre: Bluesky > Settings > Privacy and Security > App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- X / Twitter (OAuth 1.0a, API v2) ---
# developer.x.com > Project & App > Keys and tokens (Read and Write izni gerekir)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ===================================================================
# SİTE (derleme sırasında okunur)
# ===================================================================
# Kanonik adres, RSS ve site haritaları için. Boşsa sitenin yayında olduğu
# adres kullanılır (https://fruyorsan.github.io). Özel alan adı yayına
# girdiğinde bunu ayarla.
SITE_URL=

# İletişim adresi (iletişim sayfası + yapısal veri).
# CONTACT_EMAIL=haberai@yahoo.com

# --- AdSense (hepsi OPSİYONEL; boşken reklam kodu ve reklam alanı basılmaz) ---
# Yayıncı kimliği: ca-pub-XXXXXXXXXXXXXXXX
# ADSENSE_CLIENT=
# Reklam birimleri (AdSense panelinden alınır):
# ADSENSE_SLOT_MAKALE=
# ADSENSE_SLOT_MAKALE2=
# ADSENSE_SLOT_LISTE=
