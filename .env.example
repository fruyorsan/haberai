# Google AI Studio'dan ÜCRETSİZ al: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=buraya_api_keyini_yaz

# --- İsteğe bağlı ayarlar ---
# Kullanılacak model (boş bırakırsan gemini-2.5-flash kullanılır)
GEMINI_MODEL=gemini-2.5-flash

# Bir çalıştırmada işlenecek maksimum haber
MAX_PER_RUN=8

# Bu saatten eski haberleri atla
MAX_AGE_HOURS=48
