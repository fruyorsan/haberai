# ===================================================================
# AI SAĞLAYICILAR
# ===================================================================
# ÖNERİLEN: Groq — ücretsiz katmanı çok cömert ve hızlı.
# Anahtar: https://console.groq.com/keys  (ücretsiz kayıt)
GROQ_API_KEY=

# Gemini — ücretsiz katman: MODEL BAŞINA GÜNDE ~20 istek (yedek olarak iyi).
# Anahtar: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- İsteğe bağlı ayarlar ---
# Bir çalıştırmada işlenecek maksimum haber
MAX_PER_RUN=8

# Bu saatten eski haberleri atla
MAX_AGE_HOURS=48

# Model listelerini değiştirmek istersen (virgülle):
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest
