# ===================================================================
# AI SAĞLAYICILAR
# ===================================================================
# ÖNERİLEN: Groq — ücretsiz katmanı çok cömert ve hızlı.
# Anahtar: https://console.groq.com/keys  (ücretsiz kayıt)
GROQ_API_KEY=

# Gemini — ücretsiz katman: MODEL BAŞINA GÜNDE ~20 istek (yedek olarak iyi).
# Anahtar: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- İsteğe bağlı ayarlar ---
# Bir çalıştırmada işlenecek maksimum haber
MAX_PER_RUN=8

# Bu saatten eski haberleri atla
MAX_AGE_HOURS=48

# Model listelerini değiştirmek istersen (virgülle):
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest

# ===================================================================
# SOSYAL DAĞITIM (hepsi OPSİYONEL — boş bıraktığın kanal atlanır)
# ===================================================================
# Sitenin genel adresi (paylaşım linkleri için). Boşsa https://fruyorsan.github.io
SITE_URL=

# Bir çalıştırmada paylaşılacak maksimum haber (ilk kurulumda eski arşiv taşmasını
# önler). 0 = sınırsız.
SHARE_MAX_PER_RUN=5

# --- Telegram ---
# Bot: @BotFather ile oluştur. Chat ID: @userinfobot veya kanal/grup id'si (-100...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ---
# Kanal > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# --- Slack ---
# apps.slack.com > Incoming Webhooks > Add New Webhook
SLACK_WEBHOOK_URL=

# --- Generic webhook (Zapier / Make / IFTTT / n8n) ---
# JSON gövde: { title, summary, url, category, image }
SHARE_WEBHOOK_URL=

# --- Bluesky ---
# Şifre: Bluesky > Settings > Privacy and Security > App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- X / Twitter (OAuth 1.0a, API v2) ---
# developer.x.com > Project & App > Keys and tokens (Read and Write izni gerekir)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
